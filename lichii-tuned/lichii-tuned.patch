diff --git a/src/tests/video_core/memory_switches.cpp b/src/tests/video_core/memory_switches.cpp
new file mode 100644
index 0000000000..0ea194f05b
--- /dev/null
+++ b/src/tests/video_core/memory_switches.cpp
@@ -0,0 +1,103 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <cstddef>
+#include <optional>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include "video_core/renderer_vulkan/vk_staging_ring.h"
+#include "video_core/vulkan_common/vulkan_memory_reserve.h"
+
+namespace {
+
+namespace DeviceMemory = Vulkan::DeviceMemory;
+using Vulkan::StagingRingRegions;
+
+constexpr size_t MiB = size_t{1} << 20;
+constexpr u64 GiB = u64{1} << 30;
+
+} // namespace
+
+TEST_CASE("Area load size switches take their defaults only when unset",
+          "[video_core][vulkan][memory_switches]") {
+    REQUIRE_FALSE(DeviceMemory::ParseMiBSwitch(nullptr).has_value());
+    REQUIRE_FALSE(DeviceMemory::ParseMiBSwitch("").has_value());
+    REQUIRE(DeviceMemory::ParseMiBSwitch("512") == std::optional<u64>{512});
+    REQUIRE(DeviceMemory::ParseMiBSwitch("0") == std::optional<u64>{0});
+    // A value that is not a size turns the item off, as it did before the defaults.
+    REQUIRE(DeviceMemory::ParseMiBSwitch("off") == std::optional<u64>{0});
+    REQUIRE(DeviceMemory::ParseMiBSwitch(nullptr).value_or(DeviceMemory::DefaultStagingRingMiB) ==
+            256);
+    REQUIRE(DeviceMemory::ParseMiBSwitch("0").value_or(DeviceMemory::DefaultStagingRingMiB) == 0);
+}
+
+TEST_CASE("The device memory reserve is on by default only on large discrete GPUs",
+          "[video_core][vulkan][memory_switches]") {
+    // The 16 GB RX 9070 XT with 32 GB of RAM it was proven on, 12 and 11 GB cards.
+    REQUIRE(DeviceMemory::DefaultPreallocMiBFor(true, 16304 * MiB, 32 * GiB) == 4096);
+    REQUIRE(DeviceMemory::DefaultPreallocMiBFor(true, 12282 * MiB, 32 * GiB) == 4096);
+    REQUIRE(DeviceMemory::DefaultPreallocMiBFor(true, 11 * GiB, 24 * GiB) == 4096);
+    // 10 and 8 GB cards, or EDEN_NX2_VRAM_LIMIT_MIB=8192 on a larger one.
+    REQUIRE(DeviceMemory::DefaultPreallocMiBFor(true, 10 * GiB, 32 * GiB) == 0);
+    REQUIRE(DeviceMemory::DefaultPreallocMiBFor(true, 8 * GiB, 32 * GiB) == 0);
+    // An integrated GPU's device-local heap is system memory, however large.
+    REQUIRE(DeviceMemory::DefaultPreallocMiBFor(false, 32 * GiB, 64 * GiB) == 0);
+    // Its blocks hold host commit on Windows: not with 16 GB of RAM, nor when it is unknown.
+    REQUIRE(DeviceMemory::DefaultPreallocMiBFor(true, 16304 * MiB, 16 * GiB) == 0);
+    REQUIRE(DeviceMemory::DefaultPreallocMiBFor(true, 16304 * MiB, 0) == 0);
+}
+
+TEST_CASE("The staging ring reuses a region only once the GPU is past it",
+          "[video_core][vulkan][staging_ring]") {
+    StagingRingRegions ring{256 * MiB}; // 16 regions of 16 MiB
+    REQUIRE(ring.RegionSize() == 16 * MiB);
+    // Tick 1, nothing done on the GPU yet: uploads one after another, aligned.
+    REQUIRE(ring.Take(100, 1, 0) == std::optional<size_t>{0});
+    REQUIRE(ring.Take(100 * MiB, 1, 0) == std::optional<size_t>{256});
+    REQUIRE(ring.Take(100 * MiB, 1, 0) == std::optional<size_t>{100 * MiB + 256});
+    // The next one wraps to the start, which tick 1 still holds: refused, and nothing changes.
+    REQUIRE_FALSE(ring.Take(100 * MiB, 1, 0).has_value());
+    REQUIRE(ring.Take(40 * MiB, 1, 0) == std::optional<size_t>{200 * MiB + 256});
+    // Once the GPU is past tick 1 the start is free again.
+    REQUIRE(ring.Take(100 * MiB, 2, 1) == std::optional<size_t>{0});
+}
+
+TEST_CASE("Each lap of the staging ring checks the regions it enters",
+          "[video_core][vulkan][staging_ring]") {
+    StagingRingRegions ring{256 * MiB};
+    REQUIRE(ring.Take(64 * MiB, 1, 0) == std::optional<size_t>{0});
+    REQUIRE(ring.Take(64 * MiB, 2, 0) == std::optional<size_t>{64 * MiB});
+    REQUIRE(ring.Take(128 * MiB, 3, 0) == std::optional<size_t>{128 * MiB});
+    // The GPU is past tick 1 only: the next lap takes tick 1's regions, not tick 2's.
+    REQUIRE(ring.Take(64 * MiB, 4, 1) == std::optional<size_t>{0});
+    REQUIRE_FALSE(ring.Take(64 * MiB, 4, 1).has_value());
+    REQUIRE(ring.Take(64 * MiB, 4, 2) == std::optional<size_t>{64 * MiB});
+}
+
+TEST_CASE("The staging ring takes an upload over half of it only when it is free",
+          "[video_core][vulkan][staging_ring]") {
+    StagingRingRegions ring{256 * MiB};
+    REQUIRE(ring.IsFree(0));
+    REQUIRE(ring.Take(16 * MiB, 1, 0) == std::optional<size_t>{0});
+    REQUIRE_FALSE(ring.IsFree(0));
+    // Its own regions are free, but another upload of the GPU's unfinished work is in the ring.
+    REQUIRE_FALSE(ring.Take(200 * MiB, 1, 0).has_value());
+    REQUIRE_FALSE(ring.Take(200 * MiB, 2, 0).has_value());
+    // r64's area loads: a 213 MiB storage buffer upload once the GPU is done with the ring.
+    REQUIRE_FALSE(ring.LargeUploadInFlight(1));
+    REQUIRE(ring.Take(213 * MiB, 2, 1) == std::optional<size_t>{16 * MiB});
+    REQUIRE(ring.LargeUploadInFlight(1));
+    // The rest of its tick gets what it leaves.
+    REQUIRE(ring.Take(20 * MiB, 2, 1) == std::optional<size_t>{229 * MiB});
+    REQUIRE_FALSE(ring.Take(20 * MiB, 2, 1).has_value());
+    REQUIRE_FALSE(ring.LargeUploadInFlight(2));
+    // All of it, from the start.
+    REQUIRE_FALSE(ring.Take(256 * MiB, 3, 1).has_value());
+    REQUIRE(ring.Take(256 * MiB, 3, 2) == std::optional<size_t>{0});
+    REQUIRE_FALSE(ring.Take(1, 3, 2).has_value());
+    REQUIRE(ring.Take(1, 4, 3) == std::optional<size_t>{0});
+    // Never more than the ring, nor nothing.
+    REQUIRE_FALSE(ring.Take(256 * MiB + 1, 5, 4).has_value());
+    REQUIRE_FALSE(ring.Take(0, 5, 4).has_value());
+}
diff --git a/src/tests/video_core/native_qmd.cpp b/src/tests/video_core/native_qmd.cpp
index 560ae4b13f..2a7943a018 100644
--- a/src/tests/video_core/native_qmd.cpp
+++ b/src/tests/video_core/native_qmd.cpp
@@ -4,7 +4,9 @@
 #include <array>
 #include <cstdint>
 #include <map>
+#include <string>
 #include <string_view>
+#include <utility>
 #include <vector>
 
 #include <catch2/catch_test_macros.hpp>
@@ -149,3 +151,141 @@ TEST_CASE("Semaphore reductions follow the documented ops", "[video_core][native
     REQUIRE(ReduceSemaphore(6, false, 0b1100, 0b1010) == 0b1110);
     REQUIRE(ReduceSemaphore(7, false, 0b1100, 0b1010) == 0b0110);
 }
+
+TEST_CASE("A QMD scheduler with a table of its own schedules apart from the shared one",
+          "[video_core][native_qmd]") {
+    constexpr Address address = 0x40000;
+    auto qmd = MakeQmd();
+    qmd[4] = 1U << 14; // One dependency
+    SetRelease(qmd, 24, 0x5000, Enable | OneWord, 1);
+    const std::map<Address, Descriptor> memory{{address, qmd}};
+    const auto signal = [&](NativeQmdScheduler& scheduler, Word action) {
+        std::vector<Released> released;
+        const auto error = scheduler.Signal(
+            address, action,
+            [&](Address qmd_address, Descriptor& descriptor) {
+                const auto it = memory.find(qmd_address);
+                if (it == memory.end()) {
+                    return false;
+                }
+                descriptor = it->second;
+                return true;
+            },
+            [&](Address destination, Word payload, Word flags) {
+                released.push_back({destination, payload, flags});
+                return true;
+            });
+        REQUIRE(error.empty());
+        return released;
+    };
+    const std::vector<Released> run{{0x5000, 1, Enable | OneWord}};
+    // Loaded on the shared table, it waits for its dependency.
+    NativeQmdScheduler shared;
+    REQUIRE(signal(shared, 3).empty());
+    // A copy of the table runs it at the decrement as the shared one does, and apart from it.
+    NativeQmdScheduler own{NativeQmdScheduler::OwnTable{}};
+    own.CopyStates(shared);
+    REQUIRE(signal(own, 7) == run);
+    REQUIRE(signal(own, 7).empty()); // Completed: a decrement is kept for its next load
+    REQUIRE(signal(shared, 7) == run);
+    // A table that never saw the load keeps the decrement for it.
+    NativeQmdScheduler other{NativeQmdScheduler::OwnTable{}};
+    REQUIRE(signal(other, 7).empty());
+    REQUIRE(signal(other, 3) == run);
+}
+
+TEST_CASE("A QMD scheduler takes back what an attempt changed and keeps what one committed",
+          "[video_core][native_qmd]") {
+    constexpr Address first = 0x40000;
+    constexpr Address second = 0x40100;
+    auto waiting = MakeQmd();
+    waiting[4] = 1U << 14; // One dependency
+    SetRelease(waiting, 24, 0x5000, Enable | OneWord, 1);
+    auto chained = MakeQmd(); // Decrements `first` when it runs
+    SetRelease(chained, 24, 0x5004, Enable | OneWord, 2);
+    chained[15] = static_cast<Word>(first >> 8);
+    chained[16] = 1 | (4U << 1);
+    std::map<Address, Descriptor> memory{{first, waiting}, {second, chained}};
+    bool unreadable{};
+    const auto signal = [&](NativeQmdScheduler& scheduler, Address address, Word action) {
+        std::vector<Released> released;
+        const auto error = scheduler.Signal(
+            address, action,
+            [&](Address qmd_address, Descriptor& descriptor) {
+                const auto it = memory.find(qmd_address);
+                if (it == memory.end() || (unreadable && qmd_address == first)) {
+                    return false;
+                }
+                descriptor = it->second;
+                return true;
+            },
+            [&](Address destination, Word payload, Word flags) {
+                released.push_back({destination, payload, flags});
+                return true;
+            });
+        return std::make_pair(std::string{error}, released);
+    };
+    NativeQmdScheduler own{NativeQmdScheduler::OwnTable{}};
+    NativeQmdScheduler reference{NativeQmdScheduler::OwnTable{}};
+    REQUIRE(signal(own, first, 3).second.empty()); // Loaded, waits for its dependency
+    REQUIRE(signal(reference, first, 3).second.empty());
+    // The chained launch runs and decrements `first`, which can't be read: taken back, the table
+    // is as before, `second` never ran.
+    unreadable = true;
+    own.BeginAttempt();
+    REQUIRE_FALSE(signal(own, second, 3).first.empty());
+    own.RollbackAttempt();
+    REQUIRE(own.SameStates(reference));
+    REQUIRE(own.StateCount() == 1);
+    // Tried again once it can be read: both run, as on a table that never tried.
+    unreadable = false;
+    own.BeginAttempt();
+    const auto ran = signal(own, second, 3);
+    own.CommitAttempt();
+    const std::vector<Released> both{{0x5004, 2, Enable | OneWord}, {0x5000, 1, Enable | OneWord}};
+    REQUIRE(ran.first.empty());
+    REQUIRE(ran.second == both);
+    REQUIRE(signal(reference, second, 3).second == both);
+    REQUIRE(own.SameStates(reference));
+    // A rollback after the commit changes nothing.
+    own.RollbackAttempt();
+    REQUIRE(own.SameStates(reference));
+}
+
+TEST_CASE("A QMD scheduler takes back the history an attempt dropped at its limit",
+          "[video_core][native_qmd]") {
+    // Any address holds a QMD that runs at once; one of them can't be read.
+    const Descriptor qmd = MakeQmd();
+    Address unreadable = 0;
+    const auto signal = [&](NativeQmdScheduler& scheduler, Address address) {
+        return std::string{scheduler.Signal(
+            address, 3,
+            [&](Address qmd_address, Descriptor& descriptor) {
+                descriptor = qmd;
+                return qmd_address != unreadable;
+            },
+            [](Address, Word, Word) { return true; })};
+    };
+    NativeQmdScheduler own{NativeQmdScheduler::OwnTable{}};
+    NativeQmdScheduler reference{NativeQmdScheduler::OwnTable{}};
+    for (Address i = 0; i < 4096; ++i) {
+        REQUIRE(signal(own, 0x100000 + i * 0x100).empty());
+        REQUIRE(signal(reference, 0x100000 + i * 0x100).empty());
+    }
+    REQUIRE(own.StateCount() == 4096);
+    // A new QMD past the limit drops the finished ones first; it can't be read: all taken back.
+    unreadable = 0x900000;
+    own.BeginAttempt();
+    REQUIRE_FALSE(signal(own, unreadable).empty());
+    own.RollbackAttempt();
+    REQUIRE(own.StateCount() == 4096);
+    REQUIRE(own.SameStates(reference));
+    // Kept, it drops them as the reference does.
+    unreadable = 0;
+    own.BeginAttempt();
+    REQUIRE(signal(own, 0x900000).empty());
+    own.CommitAttempt();
+    REQUIRE(signal(reference, 0x900000).empty());
+    REQUIRE(own.StateCount() == 1);
+    REQUIRE(own.SameStates(reference));
+}
