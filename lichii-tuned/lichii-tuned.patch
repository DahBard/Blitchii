+void RasterizerVulkan::ReportWaitForIdle() {
+    auto& stats = wfi_stats;
+    const u64 now = VideoCommon::Nx2Profile::Now();
+    if (stats.window_start == 0) {
+        stats = WaitForIdleStats{.window_start = now};
+        void(query_cache.TakeFenceSyncs());
+        return;
+    }
+    if (now - stats.window_start < 10'000'000'000ULL) {
+        return;
+    }
+    const double seconds = static_cast<double>(now - stats.window_start) / 1e9;
+    const auto rate = [seconds](u64 count) { return static_cast<double>(count) / seconds; };
+    // A fence-flagged report syncs at its own fence (CommitAsyncFlushes), so waits for idle find
+    // none pending.
+    const std::array<u64, 3> fence_syncs = query_cache.TakeFenceSyncs();
+    LOG_INFO(Render_Vulkan,
+             "Wait for idle per second: {:.0f}, {:.0f} in a render pass; with a query sync, in a "
+             "pass: {:.0f} only immediate writes, {:.0f} with a fence-flagged entry, {:.0f} "
+             "other; outside a pass: {:.0f}, {:.0f}, {:.0f}; a keep-pass would take {:.0f} (in a "
+             "pass, nothing to sync, no storage or transform feedback write since the last "
+             "wait-for-idle barrier), {:.0f} more if only immediate writes did not sync; {:.0f} "
+             "with nothing recorded since that barrier and no upload or clear waiting; query "
+             "syncs at fences: {:.0f} only immediate writes, {:.0f} with a fence-flagged entry, "
+             "{:.0f} other",
+             rate(stats.total), rate(stats.render_pass), rate(stats.syncs[1][0]),
+             rate(stats.syncs[1][1]), rate(stats.syncs[1][2]), rate(stats.syncs[0][0]),
+             rate(stats.syncs[0][1]), rate(stats.syncs[0][2]), rate(stats.keep),
+             rate(stats.keep_lazy), rate(stats.redundant), rate(fence_syncs[0]),
+             rate(fence_syncs[1]), rate(fence_syncs[2]));
+    stats = WaitForIdleStats{.window_start = now};
+}
