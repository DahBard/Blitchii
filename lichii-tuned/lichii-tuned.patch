+}
+void vka_rc_cs_c0(const vka_shader* sh, const vka_bstate* s, uint8_t* d) {
+    if (sh && sh->nvn2_control) cs_c0_fill(sh->nvn2_control, s, d); else memset(d, 0, DMSH_DRV_SIZE);
+}
