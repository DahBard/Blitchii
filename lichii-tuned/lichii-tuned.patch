+// From Banana Native (github.com/hugorosario/BananaNative, Android port of github.com/seedds/nxnative by seedds), MIT: see LICENSE in src/video_core/nvn_direct/bananative.
+// The Vulkan shader library reader (vka_shlib.h). Every offset in the file is checked once at open, so lookups afterwards index the tables without further checks
+#include "vka_shlib.h"
+#include <fcntl.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+// zstd's decompressor (dm/third_party/zstd/zstddeclib.c, linked beside this file): the two calls used
+size_t ZSTD_decompress(void *dst, size_t dst_cap, const void *src, size_t src_size);
+unsigned ZSTD_isError(size_t code);
+const char *ZSTD_getErrorName(size_t code);
+
+static int fail(char *err, size_t n, const char *fmt, ...) {
+    if (err && n) { va_list ap; va_start(ap, fmt); vsnprintf(err, n, fmt, ap); va_end(ap); }
+    return 0;
+}
+void vka_shlib_str(const char field[16], char out[17]) { memcpy(out, field, 16); out[16] = 0; }
+static int str_is(const char field[16], const char *want) { char s[17]; vka_shlib_str(field, s); return !strcmp(s, want); }
+
+int vka_shlib_check(vka_shlib *L, const void *base, size_t size, const char *chain, const char *vk_chain, const char *game, const char *abi, char *err, size_t errn) {
+    memset(L, 0, sizeof *L);
+    if (!base || size < sizeof(dmsh_vk_header)) return fail(err, errn, "%zu bytes: shorter than the header", size);
+    const dmsh_vk_header *h = base; char s[17];
+    if (h->magic != DMSH_VK_LIB_MAGIC) return fail(err, errn, "magic %#x, not a Vulkan shader library", h->magic);
+    if (h->version != DMSH_VK_LIB_VERSION) return fail(err, errn, "library format %u, this host reads %u", h->version, DMSH_VK_LIB_VERSION);
+    // Another version is taken only by the ABI the header records (12 characters, no NUL; zero in a library made before the field): what this host reads of it is the same
+    int by_abi = 0;
+    if ((chain && !str_is(h->chain, chain)) || (vk_chain && !str_is(h->vk_chain, vk_chain))) {
+        by_abi = abi && strlen(abi) == sizeof h->abi && !memcmp(h->abi, abi, sizeof h->abi);
+        char a[13]; memcpy(a, h->abi, 12); a[12] = 0; for (int i = 0; i < 12; i++) if (a[i] < 32 || a[i] > 126) { a[0] = 0; break; }
+        if (!by_abi && chain && !str_is(h->chain, chain)) { vka_shlib_str(h->chain, s); return fail(err, errn, "translator chain %s, this host has %s (library ABI %s, this host's %s)", s, chain, *a ? a : "none", abi ? abi : "not asked"); }
+        if (!by_abi) { vka_shlib_str(h->vk_chain, s); return fail(err, errn, "Vulkan chain %s, this host has %s (library ABI %s, this host's %s)", s, vk_chain, *a ? a : "none", abi ? abi : "not asked"); }
+    }
+    if (game && !str_is(h->game, game)) { vka_shlib_str(h->game, s); return fail(err, errn, "built for game %s, this is %s", s, game); }
+    uint64_t sz = size;
+    if ((uint64_t)h->entry_off + (uint64_t)h->entry_count * sizeof(dmsh_vk_entry) > sz || (h->entry_off & 7)) return fail(err, errn, "entry table out of the file");
+    if ((uint64_t)h->bind_off + (uint64_t)h->bind_count * sizeof(dmsh_vk_bind) > sz || (h->bind_off & 7)) return fail(err, errn, "binding table out of the file");
+    if ((uint64_t)h->mod_off + (uint64_t)h->mod_count * sizeof(dmsh_vk_module) > sz || (h->mod_off & 7)) return fail(err, errn, "module table out of the file");
+    if (h->blob_off > sz || h->blob_size > sz - h->blob_off) return fail(err, errn, "blob out of the file");
+    const uint8_t *b = base;
+    L->base = b; L->size = size; L->h = h; L->by_abi = by_abi;
+    L->ent = (const dmsh_vk_entry *)(b + h->entry_off); L->bind = (const dmsh_vk_bind *)(b + h->bind_off); L->mod = (const dmsh_vk_module *)(b + h->mod_off); L->blob = b + h->blob_off;
+    for (uint32_t i = 0; i < h->entry_count; i++) {
+        const dmsh_vk_entry *e = &L->ent[i];
+        if (i && e->key <= L->ent[i - 1].key) return fail(err, errn, "entry %u (key %016llx) out of order", i, (unsigned long long)e->key);
+        if ((uint64_t)e->bind + e->bind_count > h->bind_count) return fail(err, errn, "entry %016llx: bindings past the table", (unsigned long long)e->key);
+        if ((uint64_t)e->mod + e->mod_count > h->mod_count || !e->mod_count) return fail(err, errn, "entry %016llx: modules past the table", (unsigned long long)e->key);
+        if ((uint64_t)e->c1_off + e->c1_len > h->blob_size) return fail(err, errn, "entry %016llx: c1 bytes past the blob", (unsigned long long)e->key);
+        if (e->stage > DMSH_VK_STAGE_MS) return fail(err, errn, "entry %016llx: stage %u", (unsigned long long)e->key, e->stage);
+    }
+    for (uint32_t i = 0; i < h->mod_count; i++) {
+        const dmsh_vk_module *m = &L->mod[i];
+        if ((uint64_t)m->off + m->stored > h->blob_size) return fail(err, errn, "module %u past the blob", i);
+        if (m->codec != DMSH_VK_CODEC_RAW && m->codec != DMSH_VK_CODEC_ZSTD) return fail(err, errn, "module %u: codec %u", i, m->codec);
+        if (m->size & 3 || m->size < 20 || (m->codec == DMSH_VK_CODEC_RAW && m->stored != m->size)) return fail(err, errn, "module %u: %u bytes of SPIR-V, %u stored", i, m->size, m->stored);
+    }
+    return 1;
+}
+
+int vka_shlib_open(vka_shlib *L, const char *path, const char *chain, const char *vk_chain, const char *game, const char *abi, char *err, size_t errn) {
+    memset(L, 0, sizeof *L);
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0) return fail(err, errn, "cannot open %s", path);
+    struct stat st;
+    if (fstat(fd, &st) || st.st_size < (off_t)sizeof(dmsh_vk_header)) { close(fd); return fail(err, errn, "%s: no header", path); }
+    void *p = mmap(NULL, (size_t)st.st_size, PROT_READ, MAP_SHARED, fd, 0);
+    close(fd);
+    if (p == MAP_FAILED) return fail(err, errn, "%s: mmap failed", path);
+    if (!vka_shlib_check(L, p, (size_t)st.st_size, chain, vk_chain, game, abi, err, errn)) { munmap(p, (size_t)st.st_size); return 0; }
+    L->mapped = 1;
+    return 1;
+}
+void vka_shlib_close(vka_shlib *L) {
+    if (L->mapped && L->base) munmap((void *)L->base, L->size);
+    memset(L, 0, sizeof *L);
+}
+
+uint64_t vka_shlib_key(const uint8_t md[8]) { uint64_t k = 0; for (int i = 0; i < 8; i++) k = k << 8 | md[i]; return k; }
+
+const dmsh_vk_entry *vka_shlib_find(const vka_shlib *L, uint64_t key) {
+    if (!L->h) return NULL;
+    uint32_t lo = 0, hi = L->h->entry_count;
+    while (lo < hi) {
+        uint32_t m = lo + (hi - lo) / 2; uint64_t k = L->ent[m].key;
+        if (k == key) return &L->ent[m];
+        if (k < key) lo = m + 1; else hi = m;
+    }
+    return NULL;
+}
+const dmsh_vk_module *vka_shlib_module(const vka_shlib *L, const dmsh_vk_entry *e, int variant) {
+    for (unsigned i = 0; i < e->mod_count; i++) if (L->mod[e->mod + i].variant == variant) return &L->mod[e->mod + i];
+    return NULL;
+}
+
+uint32_t *vka_shlib_spirv(const vka_shlib *L, const dmsh_vk_module *m, size_t *nbytes, char *err, size_t errn) {
+    uint32_t *w = malloc(m->size);
+    if (!w) { fail(err, errn, "%u bytes for a module", m->size); return NULL; }
+    const uint8_t *src = L->blob + m->off;
+    if (m->codec == DMSH_VK_CODEC_RAW) memcpy(w, src, m->size);
+    else {
+        size_t r = ZSTD_decompress(w, m->size, src, m->stored);
+        if (ZSTD_isError(r) || r != m->size) { fail(err, errn, "zstd: %s (%zu of %u bytes)", ZSTD_isError(r) ? ZSTD_getErrorName(r) : "short frame", ZSTD_isError(r) ? 0 : r, m->size); free(w); return NULL; }
+    }
+    if (w[0] != 0x07230203u) { fail(err, errn, "not SPIR-V (first word %#x)", w[0]); free(w); return NULL; }
+    if (nbytes) *nbytes = m->size;
+    return w;
+}
diff --git a/src/video_core/nvn_direct/bananative/dm/gfx/vk_android/vka_shlib.h b/src/video_core/nvn_direct/bananative/dm/gfx/vk_android/vka_shlib.h
new file mode 100644
index 0000000000..861f87f1b0
--- /dev/null
+++ b/src/video_core/nvn_direct/bananative/dm/gfx/vk_android/vka_shlib.h
@@ -0,0 +1,33 @@
+// From Banana Native (github.com/hugorosario/BananaNative, Android port of github.com/seedds/nxnative by seedds), MIT: see LICENSE in src/video_core/nvn_direct/bananative.
+// The Vulkan shader library reader (android/SHADERS.md "Library format"): one file per game, dmsh_vk.lib, made by dm/gfx/tools/vk_android_build.py. Plain C with no Vulkan,
+// so the Mac unit test (dm/host/tests t_android_shlib) runs the same code against a real library. The replay (vka_shader.c) maps the file once and takes modules from it by key
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#include "../nvn/dmsh_abi_vk.h"
+
+typedef struct {
+    const uint8_t *base; size_t size;          // the whole file (mapped, or a caller's buffer)
+    const dmsh_vk_header *h;
+    const dmsh_vk_entry *ent; const dmsh_vk_bind *bind; const dmsh_vk_module *mod; const uint8_t *blob;
+    int mapped;
+    int by_abi;   // taken by its abi only: its chain or vk_chain is not the host's (an older library played while its update runs)
+} vka_shlib;
+
+// Checks a library image against what the host was built with: magic, version, chain, vk_chain and game (NULL = not checked), then every table and range inside the file and the
+// entries' key order. abi (the host's DMSH_VK_ABI; NULL = versions only): a library whose chain or vk_chain differs is still taken when its header's abi is this one (by_abi),
+// the rule for an older library while its delta update runs (android/SHADERS.md#delta-updates). 1 = usable; else 0 and err says why (one line)
+int vka_shlib_check(vka_shlib *L, const void *base, size_t size, const char *chain, const char *vk_chain, const char *game, const char *abi, char *err, size_t errn);
+// Maps path read-only and checks it as above
+int vka_shlib_open(vka_shlib *L, const char *path, const char *chain, const char *vk_chain, const char *game, const char *abi, char *err, size_t errn);
+void vka_shlib_close(vka_shlib *L);
+
+uint64_t vka_shlib_key(const uint8_t md[8]);   // the host's 8-byte program key (prog_key) as the library's sort key: its 16 hex digits read as one big-endian number
+const dmsh_vk_entry *vka_shlib_find(const vka_shlib *L, uint64_t key);   // NULL = not in the library
+static inline const dmsh_vk_bind *vka_shlib_binds(const vka_shlib *L, const dmsh_vk_entry *e) { return L->bind + e->bind; }
+const dmsh_vk_module *vka_shlib_module(const vka_shlib *L, const dmsh_vk_entry *e, int variant);   // NULL = no module of that variant
+static inline const uint8_t *vka_shlib_c1(const vka_shlib *L, const dmsh_vk_entry *e) { return e->c1_len ? L->blob + e->c1_off : NULL; }
+// The module's SPIR-V words, decompressed when stored with zstd: malloc'd (the caller frees), *nbytes its size. NULL with err on a bad module
+uint32_t *vka_shlib_spirv(const vka_shlib *L, const dmsh_vk_module *m, size_t *nbytes, char *err, size_t errn);
+// A header string (chain, vk_chain, game, inputs: 16 bytes NUL padded) as a C string
+void vka_shlib_str(const char field[16], char out[17]);
diff --git a/src/video_core/nvn_direct/bananative/dm/gfx/vk_android/vka_sparse.c b/src/video_core/nvn_direct/bananative/dm/gfx/vk_android/vka_sparse.c
new file mode 100644
index 0000000000..71b689a4c5
--- /dev/null
+++ b/src/video_core/nvn_direct/bananative/dm/gfx/vk_android/vka_sparse.c
@@ -0,0 +1,319 @@
+// From Banana Native (github.com/hugorosario/BananaNative, Android port of github.com/seedds/nxnative by seedds), MIT: see LICENSE in src/video_core/nvn_direct/bananative.
+// Sparse residency images: a large texture of a sparse virtual pool (hle_nvn.c) gets memory only behind the 64 KB tiles the game maps (docs/reference/nvn-objects.md
+// "Sparse texture arrays made at their full size").
+// Before, such a texture was a dense image of every level with a mapped page: Mario Kart World 1.8.0's 8192x8192 x68 ASTC 8x8 arrays with a few mapped tiles in level 0 took
+// 1.45 GB each with 128 MiB mapped, and its 6 GB array was refused (-2), at 147 MB of free memory before the first frame.
+// NVN's sparse tile is the standard 64 KB block shape (nvn_tex.c sparse_tile_h: 256x256 / 256x128 / 128x128 / 128x64 / 64x64 blocks for 1 / 2 / 4 / 8 / 16 bytes a block), which
+// is Vulkan's residencyStandard2DBlockShape: one NVN page of a tiled level is one Vulkan tile. The image is made with VK_IMAGE_CREATE_SPARSE_RESIDENCY_BIT (vka_tex.c img_create);
+// per tile of its tiled levels a 64 KiB slot of a 64 MiB tile block is bound while the page table has any page of the tile mapped, and unbound when it has none (strict
+// non-resident reads: an unbound tile reads 0, as an unmapped page reads on the Switch). Levels Vulkan tiles but NVN packs into its mip tail are bound whole, and the mip tail too.
+// Order: binds are queued here and go to the queue with vkQueueBindSparse right before the next submission of the replay or of an upload batch (vks_queue_locked, under V.qmu).
+// A bind batch waits for every submission handed to the host's queue (V.q) before it (none still reads a tile it unbinds or rebinds): an empty vkQueueSubmit first signals
+// the sparse timeline at a value of its own, which by queue order covers everything submitted there before (with one queue: every replay part, upload batch and framegen),
+// after the batch before it; the bind waits for that value only and signals the next. Every later submission of the replay and of the upload batches waits for the bind's
+// value, so the tiles are bound before the copies that fill them and the draws that read them. A batch that fails keeps its binds (and the slots its unbinds free) for the
+// next one. A slot unbound is reused only by a later batch; a tile block is freed once empty and the batch that emptied it has run. No aliasing (a slot is one tile of one
+// image): the phone has no sparseResidencyAliased.
+// Lichii: with the NVN queues as Vulkan queues (V.multi) a batch does not wait for the replay's earlier submissions on those queues. nvnMemoryPoolMapVirtual takes effect at
+// once on the CPU, and the replay binds what the page table holds when it prepares the next submission that uses the texture. A game may only remap a page once it knows
+// the GPU work that reads it is done, and what it can know that from is published only after the host GPU ran that work: a fence reads as done once its queue's timeline
+// got there and its CPU-side effects ran (vka_dev.c multi_pass), and GPU event signals and counter reports are written by those effects. Exceptions, which break more than
+// this anyway: a report's counter word written at replay (vka_exec.c rc_counter), and the [RED] let-throughs (a gate signalled by the host at a stall or as the shared-queue
+// stopgap, every fence done after a GPU hang or at shutdown). Waiting would instead deadlock what the console allows: queue B waits for event E and then samples sparse
+// texture X, the CPU maps new tiles of X, and queue A uploads and signals E: the batch would wait for B's work, A's next part waits for the batch, and E never comes.
+// Vulkan lets other ranges of a sparse image be used while a bind runs
+// DM_VK_SPARSE_RES=0: dense images as before (read once)
+#if defined(__ANDROID__)
+#include "vka.h"
+#include <stdlib.h>
+
+#define TILE 65536u
+#define BLOCK_TILES 1024u                     // 64 MiB tile blocks
+typedef struct { VkDeviceMemory dm; uint32_t type, used; uint64_t bits[BLOCK_TILES / 64]; uint64_t free_at; } tblock;   // free_at: the sparse value after which, empty, it may be freed
+struct vks_img {
+    VkImage img; uint32_t type, w, h, levels, layers, tiled, mtfl, tw, th;
+    uint32_t lofs[16], ntx[16], nty[16], per_layer;   // levels < mtfl: first tile of the level in a layer's run of slot[], tiles across and down; tiles a layer
+    uint32_t *slot;                            // per tile of levels < mtfl, layer-major: slot id + 1, 0 = unbound
+    uint32_t ntail, tail_each, *tail;          // mip tails (one, or one a layer) of tail_each slots each
+    VkSparseImageMemoryRequirements sr;
+    uint64_t last;                             // the last sparse value whose batch binds into it (under g_ks)
+    uint32_t bound;                            // slots bound (tiles and tails)
+};
+static pthread_mutex_t g_ks = PTHREAD_MUTEX_INITIALIZER;
+static tblock **g_tb; static uint32_t g_ntb, g_ctb;
+static VkSemaphore g_stl; static uint64_t g_sval, g_sig;   // the sparse timeline: g_sval = the last bind batch's value handed to the queue, g_sig = the last value anything signals
+                                                             // (the empty submissions before each batch take values too: a value >= a batch's means it has run)
+typedef struct { vks_img *s; uint64_t seq; VkSparseImageMemoryBind b; } pimg;   // pending binds, with the image they bind into and their order
+typedef struct { vks_img *s; uint64_t seq; VkSparseMemoryBind b; } popq;
+static uint64_t g_seq;
+static pimg *g_pi; static uint32_t g_npi, g_cpi;
+static popq *g_po; static uint32_t g_npo, g_cpo;
+static uint32_t *g_rel; static uint32_t g_nrel, g_crel;   // slots that pending binds unbind: given back once their batch is queued
+static uint64_t g_bytes, g_va, g_nbatch, g_nbinds, g_nimg;
+static int grow(void **p, uint32_t *cap, uint32_t n, size_t sz) {
+    if (n < *cap) return 1;
+    uint32_t c = *cap ? *cap * 2 : 256; void *q = realloc(*p, (size_t)c * sz); if (!q) return 0; *p = q; *cap = c; return 1;
+}
+
+// Lichii: on by default on NVIDIA's driver only (DM_VK_SPARSE_RES=0/1 overrides). An early run on Lichii's device (dotfiles-25x.5, nd-pic-0, before most of the replay's
+// fixes) lost the device within the first menus after the driver's "can't alloc VA space for mapping" (Xid 31); with them off, MKW's sparse arrays were dense images from a
+// coarser level, which left out the levels the game samples up close (dotfiles-25x.22). Other drivers keep the dense images until measured there
+int vks_on(void) {
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("DM_VK_SPARSE_RES"); on = V.sparse_res && (e && *e ? atoi(e) != 0 : V.driver_id == VK_DRIVER_ID_NVIDIA_PROPRIETARY); }
+    return on;
+}
+
+// Sparse address space (sparseAddressSpaceSize: 4095 MiB on the Adreno 840, less than Mario Kart World's arrays span at full size), taken by each image's virtual size
+int vks_va_take(uint64_t n) {
+    uint64_t lim = V.props.limits.sparseAddressSpaceSize, margin = 64ull << 20;
+    pthread_mutex_lock(&g_ks); int ok = lim > margin && g_va + n <= lim - margin; if (ok) g_va += n; pthread_mutex_unlock(&g_ks); return ok;
+}
+void vks_va_give(uint64_t n) { pthread_mutex_lock(&g_ks); g_va -= n < g_va ? n : g_va; pthread_mutex_unlock(&g_ks); }
+uint64_t vks_va_free(void) {
+    uint64_t lim = V.props.limits.sparseAddressSpaceSize, margin = 64ull << 20;
+    pthread_mutex_lock(&g_ks); uint64_t f = lim > margin + g_va ? lim - margin - g_va : 0; pthread_mutex_unlock(&g_ks); return f;
+}
+
+static uint64_t stl_now(void) { uint64_t v = 0; if (vka_hung()) return UINT64_MAX; if (g_stl) vk.vkGetSemaphoreCounterValue(V.dev, g_stl, &v); return v; }
+// Empty blocks whose last unbind has run are freed while another block of their type has room (caller holds g_ks)
+static void blocks_trim(void) {
+    uint64_t now = 0; int got = 0;
+    for (uint32_t i = 0; i < g_ntb; i++) {
+        tblock *b = g_tb[i]; if (!b || b->used) continue;
+        int other = 0; for (uint32_t j = 0; j < g_ntb && !other; j++) other = j != i && g_tb[j] && g_tb[j]->type == b->type && g_tb[j]->used < BLOCK_TILES;
+        if (!other) continue;
+        if (!got) { now = stl_now(); got = 1; }
+        if (b->free_at > now) continue;
+        vk.vkFreeMemory(V.dev, b->dm, NULL); free(b); g_tb[i] = NULL; g_bytes -= (uint64_t)BLOCK_TILES * TILE;
+    }
+}
+// A free 64 KiB slot of memory type type: its id + 1, 0 = none (caller holds g_ks)
+static uint32_t slot_take(uint32_t type) {
+    tblock *b = NULL; uint32_t bi = 0;
+    for (uint32_t i = 0; i < g_ntb && !b; i++) if (g_tb[i] && g_tb[i]->type == type && g_tb[i]->used < BLOCK_TILES) { b = g_tb[i]; bi = i; }
+    if (!b) {
+        for (bi = 0; bi < g_ntb && g_tb[bi]; bi++) {}
+        if (bi == g_ntb && !grow((void **)&g_tb, &g_ctb, g_ntb, sizeof *g_tb)) return 0;
+        if (!(b = calloc(1, sizeof *b))) return 0;
+        VkMemoryAllocateInfo ai = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, .allocationSize = (uint64_t)BLOCK_TILES * TILE, .memoryTypeIndex = type};
+        VkResult r = vk.vkAllocateMemory(V.dev, &ai, NULL, &b->dm);
+        if (r) { free(b); static _Atomic int n; if (atomic_fetch_add(&n, 1) < 8) VRED("sparse tile block of 64 MiB not allocated (%d; %.0f MiB of tiles): its tiles stay unbound (read 0)", r, g_bytes / 1048576.0); return 0; }
+        b->type = type; g_tb[bi] = b; if (bi == g_ntb) g_ntb++;
+        g_bytes += (uint64_t)BLOCK_TILES * TILE; vka_mem_grew((uint64_t)BLOCK_TILES * TILE);
+    }
+    for (uint32_t w = 0; w < BLOCK_TILES / 64; w++) if (~b->bits[w]) {
+        uint32_t k = (uint32_t)__builtin_ctzll(~b->bits[w]); b->bits[w] |= 1ull << k; b->used++;
+        return bi * BLOCK_TILES + w * 64 + k + 1;
+    }
+    return 0;
+}
+static void slot_give(uint32_t id, uint64_t at) {   // caller holds g_ks; at: the sparse value after which no binding uses it
+    id--; tblock *b = id / BLOCK_TILES < g_ntb ? g_tb[id / BLOCK_TILES] : NULL; uint32_t k = id % BLOCK_TILES;
+    if (!b || !(b->bits[k / 64] >> (k % 64) & 1)) { VRED_ONCE("sparse tile slot %u given back twice", id); return; }
+    b->bits[k / 64] &= ~(1ull << (k % 64)); b->used--; if (at > b->free_at) b->free_at = at;
+}
+static VkDeviceMemory slot_mem(uint32_t id, VkDeviceSize *off) { id--; *off = (VkDeviceSize)(id % BLOCK_TILES) * TILE; return g_tb[id / BLOCK_TILES]->dm; }
+
+// One tile's bind (id 0: unbind) queued (caller holds g_ks)
+static int push_tile(vks_img *s, uint32_t lv, uint32_t ly, uint32_t tx, uint32_t ty, uint32_t id) {
+    if (!grow((void **)&g_pi, &g_cpi, g_npi, sizeof *g_pi)) return 0;
+    uint32_t lw = s->w >> lv ? s->w >> lv : 1, lh = s->h >> lv ? s->h >> lv : 1, x = tx * s->tw, y = ty * s->th;
+    pimg *p = &g_pi[g_npi++]; memset(p, 0, sizeof *p); p->s = s; p->seq = g_seq++;
+    p->b.subresource = (VkImageSubresource){VK_IMAGE_ASPECT_COLOR_BIT, lv, ly};
+    p->b.offset = (VkOffset3D){(int32_t)x, (int32_t)y, 0};
+    p->b.extent = (VkExtent3D){x + s->tw <= lw ? s->tw : lw - x, y + s->th <= lh ? s->th : lh - y, 1};   // a tile at the level's edge ends there
+    if (id) p->b.memory = slot_mem(id, &p->b.memoryOffset);
+    return 1;
+}
+static int push_opaque(vks_img *s, VkDeviceSize at, VkDeviceSize n, uint32_t id) {   // caller holds g_ks
+    if (!grow((void **)&g_po, &g_cpo, g_npo, sizeof *g_po)) return 0;
+    popq *p = &g_po[g_npo++]; memset(p, 0, sizeof *p); p->s = s; p->seq = g_seq++; p->b.resourceOffset = at; p->b.size = n;
+    if (id) p->b.memory = slot_mem(id, &p->b.memoryOffset);
+    return 1;
+}
+static uint32_t *tile_at(vks_img *s, uint32_t lv, uint32_t ly, uint32_t tx, uint32_t ty) { return &s->slot[(size_t)ly * s->per_layer + s->lofs[lv] + (size_t)ty * s->ntx[lv] + tx]; }
+static int bind_tile(vks_img *s, uint32_t lv, uint32_t ly, uint32_t tx, uint32_t ty) {   // caller holds g_ks: 1 = bound
+    uint32_t *t = tile_at(s, lv, ly, tx, ty);
+    if (*t) return 1;
+    uint32_t id = slot_take(s->type);
+    if (!id) return 0;
+    if (!push_tile(s, lv, ly, tx, ty, id)) { slot_give(id, 0); return 0; }
+    *t = id; s->bound++; return 1;
+}
+
+// The residency of a new sparse image: its tile shape (texels, the format's granularity), the levels bound tile by tile (tiled: NVN's tiled levels that Vulkan tiles too).
+// Levels from tiled to the mip tail and the mip tail are bound now. NULL: the image cannot be one (the caller makes a dense image)
+vks_img *vks_new(VkImage img, uint32_t type, uint32_t w, uint32_t h, uint32_t levels, uint32_t layers, uint32_t tw, uint32_t th, uint32_t tiled) {
+    uint32_t n = 0; vk.vkGetImageSparseMemoryRequirements(V.dev, img, &n, NULL);
+    VkSparseImageMemoryRequirements sr[4];
+    if (n > 4) { VRED_ONCE("sparse image: %u sparse memory requirements (at most 4 handled): dense images instead", n); return NULL; }
+    vk.vkGetImageSparseMemoryRequirements(V.dev, img, &n, sr);
