+template <class P>
+void TextureCache<P>::RetireStaleTargets() {
+    if (!Tegra::g_nx2_ampere.load(std::memory_order_relaxed)) {
+        retire_watch.clear();
+        return;
+    }
+    if (frame_tick <= STALE_TARGET_AGE) {
+        return;
+    }
+    // Bad-overlap targets can fill the cache before collection starts. Retire them at the
+    // collector's critical age, independently of memory pressure and costly textures.
+    constexpr size_t MaxPerFrame = 512;
+    const u64 cutoff = frame_tick - STALE_TARGET_AGE;
+    const auto unused = [&](ImageId image_id) {
+        const Image& image = slot_images[image_id];
+        return True(image.flags & ImageFlagBits::Registered) &&
+               lru_cache.Tick(image.lru_index) <= cutoff;
+    };
+    enum class Keep { No, Referenced, Partner, Read };
+    const auto kept = [&](ImageId image_id, const Image& image) {
+        if (True(image.flags & ImageFlagBits::IsDecoding) || StaleTargetReferenced(image_id)) {
+            return Keep::Referenced;
+        }
+        // EXP43's guards, as the cold sweep's with EDEN_NX2_TC_COLD_GUARDED=1: the image was
+        // itself read in a later frame or by the CPU, or its shape was read by the CPU.
+        if (image.relocation_guard_noted != 0 || image.info.forced_flushed ||
+            image.info.dma_downloaded) {
+            return Keep::Read;
+        }
+        if (RelocationShaped(image.info)) {
+            const auto shape = relocation_shapes.find(RelocationShapeKey(image.info));
+            if (shape != relocation_shapes.end() && (shape->second.guard & GuardCpuRead) != 0) {
