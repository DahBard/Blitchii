+                                                               (unsigned long)s->lo, (size_t)(s->hi - s->lo), (unsigned long long)fence, vka_hung() ? ", GPU hang" : " not reached in the hang time");
+}
+static void alias_drop_buf(VkBuffer buf, VkDeviceSize lo, VkDeviceSize hi);   // (Virtual pools below)
