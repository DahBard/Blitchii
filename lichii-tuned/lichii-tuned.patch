+// From Banana Native (github.com/hugorosario/BananaNative, Android port of github.com/seedds/nxnative by seedds), MIT: see LICENSE in src/video_core/nvn_direct/bananative.
+// NVN frame capture: the record field walk and the chunk file (see nvn_capture.h). Plain C, shared by the host, the replayer and the unit test.
+#include "nvn_capture.h"
+#include <stdlib.h>
+#include <string.h>
+#if defined(__APPLE__)
+#include <compression.h>
+__asm__(".linker_option \"-lcompression\"");   // libcompression (LZFSE) links itself: the host, the iOS app and the tests that compile this file need no link flag
+#else
+// No LZFSE outside Apple: captures are written uncompressed (CAP_RAW), and an LZFSE chunk from a Mac capture does not decode
+#define COMPRESSION_LZFSE 0
+static size_t compression_encode_buffer(uint8_t *d, size_t dn, const uint8_t *s, size_t sn, void *scratch, int alg) { (void)d; (void)dn; (void)s; (void)sn; (void)scratch; (void)alg; return 0; }
+static size_t compression_decode_buffer(uint8_t *d, size_t dn, const uint8_t *s, size_t sn, void *scratch, int alg) { (void)d; (void)dn; (void)s; (void)sn; (void)scratch; (void)alg; return 0; }
+#endif
+
+// The walk below names every pointer field of every payload by its offset. A change to a payload struct in nvn_obj.h must come here too: these asserts stop the build
+// instead of letting a capture carry a host pointer or relocate the wrong bytes. The numbers are the layout the walk was written against.
+#define CAP_SIZE(T, n) _Static_assert(sizeof(T) == (n), "nvn_capture.c: " #T " changed size: update cap_rec_fields and cap_layout")
+#define CAP_OFF(T, f, n) _Static_assert(offsetof(T, f) == (n), "nvn_capture.c: " #T "." #f " moved: update cap_rec_fields and cap_layout")
+CAP_SIZE(tex_t, 128); CAP_OFF(tex_t, mem, 88); CAP_OFF(tex_t, pool, 96); CAP_OFF(tex_t, serial, 120);
+CAP_SIZE(pool_t, 40); CAP_SIZE(dpool_t, 24); CAP_SIZE(prog_t, 112); CAP_SIZE(sync_t, 16); CAP_SIZE(samp_par, 40); CAP_SIZE(view_t, 16);
+CAP_SIZE(p_set_rt, 240); CAP_OFF(p_set_rt, n, 0); CAP_OFF(p_set_rt, color, 8); CAP_OFF(p_set_rt, depth, 208);
+CAP_SIZE(p_bind_program, 16); CAP_OFF(p_bind_program, prog, 0);
+CAP_SIZE(NVNbufferRange, 16); CAP_SIZE(p_bind_vbuf, 264); CAP_OFF(p_bind_vbuf, n, 4); CAP_OFF(p_bind_vbuf, r, 8);
+CAP_SIZE(p_bind_vbuf1, 16); CAP_OFF(p_bind_vbuf1, size, 4); CAP_OFF(p_bind_vbuf1, addr, 8);
+CAP_SIZE(p_bind_buf, 24); CAP_OFF(p_bind_buf, addr, 8); CAP_OFF(p_bind_buf, size, 16);
+CAP_SIZE(p_bind_ubo_small, 16); CAP_OFF(p_bind_ubo_small, size, 4); CAP_OFF(p_bind_ubo_small, addr, 8);
+CAP_SIZE(p_bind_handles, 280); CAP_OFF(p_bind_handles, n, 8); CAP_OFF(p_bind_handles, defer, 12); CAP_OFF(p_bind_handles, src, 16);
+CAP_SIZE(p_bind_tex1, 24); _Static_assert(BIND_TEX1_NOBASE == 0x100, "nvn_capture.c: BIND_TEX1_NOBASE changed: update cap_layout");
+CAP_SIZE(p_draw, 56); CAP_OFF(p_draw, ind, 24); CAP_OFF(p_draw, mdi_cnt, 32);
+CAP_SIZE(p_draw_idx, 64); CAP_OFF(p_draw_idx, ibuf, 24); CAP_OFF(p_draw_idx, ind, 32); CAP_OFF(p_draw_idx, mdi_cnt, 40);
+CAP_SIZE(p_dispatch, 32); CAP_OFF(p_dispatch, ind, 24);
+CAP_SIZE(p_set_pool, 8); CAP_OFF(p_set_pool, pool, 0);
+CAP_SIZE(p_copy_b2t, 64); CAP_OFF(p_copy_b2t, src, 0); CAP_OFF(p_copy_b2t, tex, 8);
+CAP_SIZE(p_copy_t2t, 104); CAP_OFF(p_copy_t2t, src, 0); CAP_OFF(p_copy_t2t, dst, 8);
+CAP_SIZE(p_clear_tex, 72); CAP_OFF(p_clear_tex, tex, 0);
+CAP_SIZE(p_clear_buf, 24); CAP_OFF(p_clear_buf, addr, 0); CAP_OFF(p_clear_buf, size, 8);
+CAP_SIZE(p_tf_bind, 24); CAP_OFF(p_tf_bind, addr, 8); CAP_OFF(p_tf_bind, size, 16);
+CAP_SIZE(p_tf_state, 16); CAP_OFF(p_tf_state, ctl, 8);
+CAP_SIZE(p_render_cond, 16); CAP_OFF(p_render_cond, mode, 0); CAP_OFF(p_render_cond, addr, 8);
+CAP_SIZE(p_dlss, 104); CAP_OFF(p_dlss, color, 0); CAP_OFF(p_dlss, output, 8);
+CAP_SIZE(p_coopvec_convert, 56); CAP_OFF(p_coopvec_convert, src, 0); CAP_OFF(p_coopvec_convert, dst, 8);
+CAP_SIZE(p_wait_sync, 8); CAP_SIZE(p_vrs_image, 32); CAP_OFF(p_vrs_image, tex, 0); CAP_SIZE(p_enable_cond, 16); CAP_OFF(p_enable_cond, addr, 8);
+CAP_SIZE(p_bind_defer, 32); CAP_OFF(p_bind_defer, n, 12); CAP_OFF(p_bind_defer, src, 16); CAP_SIZE(p_push_defer, 16); CAP_OFF(p_push_defer, size, 4); CAP_OFF(p_push_defer, src, 8);
+_Static_assert(OP_COUNT_ == 70, "nvn_capture.c: a record op was added or removed: give it a case in cap_rec_fields");
+
+const char *cap_layout(void) {
+    // sizes and pointer offsets as the walk knows them (the asserts above hold them to nvn_obj.h); bump this text with any change to the walk
+    return "format 1\nops 70\n"
+           "tex_t 128 mem 88 pool 96 serial 120\npool_t 40\ndpool_t 24\nprog_t 112\nsync_t 16\nsamp_par 40\nview_t 16\n"
+           "p_set_rt 240 color 8 depth 208\np_bind_program 16\np_bind_vbuf 264 r 8\np_bind_vbuf1 16 addr 8\np_bind_buf 24 addr 8\np_bind_ubo_small 16 addr 8\n"
+           "p_bind_handles 280 src 16\np_bind_tex1 24 nobase 0x100 short 16\np_bind_state short\np_draw 56 ind 24 mdi_cnt 32\np_draw_idx 64 ibuf 24 ind 32 mdi_cnt 40\np_dispatch 32 ind 24\np_set_pool 8\n"
+           "p_copy_b2t 64 src 0 tex 8\np_copy_t2t 104 src 0 dst 8\np_clear_tex 72 tex 0\np_clear_buf 24 addr 0\np_tf_bind 24 addr 8\np_tf_state 16 ctl 8\np_render_cond 16 addr 8\n"
+           "p_dlss 104 color 0 output 8\np_coopvec_convert 56 src 0 dst 8\n"
+           "signal_event 16 val 0\nreport_counter 16 addr 8\ncopy_b2b 24 src 0 dst 8\nupdate_ub dst 0\nfence_sync 8 sync 0\njump 8\ncall 8\n"
+           "p_wait_sync 8 sync 0\np_vrs_image 32 tex 0\np_enable_cond 16 addr 8\np_bind_defer 32 src 16\np_push_defer 16 src 8\n";
+}
+
+// One 8-byte field at byte offset off of the payload, present only when the record is long enough to hold it
+#define HAS(off) ((uint64_t)(off) + 8 <= plen)
+#define F(off) ((uint64_t *)(payload + (off)))   // records are 8-byte aligned and so are these fields
+static uint64_t u64_at(const uint8_t *p) { uint64_t v; memcpy(&v, p, 8); return v; }
+static int32_t i32_at(const uint8_t *p) { int32_t v; memcpy(&v, p, 4); return v; }
+
+int cap_tex_fields(tex_t *t, const cap_ops *ops, void *ctx) {
+    uint64_t *mem = (uint64_t *)((uint8_t *)t + offsetof(tex_t, mem)), *pool = (uint64_t *)((uint8_t *)t + offsetof(tex_t, pool));
+    // the texture's storage: its whole extent when the layout knows it (a linear or buffer texture is read in place)
+    int ok = ops->addr(ctx, mem, t->L.size, 0);
+    return ops->obj(ctx, CAP_K_POOL, pool, NULL, 0) && ok;
+}
+
+int cap_rec_fields(uint32_t op, uint8_t *payload, uint32_t size, const cap_ops *ops, void *ctx) {
+    uint64_t plen = size >= 8 ? size - 8 : 0; int ok = 1;
+    switch (op) {
+        case OP_END: case OP_BEGIN: case OP_CLEAR_COLOR: case OP_CLEAR_DS: case OP_VIEWPORTS: case OP_SCISSOR: case OP_DEPTH_RANGE: case OP_BIND_STATE: case OP_BIND_VATTR:
+        case OP_BIND_VSTREAM: case OP_BIND_TEX1: case OP_STENCIL: case OP_POLY_OFFSET: case OP_BARRIER: case OP_COPY_STRIDE: case OP_BLEND_COLOR: case OP_RESET_COUNTER:
+        case OP_DEPTH_CLAMP: case OP_RAST_DISCARD: case OP_VP_SWIZZLE: case OP_PRIM_RESTART: case OP_ALPHA_REF: case OP_PUSH_CONST: case OP_DEPTH_BOUNDS: case OP_DRAW_TEX:   // OP_DRAW_TEX: a texture handle, read through the pools at replay
+        case OP_PATCH_SIZE: case OP_TESS_LEVELS: case OP_SAMPLE_MASK: case OP_RASTER: case OP_VRS_PALETTE: case OP_DEBUG_LABEL: case OP_EXCL_SCISSOR:
+            return 1;
+        case OP_WAIT_SYNC: return HAS(0) && ops->obj(ctx, CAP_K_SYNC, F(0), payload, (uint32_t)plen);
+        case OP_VRS_IMAGE: return HAS(0) && ops->obj(ctx, CAP_K_TEX, F(0), payload, (uint32_t)plen);
+        case OP_ENABLE_COND: if (!HAS(8)) return 0; return i32_at(payload + 4) >= 2 || ops->addr(ctx, F(8), 32, 0);
+        case OP_BIND_DEFER: { if (!HAS(16)) return 0; int32_t kind = i32_at(payload), n = i32_at(payload + 12);   // the bindings read at src at replay are part of the frame's input
+            return ops->addr(ctx, F(16), n > 0 && n <= 32 ? (uint64_t)(kind == DEFER_UBO || kind == DEFER_SSBO ? 16 : 8) * (uint64_t)n : 0, 0); }
+        case OP_PUSH_DEFER: { if (!HAS(8)) return 0; uint32_t n; memcpy(&n, payload + 4, 4); return ops->addr(ctx, F(8), n, 0); }
+        case OP_JUMP: case OP_CALL: return HAS(0) && ops->obj(ctx, CAP_K_SEG, F(0), payload, (uint32_t)plen);
+        case OP_SIGNAL_EVENT: return HAS(0) && ops->addr(ctx, F(0), 4, 1);   // volatile uint32_t *val, mode, value
+        case OP_WAIT_EVENT: return HAS(0) && ops->addr(ctx, F(0), 4, 0);
+        case OP_REPORT_COUNTER: return HAS(8) && ops->addr(ctx, F(8), 16, 1);  // type, address of the 16-byte report
+        case OP_COPY_B2B: { if (!HAS(16)) return 0; uint64_t n = u64_at(payload + 16); return ops->addr(ctx, F(0), n, 0) & ops->addr(ctx, F(8), n, 1); }
+        case OP_UPDATE_UB: { if (!HAS(8)) return 0; return ops->addr(ctx, F(0), u64_at(payload + 8), 1); }   // dst, n, inline data
+        case OP_FENCE_SYNC: return HAS(0) && ops->obj(ctx, CAP_K_SYNC, F(0), payload, (uint32_t)plen);
+        case OP_SET_RT: {
+            int32_t n = HAS(0) ? i32_at(payload) : -1; if (n < 0 || n > 8 || !HAS(offsetof(p_set_rt, depth))) return 0;
+            for (int i = 0; i < n; i++) ok &= ops->obj(ctx, CAP_K_TEX, F(offsetof(p_set_rt, color) + 8 * (size_t)i), payload, (uint32_t)plen);
+            return ok & ops->obj(ctx, CAP_K_TEX, F(offsetof(p_set_rt, depth)), payload, (uint32_t)plen);
+        }
+        case OP_BIND_PROGRAM: return HAS(0) && ops->obj(ctx, CAP_K_PROG, F(0), payload, (uint32_t)plen);
+        case OP_BIND_VBUF: {
+            int32_t n = HAS(0) ? i32_at(payload + 4) : -1; if (n < 0 || n > 16) return 0;
+            for (int i = 0; i < n; i++) { size_t o = offsetof(p_bind_vbuf, r) + 16 * (size_t)i; if (!HAS(o + 8)) return 0; ok &= ops->addr(ctx, F(o), u64_at(payload + o + 8), 0); }
+            return ok;
+        }
+        case OP_BIND_VBUF1: { if (!HAS(8)) return 0; uint32_t n; memcpy(&n, payload + 4, 4); return ops->addr(ctx, F(8), n, 0); }
+        case OP_BIND_UBO: case OP_BIND_SSBO: { if (!HAS(16)) return 0; return ops->addr(ctx, F(8), u64_at(payload + 16), op == OP_BIND_SSBO); }
+        case OP_BIND_UBO_SMALL: { if (!HAS(8)) return 0; uint32_t n; memcpy(&n, payload + 4, 4); return ops->addr(ctx, F(8), n, 0); }
+        case OP_BIND_TEX: case OP_BIND_SAMP: case OP_BIND_IMG: {   // deferred handles are read from src at replay: the 8 * n bytes there are part of the frame's input
+            if (!HAS(16)) return 0;
+            int32_t n = i32_at(payload + 8), defer = i32_at(payload + 12);
+            if (!defer || !u64_at(payload + 16)) return 1;
+            return ops->addr(ctx, F(16), n > 0 && n <= 32 ? 8 * (uint64_t)n : 0, 0);
+        }
+        case OP_DRAW: if (HAS(24)) ok &= ops->addr(ctx, F(24), 16, 0); if (HAS(32)) ok &= ops->addr(ctx, F(32), 4, 0); return ok;
+        case OP_DRAW_IDX: if (!HAS(24)) return 0; ok &= ops->addr(ctx, F(24), 0, 0); if (HAS(32)) ok &= ops->addr(ctx, F(32), 20, 0); if (HAS(40)) ok &= ops->addr(ctx, F(40), 4, 0); return ok;
+        case OP_DISPATCH: return !HAS(24) || ops->addr(ctx, F(24), 12, 0);   // caller (+8) is a code address, kept as it is
+        case OP_SET_TEX_POOL: case OP_SET_SAMP_POOL: return HAS(0) && ops->obj(ctx, CAP_K_DPOOL, F(0), payload, (uint32_t)plen);
+        case OP_COPY_B2T: case OP_COPY_T2B: {   // src: the buffer address (the destination for T2B)
+            if (!HAS(8)) return 0;
+            return ops->addr(ctx, F(0), 0, op == OP_COPY_T2B) & ops->obj(ctx, CAP_K_TEX, F(8), payload, (uint32_t)plen);
+        }
+        case OP_COPY_T2T: if (!HAS(8)) return 0; return ops->obj(ctx, CAP_K_TEX, F(0), payload, (uint32_t)plen) & ops->obj(ctx, CAP_K_TEX, F(8), payload, (uint32_t)plen);
+        case OP_CLEAR_TEX: return HAS(0) && ops->obj(ctx, CAP_K_TEX, F(0), payload, (uint32_t)plen);
+        case OP_CLEAR_BUF: return HAS(8) && ops->addr(ctx, F(0), u64_at(payload + 8), 1);
+        case OP_TF_BIND: return HAS(16) && ops->addr(ctx, F(8), u64_at(payload + 16), 1);
+        case OP_TF_STATE: return HAS(8) && ops->addr(ctx, F(8), 32, 1);
+        case OP_RENDER_COND: if (!HAS(8)) return 0; return i32_at(payload) >= 2 || ops->addr(ctx, F(8), 32, 0);
+        case OP_DLSS: if (!HAS(8)) return 0; return ops->obj(ctx, CAP_K_TEX, F(0), payload, (uint32_t)plen) & ops->obj(ctx, CAP_K_TEX, F(8), payload, (uint32_t)plen);
+        case OP_COOPVEC_CONVERT: return HAS(8) && (ops->addr(ctx, F(0), 0, 0) & ops->addr(ctx, F(8), 0, 1));   // (Lichii: the matrices' sizes are the layouts', hle_nvn.c)
+    }
+    return 0;
+}
+
+// ---------- Chunk file ----------
+int cap_open(cap_writer *w, const char *path) {
+    memset(w, 0, sizeof *w);
+    if (!(w->f = fopen(path, "wb"))) return 0;
+    uint32_t v[2] = {CAP_VERSION, 0};
+    fwrite(CAP_MAGIC, 1, 8, w->f); fwrite(v, 4, 2, w->f);
+    return 1;
+}
+void cap_put(cap_writer *w, uint32_t tag, uint32_t submit, const void *data, uint64_t n, int compress) {
+    if (!w->f) return;
+    cap_chunk c = {tag, CAP_RAW, n, n, submit, 0};
+    uint8_t *z = NULL;
+    if (compress && n >= 256) {
+        size_t cap = (size_t)n + n / 16 + 4096;
+        if ((z = malloc(cap))) {
+            size_t zn = compression_encode_buffer(z, cap, data, (size_t)n, NULL, COMPRESSION_LZFSE);
+            if (zn && zn < n) { c.codec = CAP_LZFSE; c.stored = zn; } else { free(z); z = NULL; }
+        }
+    }
+    if (fwrite(&c, sizeof c, 1, w->f) != 1 || (c.stored && fwrite(z ? z : data, 1, (size_t)c.stored, w->f) != c.stored)) w->err = 1;
+    w->raw += n; w->stored += c.stored + sizeof c;
+    free(z);
+}
+int cap_close(cap_writer *w) {
+    if (!w->f) return 0;
+    cap_put(w, CAP_END_, 0, NULL, 0, 0);
+    int ok = !w->err && fclose(w->f) == 0; w->f = NULL; return ok;
+}
+int cap_load(cap_reader *r, const char *path) {
+    memset(r, 0, sizeof *r);
+    FILE *f = fopen(path, "rb"); if (!f) return 0;
+    fseeko(f, 0, SEEK_END); off_t n = ftello(f); fseeko(f, 0, SEEK_SET);
+    if (n < 16 || !(r->buf = malloc((size_t)n)) || fread(r->buf, 1, (size_t)n, f) != (size_t)n) { fclose(f); free(r->buf); r->buf = NULL; return 0; }
+    fclose(f); r->n = (size_t)n;
+    uint32_t ver; memcpy(&ver, r->buf + 8, 4);
+    if (memcmp(r->buf, CAP_MAGIC, 8) || ver != CAP_VERSION) { free(r->buf); r->buf = NULL; return -1; }
+    r->pos = 16; return 1;
+}
+int cap_next(cap_reader *r, cap_chunk *c, uint8_t **data) {
+    *data = NULL;
+    if (r->pos + sizeof *c > r->n) return -1;
+    memcpy(c, r->buf + r->pos, sizeof *c); r->pos += sizeof *c;
+    if (c->stored > r->n - r->pos) return -1;
+    if (c->tag == CAP_END_) return 0;
+    uint8_t *d = malloc(c->raw ? (size_t)c->raw : 1); if (!d) return -1;
+    if (c->codec == CAP_RAW) { if (c->stored != c->raw) { free(d); return -1; } memcpy(d, r->buf + r->pos, (size_t)c->raw); }
+    else if (c->codec == CAP_LZFSE) { if (compression_decode_buffer(d, (size_t)c->raw, r->buf + r->pos, (size_t)c->stored, NULL, COMPRESSION_LZFSE) != c->raw) { free(d); return -1; } }
+    else { free(d); return -1; }
+    r->pos += c->stored; *data = d; return 1;
+}
+void cap_unload(cap_reader *r) { free(r->buf); memset(r, 0, sizeof *r); }
+void cap_buf_put(cap_buf *b, const void *data, size_t n) {
+    if (b->n + n > b->cap) { size_t c = b->cap ? b->cap : 4096; while (c < b->n + n) c *= 2; b->p = realloc(b->p, c); b->cap = c; }
+    memcpy(b->p + b->n, data, n); b->n += n;
+}
diff --git a/src/video_core/nvn_direct/bananative/dm/gfx/nvn/nvn_capture.h b/src/video_core/nvn_direct/bananative/dm/gfx/nvn/nvn_capture.h
new file mode 100644
index 0000000000..38d96ce697
--- /dev/null
+++ b/src/video_core/nvn_direct/bananative/dm/gfx/nvn/nvn_capture.h
@@ -0,0 +1,110 @@
+// From Banana Native (github.com/hugorosario/BananaNative, Android port of github.com/seedds/nxnative by seedds), MIT: see LICENSE in src/video_core/nvn_direct/bananative.
+// NVN frame capture and replay (DM_NVN_CAPTURE, dm/gfx/tests/nvn_replay.m): the file format and the record relocation shared by the host's capture
+// (nvn_capture.inc, included by nvn_mtl.m), the replayer and the unit test (dm/gfx/tests/t_capture.c). Plain C: no Metal here, so the test runs without a GPU.
+//
+// A capture is one file: an 16-byte file header, then chunks {tag, codec, raw length, stored length, submit, bytes}. Submit 0 is the state at the first submit of the frame
+// (pools, objects, registries, texture contents); submit k > 0 carries what changed before the k-th submission and that submission's command segments.
+// Pointers in the captured records are not host addresses: an address into a memory pool is a region number and offset (CAP_ADDR), an object pointer is a kind and index
+// (CAP_OBJ). The replayer maps the regions at fresh addresses and rewrites the records back with the same field walk (cap_rec_fields).
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "nvn_obj.h"
+
+#define CAP_MAGIC "NVNCAP\0\0"
+#define CAP_VERSION 1u
+
+// Chunk tags (four characters, little-endian)
+#define CAP_TAG(a, b, c, d) ((uint32_t)(a) | (uint32_t)(b) << 8 | (uint32_t)(c) << 16 | (uint32_t)(d) << 24)
+enum {
+    CAP_HEAD = CAP_TAG('H', 'E', 'A', 'D'),   // text: key \t value lines (chain, commit, title, build, frame, DM_* settings, format)
+    CAP_LAYT = CAP_TAG('L', 'A', 'Y', 'T'),   // text: the record layout fingerprint (cap_layout); a replayer built against another nvn_obj.h refuses the capture
+    CAP_STAT = CAP_TAG('S', 'T', 'A', 'T'),   // text: replay-layer state set outside records (texture pool size, origin, depth mode)
+    CAP_REGN = CAP_TAG('R', 'E', 'G', 'N'),   // one memory region: cap_regn + its bytes
+    CAP_PADD = CAP_TAG('P', 'A', 'D', 'D'),   // the replay layer's pool list (mtl_pool_add calls): cap_padd[]
+    CAP_PDIF = CAP_TAG('P', 'D', 'I', 'F'),   // region bytes that changed before submit k: {u32 region, u32 0, u64 off, u64 len, bytes}...
+    CAP_POBJ = CAP_TAG('P', 'O', 'B', 'J'),   // pool_t objects: cap_pobj[]
+    CAP_TOBJ = CAP_TAG('T', 'O', 'B', 'J'),   // tex_t objects referenced by records: {u32 index, u32 0, tex_t (relocated)}...
+    CAP_PROG = CAP_TAG('P', 'R', 'O', 'G'),   // programs: cap_prog[]
+    CAP_DPOL = CAP_TAG('D', 'P', 'O', 'L'),   // descriptor pools: cap_dpol[]
+    CAP_SYNC = CAP_TAG('S', 'Y', 'N', 'C'),   // sync objects: u32 count (the replayer allocates that many sync_t)
+    CAP_TREG = CAP_TAG('T', 'R', 'E', 'G'),   // texture registry entries (all at submit 0, changed ones later): cap_treg[]
+    CAP_SREG = CAP_TAG('S', 'R', 'E', 'G'),   // sampler registry entries: cap_sreg[]
+    CAP_TKND = CAP_TAG('T', 'K', 'N', 'D'),   // per texture the frame reaches: how the replay layer holds it (cap_tknd[])
+    CAP_TPIX = CAP_TAG('T', 'P', 'I', 'X'),   // contents of one texture whose content lives only in Metal: cap_tpix + cap_tsub + bytes per level and slice
+    CAP_SEGM = CAP_TAG('S', 'E', 'G', 'M'),   // one command segment of submit k: {u32 index, u32 length, bytes}
+    CAP_SUBM = CAP_TAG('S', 'U', 'B', 'M'),   // submit k: {u32 n, u32 segment[n]}
+    CAP_PRES = CAP_TAG('P', 'R', 'E', 'S'),   // the present: cap_pres
+    CAP_PHSH = CAP_TAG('P', 'H', 'S', 'H'),   // after the frame: every region's 4 KiB block hashes as the live run left them ({u32 region, u32 blocks, u64 hash[blocks]}...), for the replayer to compare
+    CAP_LPIX = CAP_TAG('L', 'P', 'I', 'X'),   // the presented frame's pixels as the live run read them (level 0, rows packed, the format and size of cap_pres), for a pixel comparison; optional
+    CAP_END_ = CAP_TAG('E', 'N', 'D', ' '),
+};
+enum { CAP_RAW = 0, CAP_LZFSE = 1 };
+typedef struct { uint32_t tag, codec; uint64_t raw, stored; uint32_t submit, pad; } cap_chunk;
+
+// Field encodings. Host addresses stay below 2^48, so a set top byte marks an encoded value; anything else (0, an address outside every region) is left as it is
+#define CAP_ADDR_TAG 0xCAull
+#define CAP_REGION_BITS 20
+#define CAP_OFF_BITS 36
+static inline uint64_t cap_addr(uint32_t region, uint64_t off) { return CAP_ADDR_TAG << 56 | (uint64_t)region << CAP_OFF_BITS | off; }
+static inline int cap_is_addr(uint64_t v) { return v >> 56 == CAP_ADDR_TAG; }
+static inline uint32_t cap_addr_region(uint64_t v) { return (uint32_t)(v >> CAP_OFF_BITS) & ((1u << CAP_REGION_BITS) - 1); }
+static inline uint64_t cap_addr_off(uint64_t v) { return v & ((1ull << CAP_OFF_BITS) - 1); }
+enum { CAP_K_TEX = 1, CAP_K_TEXIN, CAP_K_PROG, CAP_K_DPOOL, CAP_K_SYNC, CAP_K_SEG, CAP_K_POOL, CAP_K_N };   // CAP_K_TEXIN: a tex_t snapshot inside the record (hle_nvn.c tex_snap); index = byte offset from the payload
+static inline uint64_t cap_obj(int kind, uint64_t index) { return (0xC0ull + (uint64_t)kind) << 56 | index; }
+static inline int cap_obj_kind(uint64_t v) { uint64_t t = v >> 56; return t > 0xC0 && t < 0xC0 + CAP_K_N ? (int)(t - 0xC0) : 0; }
+static inline uint64_t cap_obj_index(uint64_t v) { return v & ((1ull << 56) - 1); }
+
+// Chunk payloads
+typedef struct { uint32_t index, kind; uint64_t old_lo, size; } cap_regn;   // kind 0: pool storage, 1: memory a record points to outside the pools (deferred handles, event words)
+typedef struct { uint64_t mem, size; } cap_padd;                             // mem: CAP_ADDR
+typedef struct { uint32_t index, flags; uint64_t mem, size; int32_t vmode, pad; } cap_pobj;
+// ok: bit i = stage i has a key; iface[s]: fingerprint of the bindings and vertex inputs the replay layer resolved for NVN stage s (0 = none), so a replay
+// whose translated shaders take other bindings than the records were made for stops (nvn_replay) instead of drawing with them
+typedef struct { uint32_t index, nstage; uint64_t serial; uint8_t key[6][8]; uint8_t ok, pad[7]; uint64_t iface[6]; } cap_prog;
+typedef struct { uint32_t index; int32_t n; uint64_t pool; int64_t off; int32_t tex_base, samp_base; } cap_dpol;   // pool: CAP_OBJ(CAP_K_POOL)
+// gone: the ID stays registered but its memory pool was finalized (treg_drop_pool_views): t keeps neither its pool nor its storage address, which name memory the game has since reused
+typedef struct { int32_t tid; uint8_t ok, has_v, gone, pad; tex_t t; view_t v; } cap_treg;
+typedef struct { int32_t sid, pad; samp_par p; } cap_sreg;
+// per texture the frame reaches: live = initialized and not finalized (mtl_tex_init); cpu = its host texture is uploaded from its pool (CPU-written, or a texture the
+// flush tracking of DM_GAME_TEX_DIRTY_UPLOAD made packaged): the replay marks it CPU-written so it takes the same path
+enum { CAP_TK_LIVE = 1, CAP_TK_CPU = 2 };
+typedef struct { tex_t t; uint32_t kind, pad; } cap_tknd;   // t: relocated
+typedef struct { tex_t t; uint32_t pixfmt, type, width, height, depth, levels, slices, samples, nsub, pad; } cap_tpix;   // t: relocated, the texture to create and fill
+typedef struct { uint32_t level, slice, w, h, d, plane; uint64_t row, img, bytes; } cap_tsub;   // plane 0: color or depth, 1: stencil
+typedef struct { uint64_t tex; int32_t crop[4]; uint8_t sha256[32]; uint64_t bytes; uint32_t width, height, pixfmt, frame; double capture_ms; } cap_pres;   // tex: CAP_OBJ(CAP_K_TEX)
+
+// The field walk: every pointer or address a record's payload holds, for capture (encode) and replay (decode) alike.
+// addr: an address field; len is how many bytes the record uses there when known (0 = a buffer of unknown extent), writable: the replay writes there (events)
+// obj: an object pointer of the given kind (CAP_K_*), payload / size: the record's payload, for snapshots inside it
+typedef struct {
+    int (*addr)(void *ctx, uint64_t *field, uint64_t len, int writable);
+    int (*obj)(void *ctx, int kind, uint64_t *field, uint8_t *payload, uint32_t size);
+} cap_ops;
+// Walks one record (op, payload of size - 8 bytes); 0 = an op the walk does not know (the capture fails rather than write host pointers)
+int cap_rec_fields(uint32_t op, uint8_t *payload, uint32_t size, const cap_ops *ops, void *ctx);
+// The pointers inside a tex_t snapshot: mem (an address) and pool (a pool object)
+int cap_tex_fields(tex_t *t, const cap_ops *ops, void *ctx);
+// Layout fingerprint of every payload struct the walk knows (text): stored in the capture, compared by the replayer
+const char *cap_layout(void);
+
+// Writing: chunks, compressed with LZFSE when that makes them smaller
+typedef struct { FILE *f; uint64_t raw, stored; int err; } cap_writer;
+int cap_open(cap_writer *w, const char *path);
+void cap_put(cap_writer *w, uint32_t tag, uint32_t submit, const void *data, uint64_t n, int compress);
+int cap_close(cap_writer *w);
+// Reading: the whole file into memory, then chunk by chunk (data decompressed)
+typedef struct { uint8_t *buf; size_t n, pos; } cap_reader;
+int cap_load(cap_reader *r, const char *path);
+int cap_next(cap_reader *r, cap_chunk *c, uint8_t **data);   // 1 = a chunk (*data malloc'd, free it), 0 = end, -1 = corrupt
+void cap_unload(cap_reader *r);
+// A growable byte buffer for building chunk payloads
+typedef struct { uint8_t *p; size_t n, cap; } cap_buf;
+void cap_buf_put(cap_buf *b, const void *data, size_t n);
+static inline void cap_buf_free(cap_buf *b) { free(b->p); b->p = NULL; b->n = b->cap = 0; }
+
+// Host hooks (nvn_capture.inc, in nvn_mtl.m): hle_nvn.c calls them at each submit (under the submit lock, before the replay) and each present (before it is queued)
+void nvn_cap_submit(int n, const uint64_t *handles);
+void nvn_cap_present(const tex_t *t, const int crop[4]);
diff --git a/src/video_core/nvn_direct/bananative/dm/gfx/nvn/nvn_capture.inc b/src/video_core/nvn_direct/bananative/dm/gfx/nvn/nvn_capture.inc
new file mode 100644
index 0000000000..fe458c084c
--- /dev/null
+++ b/src/video_core/nvn_direct/bananative/dm/gfx/nvn/nvn_capture.inc
@@ -0,0 +1,508 @@
+// From Banana Native (github.com/hugorosario/BananaNative, Android port of github.com/seedds/nxnative by seedds), MIT: see LICENSE in src/video_core/nvn_direct/bananative.
+// DM_NVN_CAPTURE=<frame>:1:<path>: capture one frame at the replay boundary (nvnQueueSubmitCommands → mtl_exec) into one file, for dm/gfx/tests/nvn_replay to replay against
+// the current replay code. Included at the end of nvn_mtl.m: it reads the replay layer's tables (pools, texture and sampler registries, host textures). File format: nvn_capture.h.
+//
+// From the frame's first submit until its present: every live pool's bytes, the registries, the programs' stage keys, the contents of every texture whose content lives only
+// in Metal that the frame can reach (registered or named by a record), and each submission's record bytes with pointers written as region offsets and object indices. Before
+// each later submit of the frame, the pool bytes that changed (GPU writes included) and the registry entries that changed. At the present: the presented texture's SHA-256,
+// read back the same way the replayer reads its own (cap_digest). Each capture step first waits for the GPU (mtl_finish), so what is read is what the next submit sees; that
+// changes the frame's timing, not what it renders. The pool bytes are copied last in each submit's step (cap_mem), as the live replay of the submit reads them. Unset, the hooks cost one load and a branch per submit and present.
+#include "nvn_capture.h"
+#include <crt_externs.h>
+
+static int g_cap_frame = -1;            // -1: not parsed yet, 0: off
+static char g_cap_path[1024];
+static int g_cap_active, g_cap_done, g_cap_failed;
+static uint32_t g_cap_submit;           // submits captured in the frame so far
+static uint64_t g_cap_presents;         // presents seen (the frame number DM_NVN_SHOT uses)
+static cap_writer g_cap_w;
+static uint64_t g_cap_t0, g_cap_ns, g_cap_unmapped, g_cap_segs, g_cap_tex_bytes, g_cap_tex_n, g_cap_tex_skip;
+typedef struct { uint64_t lo, size; uint32_t kind, pending; uint64_t *hash; } cap_region;   // hash: one per 4 KiB block, for the changes before later submits; pending: bytes not written yet
+static cap_region *g_cap_reg; static uint32_t g_cap_nreg;
+static nvn_hmap g_cap_tex = {.klen = sizeof(tex_t)}, g_cap_prog = {.klen = 16}, g_cap_dpol = {.klen = 8 + sizeof(dpool_t)}, g_cap_sync = {.klen = 8}, g_cap_pool = {.klen = 8 + sizeof(pool_t)};
+static nvn_hmap g_cap_seg = {.klen = 8}, g_cap_read = {.klen = 8};
+static int g_cap_no_read;   // at the present: the frame is rendered, nothing may be read back as an input any more
+static uint32_t g_cap_ntex, g_cap_nprog, g_cap_ndpol, g_cap_nsync, g_cap_npool;
+static cap_buf g_cap_tobj, g_cap_pobj, g_cap_progb, g_cap_dpolb, g_cap_kind;   // objects interned since the last flush
+static treg_t *g_cap_treg0; static int g_cap_ntreg0; static samp_par *g_cap_sreg0; static uint8_t *g_cap_sreg0_ok; static int g_cap_nsreg0;   // the registries as last written
+
+static int nvn_cap_enabled(void) {
+    if (g_cap_frame >= 0) return g_cap_frame > 0 && !g_cap_done;
+    g_cap_frame = 0;
+    const char *e = getenv("DM_NVN_CAPTURE"); int f = 0, n = 0, used = 0;
+    if (!e || !*e) return 0;
+    if (sscanf(e, "%d:%d:%n", &f, &n, &used) < 2 || !used || f < 1 || !e[used]) { MLOG("[RED] DM_NVN_CAPTURE=%s: expected <frame>:1:<path>; capture off", e); return 0; }
+    if (n != 1) MLOG("[RED] DM_NVN_CAPTURE: %d frames asked, step 1 captures one; capturing frame %d only", n, f);
+    strlcpy(g_cap_path, e + used, sizeof g_cap_path); g_cap_frame = f;
+    MLOG("DM_NVN_CAPTURE: capturing frame %d into %s", f, g_cap_path);
+    return 1;
+}
+
+static uint64_t cap_hash_block(const uint8_t *p, size_t n) {   // a fast 64-bit hash of a 4 KiB block (only compared with itself between submits)
+    uint64_t h = 0x9E3779B97F4A7C15ull ^ n, v; size_t i = 0;
+    for (; i + 8 <= n; i += 8) { memcpy(&v, p + i, 8); h = (h ^ v) * 0xff51afd7ed558ccdull; h ^= h >> 32; }
+    for (; i < n; i++) h = (h ^ p[i]) * 0x100000001b3ull;
+    return h;
+}
+static void cap_fail(const char *why) { if (!g_cap_failed++) MLOG("[RED] DM_NVN_CAPTURE: %s: the capture is incomplete", why); }
+
+// ---------- Regions and the address encoding ----------
+static int cap_reg_find(uint64_t a) {   // the region holding address a (regions are sorted and disjoint)
+    int lo = 0, hi = (int)g_cap_nreg - 1;
+    while (lo <= hi) { int m = (lo + hi) / 2; if (a < g_cap_reg[m].lo) hi = m - 1; else if (a >= g_cap_reg[m].lo + g_cap_reg[m].size) lo = m + 1; else return m; }
+    return -1;
+}
+static void cap_reg_hash(cap_region *r, const uint8_t *p) {   // p: the region's bytes (or the copy that was written)
+    size_t nb = (size_t)((r->size + 4095) / 4096); r->hash = realloc(r->hash, nb * 8);
+    for (size_t b = 0; b < nb; b++) { uint64_t o = (uint64_t)b * 4096; r->hash[b] = cap_hash_block(p + o, (size_t)MIN(4096, r->size - o)); }
+}
+// Regions are written once their index is fixed; a later region gets the next index, so the sorted order is kept in a separate index table
+static uint32_t *g_cap_rid; static uint32_t g_cap_nrid;   // g_cap_rid[sorted position] = region number in the file
+static int cap_reg_add(uint64_t lo, uint64_t size, uint32_t kind) {   // a new disjoint region (its bytes are written by cap_mem); returns its sorted position
+    int pos = 0; while (pos < (int)g_cap_nreg && g_cap_reg[pos].lo < lo) pos++;
+    g_cap_reg = realloc(g_cap_reg, (g_cap_nreg + 1) * sizeof *g_cap_reg); g_cap_rid = realloc(g_cap_rid, (g_cap_nreg + 1) * sizeof *g_cap_rid);
+    memmove(g_cap_reg + pos + 1, g_cap_reg + pos, (g_cap_nreg - pos) * sizeof *g_cap_reg); memmove(g_cap_rid + pos + 1, g_cap_rid + pos, (g_cap_nreg - pos) * sizeof *g_cap_rid);
+    g_cap_reg[pos] = (cap_region){lo, size, kind, 1, NULL}; g_cap_rid[pos] = g_cap_nrid++; g_cap_nreg++;
+    cap_reg_hash(&g_cap_reg[pos], (const uint8_t *)(uintptr_t)lo);   // the bytes now: cap_mem counts what changed before they were written
+    return pos;
+}
+static uint32_t g_cap_cur_submit;
+static char g_cap_where[96]; static const uint8_t *g_cap_where_base;   // what is being encoded, for the red lines below (a record: its op, and the base its field offsets count from)
+#define CAP_WHERE(base, ...) (snprintf(g_cap_where, sizeof g_cap_where, __VA_ARGS__), g_cap_where_base = (const uint8_t *)(base))
+static const char *cap_where(const uint64_t *field) {
+    static char b[128]; uint64_t off = (uint64_t)((const uint8_t *)field - g_cap_where_base);
+    if (g_cap_where_base && off < (64u << 20)) snprintf(b, sizeof b, "%s, field +%llu", g_cap_where, (unsigned long long)off); else strlcpy(b, g_cap_where, sizeof b);
+    return b;
+}
+static int cap_enc_addr(void *ctx, uint64_t *field, uint64_t len, int writable) {
+    (void)ctx; (void)writable;
+    uint64_t v = *field; if (!v) return 1;
+    int i = cap_reg_find(v);
+    if (i < 0 && len && len <= (1u << 20) && nvn_host_readable(v, len)) {   // memory outside the pools a record reads (deferred handles, event words): a region of its own
+        for (uint32_t k = 0; k < g_cap_nreg; k++) if (g_cap_reg[k].lo < v + len && v < g_cap_reg[k].lo + g_cap_reg[k].size) { cap_fail("a record's memory straddles a region");
+            MLOG("[RED] DM_NVN_CAPTURE: %#llx (%llu bytes) straddles region %#llx (%llu bytes): %s", (unsigned long long)v, (unsigned long long)len, (unsigned long long)g_cap_reg[k].lo, (unsigned long long)g_cap_reg[k].size, cap_where(field)); return 1; }
+        i = cap_reg_add(v, len, 1);
+    }
+    if (i < 0) { if (g_cap_unmapped++ < 8) MLOG("[RED] DM_NVN_CAPTURE: a record names %#llx (%llu bytes), outside every pool: kept as it is (the replay resolves it as the live run does, to nothing): %s", (unsigned long long)v, (unsigned long long)len, cap_where(field)); return 1; }
+    *field = cap_addr(g_cap_rid[i], v - g_cap_reg[i].lo);
+    return 1;
+}
+
+// The interface a program's shaders were translated with, as the replay layer resolved it: per stage a hash of its bindings, vertex inputs and thread group size (the
+// replayer computes the same from its own libraries and compares). It hashes their values field by field, and a field at 0 adds nothing (header key iface 2), so a field
+// widened or added to nvn_refl.h later keeps the hash of every shader that does not use it. A hash of the structs' bytes (captures without the key) changed for every
+// program when 682fdd26 widened nvn_rbind.n and added soff, and the replayer refused every capture although no binding had changed
+#define CAP_IFACE 2
+static void cap_iface_put(CC_SHA256_CTX *c, uint32_t tag, uint64_t v) { if (!v) return; uint64_t x[2] = {tag, v}; CC_SHA256_Update(c, x, sizeof x); }
+static void cap_iface(NvProg *o, uint64_t out[6]) {
+    for (int st = 0; st < 6; st++) {
+        NvShader *sh = o ? o->sh[st] : nil; out[st] = 0; if (!sh) continue;
+        const nvn_refl *r = &sh->rf; int nb = MAX(0, MIN(r->nb, NVN_REFL_MAXB)), nv = MAX(0, MIN(r->nv, NVN_REFL_MAXV));
+        CC_SHA256_CTX c; uint8_t md[32]; CC_SHA256_Init(&c);
+        cap_iface_put(&c, 1, (uint64_t)nb + 1); cap_iface_put(&c, 2, (uint64_t)nv + 1);
+        for (int i = 0; i < 3; i++) cap_iface_put(&c, 3 + i, r->tg[i]);
+        for (int i = 0; i < nb; i++) { const nvn_rbind *b = &r->b[i]; uint32_t t = 1u << 24 | (uint32_t)i << 8;   // binding i, field f: tag t + f
+            const uint64_t f[] = {b->kind, b->rw, b->dtt, b->dpf, b->reg, b->aid, b->off, b->n, b->soff, b->f1d, b->atom};
+            for (uint32_t k = 0; k < sizeof f / sizeof *f; k++) cap_iface_put(&c, t + k, f[k]); }
+        for (int i = 0; i < nv; i++) { uint32_t t = 2u << 24 | (uint32_t)i << 8;
+            const uint64_t f[] = {r->v[i].loc, r->v[i].ct, r->v[i].nvn, r->v[i].sh[0], r->v[i].sh[1], r->v[i].sh[2]};
+            for (uint32_t k = 0; k < sizeof f / sizeof *f; k++) cap_iface_put(&c, t + k, f[k]); }
