+std::vector<Scheduler::WorkWatch> Scheduler::ParseWorkWatch(std::string_view list) {
+    using Slot = WorkWatch::Slot;
+    // 16 hex digits, as 'DKB gpu_work' prints them.
+    const auto parse_hash = [](std::string_view text) -> std::optional<u64> {
+        u64 value{};
+        const char* const end = text.data() + text.size();
+        if (text.size() != 16 || std::from_chars(text.data(), end, value, 16).ptr != end ||
+            value == 0) {
+            return std::nullopt;
+        }
+        return value;
+    };
+    const auto slot_of = [](std::string_view prefix) -> std::optional<Slot> {
+        if (prefix == "s6") {
+            return Slot::Compute;
+        }
+        if (prefix == "s1") {
+            return Slot::Vertex;
+        }
+        if (prefix == "s5") {
+            return Slot::Fragment;
+        }
+        if (prefix == "m1") {
+            return Slot::Mesh;
+        }
+        return std::nullopt;
+    };
+    std::vector<WorkWatch> watches;
+    while (!list.empty()) {
+        const size_t comma = list.find(',');
+        std::string_view token = list.substr(0, comma);
+        list = comma == std::string_view::npos ? std::string_view{} : list.substr(comma + 1);
+        while (!token.empty() && token.front() == ' ') {
+            token.remove_prefix(1);
+        }
+        while (!token.empty() && token.back() == ' ') {
+            token.remove_suffix(1);
+        }
+        if (token.empty()) {
+            continue;
+        }
+        // <hash>, s6:/s1:/s5:/m1:<hash>, or s1:/m1:<hash>+s5:<hash>.
+        WorkWatch watch{};
+        bool valid = false;
+        if (const std::optional<u64> bare = parse_hash(token)) {
+            watch.name = fmt::format("{:016x}", *bare);
+            watch.hash = *bare;
+            valid = true;
+        } else if (token.size() >= 19 && token[2] == ':') {
+            const std::string_view prefix = token.substr(0, 2);
+            const std::optional<Slot> slot = slot_of(prefix);
+            const std::optional<u64> hash = parse_hash(token.substr(3, 16));
+            const std::string_view rest = token.substr(19);
+            if (slot && hash) {
+                watch.slot = *slot;
+                watch.hash = *hash;
+                if (rest.empty()) {
+                    watch.name = fmt::format("{}:{:016x}", prefix, *hash);
+                    valid = true;
+                } else if ((*slot == Slot::Vertex || *slot == Slot::Mesh) && rest.size() == 20 &&
+                           rest.starts_with("+s5:")) {
+                    if (const std::optional<u64> fragment = parse_hash(rest.substr(4))) {
+                        watch.name = fmt::format("{}:{:016x}+s5:{:016x}", prefix, *hash, *fragment);
+                        watch.fragment_hash = *fragment;
+                        watch.pair = true;
+                        valid = true;
+                    }
+                }
+            }
+        }
+        if (!valid) {
+            LOG_WARNING(Render_Vulkan,
+                        "EDEN_NX2_GPU_WORK_WATCH: '{}' is not a program: 16 hex digits, alone or "
+                        "after s6:, s1:, s5: or m1:, or s1:<hash>+s5:<hash>, m1:<hash>+s5:<hash>",
+                        token);
+            continue;
+        }
+        watches.push_back(std::move(watch));
+    }
+    return watches;
+}
