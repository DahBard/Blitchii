+// A translated stage's binding records (malloc'd, o->desc_count of them); why names the first the replay cannot fill (the record then UNKNOWN)
+static dmsh_vk_bind* rc_binds(const nvn_direct_shader* o, int st, const rc_control* control, char* why, size_t whyn) {
+    dmsh_vk_bind* b = calloc(o->desc_count ? o->desc_count : 1, sizeof *b);
+    if (!b) { snprintf(why, whyn, "out of memory"); return NULL; }
+    const int cs2 = st == 5 && nvn2_control(control->bytes);
+    cs_layout l = cs2 ? cs_layout_of(control->bytes) : (cs_layout){0}; char w2[200] = "";
+    for (unsigned k = 0; k < o->desc_count; k++) if (!rc_bind(&o->descs[k], st, cs2 ? &l : NULL, &b[k], w2, sizeof w2) && !*why) snprintf(why, whyn, "%s", w2);
+    return b;
+}
+
+// ---------- Translations kept across runs ----------
+// $DM_TEMP/vk_recompiled.bin (EDEN_NX2_NVN_RECOMPILE_CACHE=0: none): each translation as it was first made, by shader key (and per-primitive
+// inputs), so the next run takes it as it is rather than translating again with that run's first draw's state, whose SPIR-V may differ
+// (another texture bound when a slot's type is read) and miss the pipeline cache.
+// Lichii (dotfiles-25x.13): the file is tied to NVN_RECOMPILE_STAMP, a hash of the sources a translation depends on made at build time
+// (recompile_stamp.cmake), and to the device and driver (the recompiler's profile follows them), no longer to the executable's size and
+// modification time: every build started it again, so the first run after one translated every shader on the frame path. A record also
+// keeps the shader's control section (rc_control) and its own constants (c1, inside the code the key hashes), so a later run makes the shader
+// before the game sets it: the prewarm list's pipelines are made at boot from these (vka_rc_by_key).
+// Records: magic, size of the rest, slot, the shader key and the pixel shader's per-primitive inputs it was made for, gl_depth, per-primitive outputs,
+// vertex input types, the nvn_direct_shader fields, c1's size, the rc_control's size, descriptors, SPIR-V, rc_control, c1. Lichii: also "LRCS" records, the header
+// alone (key set, the rest 0): a shader translated speculatively (spec_main) in an earlier run, not done again
+#define RC_FILE_MAGIC 0x3543524cu   // "LRC5"
+#define RC_REC_MAGIC 0x5243524cu    // "LRCR"
+#define RC_SPEC_MAGIC 0x5343524cu   // "LRCS"
+typedef struct { uint32_t magic, size; uint64_t slot, key; uint32_t prim_inputs; int32_t gl_depth; uint32_t prim; uint64_t vin_types; uint32_t local[3], shared, input_mask, output_mask, ssbo_align, uses_render_area, desc_count, spirv_words, c1_len, ctl_len; uint64_t shader_hash; } rc_rec;
+static size_t rc_rec_rest(const rc_rec* r) { return (size_t)r->desc_count * sizeof(nvn_direct_shader_desc) + (size_t)r->spirv_words * 4 + r->ctl_len + r->c1_len; }
+static const rc_control* rc_rec_control(const rc_rec* r) { return (const rc_control*)((const uint8_t*)r + sizeof *r + (size_t)r->desc_count * sizeof(nvn_direct_shader_desc) + (size_t)r->spirv_words * 4); }
+static rc_map g_disk;      // slot -> rc_rec + its descriptors, SPIR-V, control section and c1 (malloc'd, kept)
+static rc_map g_spec_done; // key -> 1: translated speculatively in an earlier run or this one
+static FILE* g_disk_f; static int g_disk_state;   // 0 not opened, 1 open, -1 none
+static void disk_open(void) {
+    if (g_disk_state) return;
+    g_disk_state = -1;
+    const char *t = getenv("DM_TEMP"), *e = getenv("EDEN_NX2_NVN_RECOMPILE_CACHE");
+    if (!t || !*t || (e && !strcmp(e, "0"))) return;
+    // (and to the render scale, which RescalingPass bakes into the SPIR-V)
+    const uint64_t stamp[2] = {NVN_RECOMPILE_STAMP, (uint64_t)V.props.vendorID << 48 ^ (uint64_t)V.props.deviceID << 32 ^ V.props.driverVersion ^
+                                                    (vka_scale_on() ? ((uint64_t)vka_scale_up << 8 | vka_scale_shift) * 0x9E3779B97F4A7C15ull : 0)};
+    char path[1024]; snprintf(path, sizeof path, "%s/vk_recompiled.bin", t);
+    FILE* f = fopen(path, "rb"); unsigned n = 0; long good = 0, end = 0;
+    if (f) {
+        uint32_t magic = 0; uint64_t had[2] = {0, 0};
+        if (fread(&magic, 4, 1, f) == 1 && magic == RC_FILE_MAGIC && fread(had, 8, 2, f) == 2 && had[0] == stamp[0] && had[1] == stamp[1]) {
+            rc_rec r; good = ftell(f); unsigned ns = 0;
+            while (fread(&r, sizeof r, 1, f) == 1 && (r.magic == RC_REC_MAGIC || r.magic == RC_SPEC_MAGIC)) {
+                if (r.magic == RC_SPEC_MAGIC) { if (r.size != sizeof r) break; rc_put(&g_spec_done, rc_key(r.key), (void*)1); ns++; good = ftell(f); continue; }
+                size_t rest = rc_rec_rest(&r);
+                if (r.size != sizeof r + rest) break;
+                uint8_t* m = malloc(sizeof r + rest); if (!m) break;
+                memcpy(m, &r, sizeof r);
+                if (fread(m + sizeof r, 1, rest, f) != rest) { free(m); break; }
+                if (r.ctl_len < sizeof(rc_control) || rc_control_bytes(rc_rec_control((const rc_rec*)m)) != r.ctl_len) { free(m); break; }
+                // (Lichii: by the slot of its depth mode: records written before the mode was part of the slot have the key's own in r.slot)
+                rc_put(&g_disk, rc_translation_slot(r.key, r.prim_inputs, (int)rc_rec_control((const rc_rec*)m)->stage, r.gl_depth), m);
+                n++; good = ftell(f);
+            }
+            if (ns) VLOG("recompiler: %u shaders translated speculatively in earlier runs (not done again)", ns);
+            // A run killed while it appended a record leaves part of one at the end: cut there, or this run's records would follow it and never be read
+            fseek(f, 0, SEEK_END); end = ftell(f);
+        } else n = ~0u;
+        fclose(f);
+        if (n != ~0u && end > good) {
+            VLOG("recompiler: %s ends in %ld bytes of a record not written whole (a run that ended while writing it): cut off", path, end - good);
+            if (truncate(path, good)) VRED("recompiler: %s not cut (errno %d): translations made now are not read back", path, errno);
+        }
+    }
+    if (n == ~0u || !f) {   // none yet, or another build's translations or device's: started again
+        g_disk_f = fopen(path, "wb");
+        if (g_disk_f) { uint32_t magic = RC_FILE_MAGIC; fwrite(&magic, 4, 1, g_disk_f); fwrite(stamp, 8, 2, g_disk_f); fflush(g_disk_f); }
+        if (n == ~0u) VLOG("recompiler: %s holds another build's or device's translations: started again", path);
+        n = 0;
+    } else g_disk_f = fopen(path, "ab");
+    if (!g_disk_f) { VRED("recompiler: %s not writable: translations are not kept", path); return; }
+    g_disk_state = 1;
+    VLOG("recompiler: %u translations read from %s (stamp %016llx)", n, path, (unsigned long long)stamp[0]);
+}
+// A kept translation as an nvn_direct_shader (its arrays point into the record: not to be freed), with the control section and c1 it was made from
+static int disk_get(uint64_t slot, nvn_direct_shader* o, uint64_t* vin_types, int* gl_depth, uint32_t* prim, const rc_control** control, const uint8_t** c1, uint32_t* c1_len) {
+    pthread_mutex_lock(&g_mu); disk_open(); rc_ent* e = rc_find(&g_disk, slot); uint8_t* m = e ? e->val : NULL; pthread_mutex_unlock(&g_mu);
+    if (!m) return 0;
+    const rc_rec* r = (const rc_rec*)m;
+    memset(o, 0, sizeof *o);
+    o->descs = (nvn_direct_shader_desc*)(m + sizeof *r); o->desc_count = r->desc_count;
+    o->spirv = (uint32_t*)(m + sizeof *r + (size_t)r->desc_count * sizeof(nvn_direct_shader_desc)); o->spirv_words = r->spirv_words;
+    memcpy(o->local, r->local, sizeof o->local); o->shared = r->shared; o->input_mask = r->input_mask; o->output_mask = r->output_mask; o->ssbo_align = r->ssbo_align; o->uses_render_area = r->uses_render_area;
+    o->per_primitive_outputs = r->prim; o->shader_hash = r->shader_hash;
+    *vin_types = r->vin_types; *gl_depth = r->gl_depth; *prim = r->prim;
+    *control = rc_rec_control(r); *c1 = (const uint8_t*)*control + r->ctl_len; *c1_len = r->c1_len;
+    return 1;
+}
+static void disk_put(uint64_t slot, uint64_t key, uint32_t prim_inputs, const nvn_direct_shader* o, uint64_t vin_types, int gl_depth, const rc_control* control, const uint8_t* c1, uint32_t c1_len) {
+    rc_rec r = {RC_REC_MAGIC, 0, slot, key, prim_inputs, gl_depth, o->per_primitive_outputs, vin_types, {o->local[0], o->local[1], o->local[2]}, o->shared, o->input_mask, o->output_mask, o->ssbo_align,
+                o->uses_render_area, o->desc_count, (uint32_t)o->spirv_words, c1_len, (uint32_t)rc_control_bytes(control), o->shader_hash};
+    r.size = (uint32_t)(sizeof r + rc_rec_rest(&r));
+    pthread_mutex_lock(&g_mu); disk_open();
+    if (g_disk_f) {
+        fwrite(&r, sizeof r, 1, g_disk_f); fwrite(o->descs, sizeof *o->descs, o->desc_count, g_disk_f); fwrite(o->spirv, 4, o->spirv_words, g_disk_f);
+        fwrite(control, 1, rc_control_bytes(control), g_disk_f); if (c1_len) fwrite(c1, 1, c1_len, g_disk_f); fflush(g_disk_f);
+    }
+    pthread_mutex_unlock(&g_mu);
+}
+// A shader translated speculatively (made or not): marked in the file, so later runs leave it
+static void disk_spec_done(uint64_t key) {
+    rc_rec r; memset(&r, 0, sizeof r); r.magic = RC_SPEC_MAGIC; r.size = sizeof r; r.key = key;
+    pthread_mutex_lock(&g_mu); disk_open(); rc_put(&g_spec_done, rc_key(key), (void*)1);
+    if (g_disk_f) { fwrite(&r, sizeof r, 1, g_disk_f); fflush(g_disk_f); }
+    pthread_mutex_unlock(&g_mu);
+}
+// The kept translations' shader keys of NVN stage st (not the pixel shaders' per-primitive variants, valid only in mesh pipelines), malloc'd into *out: how many
+// (vka_pso.c lib_ahead_start: their stage libraries are made ahead, so a pair the frame path has not met only needs the fast link)
+unsigned vka_rc_stage_keys(int st, uint64_t** out) {
+    pthread_mutex_lock(&g_mu); disk_open();
+    unsigned n = 0; *out = malloc((g_disk.n ? g_disk.n : 1) * sizeof **out);
+    for (size_t i = 0; *out && i < g_disk.cap; i++) {
+        const rc_rec* r = g_disk.e[i].key ? g_disk.e[i].val : NULL;
+        if (!r || r->prim_inputs) continue;
+        if (rc_rec_control(r)->stage == (uint32_t)st) (*out)[n++] = r->key;
+    }
+    pthread_mutex_unlock(&g_mu);
+    return n;
+}
+// EDEN_NX2_NVN_RECOMPILE_DUMP=<dir> (lab): every module translated in this run (not those kept from earlier runs) as <key>[-p<per-primitive inputs>].spv, for spirv-val
+static void dump_spirv(uint64_t key, uint32_t prim_inputs, const nvn_direct_shader* o) {
+    static const char* dir; static int init;
+    if (!init) { dir = getenv("EDEN_NX2_NVN_RECOMPILE_DUMP"); init = 1; }
+    if (!dir || !*dir) return;
+    char path[1024];
+    if (prim_inputs) snprintf(path, sizeof path, "%s/%016llx-p%x.spv", dir, (unsigned long long)key, prim_inputs);
+    else snprintf(path, sizeof path, "%s/%016llx.spv", dir, (unsigned long long)key);
+    FILE* f = fopen(path, "wb");
+    if (f) { fwrite(o->spirv, 4, o->spirv_words, f); fclose(f); }
+}
+
+// EDEN_NX2_NVN_RECOMPILE_DUMP_KEYS=<key>[,<key>...] (lab, with EDEN_NX2_NVN_RECOMPILE_DUMP): those shaders translated and dumped as <key>-setshaders.spv when the
+// game sets them (no draw's state: constant buffer words read as 0, textures as unbound), whether or not they are ever drawn
+static void dump_listed(const prog_t* p, unsigned i, uint64_t key, const rc_control* control) {
+    static uint64_t keys[16]; static int nk = -1;
+    if (nk < 0) { nk = 0; const char* e = getenv("EDEN_NX2_NVN_RECOMPILE_DUMP_KEYS"); while (e && *e && nk < 16) { char* x; keys[nk++] = strtoull(e, &x, 16); e = *x == ',' ? x + 1 : NULL; } }
+    const char* dir = getenv("EDEN_NX2_NVN_RECOMPILE_DUMP");
+    int listed = 0; for (int k = 0; k < nk; k++) listed |= keys[k] == (key ? key : 1);
+    if (!listed || !dir || !*dir) return;
+    nvn_direct_shader o; uint64_t vin_types; char why[300] = "";
+    if (!rc_translate(p, i, control, NULL, 0, !vka_depth_zero(), &o, &vin_types, why, sizeof why)) { VRED("recompiler dump %016llx: not translated: %s", (unsigned long long)key, why); return; }
+    char path[1024]; snprintf(path, sizeof path, "%s/%016llx-setshaders.spv", dir, (unsigned long long)key);
+    FILE* f = fopen(path, "wb"); if (f) { fwrite(o.spirv, 4, o.spirv_words, f); fclose(f); }
+    VLOG("recompiler dump: %s (NVN stage %u, %zu words)", path, control->stage, o.spirv_words);
+    vka_shader_translated_free(&o);
+}
+
+int vka_rc_stage(uint64_t key) { const rc_control* c = rc_control_of(key); return c ? (int)c->stage : -1; }
+uint32_t vka_rc_prim(uint64_t key) {
+    pthread_mutex_lock(&g_mu); rc_ent* e = rc_find(&g_sh, rc_key(key)); rc_shader* r = e ? e->val : NULL; pthread_mutex_unlock(&g_mu);
+    return r ? r->prim : 0;
+}
+// The shader of a translation, new or kept (o: its descriptors and SPIR-V; control and c1: what it was made from): r->sh, NULL when refused (why says what)
+static _Atomic unsigned g_ahead;   // shaders made from kept translations before the game set them (vka_rc_by_key: the prewarm list)
+static void rc_make(rc_shader* r, uint64_t key, const nvn_direct_shader* o, const rc_control* control, const uint8_t* c1, uint32_t c1_len, uint64_t vin_types, uint32_t prim_inputs, char* why, size_t whyn) {
+    dmsh_vk_bind* b = rc_binds(o, r->st, control, why, whyn);
+    if (*why) g_unplaced++;   // a record the replay cannot fill: the shader is refused (vka_shader.c refusal) after this line
+    char err[200] = "";
+    uint16_t flags = ((r->st == 1 && prim_inputs) || (r->st == 7 && r->prim) ? DMSH_VK_F_MESH_PRIM : 0) | (o->uses_render_area ? VKA_F_RENDER_AREA : 0);
+    vka_shlib* L = b ? rc_lib(key, rc_vks(r->st), flags, o, b, o->desc_count, c1_len ? c1 : NULL, c1_len, vin_types, err, sizeof err) : NULL;
+    free(b);
+    if (!L) { if (!*why) snprintf(why, whyn, "%s", err); return; }
+    r->sh = vka_shader_make(L, key);
+    if (!r->sh) return;
+    r->sh->nvn2_control = nvn2_control(control->bytes) ? control->bytes : NULL; r->sh->shader_hash = o->shader_hash; g_made++;
+    for (unsigned k = 0; k < o->desc_count; k++) if (o->descs[k].kind == NVN_DIRECT_DESC_TEXTURE) {   // (the descriptors' order is RescalingPass's texture order)
+        r->sh->scale_tex_binding = o->descs[k].binding; r->sh->scale_tex_bit = (uint8_t)nvn_direct_scale_texture_bit((uint32_t)r->st);
+        r->sh->scale_tex_bits = (uint8_t)nvn_direct_scale_texture_bits((uint32_t)r->st); break; }
+    for (unsigned k = 0; k < r->sh->e->bind_count; k++) if (r->sh->b[k].kind == VKA_KIND_LOOP_GUARD && !r->sh->loop_guard.buf && vka_static(16, V.sb_align, &r->sh->loop_guard)) {
+        memset(r->sh->loop_guard.ptr, 0, 16); guard_add(key, &r->sh->loop_guard); }
+}
+// A shader met for the first time in this run: kept from an earlier run, or translated now with the draw's state (caller holds g_make_mu)
+static rc_shader* rc_new(const prog_t* p, unsigned i, uint64_t key, uint64_t slot, const rc_control* control, uint32_t prim_inputs, int gl_depth) {
+    rc_shader* r = calloc(1, sizeof *r); r->st = (int)control->stage;
+    nvn_direct_shader o; uint64_t vin_types = 0; char why[300] = "";
+    uint64_t t0 = now_ns();
+    const rc_control* kc; const uint8_t* c1; uint32_t c1_len; int kept_depth;
+    int kept = disk_get(slot, &o, &vin_types, &kept_depth, &r->prim, &kc, &c1, &c1_len), ok = kept;
+    if (!kept) {
+        uint32_t a, c1e; rc_c1_range(control, &a, &c1e);
+        c1 = (const uint8_t*)(uintptr_t)nvn_direct_host_of(p->sd[i].data) + a; c1_len = a < c1e ? c1e - a : 0;
+        if ((ok = rc_translate(p, i, control, g_draw, prim_inputs, gl_depth, &o, &vin_types, why, sizeof why))) {
+            r->prim = o.per_primitive_outputs;
+            disk_put(slot, key, prim_inputs, &o, vin_types, gl_depth, control, c1, c1_len);
+            dump_spirv(key, prim_inputs, &o);
+        }
+    }
+    if (ok) {
+        if (kept) g_cached++;
+        rc_make(r, key, &o, control, c1, c1_len, vin_types, prim_inputs, why, sizeof why);
+        if (!kept) vka_shader_translated_free(&o);
+        if (*why || !r->sh) { static _Atomic int n; if (atomic_fetch_add(&n, 1) < 64) VRED("recompiled shader %016llx (NVN stage %d): %s", (unsigned long long)key, r->st, *why ? why : "refused"); }
+    } else {
+        g_failed++;
+        static _Atomic int n; if (atomic_fetch_add(&n, 1) < 64) VRED("shader %016llx (NVN stage %d) not translated: %s; its draws are skipped", (unsigned long long)key, r->st, why);
+    }
+    uint64_t ms = (now_ns() - t0) / 1000000;
+    unsigned made = g_made, total = made + g_failed;
+    if (ms >= 50 || total <= 3 || total % 256 == 0)
+        VLOG("recompiler: %016llx (NVN stage %d) in %llu ms; %u made (%u kept from earlier runs, %u of them ahead), %u not translated, %u with bindings the replay cannot fill", (unsigned long long)key, r->st,
+             (unsigned long long)ms, made, (unsigned)g_cached, (unsigned)g_ahead, (unsigned)g_failed, (unsigned)g_unplaced);
+    pthread_mutex_lock(&g_mu); rc_put(&g_sh, slot, r); pthread_mutex_unlock(&g_mu);
+    return r;
+}
+// Making a shader (the frame path translating it, a prewarm thread taking it from the file): one at a time, so a key gets one vka_shader, the one
+// the pipelines made ahead were keyed with
+static pthread_mutex_t g_make_mu = PTHREAD_MUTEX_INITIALIZER;
+static rc_shader* rc_lookup(uint64_t slot) { pthread_mutex_lock(&g_mu); rc_ent* e = rc_find(&g_sh, slot); rc_shader* r = e ? e->val : NULL; pthread_mutex_unlock(&g_mu); return r; }
+// The recompiled shader of program p's stage i (key), translated at its first use with the draw's state (or as an earlier run kept it); *st its
+// NVN stage (-1: no control section kept for the key). prim_inputs: a pixel shader's generic inputs its program's mesh shader writes per primitive
+// (PerPrimitiveEXT, flag DMSH_VK_F_MESH_PRIM: a shader of its own, valid only in a mesh pipeline). gl_depth: the depth mode a depth stage is translated
+// for (each mode has a translation of its own). NULL: not translated or refused (logged once)
+vka_shader* vka_rc_shader(const prog_t* p, unsigned i, uint64_t key, uint32_t prim_inputs, int gl_depth, int* st) {
+    *st = -1;
+    const rc_control* control = rc_control_of(key);
+    if (!control) return NULL;
+    uint64_t slot = rc_translation_slot(key, prim_inputs, (int)control->stage, gl_depth);
+    rc_shader* r = rc_lookup(slot);
+    if (!r) {
+        pthread_mutex_lock(&g_make_mu);
+        if (!(r = rc_lookup(slot))) r = rc_new(p, i, key, slot, control, prim_inputs, gl_depth);
+        pthread_mutex_unlock(&g_make_mu);
+    }
+    *st = r->st;
+    return r->sh;
+}
+// Only the key is known here (the prewarm), not its stage: in the near-zero depth mode a depth stage's slot is looked at first, then the key's own, which
+// then counts only for a stage without depth (in GL's, the key's own slot holds both)
+static rc_shader* rc_by_slot(uint64_t key, uint64_t slot, int depth_ok) {
+    rc_shader* r = rc_lookup(slot);
+    if (r) return depth_ok || !rc_depth_stage(r->st) ? r : NULL;
+    // Lichii (dotfiles-25x.13): not met in this run yet: made from the translation an earlier run kept (prewarm, pipelines made ahead), and kept for the frame path
+    nvn_direct_shader o; uint64_t vin_types; const rc_control* control; const uint8_t* c1; uint32_t c1_len; int gl_depth; uint32_t prim;
+    if (!disk_get(slot, &o, &vin_types, &gl_depth, &prim, &control, &c1, &c1_len) || (!depth_ok && rc_depth_stage((int)control->stage))) return NULL;
+    r = calloc(1, sizeof *r); r->st = (int)control->stage; r->prim = prim;
+    char why[300] = "";
+    rc_make(r, key, &o, control, c1, c1_len, vin_types, 0, why, sizeof why);
+    g_cached++;
+    unsigned n = ++g_ahead;
+    if (*why || !r->sh) { static _Atomic int k; if (atomic_fetch_add(&k, 1) < 64) VRED("recompiled shader %016llx (NVN stage %d, kept): %s", (unsigned long long)key, r->st, *why ? why : "refused"); }
+    if (n == 1 || !(n & (n - 1))) VLOG("recompiler: %u shaders made ahead from kept translations (prewarm)", n);
+    pthread_mutex_lock(&g_mu); rc_put(&g_sh, slot, r); pthread_mutex_unlock(&g_mu);
+    return r;
+}
+vka_shader* vka_rc_by_key(uint64_t key, int gl_depth) {
+    const uint64_t own = rc_key(key), depth = rc_translation_slot(key, 0, 0, gl_depth);
+    rc_shader* r = rc_lookup(depth);
+    if (!r) {
+        pthread_mutex_lock(&g_make_mu);
+        if (!(r = rc_by_slot(key, depth, 1)) && depth != own) r = rc_by_slot(key, own, 0);
+        pthread_mutex_unlock(&g_make_mu);
+    }
+    return r ? r->sh : NULL;
+}
+
+// ---------- Speculative translations ----------
+// Lichii (dotfiles-25x.13): a vertex or pixel shader the game sets (nvnProgramSetShaders) that no earlier run kept is translated on a background thread without a draw's
+// state (constant buffer words read as 0, no textures) and its stage library made in the most common state (vka_lib_ahead_shader), then let go of: only the pipeline cache
+// keeps it. The draw still translates the shader with its own state and makes its own library, so what is drawn is always the draw's own translation; when the two SPIR-V
+// modules are the same (2 in 3 of those made in time in mkw-race: about 2 in 3 vertex and 2 in 5 pixel shaders) that library is a cache hit instead of a compile on
+// the frame path. Newest first: Mario Kart World sets ~4,000 programs and draws ~900, those it set last soonest. First-met content (cold, the NVIDIA disk cache off):
+// libraries compiled on the frame path 0.54 -> 0.41-0.43 per shader made (615 / 596 -> 448-515 a race), frame-path creation 54-56 -> 47-50 s; warm runs unchanged.
+// Each shader done is marked in vk_recompiled.bin (disk_spec_done), so a warm run does not translate again the ones the game sets and never draws.
+// EDEN_NX2_NVN_SPECULATE=<threads> (default an eighth of the host's threads, 1 to 4; nice 10), 0: off
+typedef struct { uint64_t key, data; const rc_control* control; } spec_item;
+static spec_item* g_spec; static size_t g_spec_n, g_spec_cap; static int g_spec_up;
+static pthread_mutex_t g_spec_mu = PTHREAD_MUTEX_INITIALIZER; static pthread_cond_t g_spec_cv = PTHREAD_COND_INITIALIZER;
+static _Atomic unsigned g_spec_made, g_spec_skipped, g_spec_failed;
+static _Atomic int g_spec_busy;
+// One speculative translation (g_spec_busy counts it while it runs)
+static void spec_one(spec_item it) {
+    pthread_mutex_lock(&g_mu); disk_open(); int known = rc_find(&g_disk, it.key) || rc_find(&g_sh, it.key) || rc_find(&g_spec_done, it.key); pthread_mutex_unlock(&g_mu);
+    if (known) { g_spec_skipped++; return; }   // kept from an earlier run (made ahead), met by a draw already, or done speculatively in an earlier run
+    int st = (int)it.control->stage;
+    prog_t p; memset(&p, 0, sizeof p); p.nstage = 1; p.sd[0].data = it.data;
+    nvn_direct_shader o; uint64_t vin_types; char why[300]; why[0] = 0;
+    if (!rc_translate(&p, 0, it.control, NULL, 0, !vka_depth_zero(), &o, &vin_types, why, sizeof why)) { g_spec_failed++; disk_spec_done(it.key); return; }
+    dmsh_vk_bind* b = rc_binds(&o, st, it.control, why, sizeof why);
+    uint32_t a0, c1e; rc_c1_range(it.control, &a0, &c1e); uint32_t c1_len = a0 < c1e ? c1e - a0 : 0;
+    const uint8_t* c1 = (const uint8_t*)(uintptr_t)nvn_direct_host_of(it.data) + a0;
+    char err[200]; err[0] = 0;
+    vka_shlib* L = b && !*why ? rc_lib(it.key, rc_vks(st), 0, &o, b, o.desc_count, c1_len ? c1 : NULL, c1_len, vin_types, err, sizeof err) : NULL;
+    free(b); vka_shader_translated_free(&o);
+    vka_shader* s = L ? vka_shader_scratch(L, it.key) : NULL;
+    if (s) vka_lib_ahead_shader(s, st == 0 ? 1 : 2);
+    vka_shader_scratch_free(s);
+    if (L) { free((void*)L->base); free(L); }
+    disk_spec_done(it.key);
+    if (!s) { g_spec_failed++; return; }
+    unsigned n = ++g_spec_made;
+    if (n == 1 || !(n & (n - 1))) VLOG("recompiler: %u shaders translated speculatively and their libraries made (%u kept or drawn already, %u not translated without a draw)", n, (unsigned)g_spec_skipped, (unsigned)g_spec_failed);
+}
+// The emulator shuts down (vka_stop): the threads drop what is queued and end, as what they use (the game's memory, Lichii's recompiler and device) goes away
+static void* spec_main(void* a) {
+    (void)a; setpriority(PRIO_PROCESS, 0, 10);
+    for (;;) {
+        pthread_mutex_lock(&g_spec_mu);
+        while (!g_spec_n && !vka_stopping()) pthread_cond_wait(&g_spec_cv, &g_spec_mu);
+        if (vka_stopping()) { g_spec_n = 0; pthread_mutex_unlock(&g_spec_mu); return NULL; }
+        spec_item it = g_spec[--g_spec_n];   // the newest first: the game draws what it set last soonest
+        atomic_fetch_add(&g_spec_busy, 1);
+        pthread_mutex_unlock(&g_spec_mu);
+        spec_one(it);
+        atomic_fetch_sub(&g_spec_busy, 1);
+    }
+    return NULL;
+}
+// nvn_direct_park (after vka_stop): wakes the speculative threads and waits (bounded) until none translates. 1 = none does
+int vka_rc_park(uint64_t timeout_ns) {
+    pthread_mutex_lock(&g_spec_mu); pthread_cond_broadcast(&g_spec_cv); pthread_mutex_unlock(&g_spec_mu);
+    const uint64_t t0 = now_ns();
+    while (atomic_load(&g_spec_busy) && now_ns() - t0 < timeout_ns) usleep(1000);
+    return !atomic_load(&g_spec_busy);
+}
+static void spec_add(uint64_t key, uint64_t data, const rc_control* control) {
+    static int on = -1;
+    if (on < 0) {   // threads: an eighth of the host's (the desktop's 32: 4, the Deck's 8: 1), 1 to 4
+        long hw = sysconf(_SC_NPROCESSORS_ONLN); int d = hw >= 32 ? 4 : hw >= 16 ? (int)(hw / 8) : 1;
+        const char* e = getenv("EDEN_NX2_NVN_SPECULATE"); on = vka_rc_mode() != 1 ? 0 : e && *e ? atoi(e) : d; if (on > 16) on = 16;
+    }
+    if (!on || control->stage > 1) return;
+    pthread_mutex_lock(&g_spec_mu);
+    if (g_spec_n == g_spec_cap) { size_t nc = g_spec_cap ? 2 * g_spec_cap : 1024; spec_item* n = realloc(g_spec, nc * sizeof *n); if (!n) { pthread_mutex_unlock(&g_spec_mu); return; } g_spec = n; g_spec_cap = nc; }
+    g_spec[g_spec_n++] = (spec_item){key, data, control};
+    for (; g_spec_up < on; g_spec_up++) { pthread_t th; if (!pthread_create(&th, NULL, spec_main, NULL)) pthread_detach(th); }
+    pthread_cond_signal(&g_spec_cv);
+    pthread_mutex_unlock(&g_spec_mu);
+}
+
+// Shaders made in this run, and of them the ones an earlier run kept (the rest were translated now: new to this run's DM_TEMP)
+void vka_rc_counts(unsigned* made, unsigned* kept) { *made = g_made; *kept = g_cached; }
+
+// ---------- Mode 2: the library's records against the recompiler's ----------
+// A record as what it reads, without its binding number or descriptor kind spelling: (class, source) strings, sorted
+static int rec_name(const dmsh_vk_bind* b, char* o, size_t n) {
+    switch (b->kind) {
+    case DMSH_VK_KIND_CBUF: return snprintf(o, n, "c%d", b->reg + 3);
+    case DMSH_VK_KIND_C1: return snprintf(o, n, "c1");
+    case DMSH_VK_KIND_DRVCB: case VKA_KIND_NVN2_CS_C0: return snprintf(o, n, "c%d", b->kind == VKA_KIND_NVN2_CS_C0 || (b->reg == DMSH_PUSH_BANK) ? 0 : b->reg);   // (the library reads compute c[0]'s push constants at c24)
+    case DMSH_VK_KIND_SBUF: return snprintf(o, n, "ssbo%d", b->reg);
+    case DMSH_VK_KIND_SBUF_UBO: return snprintf(o, n, "ssbo@c%d+%#x", b->reg + 3, b->off);
+    case DMSH_VK_KIND_UBO_PTR: return snprintf(o, n, "ubo_ptr%d", b->reg);
+    // (textures by their handle word: Lichii declares one descriptor per type a slot is read as, the library one per slot)
+    case DMSH_VK_KIND_TEX: return b->flags & DMSH_VK_BF_NOSLOT ? snprintf(o, n, "tex-none") : snprintf(o, n, "tex@c2+%#x", DMSH_C2_TEX + DMSH_C2_ROW * b->reg);
+    case DMSH_VK_KIND_TEX_C2A: return snprintf(o, n, "tex@c2+%#x%s", b->off, b->count > 1 ? "[]" : "");
+    case DMSH_VK_KIND_TEX_UBO: return snprintf(o, n, "tex@c%d+%#x", b->reg + 3, b->off);
+    case DMSH_VK_KIND_TBUF: return snprintf(o, n, "tbuf%d", b->reg);
+    case DMSH_VK_KIND_IMG: return snprintf(o, n, "img%d", b->reg);
+    case DMSH_VK_KIND_SUPPORT: case DMSH_VK_KIND_GMEM_MAP: case DMSH_VK_KIND_GMEM_LOG: case VKA_KIND_LOOP_GUARD: return 0;   // either translator's own buffers
+    default: return snprintf(o, n, "kind%u:%d:%#x", b->kind, b->reg, b->off);
+    }
+}
+static int cmp_str(const void* a, const void* b) { return strcmp(*(char* const*)a, *(char* const*)b); }
+static void rec_list(const dmsh_vk_bind* b, unsigned n, char* out, size_t on) {
+    char names[128][48]; char* ptr[128]; unsigned m = 0;
+    for (unsigned k = 0; k < n && m < 128; k++) if (rec_name(&b[k], names[m], sizeof names[m]) > 0) { ptr[m] = names[m]; m++; }
+    qsort(ptr, m, sizeof *ptr, cmp_str);
+    size_t at = 0; out[0] = 0;
+    for (unsigned k = 0; k < m && at + 2 < on; k++) if (!k || strcmp(ptr[k], ptr[k - 1])) at += (size_t)snprintf(out + at, on - at, "%s%s", k ? " " : "", ptr[k]);
+}
+static _Atomic unsigned g_cmp_same, g_cmp_diff, g_cmp_fail;
+void vka_rc_compare(const prog_t* p, unsigned i, uint64_t key, const vka_shader* lib) {
+    if (!lib) return;
+    pthread_mutex_lock(&g_mu); int seen = rc_find(&g_cmp, rc_key(key)) != NULL; if (!seen) rc_put(&g_cmp, rc_key(key), (void*)1); pthread_mutex_unlock(&g_mu);
+    if (seen) return;
+    const rc_control* control = rc_control_of(key);
+    if (!control) return;
+    nvn_direct_shader o; dmsh_vk_bind* b = NULL; uint64_t vin_types; char why[300] = "";
+    int ok = rc_translate(p, i, control, g_draw, 0, !vka_depth_zero(), &o, &vin_types, why, sizeof why);
+    if (ok && !(b = rc_binds(&o, (int)control->stage, control, why, sizeof why))) { vka_shader_translated_free(&o); ok = 0; }
+    if (!ok) {
+        g_cmp_fail++;
+        static _Atomic int n; if (atomic_fetch_add(&n, 1) < 64) VRED("compare %016llx (NVN stage %d): not translated: %s", (unsigned long long)key, (int)control->stage, why);
+    } else {
+        static char a[4096], c[4096];
+        rec_list(lib->b, lib->e->bind_count, a, sizeof a); rec_list(b, o.desc_count, c, sizeof c);
+        int same = !strcmp(a, c) && lib->e->vin_mask == o.input_mask && lib->e->fout_mask == o.output_mask;
+        if (same) g_cmp_same++; else g_cmp_diff++;
+        static _Atomic int n;
+        if ((!same || *why) && atomic_fetch_add(&n, 1) < 96)
+            VLOG("compare %016llx (NVN stage %d): %s inputs %#x/%#x outputs %#x/%#x%s%s\n  library:    %s\n  recompiler: %s", (unsigned long long)key, (int)control->stage, same ? "same" : "DIFFERENT",
+                 lib->e->vin_mask, o.input_mask, lib->e->fout_mask, o.output_mask, *why ? "; unplaced: " : "", why, a, c);
+        vka_shader_translated_free(&o); free(b);
+    }
+    unsigned t = g_cmp_same + g_cmp_diff + g_cmp_fail;
+    if (t <= 3 || t % 128 == 0) VLOG("compare: %u shaders, %u same, %u different, %u not translated", t, (unsigned)g_cmp_same, (unsigned)g_cmp_diff, (unsigned)g_cmp_fail);
+}
diff --git a/src/video_core/nvn_direct/nvn_shutdown.c b/src/video_core/nvn_direct/nvn_shutdown.c
new file mode 100644
index 0000000000..3663a17443
--- /dev/null
+++ b/src/video_core/nvn_direct/nvn_shutdown.c
@@ -0,0 +1,82 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// The emulator shutting down in direct mode (dotfiles-25x.18). Upstream's replay lives as long as
+// its process (detached threads, the GPU until exit); in Lichii the emulation stops first and the
+// device goes away while the process goes on.
+// - nvn_direct_stop, before the guest's cores are suspended: a game thread inside a halted NVN
+//   call (core/nvn_hook.cpp RunHaltedCall) waits on the host, where the kernel cannot suspend it
+//   (a fence, room in the replay worker's queue, a present's fill). Those waits return now:
+//   nothing more is replayed or submitted and every fence reads as done.
+// - nvn_direct_park, before Lichii's device and the renderer objects the replay calls back into
+//   (the ASTC decode) are destroyed: the replay worker finishes what it holds, pipeline builds
+//   and speculative shader translations stop, the pipeline cache is saved a last time, and the
+//   completion thread runs what was submitted and leaves. None of the replay's threads uses the
+//   device or guest memory after that. A thread that does not stop within its bound (stuck in the
+//   driver) ends the process instead: the device must not go away under it.
+
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "bananative/dm/gfx/vk_android/vka.h"
+#include "nvn_direct.h"
+
+void nvn_direct_present_wake(void); // nvn_present.c
+int vka_rc_park(uint64_t timeout_ns); // nvn_recompile.c
+
+static _Atomic int g_parked;
+
+// The shutdown should reach nvn_direct_park within seconds of the stop: if it does not, a line
+// (and with DM_VK_STALL_STACKS=1 every thread's stack) says where it waits.
+static void* watchdog_main(void* arg) {
+    (void)arg;
+    pthread_setname_np(pthread_self(), "vk-shutdown");
+    for (int i = 0; i < 50; i++) {
+        if (atomic_load(&g_parked)) return NULL;
+        struct timespec ts = {0, 100000000};
+        nanosleep(&ts, NULL);
+    }
+    VRED("shutdown: the device not released 5 s after the stop (Lichii's shutdown waits elsewhere; DM_VK_STALL_STACKS=1 logs every thread's stack)");
+    vka_stall_stacks();
+    return NULL;
+}
+
+void nvn_direct_stop(void) {
+    if (vka_stopping()) return;
+    vka_stop();
+    vka_worker_wake();
+    nvn_direct_present_wake();
+    VLOG("the emulator stops: nothing more is replayed or submitted, every fence reads as done");
+    pthread_t th;
+    if (!pthread_create(&th, NULL, watchdog_main, NULL)) pthread_detach(th);
+}
+
+void nvn_direct_park(void) {
+    nvn_direct_stop();
+    atomic_store(&g_parked, 1);
+    if (!vka_ok()) return;
+    vka_vram_trace_stop();
+    // Bounded: a thread stuck in the driver must not keep the emulator from shutting down. The
+    // device's own wait for idle follows (RendererVulkan's destructor).
+    const uint64_t bound = 3000000000ull;
+    const uint64_t t0 = now_ns();
+    const int worker = vka_worker_idle(bound);
+    const int builds = vka_pso_park(bound);
+    const int translations = vka_rc_park(bound);
+    const int completion = worker && builds && translations && vka_complete_stop(bound);
+    const double ms = (now_ns() - t0) / 1e6;
+    if (completion) {
+        VLOG("parked for the shutdown in %.0f ms: the replay worker is idle, no pipeline is being built or shader translated, the pipeline cache is saved, the completion thread has left", ms);
+        return;
+    }
+    VRED("parked for the shutdown in %.0f ms: the replay worker %s, pipeline builds %s, speculative translations %s, the completion thread %s; the device is still in use: the process exits", ms,
+         worker ? "is idle" : "is still replaying", builds ? "stopped" : "still running", translations ? "stopped" : "still running",
+         !(worker && builds && translations) ? "was not stopped" : "is still running");
+    vka_stall_stacks();
+    // Not abort or exit: the replay's own fatal exit (dm_host_shutdown's abort) has been seen to hang
+    // the process, and exit handlers and destructors would destroy the device under those threads.
+    _exit(1);
+}
diff --git a/src/video_core/nvn_direct/nvn_tracking.c b/src/video_core/nvn_direct/nvn_tracking.c
new file mode 100644
index 0000000000..34eae611ee
--- /dev/null
+++ b/src/video_core/nvn_direct/nvn_tracking.c
@@ -0,0 +1,274 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// CPU write tracking of memory pools in direct mode (dotfiles-25x.5): upstream's nvn_dirty.h
+// interface (its nvn_dirty.c, MIT, is not built: its own fault handler and mprotect calls would
+// fight Lichii's fastmem protections) over Lichii's page types. Protecting pages arms them
+// (track_pages: rasterizer-cached pages by guest address, which stay readable in direct mode:
+// the replay reads them in place); a CPU write to an armed page takes Core::Memory's rasterizer
+// write path, which reports it here (nvn_direct_cpu_written): the pages get a new generation and
+// are disarmed. The pools are not mapped in the SMMU: with them there MKW stalled at ~127
+// presents, one guest core busy (runs nd-bis-2..4). As upstream, a
+// texture's upload takes nvn_dirty_now, protects its pages, then reads them; it is uploaded again
+// once any page has a generation past that stamp.
+//
+// Host writes into pools: the completion thread's event values and counter reports go through
+// the backing memory (nvn_direct_writable), which is never protected; the front end's command
+// records, written in place into command memory, are on pages never armed
+// (nvn_direct_host_written); host writes that change texture storage (readbacks of linear
+// textures) disarm and stamp first (dm_guest_write_prepare).
+
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "hle.h"
+#include "nvn_direct.h"
+#include "nvn_direct_front.h"
+#include "nvn_dirty.h"
+
+enum { PAGE_SHIFT = 12 };
+#define PAGE_SIZE (1ull << PAGE_SHIFT)
+
+// A registered pool. Kept (live 0) after it goes: images hold its pointer (nvn_dirty_span).
+typedef struct {
+    uintptr_t lo, hi; // host pointers into the arena
+    _Atomic uint64_t* gen; // per page: generation of the last CPU write seen (0: none)
+    uint8_t* armed;        // per page: Lichii tracks writes to it (under g_mu)
+    uint8_t* host;         // per page: the front end writes it in place (nvn_direct_host_written): never armed
+    _Atomic int live;
+} span_t;
+
+static span_t** g_spans; // live spans by lo (under g_mu for changes, g_rw for lookups)
+static int g_nspans, g_capspans;
+static pthread_mutex_t g_mu = PTHREAD_MUTEX_INITIALIZER;
+static pthread_rwlock_t g_rw = PTHREAD_RWLOCK_INITIALIZER;
+static _Atomic uint64_t g_now = 1;
+static _Atomic uint64_t g_faults, g_preps;
+
+static span_t* find_locked(uintptr_t a, size_t len) {
+    int lo = 0, hi = g_nspans - 1, hit = -1;
+    while (lo <= hi) {
+        const int m = (lo + hi) / 2;
+        if (g_spans[m]->lo <= a) { hit = m; lo = m + 1; } else hi = m - 1;
+    }
+    return hit >= 0 && a + len <= g_spans[hit]->hi ? g_spans[hit] : NULL;
+}
+static span_t* find(uintptr_t a, size_t len) {
+    pthread_rwlock_rdlock(&g_rw);
+    span_t* s = find_locked(a, len);
+    pthread_rwlock_unlock(&g_rw);
+    return s;
+}
+
+// EDEN_NX2_NVN_TRACK=0: nothing tracked (a texture is uploaded once, at its first use).
+static int track_on(void) {
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("EDEN_NX2_NVN_TRACK"); on = !e || atoi(e) != 0; }
+    return on;
+}
+void nvn_dirty_add_range(const void* mem, size_t size) {
+    const uintptr_t lo = (uintptr_t)mem, hi = lo + size;
+    if (!size || nvn_direct_guest_of(lo) == lo || !track_on()) return; // not guest memory (a host segment)
+    span_t* s = calloc(1, sizeof *s);
+    const size_t pages = (size + PAGE_SIZE - 1 + (lo & (PAGE_SIZE - 1))) >> PAGE_SHIFT;
+    if (s) { s->gen = calloc(pages, sizeof *s->gen); s->armed = calloc(pages, 1); s->host = calloc(pages, 1); }
+    if (!s || !s->gen || !s->armed || !s->host) goto fail;
+    s->lo = lo & ~(uintptr_t)(PAGE_SIZE - 1);
+    s->hi = hi;
+    atomic_store(&s->live, 1);
+    pthread_mutex_lock(&g_mu);
+    pthread_rwlock_wrlock(&g_rw);
+    if (g_nspans == g_capspans) {
+        const int cap = g_capspans ? 2 * g_capspans : 256;
+        span_t** spans = realloc(g_spans, (size_t)cap * sizeof *g_spans);
+        if (!spans) { pthread_rwlock_unlock(&g_rw); pthread_mutex_unlock(&g_mu); goto fail; }
+        g_spans = spans;
+        g_capspans = cap;
+    }
+    int i = g_nspans;
+    while (i > 0 && g_spans[i - 1]->lo > s->lo) { g_spans[i] = g_spans[i - 1]; i--; }
+    g_spans[i] = s;
+    g_nspans++;
+    pthread_rwlock_unlock(&g_rw);
+    pthread_mutex_unlock(&g_mu);
+    return;
+fail:
+    if (s) { free(s->gen); free(s->armed); free(s->host); free(s); }
+    LOG("[RED] pool %p+%#zx: out of memory for its write tracking: CPU writes to its textures after their first upload are not seen", mem, size);
+}
+
+// Arms (on) or disarms the pages [p, q] of s that are not already so, in runs (caller holds g_mu)
+static void arm_pages(span_t* s, uintptr_t p, uintptr_t q, int on) {
+    uintptr_t run = 0;
+    int open = 0;
+    for (uintptr_t i = p; i <= q + 1; i++) {
+        const int change = i <= q && s->armed[i] != on && !(on && s->host[i]);
+        if (change) {
+            s->armed[i] = (uint8_t)on;
+            if (!open) { run = i; open = 1; }
+            continue;
+        }
+        if (open) {
+            nvn_direct_track_pages(nvn_direct_guest_of(s->lo + (run << PAGE_SHIFT)), (i - run) << PAGE_SHIFT, on);
+            open = 0;
+        }
+    }
+}
+
+void nvn_dirty_remove_range(const void* mem) {
+    pthread_mutex_lock(&g_mu);
+    pthread_rwlock_wrlock(&g_rw);
+    span_t* s = NULL;
+    for (int i = 0; i < g_nspans; i++) {
+        if (g_spans[i]->lo != ((uintptr_t)mem & ~(uintptr_t)(PAGE_SIZE - 1))) continue;
+        s = g_spans[i];
+        memmove(&g_spans[i], &g_spans[i + 1], (size_t)(g_nspans - i - 1) * sizeof *g_spans);
+        g_nspans--;
+        break;
+    }
+    pthread_rwlock_unlock(&g_rw);
+    if (s) {
+        arm_pages(s, 0, ((s->hi - s->lo - 1) >> PAGE_SHIFT), 0);
+        atomic_store(&s->live, 0);
+    }
+    pthread_mutex_unlock(&g_mu);
+}
+
+void nvn_direct_host_written(const void* mem, size_t size) {
+    if (!size) return;
+    pthread_mutex_lock(&g_mu);
+    span_t* s = find((uintptr_t)mem, size);
+    if (s) {
+        const uintptr_t a = (uintptr_t)mem;
+        const uintptr_t p = (a - s->lo) >> PAGE_SHIFT, q = (a + size - 1 - s->lo) >> PAGE_SHIFT;
+        arm_pages(s, p, q, 0);
+        for (uintptr_t i = p; i <= q; i++) s->host[i] = 1;
+    }
+    pthread_mutex_unlock(&g_mu);
+}
+
+int nvn_dirty_tracked(const void* addr, size_t len) { return len && find((uintptr_t)addr, len) != NULL; }
+const void* nvn_dirty_span(const void* addr, size_t len) { return len ? find((uintptr_t)addr, len) : NULL; }
+uint64_t nvn_dirty_now(void) { return atomic_load(&g_now); }
+
+void nvn_dirty_protect(const void* addr, size_t len) {
+    if (!len) return;
+    pthread_mutex_lock(&g_mu);
+    span_t* s = find((uintptr_t)addr, len);
+    if (s) {
+        const uintptr_t a = (uintptr_t)addr;
+        arm_pages(s, (a - s->lo) >> PAGE_SHIFT, (a + len - 1 - s->lo) >> PAGE_SHIFT, 1);
+    }
+    pthread_mutex_unlock(&g_mu);
+}
+
+// The page ranges written since the replay last took them (nvn_dirty_take): it re-uploads the
+// images over them instead of checking every live image. Past WLOG_N ranges the log is lost and
+// the taker checks them all (under g_mu).
+enum { WLOG_N = 4096 };
+static nvn_dirty_range g_wlog[WLOG_N];
+static int g_nwlog, g_wlog_lost;
+static void wlog_add(uintptr_t lo, uintptr_t hi) {
+    nvn_dirty_range* last = g_nwlog ? &g_wlog[g_nwlog - 1] : NULL;
+    if (last && lo <= last->hi && hi >= last->lo) {
+        if (lo < last->lo) last->lo = lo;
+        if (hi > last->hi) last->hi = hi;
+        return;
+    }
+    if (g_nwlog == WLOG_N) { g_wlog_lost = 1; return; }
+    g_wlog[g_nwlog++] = (nvn_dirty_range){lo, hi};
+}
+int nvn_dirty_take(nvn_dirty_range* out, int max) {
+    pthread_mutex_lock(&g_mu);
+    const int n = g_wlog_lost || g_nwlog > max ? -1 : g_nwlog;
+    if (n > 0) memcpy(out, g_wlog, (size_t)n * sizeof *out);
+    g_nwlog = 0;
+    g_wlog_lost = 0;
+    pthread_mutex_unlock(&g_mu);
+    return n;
+}
+
+// A CPU write Lichii saw on guest [address, address + size): new generation, pages disarmed, in
+// every span the range touches (spans change only under g_mu, which is held).
+static void written(uintptr_t a, size_t len) {
+    if (!len) return;
+    const uintptr_t e = a + len;
+    pthread_mutex_lock(&g_mu);
+    int k = 0, lo = 0, hi = g_nspans - 1;
+    while (lo <= hi) {
+        const int m = (lo + hi) / 2;
+        if (g_spans[m]->lo <= a) { k = m; lo = m + 1; } else hi = m - 1;
+    }
+    uint64_t g = 0;
+    for (; k < g_nspans && g_spans[k]->lo < e; k++) {
+        span_t* s = g_spans[k];
+        if (s->hi <= a) continue;
+        if (!g) g = atomic_fetch_add(&g_now, 1) + 1;
+        const uintptr_t b = a > s->lo ? a : s->lo, end = e < s->hi ? e : s->hi;
+        const uintptr_t p = (b - s->lo) >> PAGE_SHIFT, q = (end - 1 - s->lo) >> PAGE_SHIFT;
+        for (uintptr_t i = p; i <= q; i++) atomic_store(&s->gen[i], g);
+        arm_pages(s, p, q, 0);
+        wlog_add(s->lo + (p << PAGE_SHIFT), s->lo + ((q + 1) << PAGE_SHIFT));
+    }
+    pthread_mutex_unlock(&g_mu);
+}
+void mtl_pkg_stats(uint64_t* uploads, uint64_t* reuploads); // vka_tex.c
+void nvn_direct_cpu_written(uint64_t address, uint64_t size) {
+    const uint64_t n = atomic_fetch_add(&g_faults, 1) + 1;
+    written((uintptr_t)nvn_direct_host_of(address), size);
+    if (n <= 4 || !(n & (n - 1))) {
+        uint64_t uploads = 0, reuploads = 0;
+        mtl_pkg_stats(&uploads, &reuploads);
+        LOG("[vk] tracked pool memory: %llu CPU writes seen (the last at %#llx+%#llx); textures uploaded from storage %llu, again after a write %llu",
+            (unsigned long long)n, (unsigned long long)address, (unsigned long long)size, (unsigned long long)uploads, (unsigned long long)reuploads);
+    }
+}
+void dm_guest_write_prepare(void* addr, size_t len) {
+    atomic_fetch_add(&g_preps, 1);
+    written((uintptr_t)addr, len);
+}
+
+int nvn_dirty_since_span(const void* span, const void* addr, size_t len, uint64_t stamp) {
+    if (!len) return 0;
+    const span_t* s = span;
+    const uintptr_t a = (uintptr_t)addr;
+    if (!s || !atomic_load(&s->live) || a < s->lo || a + len > s->hi) s = find(a, len);
+    if (!s) return 1; // untracked: uploaded again rather than shown stale
+    const uintptr_t p = (a - s->lo) >> PAGE_SHIFT, q = (a + len - 1 - s->lo) >> PAGE_SHIFT;
+    for (uintptr_t i = p; i <= q; i++) if (atomic_load(&s->gen[i]) > stamp) return 1;
+    return 0;
+}
+int nvn_dirty_since(const void* addr, size_t len, uint64_t stamp) { return nvn_dirty_since_span(NULL, addr, len, stamp); }
+
+int nvn_dirty_bounds_since(const void* span, const void* addr, size_t len, uint64_t stamp, size_t* lo, size_t* hi) {
+    *lo = 0;
+    *hi = len;
+    if (!len) return 0;
+    const span_t* s = span;
+    const uintptr_t a = (uintptr_t)addr;
+    if (!s || !atomic_load(&s->live) || a < s->lo || a + len > s->hi) s = find(a, len);
+    if (!s) return 1;
+    uintptr_t f = UINTPTR_MAX, l = 0;
+    const uintptr_t p = (a - s->lo) >> PAGE_SHIFT, q = (a + len - 1 - s->lo) >> PAGE_SHIFT;
+    for (uintptr_t i = p; i <= q; i++) {
+        if (atomic_load(&s->gen[i]) > stamp) { if (f == UINTPTR_MAX) f = i; l = i; }
+    }
+    if (f == UINTPTR_MAX) return 0;
+    const uintptr_t b0 = s->lo + (f << PAGE_SHIFT), b1 = s->lo + ((l + 1) << PAGE_SHIFT);
+    *lo = b0 > a ? b0 - a : 0;
+    *hi = b1 - a < len ? b1 - a : len;
+    return 1;
+}
+
+// Upstream's placement swap held the tracker over a range it remapped; imports remap nothing.
+void nvn_dirty_hold(const void* addr, size_t len) { (void)addr; (void)len; }
+void nvn_dirty_unhold(void) {}
+void nvn_dirty_stats(uint64_t* faults, uint64_t* preps) { *faults = atomic_load(&g_faults); *preps = atomic_load(&g_preps); }
+void nvn_dirty_mp_stats(uint64_t* calls, uint64_t* pages, uint64_t* ns) { *calls = *pages = *ns = 0; }
+void nvn_dirty_debug(const void* span, const void* addr, size_t len, uint64_t stamp, char* out, size_t n) {
+    (void)span; (void)addr; (void)len; (void)stamp;
+    if (n) out[0] = 0;
+}
diff --git a/src/video_core/nvn_direct/nvn_window.c b/src/video_core/nvn_direct/nvn_window.c
new file mode 100644
index 0000000000..a2d8cd8612
--- /dev/null
+++ b/src/video_core/nvn_direct/nvn_window.c
@@ -0,0 +1,202 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// NVN windows in direct mode: what upstream's window block of hle_nvn.c did (left out there),
+// without its pacing, frame statistics and present thread. A present hands the image to the
+// replay's present queue (nvn_present.c); Lichii's hook shows it and does the present's
+// bookkeeping and pacing (core/nvn_hook.cpp). The window and sync layouts are the front end's
+// (nvn_obj.h).
+
+#include <stdatomic.h>
+#include <string.h>
+
+#include "hle.h"
+#include "nvn_protos.h"
+#include "nvn_obj.h"
+#include "nvn_capture.h"
+#include "nvn_mtl.h"
+#include "nvn_direct_front.h"
+
+typedef struct { const char* name; void* fn; } nvn_impl;
+// As hle_nvn.c's NVN(): an implementation with its signature checked against the prototype,
+// listed in the front end's table (section swnvn).
+#define NVN(name, ret, ...)                                                                        \
+    static ret h_##name(__VA_ARGS__);                                                              \
+    static const NVNT_##name chk_##name __attribute__((unused)) = h_##name;                        \
+    PLAT_TABLE(swnvn) static const nvn_impl e_##name = {#name, (void*)h_##name};                   \
+    static ret h_##name(__VA_ARGS__)
+// NVN2's functions without a prototype (gen_dispatch.py reads their signatures here).
+#define NVN_NOPROTO(name, ret, ...)                                                                \
+    static ret h_##name(__VA_ARGS__);                                                              \
+    PLAT_TABLE(swnvn) static const nvn_impl e_##name = {#name, (void*)h_##name};                   \
+    static ret h_##name(__VA_ARGS__)
+
+#define WB(b) ((win_builder_t*)(b))
+#define WBHDR(b) ((win_hdr_t*)((uint8_t*)(b) + WIN_BUILDER_HDR))
+#define CTX(t) ((const tex_t*)(t))
+
+static _Atomic uint64_t g_frame;
+uint64_t dm_nvn_frame_count(void) { return atomic_load(&g_frame); }
+
+NVN(nvnWindowBuilderSetDefaults, void, NVNwindowBuilder* b) {
+    NVNdevice* dev = WB(b)->dev;
+    memset(b, 0, sizeof(win_builder_t));
+    WB(b)->dev = dev;
+    WB(b)->interval = 1;
+    if (dm_sdk_ounce()) {
+        static const win_hdr_t defaults = {{0.64f, 0.33f, 0.30f, 0.60f, 0.15f, 0.06f, 0.3127f, 0.3290f, 0.03f, 1000.f}, {200.f, 60.f}};
+        *WBHDR(b) = defaults;
+    }
+}
+NVN(nvnWindowBuilderSetDevice, void, NVNwindowBuilder* b, NVNdevice* d) { WB(b)->dev = d; }
+NVN(nvnWindowBuilderSetNativeWindow, void, NVNwindowBuilder* b, NVNnativeWindow w) { WB(b)->native = w; }
+// The builder keeps the game's array, as the driver does, and reads it at WindowInitialize and
+// GetTexture: its entries are the game's addresses.
+NVN_NOPROTO(nvnWindowBuilderSetTextures, void, NVNwindowBuilder* b, int n, const void* t) {
+    if (n < 0 || n > 4) {
+        LOG("[RED] WindowBuilderSetTextures count %d", n);
+        n = n < 0 ? 0 : 4;
+    }
+    WB(b)->ntex = n;
+    WB(b)->tex = t;
+}
+static NVNtexture* builder_texture(const win_builder_t* b, int i) {
+    return (NVNtexture*)(uintptr_t)nvn_direct_host_of(((const uint64_t*)b->tex)[i]);
+}
+NVN(nvnWindowBuilderSetPresentInterval, void, NVNwindowBuilder* b, int v) { WB(b)->interval = v; }
+NVN(nvnWindowInitialize, NVNboolean, NVNwindow* w, const NVNwindowBuilder* b) {
+    const win_builder_t* s = (const win_builder_t*)b;
+    win_t* o = (win_t*)w;
+    memset(o, 0, sizeof *o);
+    o->magic = MAGIC('W', 'I', 'N', 'D');
+    o->native = s->native;
+    o->ntex = s->ntex;
+    o->interval = s->interval;
+    o->active = s->active ? s->active : s->ntex;
+    for (int i = 0; i < s->ntex; i++) o->tex[i] = builder_texture(s, i);
+    if (dm_sdk_ounce()) o->hdr = *(const win_hdr_t*)((const uint8_t*)b + WIN_BUILDER_HDR);
+    LOG("[nvn] WindowInitialize swap chain %d textures, interval %d, first %dx%d format %#x", o->ntex, o->interval,
+        o->ntex && o->tex[0] ? (int)CTX(o->tex[0])->d.width : 0, o->ntex && o->tex[0] ? (int)CTX(o->tex[0])->d.height : 0,
+        o->ntex && o->tex[0] ? CTX(o->tex[0])->d.format : 0);
+    return 1;
+}
+NVN(nvnWindowGetPresentInterval, int, const NVNwindow* w) { return ((const win_t*)w)->interval; }
+NVN(nvnWindowSetPresentInterval, void, NVNwindow* w, int v) {
+    if (((win_t*)w)->interval != v) LOG("[nvn] the game sets present interval %d -> %d", ((win_t*)w)->interval, v);
+    ((win_t*)w)->interval = v;
+}
+NVN(nvnWindowSetCrop, void, NVNwindow* w, int x, int y, int ww, int hh) {
+    win_t* o = (win_t*)w;
+    const int v[4] = {x, y, ww, hh};
+    memcpy(o->crop, v, sizeof v);
+}
+// Before any SetCrop it is the whole first texture, as NVN starts it.
+NVN(nvnWindowGetCrop, void, const NVNwindow* w, NVNrectangle* r) {
+    const win_t* o = (const win_t*)w;
+    if (o->crop[2] > 0 && o->crop[3] > 0) {
+        r->x = o->crop[0]; r->y = o->crop[1]; r->width = o->crop[2]; r->height = o->crop[3];
+        return;
+    }
+    r->x = r->y = 0;
+    r->width = o->ntex && o->tex[0] ? (int)CTX(o->tex[0])->d.width : 0;
+    r->height = o->ntex && o->tex[0] ? (int)CTX(o->tex[0])->d.height : 0;
+}
+// The images go round in order; an acquire's sync is reached when the window's last present is:
+// its queue's last submission and every fence before it (mtl_wait_acq), as on the console, where
+// the image is free once the frame after it is on screen (dotfiles-25x.4). The last submission of
+// any queue, as upstream's default mtl_acquire_fence, may be another queue's that waits for an
+// event the game signals only after this acquire's wait (Mario Kart World's second queue: a GPU
+// hang). Only the presenting queue's own fence was too early: the game then rewrote data the
+// other queues still read (device lost at the title).
+NVN(nvnWindowAcquireTexture, NVNwindowAcquireTextureResult, NVNwindow* w, NVNsync* s, int* idx) {
+    win_t* o = (win_t*)w;
+    *idx = o->ntex ? o->next++ % o->ntex : 0;
+    if (s) {
+        ((sync_t*)s)->fenced = 2;
+        ((sync_t*)s)->fence = o->last_pfence;
+    }
+    return NVN_WINDOW_ACQUIRE_TEXTURE_RESULT_SUCCESS;
+}
+NVN(nvnQueueAcquireTexture, NVNqueueAcquireTextureResult, NVNqueue* q, NVNwindow* w, int* idx) {
+    (void)q;
+    return h_nvnWindowAcquireTexture(w, NULL, idx) == NVN_WINDOW_ACQUIRE_TEXTURE_RESULT_SUCCESS
+               ? (NVNqueueAcquireTextureResult)0
+               : (NVNqueueAcquireTextureResult)1;
+}
+// The image goes to the replay's present queue (mtl_present: after every submission before it);
+// Lichii's present on this thread then shows it (nvn_direct_present_take, core/nvn_hook.cpp).
+NVN(nvnQueuePresentTexture, void, NVNqueue* q, NVNwindow* w, int idx) {
+    win_t* o = (win_t*)w;
+    o->presents++;
+    atomic_fetch_add(&g_frame, 1);
+    if (idx < 0 || idx >= o->ntex || !o->tex[idx]) return;
+    o->pfence[idx] = o->last_pfence = nvn_direct_present_queue_fence = ((const queue_t*)q)->last_fence;
+    const int interval = o->interval > 0 ? o->interval : 1;
+    const int has_crop = o->crop[2] > 0 && o->crop[3] > 0;
+    nvn_cap_present(CTX(o->tex[idx]), has_crop ? o->crop : NULL); // DM_NVN_CAPTURE
+    nvn_direct_present_note(mtl_present(CTX(o->tex[idx]), interval / 60.0, has_crop ? o->crop : NULL), (uint32_t)interval);
+}
+
+// ---------- Window state and HDR metadata ----------
+// What the getters return is what the driver returns (Mario Kart World's sdk, read statically):
+// the value set, or SetDefaults' value. The HDR metadata and the colour space are the game's
+// description of what it renders. Its driver hands a window's metadata to the system for the
+// display; Lichii's presenter takes no metadata, from either renderer (nx2:vi2's layer metadata is
+// not kept either): it labels a frame by its format and the HDR status the game was told
+// (Service::Nx2NativeImageColorSpace), so these are kept for the getters only.
+NVN_NOPROTO(nvnWindowBuilderGetDevice, NVNdevice*, const NVNwindowBuilder* b) { return WB(b)->dev; }
+NVN_NOPROTO(nvnWindowBuilderGetNumTextures, int, const NVNwindowBuilder* b) { return WB(b)->ntex; }
+NVN_NOPROTO(nvnWindowBuilderGetTexture, NVNtexture*, const NVNwindowBuilder* b, int i) {
+    return i >= 0 && i < WB(b)->ntex ? builder_texture(WB(b), i) : NULL;
+}
+NVN(nvnWindowBuilderGetNativeWindow, NVNnativeWindow, const NVNwindowBuilder* b) { return WB(b)->native; }
+NVN(nvnWindowBuilderGetPresentInterval, int, const NVNwindowBuilder* b) { return WB(b)->interval; }
+NVN_NOPROTO(nvnWindowBuilderGetNumActiveTextures, int, const NVNwindowBuilder* b) { return WB(b)->active; }
+NVN(nvnWindowGetNativeWindow, NVNnativeWindow, const NVNwindow* w) { return ((const win_t*)w)->native; }
+NVN_NOPROTO(nvnWindowGetNumTextures, int, const NVNwindow* w) { return ((const win_t*)w)->ntex; }
+NVN_NOPROTO(nvnWindowGetNumActiveTextures, int, const NVNwindow* w) { return ((const win_t*)w)->active; }
+NVN_NOPROTO(nvnWindowBuilderSetColorSpace, void, NVNwindowBuilder* b, int space) { WB(b)->color_space = space; }
+NVN_NOPROTO(nvnWindowBuilderGetColorSpace, int, const NVNwindowBuilder* b) { return WB(b)->color_space; }
+
+static void hdr_set_display(win_hdr_t* h, float rx, float ry, float gx, float gy, float bx, float by,
+                            float wx, float wy, float l0, float l1) {
+    const float v[10] = {rx, ry, gx, gy, bx, by, wx, wy, l0, l1};
+    memcpy(h->display, v, sizeof v);
+}
+static void hdr_get_display(const win_hdr_t* h, float* rx, float* ry, float* gx, float* gy, float* bx,
+                            float* by, float* wx, float* wy, float* l0, float* l1) {
+    float* const out[10] = {rx, ry, gx, gy, bx, by, wx, wy, l0, l1};
+    for (int i = 0; i < 10; i++) *out[i] = h->display[i];
+}
+NVN_NOPROTO(nvnWindowBuilderSetHdrDisplayMetadata, void, NVNwindowBuilder* b, float rx, float ry, float gx,
+            float gy, float bx, float by, float wx, float wy, float l0, float l1) {
+    hdr_set_display(WBHDR(b), rx, ry, gx, gy, bx, by, wx, wy, l0, l1);
+}
+NVN_NOPROTO(nvnWindowBuilderGetHdrDisplayMetadata, void, const NVNwindowBuilder* b, float* rx, float* ry,
+            float* gx, float* gy, float* bx, float* by, float* wx, float* wy, float* l0, float* l1) {
+    hdr_get_display(WBHDR(b), rx, ry, gx, gy, bx, by, wx, wy, l0, l1);
+}
+NVN_NOPROTO(nvnWindowBuilderSetHdrContentMetadata, void, NVNwindowBuilder* b, float l0, float l1) {
+    WBHDR(b)->content[0] = l0;
+    WBHDR(b)->content[1] = l1;
+}
+NVN_NOPROTO(nvnWindowBuilderGetHdrContentMetadata, void, const NVNwindowBuilder* b, float* l0, float* l1) {
+    *l0 = WBHDR(b)->content[0];
+    *l1 = WBHDR(b)->content[1];
+}
+NVN_NOPROTO(nvnWindowSetHdrDisplayMetadata, void, NVNwindow* w, float rx, float ry, float gx, float gy,
+            float bx, float by, float wx, float wy, float l0, float l1) {
+    hdr_set_display(&((win_t*)w)->hdr, rx, ry, gx, gy, bx, by, wx, wy, l0, l1);
+}
+NVN_NOPROTO(nvnWindowGetHdrDisplayMetadata, void, const NVNwindow* w, float* rx, float* ry, float* gx,
+            float* gy, float* bx, float* by, float* wx, float* wy, float* l0, float* l1) {
+    hdr_get_display(&((const win_t*)w)->hdr, rx, ry, gx, gy, bx, by, wx, wy, l0, l1);
+}
+NVN_NOPROTO(nvnWindowSetHdrContentMetadata, void, NVNwindow* w, float l0, float l1) {
+    ((win_t*)w)->hdr.content[0] = l0;
+    ((win_t*)w)->hdr.content[1] = l1;
+}
+NVN_NOPROTO(nvnWindowGetHdrContentMetadata, void, const NVNwindow* w, float* l0, float* l1) {
+    *l0 = ((const win_t*)w)->hdr.content[0];
+    *l1 = ((const win_t*)w)->hdr.content[1];
+}
diff --git a/src/video_core/nvn_direct/recompile_stamp.cmake b/src/video_core/nvn_direct/recompile_stamp.cmake
new file mode 100644
index 0000000000..bfd158ad47
--- /dev/null
+++ b/src/video_core/nvn_direct/recompile_stamp.cmake
@@ -0,0 +1,22 @@
+# SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+# cmake -DROOT=<src> -DLIST=<file of paths under ROOT, one a line> -DOUT=<header> -P recompile_stamp.cmake
+# The stamp of the recompiler's translations (nvn_recompile.c vk_recompiled.bin, dotfiles-25x.13):
+# a hash of the sources whose change can change a translation's SPIR-V or descriptors. The header
+# is rewritten only when the stamp changes, so a build that touches none of them keeps the file.
+file(STRINGS "${LIST}" paths)
+set(all "")
+foreach(path IN LISTS paths)
+    file(SHA256 "${ROOT}/${path}" hash)
+    string(APPEND all "${path} ${hash}\n")
+endforeach()
+string(SHA256 total "${all}")
+string(SUBSTRING "${total}" 0 16 stamp)
+set(text "#define NVN_RECOMPILE_STAMP 0x${stamp}ull\n")
+if(EXISTS "${OUT}")
+    file(READ "${OUT}" old)
+endif()
+if(NOT old STREQUAL text)
+    file(WRITE "${OUT}" "${text}")
+endif()
diff --git a/src/video_core/nvn_header_count.h b/src/video_core/nvn_header_count.h
new file mode 100644
index 0000000000..09a8827931
--- /dev/null
+++ b/src/video_core/nvn_header_count.h
@@ -0,0 +1,75 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+
+#include "common/common_types.h"
+
+namespace VideoCommon::NvnHeaderCount {
+
+/// EDEN_NX2_NVN_EMITTED (Core::NvnHook): the front counts the command headers it parses by
+/// (subchannel << 13 | method), to compare with the headers NVN's proc-table calls wrote.
+inline bool g_enabled{};
+/// Written by the GPU (front) thread only; read racily by the NVN hook's periodic dump.
+inline std::array<u64, 1u << 16> g_headers{};
+
+/// Headers the front parsed from words a proc-table call wrote (the same word, at the same host
+/// address), by key: what a table hook would see, replays of recorded memory included.
+inline std::array<u64, 1u << 16> g_table_headers{};
+
+/// Header words the hook decoded from table calls, by host address: open addressing, a word
+/// written again overwrites (command memory is reused every frame). Lock-free: the game's threads
+/// insert, the front looks up.
+constexpr u32 WrittenBits = 22;
+inline std::array<std::atomic<u64>, 1u << WrittenBits> g_written_keys{};
+inline std::array<std::atomic<u32>, 1u << WrittenBits> g_written_values{};
+
+inline u32 WrittenSlot(u64 key) {
+    return static_cast<u32>((key * 0x9E3779B97F4A7C15ULL) >> (64 - WrittenBits));
+}
+
+inline void NoteWritten(const void* host, u32 header) {
+    const u64 key = reinterpret_cast<std::uintptr_t>(host);
+    for (u32 i = WrittenSlot(key), probes = 0; probes < 64;
+         i = (i + 1) & ((1u << WrittenBits) - 1), ++probes) {
+        u64 current = g_written_keys[i].load(std::memory_order_acquire);
+        if (current == 0 &&
+            g_written_keys[i].compare_exchange_strong(current, key, std::memory_order_acq_rel)) {
+            current = key;
+        }
+        if (current == key) {
+            g_written_values[i].store(header, std::memory_order_release);
+            return;
+        }
+    }
+}
+
+[[nodiscard]] inline bool WasWritten(const void* host, u32 header) {
+    const u64 key = reinterpret_cast<std::uintptr_t>(host);
+    for (u32 i = WrittenSlot(key), probes = 0; probes < 64;
+         i = (i + 1) & ((1u << WrittenBits) - 1), ++probes) {
+        const u64 current = g_written_keys[i].load(std::memory_order_acquire);
+        if (current == key) {
+            return g_written_values[i].load(std::memory_order_acquire) == header;
+        }
+        if (current == 0) {
+            return false;
+        }
+    }
+    return false;
+}
+
+/// `host`: where the header word is in guest memory (null if unknown).
+inline void Count(u32 subchannel, u32 method, u32 header, const void* host) {
+    const u32 key = ((subchannel & 7) << 13) | (method & 0x1fff);
+    ++g_headers[key];
+    if (host != nullptr && WasWritten(host, header)) {
+        ++g_table_headers[key];
+    }
+}
+
+} // namespace VideoCommon::NvnHeaderCount
