+    static const std::array<NamedSwitch, 2> switches{{
+        {"LICHII_AB_NULL", &g_ab_null, 1'000'000},
+        {"LICHII_AB_BURN_US", &g_ab_burn_us, MaxBurnMicroseconds},
+    }};
+    return switches;
