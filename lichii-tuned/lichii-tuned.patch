+    for (uintptr_t x = lo; x < hi; x = ((x >> PBLK_SHIFT) + 1) << PBLK_SHIFT) if (atomic_load_explicit(&b[(x - g_pg_lo) >> PBLK_SHIFT], memory_order_acquire) >= g_snap.gen) return 0;
