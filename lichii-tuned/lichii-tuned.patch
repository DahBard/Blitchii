 namespace Vulkan {
 
+namespace PipelineBuildTrace {
+
+struct State {
+    explicit State(std::FILE* file_) : file{file_} {}
+
+    std::FILE* const file;
+    const std::chrono::steady_clock::time_point opened = std::chrono::steady_clock::now();
+    std::mutex mutex;
+    /// Set by CloseAtExit, which exit() runs before it closes the C streams: nothing writes to
+    /// the file from then on.
+    bool closed{};
+};
+
+/// The open trace, or null when EDEN_NX2_PIPELINE_BUILD_TRACE is unset or the file won't open.
+inline State* Get();
+
+/// Seconds since the trace opened. Read under the mutex, so the times in the file never go down.
+[[nodiscard]] inline double Seconds(const State& trace) {
+    return std::chrono::duration<double>(std::chrono::steady_clock::now() - trace.opened).count();
+}
+
+/// exit()'s hook: the trace's last line, EXIT, names the thread that called exit().
+inline void CloseAtExit() {
+    State* const trace = Get();
+    std::scoped_lock lock{trace->mutex};
+    std::fprintf(trace->file, "EXIT t=%.3f thread=%zu\n", Seconds(*trace),
+                 std::hash<std::thread::id>{}(std::this_thread::get_id()));
+    std::fflush(trace->file);
+    trace->closed = true;
+}
+
+/// The sampler thread: a MEM line at once and then every second, until exit.
+inline void SampleMemory(State* trace) {
+    try {
+        Common::SetCurrentThreadName("PipelineTrace");
+        for (;;) {
+            const Common::ProcessMemoryUsage usage = Common::GetProcessMemoryUsage();
+            {
+                std::scoped_lock lock{trace->mutex};
+                if (trace->closed) {
+                    return;
+                }
+                std::fprintf(trace->file, "MEM t=%.3f commit=%llu ws=%llu system=%llu/%llu\n",
+                             Seconds(*trace), static_cast<unsigned long long>(usage.commit >> 20),
+                             static_cast<unsigned long long>(usage.working_set >> 20),
+                             static_cast<unsigned long long>(usage.system_commit >> 20),
+                             static_cast<unsigned long long>(usage.system_commit_limit >> 20));
+                std::fflush(trace->file);
+            }
+            std::this_thread::sleep_for(std::chrono::seconds{1});
+        }
+    } catch (...) {
+        // The BEGIN and END lines go on without the memory.
+    }
+}
+
+inline State* Open() {
+    const char* const path = std::getenv("EDEN_NX2_PIPELINE_BUILD_TRACE");
+    std::FILE* const file = path != nullptr && *path != '\0' ? std::fopen(path, "a") : nullptr;
+    if (file == nullptr) {
+        return nullptr;
+    }
+    // Never destroyed: builds and the sampler can still run while the process exits.
+    State* const trace = new (std::nothrow) State{file};
+    if (trace == nullptr) {
+        std::fclose(file);
+        return nullptr;
+    }
+    // The sampler runs only with the exit hook. Detached, it delays no exit: the process ends it.
+    if (std::atexit(CloseAtExit) == 0) {
+        try {
+            std::thread{SampleMemory, trace}.detach();
+        } catch (...) {
+            // No MEM lines then.
+        }
+    }
+    return trace;
+}
+
+inline State* Get() {
+    static State* const trace = Open();
+    return trace;
+}
+
