+NVN_NOPROTO(nvnQueueBuilderGetRayTracingMemorySize, NVNboolean, const NVNqueueBuilder *b, int *n) { *n = ((const queue_builder_t *)b)->sz[QB_RT]; return ((const queue_builder_t *)b)->set[QB_RT]; }
