+bool Fsr4Upscaler::Prepare(VkExtent2D render_size, VkExtent2D upscale_size, bool depth_inverted,
+                           bool hdr, bool compact_output) {
+    if (failed || output_image) {
+        return false;
+    }
+    // Nothing recorded uses FSR yet: unlike Upscale's path, this needs no Finish.
+    const auto start = std::chrono::steady_clock::now();
+    const VkFormat format = OutputFormat(device, context->provider, compact_output && !slim_off);
+    CreateOutput(upscale_size, format);
+    if (!CreateContext(render_size, upscale_size, depth_inverted, hdr)) {
+        if (format == OUTPUT_FORMAT) {
+            failed = true;
+            return false;
+        }
+        TurnSlimOff("the context failed with them");
+        recreate_reason = "LICHII_FSR_SLIM's formats turned off";
+        return false;
+    }
+    render_extent = render_size;
+    upscale_extent = upscale_size;
+    depth_inverted_input = depth_inverted;
+    hdr_input = hdr;
+    LOG_INFO(Render_Vulkan, "AMD FSR: output and context made in {:.1f} ms (prepared early){}",
+             MsSince(start),
+             format == COMPACT_OUTPUT_FORMAT ? ", A2B10G10R10 output (LICHII_FSR_SLIM c)" : "");
+    return true;
+}
