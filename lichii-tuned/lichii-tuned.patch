+                              times and the heap and clock traces in the log
+                              (EDEN_NX2_GPU_PROFILE=1, EDEN_DKB_FRAME_TRACE=1,
+                              EDEN_NX2_MME_DMA_STATS=1, EDEN_NX2_HEAP_TRACE=1,
+                              EDEN_NX2_CLOCK_TRACE=1; since r64 EDEN_NX2_GPU_CLOCK_PROBE=1;
