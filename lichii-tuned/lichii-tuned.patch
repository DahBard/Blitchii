+/// For a traced guest call, made before placeholder_mutex is taken: its wait.
+struct PlaceholderLockWait {
+    explicit PlaceholderLockWait(HostMemory::CallTrace* trace_)
+        : trace{trace_}, start{trace_ != nullptr ? TraceNowNs() : 0} {}
+
+    HostMemory::CallTrace* const trace;
+    const u64 start;
+};
+
+/// Made once placeholder_mutex is taken, so that it ends before the lock is released: the wait,
+/// then how long the lock is held, on the clock and on this thread's CPU (QueryThreadCycleTime
+/// counts TSC ticks on CPUs with an invariant TSC, as in clock_trace.cpp). A hold spent all on
+/// the CPU reads a little under 100%.
+class PlaceholderLockHold {
+public:
+    explicit PlaceholderLockHold(const PlaceholderLockWait& wait) : trace{wait.trace} {
+        if (trace == nullptr) {
+            return;
+        }
+        const u64 locked_ns = TraceNowNs();
+        trace->lock_wait_ns += locked_ns - wait.start;
+        start_tsc = TraceTsc();
+        ULONG64 cycles = 0;
+        QueryThreadCycleTime(GetCurrentThread(), &cycles);
+        start_cycles = cycles;
+        start_ns = TraceNowNs();
+        trace->trace_ns += start_ns - locked_ns;
+    }
+    ~PlaceholderLockHold() {
+        if (trace == nullptr) {
+            return;
+        }
+        const u64 end_ns = TraceNowNs();
+        ULONG64 cycles = 0;
+        QueryThreadCycleTime(GetCurrentThread(), &cycles);
+        const u64 end_tsc = TraceTsc();
+        trace->held_ns += end_ns - start_ns;
+        trace->held_tsc += end_tsc - start_tsc;
+        trace->on_cpu_cycles += cycles - start_cycles;
+        trace->trace_ns += TraceNowNs() - end_ns;
+    }
+    PlaceholderLockHold(const PlaceholderLockHold&) = delete;
+    PlaceholderLockHold& operator=(const PlaceholderLockHold&) = delete;
+
+private:
+    HostMemory::CallTrace* const trace;
+    u64 start_ns{};
+    u64 start_tsc{};
+    u64 start_cycles{};
+};
