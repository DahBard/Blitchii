+
+void StagingBufferPool::CreateUploadRing(u64 mib) {
+    // Host memory, as the staging buffers it stands in for: the 256 MiB device-local window
+    // without Resizable BAR holds the stream buffer.
+    const size_t size = static_cast<size_t>(std::clamp<u64>(mib, 16, 2048)) << 20;
+    VkBufferCreateInfo ring_ci{
+        .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+        .pNext = nullptr,
+        .flags = 0,
+        .size = size + STREAM_BUFFER_TAIL,
+        // CreateStagingBuffer's usage.
+        .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT |
+                 VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT |
+                 VK_BUFFER_USAGE_INDEX_BUFFER_BIT | VK_BUFFER_USAGE_VERTEX_BUFFER_BIT |
+                 VK_BUFFER_USAGE_INDIRECT_BUFFER_BIT,
+        .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+        .queueFamilyIndexCount = 0,
+        .pQueueFamilyIndices = nullptr,
+    };
+    if (device.IsExtTransformFeedbackSupported()) {
+        ring_ci.usage |= VK_BUFFER_USAGE_TRANSFORM_FEEDBACK_BUFFER_BIT_EXT;
+    }
+    if (device.IsBufferDeviceAddressSupported()) {
+        ring_ci.usage |= VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT;
+    }
+    const auto start = std::chrono::steady_clock::now();
+    vk::Buffer buffer;
+    try {
+        buffer = memory_allocator.CreateBuffer(ring_ci, MemoryUsage::Upload);
+    } catch (const vk::Exception& e) {
+        LOG_WARNING(Render_Vulkan, "EDEN_NX2_STAGING_RING_MIB={}: no memory for the ring ({}); off",
+                    mib, e.what());
+        return;
+    }
+    if (buffer.Mapped().size() < size || !buffer.IsHostCoherent()) {
+        LOG_WARNING(Render_Vulkan,
+                    "EDEN_NX2_STAGING_RING_MIB={}: the ring's memory is not host-coherent; off",
+                    mib);
+        return;
+    }
+    // Every page written once now, so that no upload at a load takes the first-touch faults.
+    std::memset(buffer.Mapped().data(), 0, buffer.Mapped().size());
+    const double ms =
+        std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+    const u32 memory_type = buffer.Location().memory_type;
+    const bool device_local =
+        (device.GetPhysical().GetMemoryProperties().memoryProperties.memoryTypes[memory_type]
+             .propertyFlags &
+         VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) != 0;
+    const VkDeviceAddress address = device.IsBufferDeviceAddressSupported()
+                                        ? device.GetLogical().GetBufferDeviceAddress(*buffer)
+                                        : VkDeviceAddress{};
+    const std::span<u8> mapped = buffer.Mapped();
+    upload_ring.emplace(UploadRing{
+        .buffer = std::move(buffer),
+        .address = address,
+        .mapped = mapped,
+        .regions = StagingRingRegions{size},
+    });
+    DeviceMemory::g_staging_ring_mib.store(size >> 20, std::memory_order_relaxed);
+    LOG_INFO(Render_Vulkan,
+             "Staging ring (EDEN_NX2_STAGING_RING_MIB): {} MiB in memory type {} ({}), {} regions "
+             "of {} MiB, made and written in {:.1f} ms",
+             size >> 20, memory_type, device_local ? "device-local" : "host memory",
+             StagingRingRegions::NUM_REGIONS, (size / StagingRingRegions::NUM_REGIONS) >> 20, ms);
+}
+
+std::optional<StagingBufferRef> StagingBufferPool::TryGetRingBuffer(size_t size) {
+    UploadRing& ring = *upload_ring;
+    MasterSemaphore& semaphore = scheduler.GetMasterSemaphore();
+    const u64 tick = scheduler.CurrentTick();
+    std::optional<size_t> offset = ring.regions.Take(size, tick, semaphore.KnownGpuTick());
+    const bool fits = size != 0 && size <= ring.regions.Size();
+    if (!offset && fits) {
+        // The GPU may be further along than last seen: one look before a new buffer is made.
+        semaphore.Refresh();
+        offset = ring.regions.Take(size, tick, semaphore.KnownGpuTick());
+    }
+    if (!offset) {
+        // Those refused next to an upload over half the ring are what taking it cost.
+        DeviceMemory::Stats::CountRingRefusal(
+            fits && ring.regions.LargeUploadInFlight(semaphore.KnownGpuTick()));
+        return std::nullopt;
+    }
+    DeviceMemory::Stats::CountRingUpload(size, size > ring.regions.Size() / 2);
+    return StagingBufferRef{
+        .buffer = *ring.buffer,
+        .device_address = ring.address,
+        .offset = static_cast<VkDeviceSize>(*offset),
+        .mapped_span = ring.mapped.subspan(*offset, size),
+        .usage = MemoryUsage::Upload,
+        .log2_level{},
+        .index{},
+    };
 }
 
