+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <catch2/catch_test_macros.hpp>
+
+#include "video_core/renderer_vulkan/vk_ocarina_camera_motion.h"
+
+namespace {
+
+using Vulkan::OcarinaFsrSlimSwitch;
+using Vulkan::ParseOcarinaFsrEarlyContext;
+using Vulkan::ParseOcarinaFsrSlim;
+
+bool Is(const OcarinaFsrSlimSwitch& slim, bool b, bool c, bool d) {
+    return slim.merged_reference == b && slim.compact_output == c && slim.guest_color == d;
+}
+
+} // namespace
+
+TEST_CASE("Ocarina's FSR 4 context is built at the title screen unless switched off",
+          "[video_core][vulkan][ocarina]") {
+    REQUIRE(ParseOcarinaFsrEarlyContext(nullptr));
+    REQUIRE(ParseOcarinaFsrEarlyContext(""));
+    REQUIRE(ParseOcarinaFsrEarlyContext("1"));
+    REQUIRE_FALSE(ParseOcarinaFsrEarlyContext("0"));
+}
+
+TEST_CASE("LICHII_FSR_SLIM is c unless set, and a set value's letters replace it",
+          "[video_core][vulkan][ocarina]") {
+    REQUIRE(Is(ParseOcarinaFsrSlim(nullptr), false, true, false));
+    REQUIRE(Is(ParseOcarinaFsrSlim(""), false, true, false));
+    // A value with none of b, c and d turns them all off.
+    REQUIRE(Is(ParseOcarinaFsrSlim("0"), false, false, false));
+    REQUIRE(Is(ParseOcarinaFsrSlim("off"), false, false, false));
+    REQUIRE(Is(ParseOcarinaFsrSlim("bd"), true, false, true));
+    REQUIRE(Is(ParseOcarinaFsrSlim("c"), false, true, false));
+    REQUIRE(Is(ParseOcarinaFsrSlim("BCD"), true, true, true));
+}
