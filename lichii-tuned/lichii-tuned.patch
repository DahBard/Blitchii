+#ifdef _WIN32
+void* ImportTestMap(int kind, u64 size, u64 align, u64* length) {
+    *length = 0;
+    const State* const state = Get();
+    if (state == nullptr || state->process == nullptr || state->host_memory == nullptr ||
+        (kind != 0 && kind != 1 && kind != 3)) {
+        return nullptr;
+    }
+    // Guest memory mapped since the load, in one run of the backing memory: the modules' first
+    // pages are.
+    auto& memory = state->process->GetMemory();
+    u8* const backing_base = state->host_memory->BackingBasePointer();
+    constexpr u64 PageSize = Core::Memory::LICHII_PAGESIZE;
+    for (const auto& [base, name] : state->modules) {
+        for (u64 address = base; address < base + (u64{4} << 20); address += PageSize) {
+            const u8* const first = memory.GetPointerSilent(address);
+            if (first == nullptr) {
+                break;
+            }
+            const size_t offset = static_cast<size_t>(first - backing_base);
+            bool run = offset % align == 0 && offset + size <= state->host_memory->BackingSize();
+            for (u64 page = PageSize; run && page < size; page += PageSize) {
+                run = memory.GetPointerSilent(address + page) == first + page;
+            }
+            if (!run) {
+                continue;
+            }
+            if (kind == 1) {
+                *length = size;
+                return backing_base + offset;
+            }
+            const std::array<Common::HostMemory::BackingRun, 1> runs{
+                {{.view_offset = 0, .host_offset = offset, .length = size}}};
+            const u64 view_size = kind == 3 ? size : size * 2;
+            u8* const view = state->host_memory->MapBackingView(view_size, runs);
+            *length = view != nullptr ? view_size : 0;
+            return view;
+        }
+    }
+    LOG_WARNING(Core, "NVN direct: no run of {:#x} bytes of guest memory for the import self-test",
+                size);
+    return nullptr;
+}
+
+void ImportTestFree(int kind, void* pointer, u64 length) {
+    if (const State* const state = Get(); (kind == 0 || kind == 3) && state != nullptr) {
+        state->host_memory->UnmapBackingView(static_cast<u8*>(pointer), length);
+    }
+}
+#endif
