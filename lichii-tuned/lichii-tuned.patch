+[[nodiscard]] inline bool StaleMarkerCovers(const ImageBase& image) {
+    // MarkStale retains only whole pages; partial edge pages could upload obsolete guest bytes.
+    constexpr u64 page_mask = StalePages::PAGE_SIZE - 1;
