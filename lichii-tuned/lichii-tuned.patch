+    const size_t band_bytes =
+        Common::DivCeil(stride, size_t{GOB_SIZE_X}) * (size_t{GOB_SIZE} << block_height);
+    const u32 bands_per_chunk =
+        (std::max)(static_cast<u32>(ChunkBytes / (pitch * band_rows)), 1U);
