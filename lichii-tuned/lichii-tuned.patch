+namespace {
+// EDEN_NX2_IPC_STATS=1: about once a second, the commands and services called most and those with
+// the most handler time, and the longest calls over 2 ms with their client thread (t<id> as in the
+// guest thread lines), so a hitch's second shows whether a service call went with it.
+using IpcClock = std::chrono::steady_clock;
+
+bool IpcStatsEnabled() {
+    static const bool enabled = [] {
+        const char* const value = std::getenv("EDEN_NX2_IPC_STATS");
+        return value != nullptr && value[0] == '1';
+    }();
+    return enabled;
+}
+
+struct IpcCommand {
+    const char* service;
+    const char* name;
+    u32 command;
+    bool tipc;
+    bool operator==(const IpcCommand&) const = default;
+};
+
+struct IpcCommandHash {
+    size_t operator()(const IpcCommand& key) const noexcept {
+        return std::hash<const void*>{}(key.service) ^ (std::hash<const void*>{}(key.name) << 1) ^
+               (static_cast<size_t>(key.command) << 8) ^ (key.tipc ? 1 : 0);
+    }
+};
+
+struct IpcTimes {
+    u64 calls{};
+    u64 ns{};
+    u64 max_ns{};
+};
