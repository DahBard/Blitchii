diff --git a/src/tests/video_core/precache_journal.cpp b/src/tests/video_core/precache_journal.cpp
new file mode 100644
index 0000000000..c7723210c0
--- /dev/null
+++ b/src/tests/video_core/precache_journal.cpp
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <filesystem>
+#include <random>
+#include <string>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include "video_core/renderer_vulkan/precache_journal.h"
+
+namespace {
+struct TempDir {
+    TempDir() {
+        path = std::filesystem::temp_directory_path() /
+               ("precache-journal-" + std::to_string(std::random_device{}()));
+        std::filesystem::create_directories(path);
+    }
+    ~TempDir() {
+        std::error_code ec;
+        std::filesystem::remove_all(path, ec);
+    }
+    std::filesystem::path path;
+};
+} // Anonymous namespace
+
+TEST_CASE("A build left in flight is skipped by the next precache", "[video_core][precache]") {
+    TempDir temp;
+    const auto base = temp.path / "precache-jobs";
+    {
+        Vulkan::PrecacheJournal journal{base, "driver 1", 4, "pipeline"};
+        REQUIRE_FALSE(journal.Poisoned(42));
+        journal.Begin(2, 42); // the process ends here (a driver crash): no End
+        journal.Begin(1, 7);
+        journal.End(1);
+    }
+    Vulkan::PrecacheJournal next{base, "driver 1", 4, "pipeline"};
+    REQUIRE(next.Poisoned(42));
+    REQUIRE_FALSE(next.Poisoned(7));
+    REQUIRE(next.PoisonedCount() == 1);
+    // Still skipped at the start after (the poison list is kept, the in-flight slots reset).
+    Vulkan::PrecacheJournal third{base, "driver 1", 4, "pipeline"};
+    REQUIRE(third.Poisoned(42));
+}
+
+TEST_CASE("A new driver tries the skipped builds again", "[video_core][precache]") {
+    TempDir temp;
+    const auto base = temp.path / "warm-graphics.bin";
+    {
+        Vulkan::PrecacheJournal journal{base, "driver 1", 2, "graphics program"};
+        journal.Begin(0, 9);
+    }
+    REQUIRE(Vulkan::PrecacheJournal{base, "driver 1", 2, "graphics program"}.Poisoned(9));
+    REQUIRE_FALSE(Vulkan::PrecacheJournal{base, "driver 2", 2, "graphics program"}.Poisoned(9));
+}
+
+TEST_CASE("Builds in flight with one driver are not skipped by the next",
+          "[video_core][precache]") {
+    TempDir temp;
+    const auto base = temp.path / "precache-jobs";
+    {
+        Vulkan::PrecacheJournal journal{base, "driver 1", 2, "pipeline"};
+        journal.Begin(0, 5); // ended by a kill or crash, then the driver is updated
+    }
+    // Recovered first by the new driver: its in-flight ids belong to driver 1.
+    Vulkan::PrecacheJournal updated{base, "driver 2", 2, "pipeline"};
+    REQUIRE_FALSE(updated.Poisoned(5));
+    REQUIRE(updated.PoisonedCount() == 0);
+    // Nor are they saved under driver 2 for later starts.
+    REQUIRE_FALSE(Vulkan::PrecacheJournal{base, "driver 2", 2, "pipeline"}.Poisoned(5));
+}
+
+TEST_CASE("In-flight ids survive a poison list that cannot be saved", "[video_core][precache]") {
+    TempDir temp;
+    const auto base = temp.path / "precache-jobs";
+    {
+        Vulkan::PrecacheJournal journal{base, "driver 1", 2, "pipeline"};
+        journal.Begin(1, 77);
+    }
+    auto poison = base;
+    poison += ".poison";
+    std::filesystem::remove(poison);
+    std::filesystem::create_directory(poison); // the new list cannot replace it
+    {
+        Vulkan::PrecacheJournal blocked{base, "driver 1", 2, "pipeline"};
+        REQUIRE(blocked.Poisoned(77)); // still skipped by this precache
+        blocked.Begin(0, 78);          // the journal is off: not recorded
+    }
+    std::filesystem::remove(poison);
+    // The in-flight file was not reset, so the next start still names 77.
+    Vulkan::PrecacheJournal next{base, "driver 1", 2, "pipeline"};
+    REQUIRE(next.Poisoned(77));
+    REQUIRE_FALSE(next.Poisoned(78));
+    auto tmp = poison;
+    tmp += ".tmp";
+    REQUIRE_FALSE(std::filesystem::exists(tmp));
+}
diff --git a/src/tests/video_core/stale_targets.cpp b/src/tests/video_core/stale_targets.cpp
new file mode 100644
index 0000000000..742d8a52e3
--- /dev/null
+++ b/src/tests/video_core/stale_targets.cpp
@@ -0,0 +1,81 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <initializer_list>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include "video_core/texture_cache/stale_targets.h"
+
+namespace {
+
+using VideoCommon::GpuWrittenRenderTarget;
+using VideoCommon::ImageBase;
+using VideoCommon::ImageFlagBits;
+using VideoCommon::NullImageParams;
+using VideoCommon::StaleMarkerCovers;
+using VideoCommon::StalePages;
+
+ImageBase Target() {
+    ImageBase image{NullImageParams{}};
+    image.flags = ImageFlagBits::RenderTargetOrigin | ImageFlagBits::GpuModified;
+    image.cpu_addr = 0x10000;
+    image.guest_size_bytes = 4 * StalePages::PAGE_SIZE;
+    return image;
+}
+
+} // namespace
+
+TEST_CASE("Stale targets require render-target origin and GPU contents",
+          "[video_core][texture_cache]") {
+    ImageBase image = Target();
+    REQUIRE(GpuWrittenRenderTarget(image));
+    image.flags &= ~ImageFlagBits::RenderTargetOrigin;
+    CHECK_FALSE(GpuWrittenRenderTarget(image));
+    image = Target();
+    image.flags &= ~ImageFlagBits::GpuModified;
+    CHECK_FALSE(GpuWrittenRenderTarget(image));
+
+    for (const ImageFlagBits flag :
+         {ImageFlagBits::CpuModified, ImageFlagBits::Sparse, ImageFlagBits::SparseLayers,
+          ImageFlagBits::SparseTiles, ImageFlagBits::Unbacked, ImageFlagBits::Rescaled,
+          ImageFlagBits::Remapped, ImageFlagBits::TrimmedLevels}) {
+        image = Target();
+        image.flags |= flag;
+        CHECK_FALSE(GpuWrittenRenderTarget(image));
+    }
+    image = Target();
+    image.info.is_sparse = true;
+    CHECK_FALSE(GpuWrittenRenderTarget(image));
+    image = Target();
+    image.info.num_samples = 4;
+    CHECK_FALSE(GpuWrittenRenderTarget(image));
+    image = Target();
+    image.has_scaled = true;
+    CHECK_FALSE(GpuWrittenRenderTarget(image));
+}
+
+TEST_CASE("Stale target eligibility guarantees complete page markers",
+          "[video_core][texture_cache]") {
+    ImageBase image = Target();
+    REQUIRE(StaleMarkerCovers(image));
+    StalePages pages;
+    pages.Mark(image.cpu_addr, image.guest_size_bytes, [](DAddr, u64) {});
+    REQUIRE(pages.IsAll(image.cpu_addr, image.guest_size_bytes));
+    pages.Clear(image.cpu_addr + 1, 1, [](DAddr, u64) {});
+    CHECK_FALSE(pages.IsAll(image.cpu_addr, image.guest_size_bytes));
+
+    // Sub-page and unaligned allocations must stay: marking cannot cover their edge pages.
+    for (const u32 size : {1536U, 4096U}) {
+        for (const u64 offset : {0ULL, 512ULL}) {
+            image = Target();
+            image.cpu_addr += offset;
+            image.guest_size_bytes = size;
+            StalePages marked;
+            marked.Mark(image.cpu_addr, image.guest_size_bytes, [](DAddr, u64) {});
+            CHECK(StaleMarkerCovers(image) == marked.IsAll(image.cpu_addr, image.guest_size_bytes));
+        }
+    }
+    image.guest_size_bytes = 0;
+    CHECK_FALSE(StaleMarkerCovers(image));
+}
diff --git a/src/tests/video_core/turing_macro_effects.cpp b/src/tests/video_core/turing_macro_effects.cpp
index 8998305e27..41e107cac4 100644
--- a/src/tests/video_core/turing_macro_effects.cpp
+++ b/src/tests/video_core/turing_macro_effects.cpp
@@ -4,6 +4,7 @@
 #include <algorithm>
 #include <array>
 #include <initializer_list>
+#include <optional>
 #include <random>
 #include <span>
 #include <vector>
@@ -11,6 +12,7 @@
 
 #include "common/common_types.h"
 #include "video_core/macro_turing.h"
+#include "video_core/nx2_list_indirect.h"
 #include "video_core/nx2_list_macro_trace.h"
 
 namespace {
@@ -268,3 +270,123 @@ TEST_CASE("Turing macro effects cover every write Execute makes on random code",
         }
     }
 }
+
+namespace {
+
+namespace List = Tegra::Nx2ListIndirect;
+
+/// A compute macro call as List::ComputeFront sees it (kepler_compute.cpp's ListCallContext), on
+/// an engine whose registers take the call's emits; `released` gets the slots the front gives
+/// back to the back.
+struct ListCall {
+    std::span<const u32> code;
+    u64 generation;
+    u32 start;
+    std::vector<u32>& params;
+    std::span<u32> data_ram;
+    std::span<const u32> registers;
+    List::UploadState upload;
+    std::span<u32> engine_registers;
+    std::vector<u32>& released;
+
+    [[nodiscard]] std::optional<u64> DeviceWord(u64) const {
+        return std::nullopt;
+    }
+    void Emit(u32 method, u32 value) const {
+        engine_registers[method] = value;
+    }
+    void SendOwed(u64, u32) const {}
+    void Release(u32 slot) const {
+        released.push_back(slot);
+    }
+    void ReadSlots(std::span<const u32>, std::span<u32> words) const {
+        std::ranges::fill(words, 7U);
+    }
+    void SetRegister(u32 method, u32 value) const {
+        engine_registers[method] = value;
+    }
+};
+
+} // Anonymous namespace
+
+TEST_CASE("List words: a run that moves a slot's last holder keeps the slot held",
+          "[video_core][macro]") {
+    constexpr u32 slot = 5;
+    constexpr u32 a = 0x10;
+    constexpr u32 b = 0x20;
+    const u32 word = List::Placeholder(slot, 0);
+    std::array<u32, 0xc00> data_ram{};
+    std::array<u32, 0x1000> registers{};
+    std::vector<u32> params;
+    std::vector<u32> released;
+    List::DataRamWords channel{data_ram.data(), {}, {}};
+    List::ComputeFront front;
+    bool concretized{};
+    List::Reason reason{};
+    const auto call = [&](const std::vector<u32>& code, u64 generation) {
+        return ListCall{code, generation, 0, params, data_ram, registers, {}, registers, released};
+    };
+    // DREAD of data RAM word `address` into r0; DWRITE of r0 (`source` 0), the parameter (28)
+    // or 0 (24) to one.
+    const auto dread = [](u32 address) {
+        return Mme{.op = {30, 0}, .dst = {0, 24}, .src_a = {25, 24}, .imm = {address, 0}};
+    };
+    const auto dwrite = [](u32 address, u32 source, bool end) {
+        return Mme{.end = end,
+                   .op = {31, 0},
+                   .src_a = {25, 24},
+                   .src_b = {source, 24},
+                   .imm = {address, 0}};
+    };
+    // A call whose parameter is the list's word stores it at A.
+    const auto store = Code(std::vector<Mme>{dwrite(a, 28, true), Mme{}});
+    auto stores = call(store, 1);
+    REQUIRE(front.PrepareCall(stores, channel, slot, 1));
+    params = {word};
+    REQUIRE(front.Run(stores, channel, concretized, reason));
+    REQUIRE(data_ram[a] == word);
+    REQUIRE(List::FrontHolds()[slot] == 1);
+
+    // Loads A, clears it, stores the word at B: the clear drops A's hold before B takes one.
+    const auto move =
+        Code(std::vector<Mme>{dread(a), dwrite(a, 24, false), dwrite(b, 0, true), Mme{}});
+    params.clear();
+    auto moves = call(move, 2);
+    REQUIRE(front.Run(moves, channel, concretized, reason));
+    REQUIRE(data_ram[a] == 0);
+    REQUIRE(data_ram[b] == word);
+    CHECK(released.empty());
+    CHECK(List::FrontHolds()[slot] == 1);
+
+    // Loads B, emits the word as a QMD grid word, then clears B: the run's stores are applied
+    // before its emits.
+    const Mme emit_r0{.src_a = {0, 24},
+                      .imm = {List::InlineQmdGridFirst, 0},
+                      .out_method = {5, 0},
+                      .out_emit = {1, 0}};
+    const auto consume = Code(std::vector<Mme>{dread(b), emit_r0, dwrite(b, 24, true), Mme{}});
+    auto consumes = call(consume, 3);
+    REQUIRE(front.Run(consumes, channel, concretized, reason));
+    REQUIRE(data_ram[b] == 0);
+    REQUIRE(registers[List::InlineQmdGridFirst] == word);
+    CHECK(released.empty());
+    CHECK(List::FrontHolds()[slot] == 1);
+
+    // The words read back: the front holds the slot no more and gives it back, once.
+    front.ConcretizeAll(consumes, channel);
+    CHECK(registers[List::InlineQmdGridFirst] == 7U);
+    CHECK(released == std::vector<u32>{slot});
+    CHECK(List::FrontHolds()[slot] == 0);
+}
+
+TEST_CASE("List words: a placeholder names a slot the back has", "[video_core][macro]") {
+    CHECK(List::IsPlaceholder(List::Placeholder(0, 0)));
+    CHECK(List::IsPlaceholder(List::Placeholder(List::SlotCount - 1, 2)));
+    CHECK(List::GridSlot(List::Placeholder(9, 0), List::Placeholder(9, 1),
+                         List::Placeholder(9, 2)) == 9U);
+    // A grid the guest wrote with the magic and a slot past the last.
+    const u32 past = List::Placeholder(List::SlotCount, 0);
+    CHECK_FALSE(List::IsPlaceholder(past));
+    CHECK_FALSE(List::IsPlaceholder(List::PlaceholderMagic | 0xFFFCU));
+    CHECK_FALSE(List::GridSlot(past, past + 1, past + 2).has_value());
+}
