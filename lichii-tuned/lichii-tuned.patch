@@ -0,0 +1,89 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <optional>
+
+#include "common/alignment.h"
+#include "common/common_types.h"
+
+namespace Vulkan {
+
+/// Where the staging ring (EDEN_NX2_STAGING_RING_MIB) puts each upload. Like the stream buffer,
+/// each of its regions is reused once the GPU is past the tick it was last handed out in.
+class StagingRingRegions {
+public:
+    static constexpr size_t NUM_REGIONS = 16;
+    static constexpr size_t ALIGNMENT = 256;
+
+    /// `size_` is a multiple of NUM_REGIONS * ALIGNMENT.
+    explicit StagingRingRegions(size_t size_) : size{size_}, region_size{size_ / NUM_REGIONS} {}
+
+    /// The offset of `bytes` handed out in `tick`, or nothing while the GPU, last seen at
+    /// `gpu_tick`, may still read a region they need. Up to half the ring goes wherever its
+    /// regions are free; more, up to all of it, only when every region is: then no other upload
+    /// of its tick is in the ring yet.
+    [[nodiscard]] std::optional<size_t> Take(size_t bytes, u64 tick, u64 gpu_tick) {
+        if (bytes == 0 || bytes > size || (bytes > size / 2 && !IsFree(gpu_tick))) {
+            return std::nullopt;
+        }
+        // A region is checked when a lap first enters it: the GPU must be past its last use in
+        // the lap before. The regions the lap is already in are this lap's.
+        size_t offset = Common::AlignUp(head, ALIGNMENT);
+        size_t first_new = head == 0 ? 0 : (head - 1) / region_size + 1;
+        if (offset + bytes > size) {
+            offset = 0;
+            first_new = 0;
+        }
+        const size_t last = (offset + bytes - 1) / region_size;
+        for (size_t region = first_new; region <= last; ++region) {
+            if (ticks[region] > gpu_tick) {
+                return std::nullopt;
+            }
+        }
+        for (size_t region = offset / region_size; region <= last; ++region) {
+            ticks[region] = tick;
+        }
+        head = offset + bytes;
+        if (bytes > size / 2) {
+            large_tick = tick;
+        }
+        return offset;
+    }
+
+    /// Whether the GPU, last seen at `gpu_tick`, may still read an upload over half the ring: the
+    /// ring refuses what does not fit next to it until then.
+    [[nodiscard]] bool LargeUploadInFlight(u64 gpu_tick) const {
+        return large_tick > gpu_tick;
+    }
+
+    /// Whether the GPU, last seen at `gpu_tick`, is past every region's last use.
+    [[nodiscard]] bool IsFree(u64 gpu_tick) const {
+        for (const u64 region_tick : ticks) {
+            if (region_tick > gpu_tick) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    [[nodiscard]] size_t Size() const {
+        return size;
+    }
+
+    [[nodiscard]] size_t RegionSize() const {
+        return region_size;
+    }
+
+private:
+    size_t size;
+    size_t region_size;
+    size_t head{}; ///< The next free byte of this lap
+    std::array<u64, NUM_REGIONS> ticks{};
+    u64 large_tick{}; ///< The tick of the last upload over half the ring
+};
+
+} // namespace Vulkan
