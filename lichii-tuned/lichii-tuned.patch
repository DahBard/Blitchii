+    REQUIRE(owners.entries.at("LICHII_AB_NULL").original == null_before);
+    (void)HandleSwitch(owners, 2, {{"name", "EDEN_NX2_EXP12"}, {"value", slot_before + 5}}, 13);
+
+    const json listed = HandleSwitch(owners, 1, json::object(), 14);
+    REQUIRE(listed["switches"]["LICHII_AB_NULL"] == null_before + 2);
+    REQUIRE(listed["switches"].contains("LICHII_AB_BURN_US"));
+    REQUIRE(listed["switches"]["EDEN_NX2_EXP12"] == slot_before + 5);
+    REQUIRE(listed["boot_only"].size() == Control::BootOnlyExperiments.size());
+    REQUIRE(listed["changed"]["EDEN_NX2_EXP12"]["client"] == 2);
+
+    const auto refused = [&owners](const json& params, std::string_view expected) {
+        try {
+            (void)HandleSwitch(owners, 1, params, 15);
+            FAIL("accepted " << params.dump());
+        } catch (const std::runtime_error& error) {
+            REQUIRE(std::string_view{error.what()}.find(expected) != std::string_view::npos);
+        }
+    };
+    refused({{"name", "EDEN_NX2_EXP43"}, {"value", 1}}, "boot-only: relaunch");
+    refused({{"name", "LICHII_FAKE_OCCLUSION"}}, "boot-only: relaunch");
+    refused({{"name", "nonsense"}}, "unknown live switch");
+    refused({{"name", "LICHII_AB_NULL"}, {"value", -1}}, "whole number");
+    refused({{"name", "LICHII_AB_NULL"}, {"value", 1.5}}, "whole number");
+    refused({{"name", "LICHII_AB_BURN_US"}, {"value", Control::MaxBurnMicroseconds + 1}},
+            "whole number");
+
+    // Client 1 leaves: its switch goes back and is logged; client 2's stays.
+    const auto lines = Core::Nx2Debug::RevertClientSwitches(owners, 1, 20);
+    REQUIRE(lines == std::vector<std::string>{fmt::format(
+                         "Live switch LICHII_AB_NULL: {} -> {} (client gone, present 20)",
+                         null_before + 2, null_before)});
+    REQUIRE(Control::g_ab_null.load() == null_before);
+    REQUIRE(Control::Experiment(12) == slot_before + 5);
+    // A switch another client changed last is that client's.
+    (void)HandleSwitch(owners, 1, {{"name", "EDEN_NX2_EXP12"}, {"value", slot_before + 6}}, 21);
+    REQUIRE(Core::Nx2Debug::RevertClientSwitches(owners, 2, 22).empty());
+    REQUIRE(Control::Experiment(12) == slot_before + 6);
+    REQUIRE(Core::Nx2Debug::RevertClientSwitches(owners, 1, 23).size() == 1);
+    REQUIRE(Control::Experiment(12) == slot_before);
+    REQUIRE(owners.entries.empty());
+
+    // keep: the change stays when the client leaves.
+    (void)HandleSwitch(
+        owners, 3, {{"name", "LICHII_AB_NULL"}, {"value", null_before + 1}, {"keep", true}}, 24);
+    REQUIRE(Core::Nx2Debug::RevertClientSwitches(owners, 3, 25).empty());
+    REQUIRE(Control::g_ab_null.load() == null_before + 1);
+    // ... until the session ends: the next game starts from the environment's values.
+    const int null_boot = (std::max)(Control::EnvSwitch("LICHII_AB_NULL"), 0);
+    const auto ended = Core::Nx2Debug::RestoreBootSwitches(26);
+    REQUIRE(Control::g_ab_null.load() == null_boot);
+    if (null_boot != null_before + 1) {
+        REQUIRE(std::ranges::find(ended, fmt::format("Live switch LICHII_AB_NULL: {} -> {} "
+                                                     "(session end, present 26)",
+                                                     null_before + 1, null_boot)) != ended.end());
+    }
+}
