+VkImage RasterizerVulkan::OcarinaGuestColorForFsr(const ImageView& color,
+                                                  VkExtent2D render_extent) {
+    // FFX makes its own view of the image, with the image's usage (the texture cache's images
+    // with views in other formats have storage usage): each usage must suit E5B9G9R9 views.
+    const Image* const image = color.BackingImage();
+    const VkImageUsageFlags usage = image->UsageFlags();
+    VkFormatFeatureFlags view_features = VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+    if ((usage & VK_IMAGE_USAGE_STORAGE_BIT) != 0) {
+        view_features |= VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT;
+    }
+    if ((usage & (VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT)) !=
+        0) {
+        view_features |= VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT;
+    }
+    constexpr VkFormat format = VK_FORMAT_E5B9G9R9_UFLOAT_PACK32;
+    const char* refused = nullptr;
+    if (render_extent.width != color.size.width || render_extent.height != color.size.height) {
+        refused = "an FSR preset: FSR reads part of the colour";
+    } else if (MaxwellToVK::SurfaceFormat(device, FormatType::Optimal, true, color.format).format !=
+               format) {
+        refused = "the colour isn't E5B9G9R9 on this device";
+    } else if (!color.HasIdentitySwizzle() || image->info.resources.layers != 1) {
+        refused = "the colour's view is swizzled or its image layered";
+    } else if (!device.IsFormatSupported(format, view_features, FormatType::Optimal)) {
+        refused = "its image has storage usage and the device has no E5B9G9R9 storage images, so "
+                  "the view FFX makes of it would break the Vulkan rules";
+    }
+    static const char* logged = "";
+    if (refused != logged) {
+        logged = refused;
+        if (refused) {
+            LOG_INFO(Render_Vulkan,
+                     "Ocarina of Time: LICHII_FSR_SLIM d not used ({}): FSR reads the RGBA16F "
+                     "colour copy",
+                     refused);
+        } else {
+            LOG_INFO(Render_Vulkan, "Ocarina of Time: FSR reads the game's E5B9G9R9 colour, "
+                                    "without the RGBA16F copy (LICHII_FSR_SLIM d)");
+        }
+    }
+    return refused ? VK_NULL_HANDLE : color.ImageHandle();
+}
