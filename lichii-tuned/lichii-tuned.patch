+        if (address >= code_begin && address < code_end) {
+            return true;
+        }
+        MEMORY_BASIC_INFORMATION code{};
+        if (VirtualQuery(reinterpret_cast<const void*>(address), &code, sizeof(code)) == 0 ||
+            code.State != MEM_COMMIT || code.Type != MEM_IMAGE ||
