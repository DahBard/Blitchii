diff --git a/src/video_core/host_shaders/vulkan_gpu_clock_probe.comp b/src/video_core/host_shaders/vulkan_gpu_clock_probe.comp
new file mode 100644
index 0000000000..7c66cba914
--- /dev/null
+++ b/src/video_core/host_shaders/vulkan_gpu_clock_probe.comp
@@ -0,0 +1,56 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// The GPU clock probe (EDEN_NX2_GPU_CLOCK_PROBE, vk_gpu_clock_probe.cpp): one wave times a
+// dependent integer loop with the subgroup clock (shader clock cycles) and, unless
+// SUBGROUP_CLOCK_ONLY, the device's realtime clock.
+
+#version 460 core
+
+#extension GL_ARB_shader_clock : require
+#ifndef SUBGROUP_CLOCK_ONLY
+#extension GL_EXT_shader_realtime_clock : require
+#endif
+
+layout(local_size_x = 32) in;
+
+layout(push_constant) uniform Parameters {
+    uint iterations;
+    // Always 0: ties the loop to the first clock read so it can't be moved before it.
+    uint zero;
+};
+
+layout(std430, binding = 0) writeonly buffer Result {
+    uvec2 cycles_start;
+    uvec2 cycles_end;
+    uvec2 realtime_start;
+    uvec2 realtime_end;
+    // Each lane stores its result, so the loop can't be moved into the branch below.
+    uint sinks[32];
+};
+
+void main() {
+#ifndef SUBGROUP_CLOCK_ONLY
+    const uvec2 realtime0 = clockRealtime2x32EXT();
+#endif
+    const uvec2 cycles0 = clock2x32ARB();
+    uint x = gl_LocalInvocationIndex ^ (cycles0.x & zero);
+    for (uint i = 0; i < iterations; ++i) {
+        x = x * 1664525u + 1013904223u;
+        x ^= x >> 13;
+    }
+    const uvec2 cycles1 = clock2x32ARB();
+#ifndef SUBGROUP_CLOCK_ONLY
+    const uvec2 realtime1 = clockRealtime2x32EXT();
+#else
+    const uvec2 realtime0 = uvec2(0);
+    const uvec2 realtime1 = uvec2(0);
+#endif
+    sinks[gl_LocalInvocationIndex] = x;
+    if (gl_LocalInvocationIndex == 0) {
+        cycles_start = cycles0;
+        cycles_end = cycles1;
+        realtime_start = realtime0;
+        realtime_end = realtime1;
+    }
+}
