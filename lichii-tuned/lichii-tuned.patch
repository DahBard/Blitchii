diff --git a/src/video_core/churn_counters.h b/src/video_core/churn_counters.h
new file mode 100644
index 0000000000..72c52e803e
--- /dev/null
+++ b/src/video_core/churn_counters.h
@@ -0,0 +1,52 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+
+#include "common/common_types.h"
+
+/// What the caches make and destroy: per-frame churn of objects that should be reused (render
+/// targets at drifted addresses, buffers joined over drifted ranges). Counted always (one relaxed
+/// add where an object is made or destroyed, next to far larger work); TextureCache::TickFrame
+/// logs "Churn (600 frames)" with EDEN_NX2_CHURN_LOG=1.
+namespace VideoCommon::Churn {
+
+enum Counter : size_t {
+    ImagesCreated,
+    ImagesDeleted,
+    ImagesRelocated,
+    ImagesPooled,      ///< New images that took a recycled VkImage (EDEN_NX2_EXP42)
+    ImageViewsCreated,
+    ImageViewsDestroyed,
+    BuffersCreated,    ///< BufferCache::CreateBuffer
+    BuffersDeleted,    ///< BufferCache::DeleteBuffer
+    BuffersJoined,     ///< BufferCache::JoinOverlap (each also deletes the joined buffer)
+    BufferJoinBytes,   ///< Bytes copied by those joins
+    StagingBuffers,    ///< StagingBufferPool::CreateStagingBuffer
+    StagingBytes,
+    DeviceAllocations, ///< vkAllocateMemory by the allocator (blocks and dedicated memory)
+    DeviceFrees,
+    DescriptorPools,   ///< New descriptor pools (a bank ran out)
+    Count,
+};
+
+inline std::array<std::atomic<u64>, Count> g_counters{};
+
+inline void Add(Counter counter, u64 amount = 1) {
+    g_counters[counter].fetch_add(amount, std::memory_order_relaxed);
+}
+
+/// The counts since the last call, and resets them.
+inline std::array<u64, Count> Take() {
+    std::array<u64, Count> values{};
+    for (size_t i = 0; i < Count; ++i) {
+        values[i] = g_counters[i].exchange(0, std::memory_order_relaxed);
+    }
+    return values;
+}
+
+} // namespace VideoCommon::Churn
