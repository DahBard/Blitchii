+    std::ranges::fill(Access::Get(*f.cache, id).bytes, 0x77);
+    std::memset(f.bytes + 0x10000, 0x11, 0x1000);
+    // The page's first list drained the split and flushed the page (FlushGpuWrittenCommands).
