+#include "common/host_memory.h"
+
+namespace Kernel {
+
+class KernelCore;
+class KThread;
+
+/// EDEN_NX2_HEAP_TRACE=1: what the guest's MapPhysicalMemory and UnmapPhysicalMemory (supervisor
+/// calls 0x2c and 0x2d) cost the host. A call is timed from before it takes its page table's
+/// physical memory lock to its end, its parts (Phase) where they run, and the process's page
+/// faults are counted from the lock on. Every 10 s one HW_Memory line per direction; on Windows
+/// they split HostMemory's part of Phase::Host (Common::HostMemory::CallTrace), and the map line
+/// counts the regions a view kept after its unmap would have served. Each call over
+/// EDEN_NX2_HEAP_TRACE_SLOW_US (default 2000 us, 0 none) gets a line of its own, at most 20 in
+/// 10 s. Read at startup: set them in the environment, as the launchers do, not in
+/// nx2_switches.txt.
+namespace HeapTrace {
+
+enum class Direction : u8 { Map, Unmap };
+
+/// Parts of a call, timed in the functions that do them; the line has the lock wait and the rest
+/// (block bookkeeping) too. The trace's own counter reads are timed apart and left out.
+enum class Phase : u8 {
+    Allocate,  ///< KMemoryManager::AllocateForProcess: pages taken from the heap (and committed)
+    ZeroFill,  ///< KMemoryManager::AllocateForProcess: pages that may hold data cleared
+    PageTable, ///< Memory: the emulated page table's entries
+    Host,      ///< Memory: the pages' fastmem view mapped or unmapped (HostMemory), per region
+    Free,      ///< KPageTableBase::Operate: unmapped pages' references closed (and pages freed)
+    Count,
+};
+
+extern const bool enabled;
+
+[[nodiscard]] u64 NowNs();
+
+/// Before a call takes its physical memory lock: when it started, 0 with the trace off.
+[[nodiscard]] inline u64 Start() {
+    return enabled ? NowNs() : 0;
+}
+
+/// EDEN_NX2_HEAP_TRACE_SLOW_US: calls over this get a line of their own (0: none).
+[[nodiscard]] u64 SlowCallMicroseconds();
+
+/// Drops the unfinished 10 s window (KernelCore::Shutdown), so a later session's first lines
+/// cover only that session.
+void Reset();
+
+/// A call, made once it holds its physical memory lock so that it ends before the next call on
+/// that page table starts. `start` is Start(); `mapped` the page table's mapped physical memory
+/// size, whose change is what the call mapped or unmapped. While it runs it is its guest
+/// thread's (KThread::m_nx2_heap_trace_call), so a thread that stops in a call (emulation
+/// stopped) leaves nothing behind for the next session.
+class Call {
+public:
+    Call(KernelCore& kernel, Direction direction, u64 bytes, const size_t& mapped, u64 start) {
+        if (start != 0) {
+            Begin(kernel, direction, bytes, mapped, start);
+        }
+    }
+    ~Call() {
+        if (mapped_size != nullptr) {
+            End();
+        }
+    }
+    Call(const Call&) = delete;
+    Call& operator=(const Call&) = delete;
+
+    /// Once the call holds its page table's lock: `wait_start` is Start() from before taking it.
+    /// The wait is part of the line's other.
+    void TableLocked(u64 wait_start) {
+        if (wait_start != 0) {
+            table_lock_ns += NowNs() - wait_start;
+        }
+    }
+
+private:
+    friend class Phases;
+
+    void Begin(KernelCore& kernel, Direction direction, u64 bytes, const size_t& mapped,
+               u64 start);
+    void End();
+    void LogSlow(u64 call_ns, u64 changed, u32 faults, u64 zero_filled, s32 end_core) const;
+
+    const size_t* mapped_size{}; ///< Set while traced
+    // Set by Begin, so that an untraced call stores nothing else.
+    KThread* thread; ///< The guest thread making the call
+    const Common::HostMemory* host_memory;
+    Direction call_direction;
+    u32 host_regions; ///< Host maps or unmaps (Phase::Host)
+    u64 call_bytes;
+    u64 mapped_before;
+    u64 start_ns;
+    u64 locked_ns;
+    u64 trace_ns; ///< Begin's own reads, left out of the call's time
+    u32 faults_before;
+    u64 zero_filled_before;
+    u64 committed_before;
+    std::array<u64, static_cast<size_t>(Phase::Count)> phase_ns;
+    u64 table_lock_ns; ///< TableLocked's waits
+    s32 begin_core;    ///< The guest core the call began on
+    Common::HostMemory::CallTrace host; ///< HostMemory's part of Phase::Host
+};
+
+/// Splits what a function does for a traced call into phases: End(phase) gives `phase` the time
+/// since the split began or since the previous End. Nothing unless the calling guest thread is
+/// in a traced call.
+class Phases {
+public:
+    explicit Phases(KernelCore& kernel) {
+        if (enabled) {
+            Begin(kernel);
+        }
+    }
+    /// Right before the host call that End(Phase::Host) ends: HostMemory times its parts of it
+    /// for the call.
+    void StartHost() {
+        if (call != nullptr) {
+            Common::HostMemory::SetCallTrace(&call->host);
+        }
+    }
+    void End(Phase phase) {
+        if (call != nullptr) {
+            EndSlow(phase);
+        }
+    }
+
+private:
+    void Begin(KernelCore& kernel);
+    void EndSlow(Phase phase);
+
+    Call* call{};
+    u64 since;         ///< Set by Begin
+    u64 host_trace_ns; ///< call->host.trace_ns at the last split, set by Begin
+};
+
+} // namespace HeapTrace
+} // namespace Kernel
