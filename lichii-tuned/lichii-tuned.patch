+
+namespace Vulkan {
+
+namespace {
+
+/// A few dependent ALU operations each: about 10 us at 2.5 GHz, far from where the 20-bit cycle
+/// counter wraps twice.
+constexpr u32 LoopIterations = 1024;
+constexpr auto ProbeInterval = std::chrono::seconds{1};
+constexpr auto ReportInterval = std::chrono::seconds{10};
+
+struct Parameters {
+    u32 iterations;
+    u32 zero;
+};
+
+/// The shader's Result block.
+struct ResultData {
+    std::array<u32, 2> cycles_start;
+    std::array<u32, 2> cycles_end;
+    std::array<u32, 2> realtime_start;
+    std::array<u32, 2> realtime_end;
+    std::array<u32, 32> sinks;
+};
+static_assert(sizeof(ResultData) == 160, "The shader's std430 layout");
+
+std::atomic<const char*> g_state{"off"};
+
+u64 Combine(const std::array<u32, 2>& value) {
+    return u64{value[0]} | (u64{value[1]} << 32);
+}
+
+/// Shader clocks can be narrower than 64 bits (the subgroup clock is the 20-bit SHADER_CYCLES
+/// register on RDNA 3, llvmpipe's realtime clock has 32 bits): a counter that wrapped once ends
+/// below its start.
+u64 CounterDelta(u64 start, u64 end) {
+    if (end >= start) {
+        return end - start;
+    }
+    for (const u32 bits : {20U, 32U}) {
+        const u64 range = u64{1} << bits;
+        if (start < range && end < range) {
+            return end + range - start;
+        }
+    }
+    return 0;
+}
+
+double Median(const std::vector<double>& sorted) {
+    const size_t middle = sorted.size() / 2;
+    return sorted.size() % 2 != 0 ? sorted[middle] : (sorted[middle - 1] + sorted[middle]) / 2.0;
+}
+
+} // Anonymous namespace
+
+bool GpuClockProbeRequested() {
+    static const bool requested = [] {
+        const char* const value = std::getenv("EDEN_NX2_GPU_CLOCK_PROBE");
+        return value != nullptr && value[0] == '1';
+    }();
+    return requested;
+}
+
+std::string_view GpuClockProbeState() {
+    return g_state.load(std::memory_order_relaxed);
+}
+
+std::optional<GpuClockProbe> GpuClockProbe::Create(const Device& device) {
+    if (!GpuClockProbeRequested()) {
+        return std::nullopt;
+    }
+    const auto physical = device.GetPhysical();
+    const u32 valid_bits =
+        physical.GetQueueFamilyProperties()[device.GetGraphicsFamily()].timestampValidBits;
+    const char* missing = nullptr;
+    if (!device.HasShaderSubgroupClock()) {
+        missing = "VK_KHR_shader_clock's subgroup clock";
+    } else if (valid_bits == 0 || physical.GetProperties().limits.timestampPeriod <= 0.0f) {
+        missing = "timestamps on the graphics queue";
+    }
+    if (missing != nullptr) {
+        LOG_WARNING(Render_Vulkan,
+                    "GPU clock probe (EDEN_NX2_GPU_CLOCK_PROBE): off, the device has no {}",
+                    missing);
+        g_state.store("set, not supported", std::memory_order_relaxed);
+        return std::nullopt;
+    }
+    try {
+        return std::optional<GpuClockProbe>{std::in_place, device};
+    } catch (const vk::Exception& error) {
+        LOG_WARNING(Render_Vulkan, "GPU clock probe (EDEN_NX2_GPU_CLOCK_PROBE): off, {}",
+                    error.what());
+        g_state.store("set, failed", std::memory_order_relaxed);
+        return std::nullopt;
+    }
+}
+
+GpuClockProbe::GpuClockProbe(const Device& device) : realtime{device.HasShaderDeviceClock()} {
+    const vk::Device& logical = device.GetLogical();
+    const auto physical = device.GetPhysical();
+    timestamp_bits =
+        physical.GetQueueFamilyProperties()[device.GetGraphicsFamily()].timestampValidBits;
+    timestamp_period_ns = physical.GetProperties().limits.timestampPeriod;
+
+    const MemoryAllocator allocator{device};
+    buffer = allocator.CreateBuffer(
+        VkBufferCreateInfo{
+            .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+            .pNext = nullptr,
+            .flags = 0,
+            .size = sizeof(ResultData),
+            .usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+            .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+            .queueFamilyIndexCount = 0,
+            .pQueueFamilyIndices = nullptr,
+        },
+        MemoryUsage::Download);
+    if (buffer.Mapped().size() < sizeof(ResultData)) {
+        throw vk::Exception(VK_ERROR_MEMORY_MAP_FAILED);
+    }
+    query_pool = logical.CreateQueryPool({
+        .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+        .pNext = nullptr,
+        .flags = 0,
+        .queryType = VK_QUERY_TYPE_TIMESTAMP,
+        .queryCount = 2,
+        .pipelineStatistics = 0,
+    });
+
+    static constexpr VkDescriptorSetLayoutBinding binding{
+        .binding = 0,
+        .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+        .descriptorCount = 1,
+        .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+        .pImmutableSamplers = nullptr,
+    };
+    set_layout = logical.CreateDescriptorSetLayout({
+        .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+        .pNext = nullptr,
+        .flags = 0,
+        .bindingCount = 1,
+        .pBindings = &binding,
+    });
+    static constexpr VkDescriptorPoolSize pool_size{
+        .type = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+        .descriptorCount = 1,
+    };
+    descriptor_pool = logical.CreateDescriptorPool({
+        .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+        .pNext = nullptr,
+        .flags = 0,
+        .maxSets = 1,
+        .poolSizeCount = 1,
+        .pPoolSizes = &pool_size,
+    });
+    descriptor_set = descriptor_pool.Allocate({
+        .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+        .pNext = nullptr,
+        .descriptorPool = *descriptor_pool,
+        .descriptorSetCount = 1,
+        .pSetLayouts = set_layout.address(),
+    });
+    if (descriptor_set.IsOutOfPoolMemory()) {
+        throw vk::Exception(VK_ERROR_OUT_OF_POOL_MEMORY);
+    }
+    const VkDescriptorBufferInfo buffer_info{
+        .buffer = *buffer,
+        .offset = 0,
+        .range = VK_WHOLE_SIZE,
+    };
+    const VkWriteDescriptorSet write{
+        .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+        .pNext = nullptr,
+        .dstSet = descriptor_set[0],
+        .dstBinding = 0,
+        .dstArrayElement = 0,
+        .descriptorCount = 1,
+        .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+        .pImageInfo = nullptr,
+        .pBufferInfo = &buffer_info,
+        .pTexelBufferView = nullptr,
+    };
+    logical.UpdateDescriptorSets(std::array{write}, {});
+
+    static constexpr VkPushConstantRange push_range{
+        .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+        .offset = 0,
+        .size = sizeof(Parameters),
+    };
+    pipeline_layout = logical.CreatePipelineLayout({
+        .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+        .pNext = nullptr,
+        .flags = 0,
+        .setLayoutCount = 1,
+        .pSetLayouts = set_layout.address(),
+        .pushConstantRangeCount = 1,
+        .pPushConstantRanges = &push_range,
+    });
+    // The device clock may only be read where shaderDeviceClock is enabled.
+    shader = BuildShader(device,
+                         realtime ? std::span<const u32>{VULKAN_GPU_CLOCK_PROBE_COMP_SPV}
+                                  : std::span<const u32>{VULKAN_GPU_CLOCK_PROBE_SUBGROUP_COMP_SPV});
+    pipeline = logical.CreateComputePipeline({
+        .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+        .pNext = nullptr,
+        .flags = 0,
+        .stage{
+            .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+            .pNext = nullptr,
+            .flags = 0,
+            .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+            .module = *shader,
+            .pName = "main",
+            .pSpecializationInfo = nullptr,
+        },
+        .layout = *pipeline_layout,
+        .basePipelineHandle = VK_NULL_HANDLE,
+        .basePipelineIndex = 0,
+    });
+
+    const auto now = std::chrono::steady_clock::now();
+    next_probe = now + ProbeInterval;
+    window_start = now;
+    samples.reserve(32);
+    g_state.store(realtime ? "on" : "on, subgroup clock only", std::memory_order_relaxed);
+    LOG_INFO(Render_Vulkan,
+             "GPU clock probe (EDEN_NX2_GPU_CLOCK_PROBE): a {}-iteration loop on one wave once a "
+             "second, timed with the subgroup clock and {}; timestamps {} bits, {} ns",
+             LoopIterations,
+             realtime ? "the device realtime clock" : "the timestamps (no device clock)",
+             timestamp_bits, timestamp_period_ns);
+}
+
+void GpuClockProbe::BeginCommandBuffer(const Device& device, MasterSemaphore& master_semaphore,
+                                       vk::CommandBuffer cmdbuf) {
+    const auto now = std::chrono::steady_clock::now();
+    if (pending_tick != 0) {
+        if (!master_semaphore.IsFree(pending_tick)) {
+            // Other threads refresh the known GPU tick often; ask the driver at most once a ms.
+            if (now < next_refresh) {
+                return;
+            }
+            next_refresh = now + std::chrono::milliseconds{1};
+            master_semaphore.Refresh();
+            if (!master_semaphore.IsFree(pending_tick)) {
+                return;
+            }
+        }
+        ReadBack(device);
+        pending_tick = 0;
+    }
+    if (now - window_start >= ReportInterval) {
+        Report(now);
+    }
+    if (recorded || now < next_probe) {
+        return;
+    }
+    Record(cmdbuf);
+    recorded = true;
+    next_probe = now + ProbeInterval;
+}
+
+void GpuClockProbe::Record(vk::CommandBuffer cmdbuf) const {
+    // An execution dependency only, but the wrapper's synchronization2 path takes the stages
+    // from the barriers it is given: none would be no dependency at all.
+    static constexpr VkMemoryBarrier WAIT_BARRIER{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+        .pNext = nullptr,
+        .srcAccessMask = 0,
+        .dstAccessMask = 0,
+    };
+    static constexpr VkMemoryBarrier READ_BARRIER{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+        .pNext = nullptr,
+        .srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT,
+        .dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+    };
+    // The work submitted before finishes first, so the timestamps time the loop alone.
+    cmdbuf.PipelineBarrier(VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                           0, WAIT_BARRIER);
+    cmdbuf.ResetQueryPool(*query_pool, 0, 2);
+    cmdbuf.WriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, *query_pool, 0);
+    cmdbuf.BindPipeline(VK_PIPELINE_BIND_POINT_COMPUTE, *pipeline);
+    cmdbuf.BindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, *pipeline_layout, 0, descriptor_set,
+                              {});
+    cmdbuf.PushConstants(*pipeline_layout, VK_SHADER_STAGE_COMPUTE_BIT,
+                         Parameters{.iterations = LoopIterations, .zero = 0});
+    cmdbuf.Dispatch(1, 1, 1);
+    cmdbuf.WriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, *query_pool, 1);
+    cmdbuf.PipelineBarrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0,
+                           READ_BARRIER);
+}
+
+void GpuClockProbe::ReadBack(const Device& device) {
+    struct Query {
+        u64 value;
+        u64 available;
+    };
+    std::array<Query, 2> queries{};
+    const VkResult result = device.GetLogical().GetQueryResults(
+        *query_pool, 0, 2, sizeof(queries), queries.data(), sizeof(Query),
+        VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+    if (result != VK_SUCCESS || queries[0].available == 0 || queries[1].available == 0) {
+        ++dropped;
+        return;
+    }
+    if (!buffer.IsHostCoherent()) {
+        buffer.Invalidate();
+    }
+    ResultData data;
+    std::memcpy(&data, buffer.Mapped().data(), sizeof(data));
+    const u64 cycles = CounterDelta(Combine(data.cycles_start), Combine(data.cycles_end));
+    const u64 realtime_start = Combine(data.realtime_start);
+    const u64 realtime_ticks =
+        realtime ? CounterDelta(realtime_start, Combine(data.realtime_end)) : 0;
+    const u64 timestamp_ticks =
+        Common::DkbFrameTrace::TimestampDelta(queries[0].value, queries[1].value, timestamp_bits);
+    if (cycles == 0 || timestamp_ticks == 0 || (realtime && realtime_ticks == 0)) {
+        ++dropped;
+        return;
+    }
+    if (realtime) {
+        // The realtime clock's rate against the timestamps', summed over the steps from one
+        // probe to the next. A step longer than 2 s could hide a wrap of a 32-bit counter.
+        if (last_clocks) {
+            const double ticks =
+                static_cast<double>(CounterDelta(last_clocks->first, realtime_start));
+            const double seconds = static_cast<double>(Common::DkbFrameTrace::TimestampDelta(
+                                       last_clocks->second, queries[0].value, timestamp_bits)) *
+                                   timestamp_period_ns / 1e9;
+            if (seconds > 0.0 && seconds <= 2.0 && ticks >= 1e6 * seconds &&
+                ticks <= 1e10 * seconds) {
+                calibration_ticks += ticks;
+                calibration_seconds += seconds;
+                realtime_hz = calibration_ticks / calibration_seconds;
+            }
+        }
+        last_clocks.emplace(realtime_start, queries[0].value);
+    }
+    samples.push_back({
+        .cycles = cycles,
+        .realtime_ticks = realtime_ticks,
+        .timestamp_ticks = timestamp_ticks,
+    });
+}
+
+void GpuClockProbe::Report(std::chrono::steady_clock::time_point now) {
+    const double seconds = std::chrono::duration<double>(now - window_start).count();
+    window_start = now;
+    if (samples.empty()) {
+        if (dropped != 0) {
+            LOG_INFO(Render_Vulkan, "GPU clock probe in {:.0f} s: no samples ({} dropped)", seconds,
+                     dropped);
+        }
+        dropped = 0;
+        return;
+    }
+    // Shader clock cycles over the loop's time on the realtime clock. The timestamps also count
+    // the dispatch's start and end, so their MHz reads somewhat low: they stand in until the
+    // realtime clock's rate is known, or without the device clock.
+    const bool use_realtime = realtime && realtime_hz > 0.0;
+    std::vector<double> mhz;
+    std::vector<double> timestamp_mhz;
+    std::vector<double> loop_us;
+    std::vector<double> cycles;
+    for (const Sample& sample : samples) {
+        const double timestamp_us =
+            static_cast<double>(sample.timestamp_ticks) * timestamp_period_ns / 1e3;
+        const double sample_cycles = static_cast<double>(sample.cycles);
+        timestamp_mhz.push_back(sample_cycles / timestamp_us);
+        mhz.push_back(use_realtime ? sample_cycles * realtime_hz /
+                                         static_cast<double>(sample.realtime_ticks) / 1e6
+                                   : timestamp_mhz.back());
+        loop_us.push_back(timestamp_us);
+        cycles.push_back(sample_cycles);
+    }
+    std::ranges::sort(mhz);
+    std::ranges::sort(timestamp_mhz);
+    std::ranges::sort(loop_us);
+    std::ranges::sort(cycles);
+    LOG_INFO(Render_Vulkan,
+             "GPU clock probe in {:.0f} s: median {:.0f} MHz ({:.0f}-{:.0f}), loop {:.1f} us ({} "
+             "samples), {:.0f} cycles; {}{}",
+             seconds, Median(mhz), mhz.front(), mhz.back(), Median(loop_us), samples.size(),
+             Median(cycles),
+             use_realtime ? fmt::format("realtime clock {:.2f} MHz, {:.0f} MHz over the timestamps",
+                                        realtime_hz / 1e6, Median(timestamp_mhz))
+                          : std::string{"MHz over the timestamps"},
+             dropped != 0 ? fmt::format(", {} dropped", dropped) : std::string{});
+    samples.clear();
+    dropped = 0;
+}
+
+} // namespace Vulkan
