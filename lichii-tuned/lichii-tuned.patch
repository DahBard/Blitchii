+            const u32 cap = 0xD280000EU | (static_cast<u32>(fps) << 5);
+            std::memcpy(out.data() + routine + 0x24, &cap, sizeof(cap));
+            LOG_INFO(Loader, "    - Dynamic FPS keeps real speed down to {} fps", fps);
