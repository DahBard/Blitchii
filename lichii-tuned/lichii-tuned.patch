+// Checks that every routing helper (a function whose first parameter is the 64-bit address) has
+// r64's form (Profile::r64_global_memory_routing): each candidate buffer's branch ends in a return,
+// one more return gives the fallback, and no value merges in an OpPhi. Returns the number of
+// helpers.
+size_t CheckR64Helpers(const std::vector<u32>& code) {
+    constexpr u32 OpTypeInt = 21;
+    constexpr u32 OpFunction = 54;
+    constexpr u32 OpFunctionParameter = 55;
+    constexpr u32 OpFunctionEnd = 56;
+    constexpr u32 OpPhi = 245;
+    constexpr u32 OpLabel = 248;
+    constexpr u32 OpBranch = 249;
+    constexpr u32 OpBranchConditional = 250;
+    constexpr u32 OpReturn = 253;
+    constexpr u32 OpReturnValue = 254;
+    constexpr u32 OpUnreachable = 255;
+    std::vector<u32> int64_types;
+    for (const auto& ops : Instructions(code, OpTypeInt)) {
+        if (ops[1] == 64) {
+            int64_types.push_back(ops[0]);
+        }
+    }
+    REQUIRE(!int64_types.empty());
+    size_t helpers{};
+    bool in_function{};
+    bool helper{};
+    u32 parameters{};
+    u32 function_id{};
+    u32 label{};
+    u32 returns{};
+    u32 phis{};
+    std::vector<u32> branch_targets;
+    std::vector<std::pair<u32, u32>> terminators;
+    for (size_t i = 5; i < code.size();) {
+        const u32 count = code[i] >> 16;
+        const u32 opcode = code[i] & 0xffff;
+        REQUIRE(count > 0);
+        REQUIRE(i + count <= code.size());
+        if (opcode == OpFunction) {
+            in_function = true;
+            helper = false;
+            function_id = code[i + 2];
+            parameters = returns = phis = 0;
+            branch_targets.clear();
+            terminators.clear();
+        } else if (opcode == OpFunctionParameter) {
+            if (parameters++ == 0) {
+                helper = std::ranges::find(int64_types, code[i + 1]) != int64_types.end();
+            }
+        } else if (opcode == OpLabel) {
+            label = code[i + 1];
+        } else if (opcode == OpPhi) {
+            ++phis;
+        } else if (in_function && opcode >= OpBranch && opcode <= OpUnreachable) {
+            terminators.emplace_back(label, opcode);
+            if (opcode == OpBranchConditional) {
+                branch_targets.push_back(code[i + 2]);
+            }
+            returns += opcode == OpReturn || opcode == OpReturnValue ? 1 : 0;
+        } else if (opcode == OpFunctionEnd) {
+            in_function = false;
+            if (helper) {
+                ++helpers;
+                CAPTURE(function_id);
+                CHECK(!branch_targets.empty());
+                CHECK(returns == branch_targets.size() + 1);
+                CHECK(phis == 0);
+                for (const u32 target : branch_targets) {
+                    const auto block = std::ranges::find(terminators, target,
+                                                         &std::pair<u32, u32>::first);
+                    REQUIRE(block != terminators.end());
+                    CHECK((block->second == OpReturn || block->second == OpReturnValue));
+                }
+            }
+        }
+        i += count;
+    }
+    return helpers;
+}
 } // namespace
 
 TEST_CASE("Global memory helpers branch per buffer and return only from their last block",
@@ -349,3 +432,55 @@ TEST_CASE("Untracked 32-bit global atomics route to their storage buffer",
         }
     }
 }
+
+TEST_CASE("r64's global memory helpers return inside each candidate buffer's branch",
+          "[shader_recompiler][global_memory]") {
+    constexpr u32 OpTypePointer = 32;
+    constexpr u32 OpSelect = 169;
+    constexpr u32 OpSwitch = 251;
+    // The flag replaces select_global_memory_buffer, which the pipeline cache never sets with it.
+    for (const bool select : {false, true}) {
+        for (const bool native : {true, false}) {
+            for (const u32 alignment : {16U, 4U}) {
+                CAPTURE(select, native, alignment);
+                std::vector<u32> code;
+                REQUIRE_NOTHROW(code = EmitUntrackedAccesses(native, alignment, select, true));
+                CHECK(CheckR64Helpers(code) >= 7);
+                CHECK(Instructions(code, OpSwitch).empty());
+                std::vector<u32> pointer_types;
+                for (const auto& ops : Instructions(code, OpTypePointer)) {
+                    pointer_types.push_back(ops[0]);
+                }
+                CHECK(std::ranges::none_of(Instructions(code, OpSelect), [&](const auto& ops) {
+                    return std::ranges::find(pointer_types, ops[0]) != pointer_types.end();
+                }));
+            }
+        }
+    }
+}
+
+TEST_CASE("Untracked 32-bit global atomics route through r64's helpers",
+          "[shader_recompiler][global_memory]") {
+    constexpr u32 OpAtomicCompareExchange = 230;
+    const std::array<std::pair<IR::Opcode, u32>, 12> cases{{
+        {IR::Opcode::GlobalAtomicIAdd32, 234},
+        {IR::Opcode::GlobalAtomicSMin32, 236},
+        {IR::Opcode::GlobalAtomicUMin32, 237},
+        {IR::Opcode::GlobalAtomicSMax32, 238},
+        {IR::Opcode::GlobalAtomicUMax32, 239},
+        {IR::Opcode::GlobalAtomicAnd32, 240},
+        {IR::Opcode::GlobalAtomicOr32, 241},
+        {IR::Opcode::GlobalAtomicXor32, 242},
+        {IR::Opcode::GlobalAtomicExchange32, 229},
+        {IR::Opcode::GlobalAtomicInc32, OpAtomicCompareExchange},
+        {IR::Opcode::GlobalAtomicDec32, OpAtomicCompareExchange},
+        {IR::Opcode::GlobalAtomicAddF32, OpAtomicCompareExchange},
+    }};
+    for (const auto& [opcode, atomic] : cases) {
+        CAPTURE(static_cast<u32>(opcode));
+        std::vector<u32> code;
+        REQUIRE_NOTHROW(code = EmitUntrackedAtomic(opcode, false, true));
+        CHECK_FALSE(Instructions(code, atomic).empty());
+        CHECK(CheckR64Helpers(code) >= 7);
+    }
+}
