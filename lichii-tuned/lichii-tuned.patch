+// Live switches, ported by hand from Fritchii (Frizti/Lichii): the numbered slots of Frizti's
+// 93487071d5 and the `switch` method of 6bec8231a2 (thibaut, a281376cc8), with Fritchii's names
+// so its v6 merge lands on the same code. Each is read from the environment on first use; the
+// debug server's `switch` stores into it (nx2_debug_tools.cpp), and readers load it relaxed where
+// they read it, so a change takes effect at the reader's next load. Experiment switches: not for
+// nx2.
+
+/// The whole number in the variable `name`, 0 when it is unset.
+[[nodiscard]] inline int EnvSwitch(const char* name) {
+    const char* value = std::getenv(name);
+    return value == nullptr ? 0 : std::atoi(value);
+}
+
+/// The switch's value, read from the environment on first use (-1: not read yet). Static
+/// initialization runs before the frontend applies nx2_switches.txt.
+[[nodiscard]] inline int SwitchValue(std::atomic<int>& value, const char* name, int fallback = 0) {
+    int current = value.load(std::memory_order_relaxed);
+    if (current < 0) [[unlikely]] {
+        int unset = -1;
+        const int initial = std::getenv(name) != nullptr ? EnvSwitch(name) : fallback;
+        value.compare_exchange_strong(unset, (std::max)(initial, 0), std::memory_order_relaxed);
+        current = value.load(std::memory_order_relaxed);
+    }
+    return current;
