+            b->kind = DMSH_VK_KIND_TEX_UBO; b->reg = (int16_t)(s->cbuf_index - 3); b->off = (uint16_t)s->cbuf_offset;
+            b->skind = DMSH_VK_KIND_SAMP_UBO; b->sreg = b->reg; b->soff = b->off;
