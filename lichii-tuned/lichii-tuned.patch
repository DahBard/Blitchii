+
+namespace Kernel::HeapTrace {
+namespace {
+
+constexpr size_t PhaseCount = static_cast<size_t>(Phase::Count);
+constexpr u64 WindowNs = 10'000'000'000;
+
+using HostCall = Common::HostMemory::CallTrace::HostCall;
+constexpr size_t HostCallCount = static_cast<size_t>(HostCall::Count);
+
+/// Slow-call lines, both directions together: 10 at once, then one a second (at most 20 in
+/// 10 s), so that a window's later calls get lines too.
+constexpr u64 SlowLineNs = 1'000'000'000;
+constexpr u64 SlowLineBurstNs = 10 * SlowLineNs;
+
+/// The would-reuse count follows the views unmapped in the last 10 s, at most this many.
+constexpr u64 ReuseNs = 10'000'000'000;
+constexpr u64 RecentReuseNs = 1'000'000'000;
+constexpr size_t MaxUnmappedViews = 32768;
+/// Views a call keeps for it (Common::HostMemory::CallTrace::view).
+constexpr size_t KeptViews = std::tuple_size_v<decltype(Common::HostMemory::CallTrace::view)>;
+
+bool ReadSwitch() {
+    const char* const value = std::getenv("EDEN_NX2_HEAP_TRACE");
+    return value != nullptr && value[0] != '\0' && value[0] != '0';
+}
+
+u64 ReadSlowCallMicroseconds() {
+    constexpr u64 DefaultUs = 2000;
+    const char* const value = std::getenv("EDEN_NX2_HEAP_TRACE_SLOW_US");
+    if (value == nullptr || value[0] == '\0') {
+        return DefaultUs;
+    }
+    char* end = nullptr;
+    const unsigned long long us = std::strtoull(value, &end, 10);
+    return end == value ? DefaultUs : static_cast<u64>(us);
+}
+
+const u64 g_slow_call_us = ReadSlowCallMicroseconds();
+
+struct ProcessCounters {
+    u32 faults{}; ///< Page faults of all its threads (Windows counts them in 32 bits)
+    u64 working_set{};
+    u64 commit{}; ///< Private commit
+};
+
+ProcessCounters ReadProcessCounters() {
+#ifdef _WIN32
+    PROCESS_MEMORY_COUNTERS counters{};
+    counters.cb = sizeof(counters);
+    if (K32GetProcessMemoryInfo(::GetCurrentProcess(), &counters, sizeof(counters))) {
+        return {static_cast<u32>(counters.PageFaultCount), counters.WorkingSetSize,
+                counters.PagefileUsage};
+    }
+#endif
+    return {};
+}
+
+/// HostMemory's part of the host phase (Common::HostMemory::CallTrace), summed.
+struct HostCounts {
+    u64 lock_wait_ns{};
+    u64 held_ns{};
+    u64 held_tsc{};
+    u64 on_cpu_cycles{};
+    std::array<u64, HostCallCount> call_ns{};
+    std::array<u64, HostCallCount> calls{};
+    u64 unmap_bytes{};
+    u64 view_bytes{};
+    u64 partial_views{};
+
+    void Add(const Common::HostMemory::CallTrace& trace) {
+        lock_wait_ns += trace.lock_wait_ns;
+        held_ns += trace.held_ns;
+        held_tsc += trace.held_tsc;
+        on_cpu_cycles += trace.on_cpu_cycles;
+        for (size_t call = 0; call < HostCallCount; ++call) {
+            call_ns[call] += trace.call_ns[call];
+            calls[call] += trace.calls[call];
+        }
+        unmap_bytes += trace.unmap_bytes;
+        view_bytes += trace.view_bytes;
+        partial_views += trace.partial_views;
+    }
+};
+
+/// Map regions at the range of a view a traced unmap took down lately: with the same backing
+/// offset, that view kept mapped would have served them.
+struct ReuseCounts {
+    u64 regions{}; ///< Followed
+    u64 bytes{};
+    u64 recent{}; ///< The same backing, unmapped within 1 s
+    u64 recent_bytes{};
+    u64 hits{}; ///< The same backing, unmapped within 10 s
+    u64 hit_bytes{};
+    u64 other_backing{}; ///< The same range, unmapped within 10 s with another backing
+    u64 unfollowed{};    ///< Regions (or views, for unmaps) past those a call keeps
+};
+
+struct Totals {
+    u64 calls{};
+    u64 bytes{};
+    u64 changed{};
+    u64 total_ns{};
+    u64 lock_ns{};
+    std::array<u64, PhaseCount> phase_ns{};
+    u64 host_regions{};
+    u64 faults{};
+    u64 zero_filled{};
+    u64 committed{};
+    u64 trace_ns{};
+    std::vector<u64> call_ns;
+    u64 table_lock_ns{};
+    HostCounts host{};
+    ReuseCounts reuse{};
+    u64 slow_calls{};
+    u64 slow_logged{};
+};
+
+struct UnmappedView {
+    u64 end;
+    u64 host_offset;
+    u64 ns; ///< When its unmap ended
+};
+
+struct Window {
+    std::mutex mutex;
+    u64 start_ns{};
+    u32 start_faults{};
+    std::array<Totals, 2> totals{};
+    u64 slow_line_credit_ns{SlowLineBurstNs}; ///< SlowLineNs a line
+    u64 slow_line_credit_at_ns{};
+    /// The host views traced unmaps took down in the last 10 s, by virtual offset (they don't
+    /// overlap), and when, in the order they were taken down. They outlive the window.
+    std::map<u64, UnmappedView> unmapped;
+    std::deque<std::pair<u64, u64>> unmapped_order;
+};
+Window g_window;
+
+double MiB(u64 bytes) {
+    return static_cast<double>(bytes) / (1024.0 * 1024.0);
+}
+
+/// The q quantile of `values`, which it reorders.
+u64 Quantile(std::vector<u64>& values, double q) {
+    const auto index = static_cast<std::ptrdiff_t>(q * static_cast<double>(values.size() - 1));
+    std::nth_element(values.begin(), values.begin() + index, values.end());
+    return values[static_cast<size_t>(index)];
+}
+
+/// Drops the views unmapped 10 s ago or more, and the oldest past MaxUnmappedViews. With
+/// g_window.mutex held.
+void ExpireUnmapped(u64 now_ns) {
+    auto& order = g_window.unmapped_order;
+    while (!order.empty() &&
+           (order.front().second + ReuseNs <= now_ns || order.size() > MaxUnmappedViews)) {
+        const auto [offset, unmapped_ns] = order.front();
+        const auto it = g_window.unmapped.find(offset);
+        if (it != g_window.unmapped.end() && it->second.ns == unmapped_ns) {
+            g_window.unmapped.erase(it);
+        }
+        order.pop_front();
+    }
+}
+
+/// Takes the views that overlap [begin, end) out; returns the one that was that range exactly.
+/// With g_window.mutex held.
+std::optional<UnmappedView> TakeUnmapped(u64 begin, u64 end) {
+    auto& unmapped = g_window.unmapped;
+    std::optional<UnmappedView> same_range;
+    auto it = unmapped.upper_bound(begin);
+    if (it != unmapped.begin() && std::prev(it)->second.end > begin) {
+        --it;
+    }
+    while (it != unmapped.end() && it->first < end) {
+        if (it->first == begin && it->second.end == end) {
+            same_range = it->second;
+        }
+        it = unmapped.erase(it);
+    }
+    return same_range;
+}
+
+/// The would-reuse count, with g_window.mutex held: a map's regions against the views traced
+/// unmaps took down lately, which an unmap's views join. A map over part of such a view ends it.
+void FollowViews(Direction direction, const Common::HostMemory::CallTrace& host, u64 now_ns,
+                 ReuseCounts& reuse) {
+    ExpireUnmapped(now_ns);
+    const u32 kept = (std::min)(host.views, static_cast<u32>(KeptViews));
+    reuse.unfollowed += host.views - kept;
+    for (u32 i = 0; i < kept; ++i) {
+        const Common::HostMemory::CallTrace::View& view = host.view[i];
+        const u64 end = view.virtual_offset + view.length;
+        const std::optional<UnmappedView> same_range = TakeUnmapped(view.virtual_offset, end);
+        if (direction == Direction::Unmap) {
+            g_window.unmapped.emplace(view.virtual_offset,
+                                      UnmappedView{end, view.host_offset, now_ns});
+            g_window.unmapped_order.emplace_back(view.virtual_offset, now_ns);
+            continue;
+        }
+        ++reuse.regions;
+        reuse.bytes += view.length;
+        if (!same_range) {
+            continue;
+        }
+        if (same_range->host_offset != view.host_offset) {
+            ++reuse.other_backing;
+            continue;
+        }
+        ++reuse.hits;
+        reuse.hit_bytes += view.length;
+        if (now_ns - same_range->ns <= RecentReuseNs) {
+            ++reuse.recent;
+            reuse.recent_bytes += view.length;
+        }
+    }
+}
+
+#ifdef _WIN32
+/// HostMemory's part of the host phase: times are ns over `ns_per_unit` in `unit`, counts over
+/// `count_scale` (seconds in the 10 s lines, 1 for one call).
+std::string FormatHost(Direction direction, const HostCounts& host, double ns_per_unit,
+                       double count_scale, std::string_view unit) {
+    const auto time = [ns_per_unit](u64 ns) { return static_cast<double>(ns) / ns_per_unit; };
+    const auto count = [count_scale](u64 n) { return static_cast<double>(n) / count_scale; };
+    const auto call = [&](HostCall which, std::string_view name) {
+        const size_t index = static_cast<size_t>(which);
+        return fmt::format("{} {:.0f} in {:.1f} {}", name, count(host.calls[index]),
+                           time(host.call_ns[index]), unit);
+    };
+    const std::string on_cpu =
+        host.held_tsc == 0
+            ? std::string{"n/a"}
+            : fmt::format("{:.0f}%", 100.0 * static_cast<double>(host.on_cpu_cycles) /
+                                         static_cast<double>(host.held_tsc));
+    std::string text =
+        fmt::format("placeholder lock wait {:.1f} {}, held {:.1f} {} ({} of it on the CPU); ",
+                    time(host.lock_wait_ns), unit, time(host.held_ns), unit, on_cpu);
+    if (direction == Direction::Map) {
+        text += fmt::format("{}, {}, {}", call(HostCall::Split, "VirtualFreeEx split"),
+                            call(HostCall::MapView, "MapViewOfFile3"),
+                            call(HostCall::Commit, "VirtualAlloc commit"));
+    } else {
+        text += fmt::format("{} ({:.2f} MiB of views for {:.2f} MiB asked; {:.4g} of them taken "
+                            "down in part, their rest mapped again: {}, {}), {}",
+                            call(HostCall::UnmapView, "UnmapViewOfFile2"),
+                            MiB(host.view_bytes) / count_scale, MiB(host.unmap_bytes) / count_scale,
+                            count(host.partial_views), call(HostCall::Split, "VirtualFreeEx split"),
+                            call(HostCall::MapView, "MapViewOfFile3"),
+                            call(HostCall::Coalesce, "VirtualFreeEx coalesce"));
+    }
+    return text;
+}
+
+std::string FormatReuse(const ReuseCounts& reuse, double seconds) {
+    const auto rate = [seconds](u64 n) { return static_cast<double>(n) / seconds; };
+    const auto share = [&reuse](u64 regions) {
+        return reuse.regions == 0 ? 0.0
+                                  : 100.0 * static_cast<double>(regions) /
+                                        static_cast<double>(reuse.regions);
+    };
+    std::string text = fmt::format(
+        "would-reuse: {:.0f} of {:.0f} regions ({:.0f}%, {:.1f} of {:.1f} MiB) mapped where a "
+        "view of the same backing was unmapped within 1 s, {:.0f} ({:.0f}%, {:.1f} MiB) within "
+        "10 s; {:.0f} where one of another backing was",
+        rate(reuse.recent), rate(reuse.regions), share(reuse.recent),
+        MiB(reuse.recent_bytes) / seconds, MiB(reuse.bytes) / seconds, rate(reuse.hits),
+        share(reuse.hits), MiB(reuse.hit_bytes) / seconds, rate(reuse.other_backing));
+    if (reuse.unfollowed != 0) {
+        text += fmt::format("; {:.0f} regions past {} a call not followed",
+                            rate(reuse.unfollowed), KeptViews);
+    }
+    return text;
+}
+#endif
+
+void LogTotals(Direction direction, Totals& totals, double seconds, const std::string& context) {
+    const bool map = direction == Direction::Map;
+    const auto ms = [seconds](u64 ns) { return static_cast<double>(ns) / 1e6 / seconds; };
+    const auto us = [](u64 ns) { return static_cast<double>(ns) / 1e3; };
+    const auto phase = [&totals](Phase which) {
+        return totals.phase_ns[static_cast<size_t>(which)];
+    };
+    const auto per_call = [&totals](u64 count) {
+        return totals.calls == 0 ? 0.0
+                                 : static_cast<double>(count) / static_cast<double>(totals.calls);
+    };
+    u64 p50 = 0;
+    u64 p99 = 0;
+    u64 longest = 0;
+    if (!totals.call_ns.empty()) {
+        longest = *std::max_element(totals.call_ns.begin(), totals.call_ns.end());
+        p99 = Quantile(totals.call_ns, 0.99);
+        p50 = Quantile(totals.call_ns, 0.50);
+    }
+    u64 other = totals.total_ns - totals.lock_ns;
+    for (const u64 ns : totals.phase_ns) {
+        other -= (std::min)(other, ns);
+    }
+    std::string parts = fmt::format("lock wait {:.1f} ms", ms(totals.lock_ns));
+    if (map) {
+        const u64 zero_ns = phase(Phase::ZeroFill);
+        parts += fmt::format(", allocation {:.1f} ms", ms(phase(Phase::Allocate)));
+#ifdef _WIN32
+        // EDEN_NX2_SEC_RESERVE commits guest memory the first time the heap hands it out.
+        parts += fmt::format(" ({:.1f} MiB committed)", MiB(totals.committed) / seconds);
+#endif
+        parts += fmt::format(", zero fill {:.1f} ms ({:.1f} MiB at {:.2f} GB/s)", ms(zero_ns),
+                             MiB(totals.zero_filled) / seconds,
+                             zero_ns == 0 ? 0.0
+                                          : static_cast<double>(totals.zero_filled) /
+                                                static_cast<double>(zero_ns));
+    }
+    parts += fmt::format(", page table {:.1f} ms, host {} {:.1f} ms ({:.1f} regions per call)",
+                         ms(phase(Phase::PageTable)), map ? "map" : "unmap",
+                         ms(phase(Phase::Host)), per_call(totals.host_regions));
+    if (!map || phase(Phase::Free) != 0) {
+        parts += fmt::format(", free {:.1f} ms", ms(phase(Phase::Free)));
+    }
+    parts += fmt::format(", other {:.1f} ms; trace overhead {:.2f} ms", ms(other),
+                         ms(totals.trace_ns));
+#ifdef _WIN32
+    parts += fmt::format(" | page faults during calls {:.1f} per call, {:.0f}/s",
+                         per_call(totals.faults), static_cast<double>(totals.faults) / seconds);
+#endif
+    // Last, after the process context, so that parsers of the segments before it still match.
+    std::string tail =
+        fmt::format(" | page table lock wait {:.1f} ms (in other)", ms(totals.table_lock_ns));
+#ifdef _WIN32
+    tail += fmt::format(" | host {} calls: {}", map ? "map" : "unmap",
+                        FormatHost(direction, totals.host, 1e6 * seconds, seconds, "ms"));
+    if (map) {
+        tail += "; " + FormatReuse(totals.reuse, seconds);
+    } else if (totals.reuse.unfollowed != 0) {
+        tail += fmt::format("; {:.0f} views past {} a call not followed",
+                            static_cast<double>(totals.reuse.unfollowed) / seconds, KeptViews);
+    }
+#endif
+    if (g_slow_call_us != 0) {
+        tail += fmt::format(" | calls over {} us: {} in {:.1f} s, {} logged", g_slow_call_us,
+                            totals.slow_calls, seconds, totals.slow_logged);
+    }
+    LOG_INFO(HW_Memory,
+             "{} per second (EDEN_NX2_HEAP_TRACE, {:.1f} s): {:.0f} calls for {:.1f} MiB ({:.1f} "
+             "MiB changed), {:.1f} ms; per call p50 {:.0f} us, p99 {:.0f} us, max {:.0f} us | "
+             "{}{}{}",
+             map ? "MapPhysicalMemory" : "UnmapPhysicalMemory", seconds,
+             static_cast<double>(totals.calls) / seconds, MiB(totals.bytes) / seconds,
+             MiB(totals.changed) / seconds, ms(totals.total_ns), us(p50), us(p99), us(longest), parts,
+             context, tail);
+    std::vector<u64> call_ns = std::move(totals.call_ns);
+    call_ns.clear();
+    totals = Totals{};
+    totals.call_ns = std::move(call_ns);
+}
+
+/// With g_window.mutex held.
+void LogWindow(u64 now_ns, const ProcessCounters& counters) {
+    const double seconds = static_cast<double>(now_ns - g_window.start_ns) / 1e9;
+    std::string context;
+#ifdef _WIN32
+    context = fmt::format(
+        " | process: page faults {:.0f}/s, working set {:.0f} MiB, commit {:.0f} MiB",
+        static_cast<double>(static_cast<u32>(counters.faults - g_window.start_faults)) / seconds,
+        MiB(counters.working_set), MiB(counters.commit));
+    MEMORYSTATUSEX status{};
+    status.dwLength = sizeof(status);
+    if (GlobalMemoryStatusEx(&status)) {
+        context += fmt::format("; host: RAM available {:.0f} of {:.0f} MiB, commit {:.0f} of "
+                               "{:.0f} MiB",
+                               MiB(status.ullAvailPhys), MiB(status.ullTotalPhys),
+                               MiB(status.ullTotalPageFile - status.ullAvailPageFile),
+                               MiB(status.ullTotalPageFile));
+    }
+#endif
+    LogTotals(Direction::Map, g_window.totals[static_cast<size_t>(Direction::Map)], seconds,
+              context);
+    LogTotals(Direction::Unmap, g_window.totals[static_cast<size_t>(Direction::Unmap)], seconds,
+              context);
+    g_window.start_ns = now_ns;
+    g_window.start_faults = counters.faults;
+}
+
+} // Anonymous namespace
+
+const bool enabled = ReadSwitch();
+
+u64 NowNs() {
+    const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                        std::chrono::steady_clock::now().time_since_epoch())
+                        .count();
+    return (std::max)(static_cast<u64>(ns), u64{1});
+}
+
+u64 SlowCallMicroseconds() {
+    return g_slow_call_us;
+}
+
+void Reset() {
+    if (!enabled) {
+        return;
+    }
+    std::scoped_lock lock{g_window.mutex};
+    g_window.start_ns = 0;
+    g_window.start_faults = 0;
+    g_window.totals = {};
+    g_window.slow_line_credit_ns = SlowLineBurstNs;
+    g_window.slow_line_credit_at_ns = 0;
+    g_window.unmapped.clear();
+    g_window.unmapped_order.clear();
+}
+
+void Call::Begin(KernelCore& kernel, Direction direction, u64 bytes, const size_t& mapped,
+                 u64 start) {
+    locked_ns = NowNs();
+    start_ns = start;
+    mapped_size = &mapped;
+    mapped_before = mapped;
+    call_direction = direction;
+    host_regions = 0;
+    call_bytes = bytes;
+    phase_ns = {};
+    table_lock_ns = 0;
+    host = {};
+    thread = GetCurrentThreadPointer(kernel);
+    if (thread->m_nx2_heap_trace_call == nullptr) {
+        thread->m_nx2_heap_trace_call = this;
+    }
+    begin_core = thread->GetCurrentCore();
+    host_memory = &kernel.System().DeviceMemory().buffer;
+    faults_before = ReadProcessCounters().faults;
+    zero_filled_before = Common::HostMemory::ZeroFilledBytes();
+    committed_before = host_memory->GetCommitStats().committed_bytes;
+    trace_ns = NowNs() - locked_ns;
+}
+
+void Call::End() {
+    const u64 end_ns = NowNs();
+    const ProcessCounters counters = ReadProcessCounters();
+    const u64 zero_filled = Common::HostMemory::ZeroFilledBytes() - zero_filled_before;
+    const u64 committed = host_memory->GetCommitStats().committed_bytes - committed_before;
+    const u64 mapped_after = *mapped_size;
+    if (thread->m_nx2_heap_trace_call == this) {
+        thread->m_nx2_heap_trace_call = nullptr;
+    }
+    // Begin's reads and HostMemory's cycle reads are left out.
+    const u64 own_ns = trace_ns + host.trace_ns;
+    const u64 elapsed_ns = end_ns - start_ns;
+    const u64 call_ns = elapsed_ns - (std::min)(elapsed_ns, own_ns);
+    const u64 changed =
+        mapped_after > mapped_before ? mapped_after - mapped_before : mapped_before - mapped_after;
+    const u32 faults = static_cast<u32>(counters.faults - faults_before);
+    bool log_slow = false;
+    {
+        std::scoped_lock lock{g_window.mutex};
+        if (g_window.start_ns == 0) {
+            g_window.start_ns = start_ns;
+            g_window.start_faults = faults_before;
+        }
+        Totals& totals = g_window.totals[static_cast<size_t>(call_direction)];
+        if (totals.call_ns.capacity() == 0) {
+            totals.call_ns.reserve(8192);
+        }
+        ++totals.calls;
+        totals.bytes += call_bytes;
+        totals.changed += changed;
+        totals.total_ns += call_ns;
+        totals.lock_ns += locked_ns - start_ns;
+        for (size_t phase = 0; phase < PhaseCount; ++phase) {
+            totals.phase_ns[phase] += phase_ns[phase];
+        }
+        totals.host_regions += host_regions;
+        totals.faults += faults;
+        totals.zero_filled += zero_filled;
+        totals.committed += committed;
+        totals.call_ns.push_back(call_ns);
+        totals.table_lock_ns += table_lock_ns;
+        totals.host.Add(host);
+        FollowViews(call_direction, host, end_ns, totals.reuse);
+        if (g_slow_call_us != 0 && call_ns >= g_slow_call_us * 1000) {
+            ++totals.slow_calls;
+            if (end_ns > g_window.slow_line_credit_at_ns) {
+                if (g_window.slow_line_credit_at_ns != 0) {
+                    g_window.slow_line_credit_ns =
+                        (std::min)(SlowLineBurstNs, g_window.slow_line_credit_ns + end_ns -
+                                                        g_window.slow_line_credit_at_ns);
+                }
+                g_window.slow_line_credit_at_ns = end_ns;
+            }
+            if (g_window.slow_line_credit_ns >= SlowLineNs) {
+                g_window.slow_line_credit_ns -= SlowLineNs;
+                ++totals.slow_logged;
+                log_slow = true;
+            }
+        }
+        // Begin's and HostMemory's reads, then this function's and its wait for the lock.
+        totals.trace_ns += own_ns + (NowNs() - end_ns);
+        if (end_ns >= g_window.start_ns + WindowNs) {
+            LogWindow(end_ns, counters);
+        }
+    }
+    if (log_slow) {
+        LogSlow(call_ns, changed, faults, zero_filled, thread->GetCurrentCore());
+    }
+}
+
+void Call::LogSlow(u64 call_ns, u64 changed, u32 faults, u64 zero_filled, s32 end_core) const {
+    const bool map = call_direction == Direction::Map;
+    const auto us = [](u64 ns) { return static_cast<double>(ns) / 1e3; };
+    const auto phase = [this](Phase which) { return phase_ns[static_cast<size_t>(which)]; };
+    const u64 lock_ns = locked_ns - start_ns;
+    u64 other = call_ns - (std::min)(call_ns, lock_ns);
+    for (const u64 ns : phase_ns) {
+        other -= (std::min)(other, ns);
+    }
+    std::string parts = fmt::format("lock wait {:.0f} us", us(lock_ns));
+    if (map) {
+        parts += fmt::format(", allocation {:.0f} us, zero fill {:.0f} us ({} KiB)",
+                             us(phase(Phase::Allocate)), us(phase(Phase::ZeroFill)),
+                             zero_filled >> 10);
+    }
+    parts += fmt::format(", page table {:.0f} us, host {} {:.0f} us", us(phase(Phase::PageTable)),
+                         map ? "map" : "unmap", us(phase(Phase::Host)));
+#ifdef _WIN32
+    HostCounts host_counts;
+    host_counts.Add(host);
+    parts += fmt::format(" ({})", FormatHost(call_direction, host_counts, 1e3, 1.0, "us"));
+#endif
+    if (!map || phase(Phase::Free) != 0) {
+        parts += fmt::format(", free {:.0f} us", us(phase(Phase::Free)));
+    }
+    parts += fmt::format(", other {:.0f} us (page table lock wait {:.0f} us)", us(other),
+                         us(table_lock_ns));
+    // As the guest thread lines name it (EDEN_NX2_GUEST_THREAD_STATS).
+    std::string caller = fmt::format("t{} prio {} on guest core {}", thread->GetThreadId(),
+                                     thread->GetPriority(), begin_core);
+    if (end_core != begin_core) {
+        caller += fmt::format(" then {}", end_core);
+    }
+#ifdef _WIN32
+    caller += fmt::format(", host CPU {}", GetCurrentProcessorNumber());
+    parts += fmt::format(" | page faults during the call {}", faults);
+#else
+    static_cast<void>(faults);
+#endif
+    LOG_INFO(HW_Memory,
+             "Slow {} (EDEN_NX2_HEAP_TRACE_SLOW_US {}): {:.0f} us for {} KiB ({} KiB changed), "
+             "{} host regions; {} | {}",
+             map ? "MapPhysicalMemory" : "UnmapPhysicalMemory", g_slow_call_us, us(call_ns),
+             call_bytes >> 10, changed >> 10, host_regions, caller, parts);
+}
+
+void Phases::Begin(KernelCore& kernel) {
+    call = GetCurrentThreadPointer(kernel)->m_nx2_heap_trace_call;
+    if (call != nullptr) {
+        since = NowNs();
+        host_trace_ns = call->host.trace_ns;
+    }
+}
+
+void Phases::EndSlow(Phase phase) {
+    const u64 now = NowNs();
+    u64 ns = now - since;
+    if (phase == Phase::Host) {
+        Common::HostMemory::SetCallTrace(nullptr);
+        // HostMemory's cycle reads, which the call's time leaves out too.
+        const u64 own_ns = call->host.trace_ns - host_trace_ns;
+        host_trace_ns = call->host.trace_ns;
+        ns -= (std::min)(ns, own_ns);
+        ++call->host_regions;
+    }
+    call->phase_ns[static_cast<size_t>(phase)] += ns;
+    since = now;
+}
+
+} // namespace Kernel::HeapTrace
