+    memmove(&g_vp[at + 1], &g_vp[at], (size_t)(g_nvp - at) * sizeof *g_vp); g_vp[at] = v; g_nvp++; o->vp = v;
+#if defined(_WIN32)
+    // Lichii (Windows): never dense. The range is not aliased for the CPU there (vpool_map), and a dense pool's textures read it in place: textures read through the page table
+    o->vmode = 2;
+#else
+    o->vmode = o->size > DM_GAME_APP_POOL ? 2 : 0;
+#endif
+    pthread_mutex_unlock(&g_vp_mu);
+    static _Atomic int nsp;   // (Windows makes every virtual pool sparse: the first 16 smaller ones are logged)
+    if (o->vmode == 2 && (o->size > DM_GAME_APP_POOL || atomic_fetch_add(&nsp, 1) < 16)) LOG("[nvn] virtual pool %p (%#llx bytes, flags %#x): sparse, own address range %p+%#llx, physical pages are remapped into it", (const void *)o, (unsigned long long)o->size, o->flags, a, (unsigned long long)len);
+    return a;
+}
+static void vpool_drop(pool_t *o) {   // caller holds g_vp_mu
+    struct vpool *v = o->vp; if (!v) return;
+    for (int k = 0; k < v->nrun; k++) mtl_pool_del(v->base + v->run[k].lo);
+#if !PLAT_APPLE
+    mtl_pool_alias(v->base, v->len < v->size ? v->len : v->size, NULL);   // (the GPU's aliases go with the range: a pool reserved there later starts unmapped)
+#endif
+    munmap(v->base, v->len);
+    for (uint64_t l = 0; l < (v->size + (2u << 20) - 1) >> 21; l++) free(v->pt[l]);
+    for (int i = 0; i < g_nvp; i++) if (g_vp[i] == v) { memmove(&g_vp[i], &g_vp[i + 1], (size_t)(g_nvp - 1 - i) * sizeof *g_vp); g_nvp--; break; }
