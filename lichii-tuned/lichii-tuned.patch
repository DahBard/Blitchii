+            switches[entry.name] = Control::FindSwitch(entry.name)->load(std::memory_order_relaxed);
+        }
+        Control::LoadExperiments();
+        json boot_only = json::array();
+        for (int n = 0; n < Control::ExperimentCount; ++n) {
+            const std::string name = fmt::format("EDEN_NX2_EXP{}", n);
+            if (Control::IsBootOnlySwitch(name)) {
+                boot_only.push_back(name);
+            } else if (const int value = Control::Experiment(n); value != 0) {
+                switches[name] = value;
+            }
+        }
+        json changed = json::object();
+        for (const auto& [name, entry] : owners.entries) {
+            changed[name] = {{"original", entry.original}, {"client", entry.client}};
+        }
+        return {{"switches", std::move(switches)},
+                {"experiments", fmt::format("EDEN_NX2_EXP0..{} (those not listed are 0)",
+                                            Control::ExperimentCount - 1)},
+                {"boot_only", std::move(boot_only)},
+                {"changed", std::move(changed)}};
+    }
+    const std::string name = params.at("name").get<std::string>();
+    std::atomic<int>* const value = Control::FindSwitch(name);
+    if (value == nullptr || Control::IsBootOnlySwitch(name)) {
+        if (value != nullptr || name.starts_with("EDEN_") || name.starts_with("LICHII_")) {
+            throw std::runtime_error{fmt::format(
