+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <algorithm>
+#include <cwchar>
+#include <iterator>
+
+#include <fmt/format.h>
+
+#include "common/nx2_environment.h"
+
+#ifdef _WIN32
+#include <windows.h>
+#include "common/string_util.h"
+#else
+extern char** environ;
+#endif
+
+namespace Common {
+
+std::vector<std::pair<std::string, std::string>> EnvironmentWithPrefixes(
+    std::initializer_list<std::string_view> prefixes) {
+    std::vector<std::pair<std::string, std::string>> variables;
+    const auto add = [&](std::string_view entry) {
+        const size_t equals = entry.find('=');
+        // Windows keeps per-drive directories as "=C:=C:\..." entries.
+        if (equals == 0 || equals == std::string_view::npos) {
+            return;
+        }
+        const std::string_view name = entry.substr(0, equals);
+        if (std::ranges::any_of(
+                prefixes, [name](std::string_view prefix) { return name.starts_with(prefix); })) {
+            variables.emplace_back(std::string{name}, std::string{entry.substr(equals + 1)});
+        }
+    };
+#ifdef _WIN32
+    // The OS block: _putenv_s, which applies nx2_switches.txt, keeps it in step with the CRT's.
+    if (wchar_t* const block = GetEnvironmentStringsW()) {
+        for (const wchar_t* entry = block; *entry != L'\0'; entry += std::wcslen(entry) + 1) {
+            add(UTF16ToUTF8(std::wstring_view{entry}));
+        }
+        FreeEnvironmentStringsW(block);
+    }
+#else
+    for (char** entry = environ; entry != nullptr && *entry != nullptr; ++entry) {
+        add(*entry);
+    }
+#endif
+    std::ranges::sort(variables);
+    return variables;
+}
+
+std::string FormatEnvironment(const std::vector<std::pair<std::string, std::string>>& variables) {
+    if (variables.empty()) {
+        return "none";
+    }
+    std::string line = fmt::format("{}: ", variables.size());
+    for (size_t index = 0; index < variables.size(); ++index) {
+        const auto& [name, value] = variables[index];
+        const bool quote = value.empty() || value.find_first_of(" ,\"") != std::string::npos;
+        std::string shown;
+        for (const char c : value) {
+            if (c == '"') {
+                shown += '\\';
+            }
+            shown += c;
+        }
+        fmt::format_to(std::back_inserter(line), "{}{}={}{}{}", index == 0 ? "" : ", ", name,
+                       quote ? "\"" : "", shown, quote ? "\"" : "");
+    }
+    return line;
+}
+
+} // namespace Common
