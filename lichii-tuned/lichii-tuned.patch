+static void cap_policy_restore(cap_policy c) { if (c.rt) thread_policy_set(pthread_mach_thread_np(pthread_self()), THREAD_TIME_CONSTRAINT_POLICY, (thread_policy_t)&c.p, THREAD_TIME_CONSTRAINT_POLICY_COUNT); }
