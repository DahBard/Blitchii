+std::string IpcName(const IpcCommand& command) {
+    return fmt::format("{}::{}{} ({})", command.service, command.command,
+                       command.tipc ? " tipc" : "", command.name);
+}
+
+void ReportIpcWindow(const IpcWindow& window, IpcClock::time_point end) {
+    const auto ms = [](u64 ns) { return static_cast<double>(ns) / 1e6; };
+    std::vector<std::pair<IpcCommand, IpcTimes>> rows(window.commands.begin(),
+                                                      window.commands.end());
+    u64 calls = 0;
+    u64 handler_ns = 0;
+    std::map<std::string_view, IpcTimes> services;
+    for (const auto& [command, times] : rows) {
+        calls += times.calls;
+        handler_ns += times.ns;
+        IpcTimes& service = services[command.service];
+        service.calls += times.calls;
+        service.ns += times.ns;
+        service.max_ns = std::max(service.max_ns, times.max_ns);
+    }
+    constexpr size_t Top = 6;
+    std::string most_called;
+    std::ranges::sort(rows, std::greater<>{}, [](const auto& row) { return row.second.calls; });
+    for (size_t i = 0; i < std::min(rows.size(), Top); ++i) {
+        fmt::format_to(std::back_inserter(most_called), "{}{} {}", i == 0 ? "" : ", ",
+                       IpcName(rows[i].first), rows[i].second.calls);
+    }
+    std::string most_time;
+    std::ranges::sort(rows, std::greater<>{}, [](const auto& row) { return row.second.ns; });
+    for (size_t i = 0; i < std::min(rows.size(), Top); ++i) {
+        fmt::format_to(std::back_inserter(most_time), "{}{} {:.3f} ms in {} (max {:.3f})",
+                       i == 0 ? "" : ", ", IpcName(rows[i].first), ms(rows[i].second.ns),
+                       rows[i].second.calls, ms(rows[i].second.max_ns));
+    }
+    std::vector<std::pair<std::string_view, IpcTimes>> by_service(services.begin(),
+                                                                  services.end());
+    std::string service_calls;
+    std::ranges::sort(by_service, std::greater<>{},
+                      [](const auto& row) { return row.second.calls; });
+    for (size_t i = 0; i < std::min(by_service.size(), Top); ++i) {
+        fmt::format_to(std::back_inserter(service_calls), "{}{} {}", i == 0 ? "" : ", ",
+                       by_service[i].first, by_service[i].second.calls);
+    }
+    std::ranges::sort(by_service, std::greater<>{},
+                      [](const auto& row) { return row.second.ns; });
+    std::string service_time;
+    for (size_t i = 0; i < std::min(by_service.size(), Top); ++i) {
+        fmt::format_to(std::back_inserter(service_time), "{}{} {:.3f} ms in {}",
+                       i == 0 ? "" : ", ", by_service[i].first, ms(by_service[i].second.ns),
+                       by_service[i].second.calls);
+    }
+    // The longest, in the order they ended.
+    std::vector<IpcSlowCall> longest = window.slow;
+    std::ranges::sort(longest, {}, &IpcSlowCall::end);
+    std::string slow;
+    for (const IpcSlowCall& call : longest) {
+        fmt::format_to(std::back_inserter(slow), "{}{} {:.2f} ms t{} at +{:.3f} s",
+                       slow.empty() ? "" : ", ", IpcName(call.command), ms(call.ns),
+                       call.thread_id, std::chrono::duration<double>(call.end).count());
+    }
+    if (window.slow_calls > window.slow.size()) {
+        fmt::format_to(std::back_inserter(slow), " and {} more",
+                       window.slow_calls - window.slow.size());
+    }
+    LOG_INFO(Service,
+             "IPC in {:.3f} s: {} calls, {:.3f} ms in handlers; most called: {}; most handler "
+             "time: {}; services most called: {}; services by handler time: {}; longest calls "
+             "over 2 ms: {}",
+             std::chrono::duration<double>(end - window.start).count(), calls, ms(handler_ns),
+             most_called, most_time, service_calls, service_time, slow.empty() ? "none" : slow);
+}
+
+void NoteIpcCall(const IpcCommand& command, u64 thread_id, IpcClock::time_point start) {
+    const IpcClock::time_point end = IpcClock::now();
+    const u64 ns =
+        static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(end - start).count());
+    IpcWindow finished;
+    {
+        std::scoped_lock lock{g_ipc_mutex};
+        IpcWindow& window = g_ipc_window;
+        if (window.start == IpcClock::time_point{}) {
+            window.start = start;
+        } else if (end - window.start >= std::chrono::seconds{1}) {
+            finished = std::exchange(window, {});
+            window.start = end;
+        }
+        IpcTimes& times = window.commands[command];
+        ++times.calls;
+        times.ns += ns;
+        times.max_ns = std::max(times.max_ns, ns);
+        if (ns > IpcSlowNs) {
+            ++window.slow_calls;
+            const IpcSlowCall call{command, ns, thread_id, end - window.start};
+            if (window.slow.size() < IpcSlowKept) {
+                window.slow.push_back(call);
+            } else if (const auto shortest =
+                           std::ranges::min_element(window.slow, {}, &IpcSlowCall::ns);
+                       shortest->ns < ns) {
+                *shortest = call;
+            }
+        }
+    }
+    if (finished.start != IpcClock::time_point{}) {
+        ReportIpcWindow(finished, end);
+    }
+}
