+/// gpu_dirty_memory_manager.h, vulkan_memory_allocator.cpp, texture_cache.h). Flipping their slot
+/// would change nothing, so the debug server refuses them until a reader of Experiment(n) replaces
+/// those reads.
+inline constexpr std::array<int, 7> BootOnlyExperiments{8, 9, 18, 29, 35, 42, 43};
