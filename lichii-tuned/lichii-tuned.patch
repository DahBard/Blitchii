+    for (size_t i = 5; i < nw;) {
+        uint32_t op = w[i] & 0xffff, len = w[i] >> 16; const uint32_t *in = w + i;
+        if (i == ep_at) {   // a new PrimitiveId input joins the interface, and from SPIR-V 1.4 the claim and guard variables
