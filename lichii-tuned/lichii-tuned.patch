+}
+
+Fsr4Upscaler::~Fsr4Upscaler() = default;
+
+void Fsr4Upscaler::CreateOutput(VkExtent2D, VkFormat) {}
+
+bool Fsr4Upscaler::CreateContext(VkExtent2D, VkExtent2D, bool, bool) {
+    return false;
+}
+
+void Fsr4Upscaler::DestroyContext() {}
