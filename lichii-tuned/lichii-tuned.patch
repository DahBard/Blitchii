+static void bc1_fmt(vka_fmt *f) { f->vk = VK_FORMAT_BC1_RGBA_UNORM_BLOCK; f->view = f->srgb ? VK_FORMAT_BC1_RGBA_SRGB_BLOCK : VK_FORMAT_BC1_RGBA_UNORM_BLOCK; f->bpb = 8; }
