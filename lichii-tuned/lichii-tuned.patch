@@ -0,0 +1,40 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// The front end's and the replay's log lines (dm.h LOG, VLOG, VRED, die) in Lichii's log, class
+// Render.NvnDirect, with their text as upstream writes it ("[dm] ...").
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+#include "common/logging.h"
+
+extern "C" void dm_log(const char* file, int line, const char* func, const char* fmt, ...) {
+    // Upstream's prefixes: "[dm] [RED] ..." marks what does not work as the game expects,
+    // "[dm] FATAL ..." precedes an abort.
+    const char* tag = fmt + (std::strncmp(fmt, "[dm] ", 5) == 0 ? 5 : 0);
+    const auto level = std::strncmp(tag, "FATAL", 5) == 0   ? Common::Log::Level::Critical
+                       : std::strncmp(tag, "[RED]", 5) == 0 ? Common::Log::Level::Error
+                                                            : Common::Log::Level::Info;
+    if (!Common::Log::IsLevelEnabled(Common::Log::Class::Render_NvnDirect, level))
+        return;
+    char buffer[1024];
+    va_list args;
+    va_start(args, fmt);
+    va_list again;
+    va_copy(again, args);
+    const int length = std::vsnprintf(buffer, sizeof(buffer), fmt, args);
+    va_end(args);
+    std::string text;
+    const char* message = buffer;
+    if (length >= static_cast<int>(sizeof(buffer))) {
+        text.resize(static_cast<std::size_t>(length));
+        std::vsnprintf(text.data(), text.size() + 1, fmt, again);
+        message = text.c_str();
+    }
+    va_end(again);
+    Common::Log::FmtLogMessage(Common::Log::Class::Render_NvnDirect, level, file,
+                               static_cast<unsigned>(line), func, "{}", message);
+}
diff --git a/src/video_core/nvn_direct/nvn_dispatch.c b/src/video_core/nvn_direct/nvn_dispatch.c
new file mode 100644
index 0000000000..aebbc5c59e
--- /dev/null
+++ b/src/video_core/nvn_direct/nvn_dispatch.c
@@ -0,0 +1,338 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// The dispatch boundary between a guest NVN call (its registers) and the front end's
+// implementation: one constant offset turns the game's addresses into host pointers into
+// Lichii's fastmem arena (object pointers, data pointers, buffer / texture addresses, command
+// handles, and the addresses inside the arrays listed in gen_dispatch.py) and turns returned
+// host pointers back. Objects and command records stay in place in the game's memory (nxnative's
+// model). Values at or past the guest address space are host addresses the front end made itself
+// (host-lent command segments, the shared empty recording, virtual pool ranges): they pass both
+// ways unchanged.
+
+#include <sys/mman.h>   // (Windows: bananative/shim/win32)
+#if !defined(_WIN32)
+#include <signal.h>
+#include <execinfo.h>
+#include <sys/prctl.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#endif
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "hle.h"
+#include "nvn_count.h"
+#include "nvn_direct.h"
+#include "nvn_direct_front.h"
+#include "nvn_protos.h"
+#include "nvn_obj.h"
+#include "nvn_mtl.h"
+
+typedef struct { NVNbufferAddress data; const void* control; uint64_t ext; } shader_data_ext;
+typedef struct { NVNmemoryPool* phys; int64_t poff, voff; uint64_t size; int32_t storage_class, pad; } mapping_request;
+_Static_assert(sizeof(mapping_request) == 0x28, "NVNmappingRequest");
+
+static uintptr_t g_arena;
+static uint64_t g_guest_size;
+static nvn_direct_memory g_memory;
+
+static inline uint64_t host_addr(uint64_t a) {
+    return a != 0 && a < g_guest_size ? (uint64_t)g_arena + a : a;
+}
+static inline void* host_ptr(uint64_t a) { return (void*)(uintptr_t)host_addr(a); }
+static inline uint64_t guest_addr(uint64_t h) {
+    return h >= g_arena && h - g_arena < g_guest_size ? h - g_arena : h;
+}
+uint64_t nvn_direct_guest_of(uint64_t host) { return guest_addr(host); }
+uint64_t nvn_direct_host_of(uint64_t guest) { return host_addr(guest); }
+void* nvn_direct_map_view(uint64_t address, uint64_t size, uint64_t* unmapped) {
+    *unmapped = 0;
+    return g_memory.map_view ? g_memory.map_view(g_memory.context, address, size, unmapped) : NULL;
+}
+void nvn_direct_unmap_view(void* view, uint64_t size) { g_memory.unmap_view(g_memory.context, view, size); }
+void nvn_direct_track_pages(uint64_t address, uint64_t size, int armed) {
+    if (g_memory.track_pages) g_memory.track_pages(g_memory.context, address, size, armed);
+}
+int nvn_direct_backing_file(uint64_t address, uint64_t* offset) {
+    if (g_memory.backing_fd < 0 || !g_memory.backing) return -1;
+    const uint8_t* const backing = g_memory.backing(g_memory.context, address);
+    if (!backing) return -1;
+    *offset = (uint64_t)(backing - g_memory.backing_base);
+    return g_memory.backing_fd;
+}
+uint64_t nvn_direct_alias_pages(void* to, uint64_t host, uint64_t size) {
+    const int guest = host >= g_arena && host - g_arena < g_guest_size;
+    uint64_t missing = 0;
+    for (uint64_t o = 0, n; o < size; o += n) {
+        uint64_t offset = 0, next = 0;
+        const int fd = guest ? nvn_direct_backing_file(host - g_arena + o, &offset) : -1;
+        n = 0x1000;
+        while (fd >= 0 && o + n < size && nvn_direct_backing_file(host - g_arena + o + n, &next) == fd &&
+               next == offset + n) {
+            n += 0x1000;
+        }
+        uint8_t* const at = (uint8_t*)to + o;
+        if (fd < 0 || mmap(at, n, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_FIXED, fd, (off_t)offset) ==
+                          MAP_FAILED) {
+            mmap(at, n, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
+            missing += n;
+        }
+    }
+    return missing;
+}
+#if defined(_WIN32)
+int nvn_vpool_translate(uint64_t a, uint64_t* phys); // hle_nvn.c
+static uint8_t g_vpool_sink[64]; // (the writes to virtual pool pages nothing is mapped at)
+#endif
+void* nvn_direct_writable(uint64_t host) {
+#if defined(_WIN32)
+    uint64_t phys;
+    int vpool = 0;
+    if ((host < g_arena || host - g_arena >= g_guest_size) && nvn_vpool_translate(host, &phys)) {
+        if (!phys) return g_vpool_sink;
+        host = phys;
+        vpool = 1;
+    }
+#endif
+    const uint64_t guest = guest_addr(host);
+    if (guest >= g_guest_size || !g_memory.backing) return (void*)(uintptr_t)host_addr(host);
+    void* const backing = g_memory.backing(g_memory.context, guest);
+#if defined(_WIN32)
+    // (a virtual pool page whose physical page the guest has since unmapped: the sink, not the
+    // arena)
+    if (!backing && vpool) return g_vpool_sink;
+#endif
+    return backing ? backing : (void*)(uintptr_t)host_addr(host);
+}
+int nvn_vpool_page_unmapped(uint64_t a); // hle_nvn.c
+const void* nvn_direct_readable(uint64_t host) {
+    if (host < g_arena || host - g_arena >= g_guest_size) {
+#if defined(_WIN32)
+        uint64_t phys;
+        if (!nvn_vpool_translate(host, &phys)) return (const void*)(uintptr_t)host;
+        if (!phys) return NULL;
+        host = phys;
+        if (host < g_arena || host - g_arena >= g_guest_size) return (const void*)(uintptr_t)host;
+#else
+        return nvn_vpool_page_unmapped(host) ? NULL : (const void*)(uintptr_t)host;
+#endif
+    }
+    if (!g_memory.backing) return (const void*)(uintptr_t)host;
+    return g_memory.backing(g_memory.context, host - g_arena);
+}
+static inline float F_float(uint64_t v) { uint32_t u = (uint32_t)v; float f; memcpy(&f, &u, 4); return f; }
+static inline double F_double(uint64_t v) { double d; memcpy(&d, &v, 8); return d; }
+static inline uint64_t R_float(float f) { uint32_t u; memcpy(&u, &f, 4); return u; }
+static inline uint64_t R_double(double d) { uint64_t u; memcpy(&u, &d, 8); return u; }
+
+// Host copies of the arrays a call passes, per thread: at most two arrays per call (gen_dispatch.py
+// checks), each copy valid until the thread's next call.
+static _Thread_local struct { void* p; size_t cap; } g_scratch[2];
+static void* scratch(int k, size_t bytes) {
+    if (g_scratch[k].cap < bytes) {
+        free(g_scratch[k].p);
+        g_scratch[k].cap = bytes < 256 ? 256 : bytes;
+        g_scratch[k].p = malloc(g_scratch[k].cap);
+    }
+    return g_scratch[k].p;
+}
+static void* xl_pointers(uint64_t a, int n, int k) {
+    if (!a || n <= 0) return host_ptr(a);
+    const uint64_t* in = host_ptr(a);
+    uint64_t* out = scratch(k, sizeof *out * (size_t)n);
+    for (int i = 0; i < n; i++) out[i] = host_addr(in[i]);
+    return out;
+}
+static void* xl_handles(uint64_t a, int n, int k) { return xl_pointers(a, n, k); }
+static void* xl_buffer_ranges(uint64_t a, int n, int k) {
+    if (!a || n <= 0) return host_ptr(a);
+    const NVNbufferRange* in = host_ptr(a);
+    NVNbufferRange* out = scratch(k, sizeof *out * (size_t)n);
+    for (int i = 0; i < n; i++) out[i] = (NVNbufferRange){host_addr(in[i].address), in[i].size};
+    return out;
+}
+static void* xl_shader_data(uint64_t a, int n, int k) {
+    if (!a || n <= 0) return host_ptr(a);
+    const NVNshaderData* in = host_ptr(a);
+    NVNshaderData* out = scratch(k, sizeof *out * (size_t)n);
+    for (int i = 0; i < n; i++) out[i] = (NVNshaderData){host_addr(in[i].data), host_ptr((uint64_t)(uintptr_t)in[i].control)};
+    return out;
+}
+static void* xl_shader_data_ext(uint64_t a, int n, int k) {
+    if (!a || n <= 0) return host_ptr(a);
+    const shader_data_ext* in = host_ptr(a);
+    shader_data_ext* out = scratch(k, sizeof *out * (size_t)n);
+    for (int i = 0; i < n; i++) out[i] = (shader_data_ext){host_addr(in[i].data), host_ptr((uint64_t)(uintptr_t)in[i].control), in[i].ext};
+    return out;
+}
+static void* xl_mapping_requests(uint64_t a, int n, int k) {
+    if (!a || n <= 0) return host_ptr(a);
+    const mapping_request* in = host_ptr(a);
+    mapping_request* out = scratch(k, sizeof *out * (size_t)n);
+    for (int i = 0; i < n; i++) {
+        out[i] = in[i];
+        out[i].phys = host_ptr((uint64_t)(uintptr_t)in[i].phys);
+    }
+    return out;
+}
+
+// s: the guest's stack at the call (its arguments past x7 / v7), as a host pointer.
+typedef uint64_t (*dispatch_fn)(void* fn, const uint64_t* x, const uint64_t* v, const uint64_t* s, uint64_t* v0);
+#define D(name, flags, body)                                                                       \
+    static uint64_t d_##name(void* fn, const uint64_t* x, const uint64_t* v, const uint64_t* s,   \
+                             uint64_t* v0) {                                                       \
+        (void)x; (void)v; (void)s; (void)v0;                                                       \
+        body                                                                                       \
+    }
+#include "nvn_dispatch.inc"
+#undef D
+typedef struct { const char* name; dispatch_fn d; int flags; } dispatch_entry;
+#define D(name, flags, body) {#name, d_##name, flags},
+static const dispatch_entry g_dispatch[] = {
+#include "nvn_dispatch.inc"
+};
+#undef D
+
+// The front end's slot table (hle_nvn.c)
+typedef struct { _Atomic uint64_t cnt; void* fn; } nvn_slot_t;
+extern nvn_slot_t nvn_slot[NVN_NFUNC];
+extern void* nvn_big_real[NVN_NFUNC];
+extern void* nvn_real[NVN_NFUNC];
+extern const char* nvn_names[NVN_NFUNC];
+void nvn_unimpl_entry(void);
+void nvn_prof_entry(void);
+void nvn_big_entry(void);
+void nvn_nops_register(void);
+void* nvn_nop_fn(void);
+
+_Thread_local uint64_t nvn_direct_guest_lr;
+static struct { void* fn; const dispatch_entry* d; } g_slot[NVN_NFUNC];
+// The empty implementations of names without a prototype (hle_nvn.c g_nops: the shading-rate calls):
+// they take no arguments and return nothing.
+static uint64_t d_empty(void* fn, const uint64_t* x, const uint64_t* v, const uint64_t* s, uint64_t* v0) {
+    (void)x; (void)v; (void)s; (void)v0;
+    ((void (*)(void))fn)();
+    return 0;
+}
+static const dispatch_entry g_empty = {"(empty)", d_empty, 0};
+
+#if defined(_WIN32)
+// Windows: Lichii's own handler reports a crash with the faulting thread's stack (the Host crash line and eden_crash.dmp)
+static void crash_stack_install(void) {}
+#else
+// Lab (DM_VK_CRASH_STACK=1, dotfiles-25x.16): a crash outside the JIT writes the faulting thread's stack to stderr (addresses as eden-cli(+offset), for
+// llvm-symbolizer). The handler before it (dynarmic's, when it was there first) runs first and decides: a fastmem fault it handles returns as before
+static struct sigaction g_crash_old;
+static void crash_stack(int sig, siginfo_t* si, void* uc) {
+    if ((g_crash_old.sa_flags & SA_SIGINFO) && g_crash_old.sa_sigaction) {
+        g_crash_old.sa_sigaction(sig, si, uc);
+        struct sigaction now;
+        sigaction(sig, NULL, &now);
+        if (now.sa_handler != SIG_DFL) return;   // (handled: dynarmic resets the action only for a fault it does not handle)
+    }
+    char h[160], name[17] = {0};
+    prctl(PR_GET_NAME, name);
+    extern _Thread_local char vka_crash_note[96];   // (what the thread was doing, when it says: vka_pso.c)
+    int k = snprintf(h, sizeof h, "[dm] [RED] crash: signal %d at %p, thread %ld %s %s\n", sig, si->si_addr, (long)syscall(SYS_gettid), name, vka_crash_note);
+    write(2, h, (size_t)k);
+    void* b[64];
+    backtrace_symbols_fd(b, backtrace(b, 64), 2);
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
+static void crash_stack_install(void) {
+    const char* e = getenv("DM_VK_CRASH_STACK");
+    if (!e || atoi(e) != 1) return;
+    void* warm[2];
+    backtrace(warm, 2);   // (libgcc loaded outside the handler)
+    struct sigaction sa;
+    memset(&sa, 0, sizeof sa);
+    sa.sa_sigaction = crash_stack;
+    sa.sa_flags = SA_SIGINFO | SA_ONSTACK;
+    sigemptyset(&sa.sa_mask);
+    sigaction(SIGSEGV, &sa, &g_crash_old);
+}
+#endif
+
+// The game's NVN (nvn_direct_init): the front end and the replay choose NVN2's behaviour by
+// dm_sdk_ounce and NVN1's API version by dm_sdk_major (upstream's loader.c reads both from the sdk).
+static int g_switch2, g_sdk_major;
+int dm_sdk_ounce(void) { return g_switch2; }
+int dm_sdk_major(void) { return g_sdk_major; }
+
+void nvn_direct_init(uint8_t* arena, uint64_t guest_size, const nvn_direct_memory* memory,
+                     int switch2, int sdk_major) {
+    crash_stack_install();
+    g_arena = (uintptr_t)arena;
+    g_guest_size = guest_size;
+    g_memory = *memory;
+    g_switch2 = switch2 != 0;
+    g_sdk_major = sdk_major;
+    nvn_nops_register();
+    for (int i = 0; i < NVN_NFUNC; i++) {
+        void* fn = nvn_slot[i].fn;
+        if (fn == (void*)nvn_prof_entry) fn = nvn_real[i];
+        if (fn == (void*)nvn_big_entry) fn = nvn_big_real[i];
+        if (fn == (void*)nvn_unimpl_entry) fn = NULL;
+        for (size_t k = 0; fn && k < sizeof g_dispatch / sizeof *g_dispatch; k++)
+            if (!strcmp(g_dispatch[k].name, nvn_names[i])) g_slot[i].d = &g_dispatch[k];
+        // Without a dispatch entry: an empty implementation, or a name the hook answers itself
+        // (nvnBootstrapLoader, nvnDeviceGetProcAddress: gen_dispatch.py HOOK_OWN).
+        if (fn && !g_slot[i].d && fn == nvn_nop_fn()) g_slot[i].d = &g_empty;
+        g_slot[i].fn = g_slot[i].d ? fn : NULL;
+    }
+}
+
+int nvn_direct_name_count(void) { return NVN_NFUNC; }
+const char* nvn_direct_name(int slot) { return nvn_names[slot]; }
+int nvn_direct_implemented(int slot) { return g_slot[slot].fn != NULL; }
+int nvn_direct_float_args(int slot) {
+    return g_slot[slot].d && (g_slot[slot].d->flags & (NVN_DISPATCH_FLOAT_ARGS | NVN_DISPATCH_FLOAT_RETURN));
+}
+
+int nvn_direct_call_blocks(int slot, const uint64_t x[8]) {
+    const char* const name = nvn_direct_name(slot);
+    if (!strcmp(name, "nvnSyncWait")) {
+        const sync_t* const s = host_ptr(x[0]);
+        return s->fenced && !(s->fenced == 2 ? mtl_wait_acq : mtl_wait)(s->fence, 0);   // (one not fenced yet answers at once: hle_nvn.c)
+    }
+    if (!strcmp(name, "nvnQueueFinish")) return !mtl_wait(((const queue_t*)host_ptr(x[0]))->last_fence, 0);
+    // A texture the GPU wrote is read back once everything submitted is done (the game waited for its own work; the replay may still be behind it)
+    if (!strcmp(name, "nvnTextureReadTexels") || !strcmp(name, "nvnTextureReadTexelsStrided"))
+        return mtl_tex_gpu_owned(((const tex_t*)host_ptr(x[0]))->serial) && !mtl_wait_acq(mtl_last_fence(), 0);
+    return 0;
+}
+// Lab (DM_VK_TS_LOG=1, dotfiles-25x.26): the calls of each name, for the counter timestamp log (vka_exec.c)
+static _Atomic uint64_t g_calls[NVN_NFUNC];
+static int calls_on(void) {
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("DM_VK_TS_LOG"); on = e && atoi(e) > 0; }
+    return on;
+}
+uint64_t nvn_direct_calls(const char* name) {
+    for (int i = 0; i < NVN_NFUNC; i++) if (!strcmp(nvn_names[i], name)) return atomic_load(&g_calls[i]);
+    return 0;
+}
+uint64_t nvn_direct_call(int slot, const uint64_t x[8], const uint64_t v[8], uint64_t sp, uint64_t lr, uint64_t* v0) {
+    nvn_direct_guest_lr = lr;
+    if (calls_on()) atomic_fetch_add_explicit(&g_calls[slot], 1, memory_order_relaxed);
+    return g_slot[slot].d->d(g_slot[slot].fn, x, v, (const uint64_t*)host_ptr(sp), v0);
+}
+
+// nvnDeviceGetInteger: the game's own NVN2 driver's answers, as Lichii captured them or read the
+// constants among them from its code (hle_nvn.c asks dm_sdk_nvn2_item before its table).
+enum { DEVICE_ITEMS = 0x100 };
+static int g_item_known[DEVICE_ITEMS], g_item_value[DEVICE_ITEMS];
+void nvn_direct_set_device_integer(unsigned item, int value) {
+    if (item >= DEVICE_ITEMS) return;
+    g_item_value[item] = value;
+    g_item_known[item] = 1;
+}
+int dm_sdk_nvn2_item(unsigned item, int* out) {
+    if (item >= DEVICE_ITEMS || !g_item_known[item]) return 0;
+    *out = g_item_value[item];
+    return 1;
+}
diff --git a/src/video_core/nvn_direct/nvn_present.c b/src/video_core/nvn_direct/nvn_present.c
new file mode 100644
index 0000000000..33ab0c6f34
--- /dev/null
+++ b/src/video_core/nvn_direct/nvn_present.c
@@ -0,0 +1,222 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Presents in direct mode (dotfiles-25x.7): what upstream's vka_present.c did (left out there),
+// handing the presented image to Lichii's presenter instead of a swapchain of the replay's own.
+// The game's present takes a ticket (vka_present_reserve, on the game's thread, from mtl_present);
+// the replay worker fills it once every submission before it was handed to the queue
+// (vka_present_fill: the image and the fence that finishes drawing it); Lichii's present on the
+// game's thread waits for the fill and takes a reference to the image (nvn_direct_present_take),
+// and Lichii's GPU thread shows it (nvn_direct_present_frame from RasterizerVulkan's
+// AccelerateDisplay), so screenshots, HDR conversion and the composite are Lichii's own.
+
+#include <pthread.h>
+#include <stdatomic.h>
+#include <string.h>
+
+#include "bananative/dm/gfx/vk_android/vka.h"
+#include "nvn_direct.h"
+#include "nvn_direct_front.h"
+
+// Presents filled and not yet taken (the game's thread takes each right after it presents: at
+// most one is outstanding per presenting thread).
+enum { NPRES = 8 };
+typedef struct {
+    uint64_t ticket, fence;
+    uint64_t serial;
+    VkFormat format;   // the presenting texture's (UNORM for sRGB); its image may have been made in another (learned view formats)
+    int32_t crop[4];
+    int has_crop;
+} pres_t;
+static pres_t g_pres[NPRES];
+static uint64_t g_reserved, g_filled;
+// The presenting queue's last submission, by ticket (dotfiles-25x.4): the present waits for it
+// and every fence before it. The last submission of any queue may be another queue's that waits for an event the game
+// signals only in its next frame (Mario Kart World's second queue): the next acquire then waited
+// for it, and the composite up to 1 s.
+_Thread_local uint64_t nvn_direct_present_queue_fence;
+static uint64_t g_queue_fence[NPRES];
+static pthread_mutex_t g_mu = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t g_cv = PTHREAD_COND_INITIALIZER;
+
+uint64_t vka_present_reserve(void) {
+    pthread_mutex_lock(&g_mu);
+    const uint64_t tk = ++g_reserved;
+    g_queue_fence[tk % NPRES] = nvn_direct_present_queue_fence;
+    pthread_mutex_unlock(&g_mu);
+    return tk;
+}
+
+void vka_perf_frame(double period_s);
+void mtl_create_ns(uint64_t* lib_ns, uint64_t* pso_ns); // vka_pso.c
+void vka_fsc_stats(uint64_t* hit, uint64_t* miss); // vka_draw.c
+void vka_skip_report(void); // vka_draw.c
+void vka_rt_size_report(void); // vka_draw.c
+void vka_tex_stale_stats(uint64_t* reads); // vka_tex.c
+void vka_copy_drop_stats(uint64_t* dropped, uint64_t* kept); // vka_exec.c
+void vka_drawflip_frame(double period_s); // vka_draw.c
+// Pipeline creation on the frame path (dotfiles-25x.16: the replay thread's compiles, links and
+// cache lookups, vka_pso.c g_create_ns) between two presents, when it is over a 60 Hz frame: the
+// stalls a cold pipeline cache costs, frame by frame (the first 300), and every 1800 presents a sum.
+static void frame_path_creation(uint64_t tk) {
+    static uint64_t last_ns, over16, over50, over_ns;
+    static int logged;
+    uint64_t lib_ns, ns;
+    mtl_create_ns(&lib_ns, &ns);
+    const uint64_t d = ns - last_ns;
+    last_ns = ns;
+    if (d > 16666667ull) {
+        over16++;
+        over50 += d > 50000000ull;
+        over_ns += d;
+        if (logged++ < 300) VLOG("present %llu: frame-path pipeline creation %.1f ms", (unsigned long long)tk, d / 1e6);
+    }
+    if (tk % 1800 == 0) {
+        uint64_t hit, miss;
+        vka_fsc_stats(&hit, &miss);
+        VLOG("presents up to %llu: %llu frames with over 16.7 ms of frame-path pipeline creation (%llu over 50 ms), %.1f s in them; pixel shader sets %llu reused, %llu written",
+             (unsigned long long)tk, (unsigned long long)over16, (unsigned long long)over50, over_ns / 1e9, (unsigned long long)hit, (unsigned long long)miss);
+        {   // (dotfiles-25x.13) what the frame-path creation above is made of: shaders new to DM_TEMP, libraries compiled rather than read from the caches
+            unsigned made, kept;
+            uint64_t slow, ahead;
+            vka_rc_counts(&made, &kept);
+            vka_lib_counts(&slow, &ahead);
+            VLOG("presents up to %llu: %u shaders made (%u translated now, %u kept from earlier runs); %llu graphics pipeline libraries compiled outside the ahead threads (over 20 ms), %llu made ahead",
+                 (unsigned long long)tk, made, made - kept, kept, (unsigned long long)slow, (unsigned long long)ahead);
+        }
+        vka_skip_report();
+        vka_rt_size_report();
+        { uint64_t stale, dr, kp; vka_tex_stale_stats(&stale); vka_copy_drop_stats(&dr, &kp); VLOG("stale alias reads so far: %llu; copies into left-out levels dropped %llu, into kept levels of such textures %llu", (unsigned long long)stale, (unsigned long long)dr, (unsigned long long)kp); }
+    }
+}
+uint64_t vka_present_filled(void) { return g_filled; }   // (the replay thread, which fills them: DM_VK_TS_LOG's frame number)
+void vka_present_fill(uint64_t tk, const tex_t* t, double period_s, const int crop[4]) {
+    vka_perf_frame(period_s);
+    frame_path_creation(tk);
+    vka_drawflip_frame(period_s);
+    pthread_mutex_lock(&g_mu);
+    pres_t* p = &g_pres[tk % NPRES];
+    p->ticket = tk;
+    p->serial = t->serial;
+    vka_fmt f;
+    p->format = vka_fmt_of(t->d.format, &f) ? f.vk : VK_FORMAT_UNDEFINED;
+    // The presenting queue's last submission (handed to the queue: the worker fills presents in
+    // order with the submissions).
+    p->fence = vka_ok() ? g_queue_fence[tk % NPRES] : 0;
+    p->has_crop = crop && crop[2] > 0 && crop[3] > 0;
+    if (p->has_crop) memcpy(p->crop, crop, sizeof p->crop);
+    if (tk > g_filled) g_filled = tk;
+    pthread_cond_broadcast(&g_cv);
+    pthread_mutex_unlock(&g_mu);
+}
+
+// The emulator shuts down (nvn_direct_stop): the waits for a fill see vka_stopping.
+void nvn_direct_present_wake(void) {
+    pthread_mutex_lock(&g_mu);
+    pthread_cond_broadcast(&g_cv);
+    pthread_mutex_unlock(&g_mu);
+}
+
+uint64_t vka_present_inline(const tex_t* t, double period_s, const int crop[4]) {
+    const uint64_t tk = vka_present_reserve();
+    vka_present_fill(tk, t, period_s, crop);
+    return tk;
+}
+
+void mtl_present_flush(void) {
+    pthread_mutex_lock(&g_mu);
+    while (g_filled < g_reserved && !vka_stopping()) pthread_cond_wait(&g_cv, &g_mu);
+    pthread_mutex_unlock(&g_mu);
+}
+
+// The images handed to Lichii, by frame id: each held (vka_tex_acquire) with a view of its own
+// until NHELD later frames were taken, long after Lichii's composite of it ran (the game's present
+// waits for the previous composite: GPU::WaitForComposite).
+enum { NHELD = 8 };
+typedef struct {
+    uint64_t id;
+    vka_img* im;
+    nvn_direct_frame frame;
+} held_t;
+static held_t g_held[NHELD];
+static uint64_t g_frames;
+static pthread_mutex_t g_held_mu = PTHREAD_MUTEX_INITIALIZER;
+
+static _Thread_local uint64_t t_ticket;
+static _Thread_local uint32_t t_interval;
+void nvn_direct_present_note(uint64_t ticket, uint32_t interval) {
+    t_ticket = ticket;
+    t_interval = interval;
+}
+
+static VkImageView frame_view(const vka_img* im, VkFormat format) {
+    // Sampled only: the image's other uses (storage) need not hold for the view's format
+    VkImageViewUsageCreateInfo vu = {VK_STRUCTURE_TYPE_IMAGE_VIEW_USAGE_CREATE_INFO, .usage = VK_IMAGE_USAGE_SAMPLED_BIT};
+    VkImageViewCreateInfo vi = {VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO, .pNext = &vu, .image = im->img, .viewType = VK_IMAGE_VIEW_TYPE_2D,
+                                .format = format, .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}};
+    VkImageView v = VK_NULL_HANDLE;
+    return vk.vkCreateImageView(V.dev, &vi, NULL, &v) ? VK_NULL_HANDLE : v;
+}
+
+int nvn_direct_present_take(nvn_direct_frame* out) {
+    memset(out, 0, sizeof *out);
+    out->interval = t_interval ? t_interval : 1;
+    const uint64_t tk = t_ticket;
+    if (!tk) return 0;
+    t_ticket = 0;
+    pthread_mutex_lock(&g_mu);
+    while (g_filled < tk && !vka_stopping()) pthread_cond_wait(&g_cv, &g_mu);
+    const pres_t p = g_pres[tk % NPRES];
+    pthread_mutex_unlock(&g_mu);
+    if (vka_stopping()) return 0;   // the emulator shuts down (nvn_direct_stop): the worker may never fill it
+    if (!vka_ok() || p.ticket != tk) return 0;
+    vka_img* im = vka_tex_acquire(p.serial);
+    if (!im) return 0;   // the replay never drew or uploaded it (a boot frame): nothing to show
+    int ok = im->inited && im->aspect == VK_IMAGE_ASPECT_COLOR_BIT && im->samples == 1 && (im->usage & VK_IMAGE_USAGE_SAMPLED_BIT);
+    // In the presenting texture's format: a texture of another format sharing the image wrote it in its own (an RGB10A2 window over an RGBA8 image)
+    VkFormat format = p.format;
+    if (ok && format != im->f.vk && !(format && vka_img_lists(im, format))) {
+        VRED_ONCE("window texture serial %llu: its image (VkFormat %d) cannot be viewed in the texture's VkFormat %d: shown in the image's", (unsigned long long)p.serial, im->f.vk, format);
+        format = im->f.vk;
+    }
+    VkImageView view = ok ? frame_view(im, format) : VK_NULL_HANDLE;
+    if (!view) {
+        VRED_ONCE("window texture serial %llu (format %#x) cannot be shown (initialised %d, aspect %#x, samples %u, usage %#x)", (unsigned long long)im->serial, im->d.format,
+                  im->inited, im->aspect, im->samples, im->usage);
+        vka_tex_drop(im);
+        return 0;
+    }
+    pthread_mutex_lock(&g_held_mu);
+    const uint64_t id = ++g_frames;
+    held_t* h = &g_held[id % NHELD];
+    if (h->im) {
+        vk.vkDestroyImageView(V.dev, h->frame.view, NULL);
+        vka_tex_drop(h->im);
+    }
+    h->id = id;
+    h->im = im;
+    h->frame = (nvn_direct_frame){.id = id, .image = im->img, .view = view, .format = format, .width = im->scaled ? im->d.width : im->w, .height = im->scaled ? im->d.height : im->h,
+                                  .scaled_width = im->w, .scaled_height = im->h, .interval = out->interval, .fence = p.fence};
+    if (p.has_crop) memcpy(h->frame.crop, p.crop, sizeof p.crop);
+    *out = h->frame;
+    pthread_mutex_unlock(&g_held_mu);
+    return 1;
+}
+
+int nvn_direct_present_frame(uint64_t id, nvn_direct_frame* out) {
+    pthread_mutex_lock(&g_held_mu);
+    // A frame dropped already (Lichii composited it late): the newest one held instead.
+    const held_t* h = &g_held[id % NHELD];
+    if (h->id != id || !h->im) h = &g_held[g_frames % NHELD];
+    const int ok = h->im != NULL;
+    if (ok) *out = h->frame;
+    pthread_mutex_unlock(&g_held_mu);
+    if (!ok) return 0;
+    // Drawn on the replay's queues: Lichii samples it once the GPU is past its fence (bounded:
+    // a frame whose GPU work waits on the CPU is shown as far as it got).
+    if (out->fence && !vka_wait_done(out->fence, 1000000000ull)) {
+        static _Atomic int n;
+        if (atomic_fetch_add(&n, 1) < 8) VRED("present: frame %llu's fence %llu not reached in 1 s: shown as it is", (unsigned long long)out->id, (unsigned long long)out->fence);
+    }
+    return 1;
+}
diff --git a/src/video_core/nvn_direct/nvn_recompile.c b/src/video_core/nvn_direct/nvn_recompile.c
new file mode 100644
index 0000000000..9720b0411b
--- /dev/null
+++ b/src/video_core/nvn_direct/nvn_recompile.c
@@ -0,0 +1,783 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// The replay's shaders from Lichii's recompiler (dotfiles-25x.11), instead of the offline library
+// (vka_shader.c). EDEN_NX2_NVN_RECOMPILE (restart): 1 or unset = every shader from the recompiler
+// (the default since dotfiles-25x.15's A/B: no library is loaded), 0 = the library, 2 = the library
+// draws, and each of its shaders is translated too and the two binding lists compared (logged; a
+// lab check of the mapping below).
+//
+// A program stage is translated at its first draw or dispatch, with that draw's state: the
+// recompiler reads constant buffer words (bindless handles, storage buffer pointers), the types
+// and formats of the textures handles name, the vertex attributes' types and the depth mode, as
+// Lichii's Maxwell path reads them from the GPU's state. Its control section is only valid during
+// nvnProgramSetShaders, so a copy is kept per shader key (vka_rc_keep, from there). NVN2 stages
+// are Ampere code, NVN1 (Switch 1) stages Maxwell code (vk_nvn_direct_shaders.cpp reads both).
+//
+// NVN1 compute reads its driver constants c[0] in the fixed tables of the graphics stages' layout
+// (dmsh_abi.h DMSH_C0_SSBO_CS, DMSH_C0_CS_UBO, DMSH_C0_DISPATCH), which vka_drv_fill fills.
+//
+// Its SPIR-V numbers its descriptors from the stage's first binding in the replay's set 0
+// (dmsh_abi_vk.h: stage s at s * DMSH_VK_STAGE_BINDINGS; compute and mesh use the vertex range, task
+// the tess control one), and each descriptor becomes a binding record of the library's ABI
+// (rc_bind): what reads the bound NVN state is vka_bind.c's walker, as for library shaders. The
+// shader is a one-entry library in memory (rc_lib), so pipelines and binding take it unchanged.
+//
+// NVN2 compute lays out its driver constants c[0] per shader (control +0xa9 push constant words,
+// +0xb1 / +0xb2 / +0xb3 uniform, storage and texture entries, +0xba the size; InstEmitAmpere.cs
+// AMapC0 in Banana Native's translator). The library's translator remaps those reads to the fixed
+// tables; Lichii's reads them where they are, so a recompiled compute shader's c[0] is filled in
+// that layout (vka_rc_cs_c0, binding kind VKA_KIND_NVN2_CS_C0).
+
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <sys/resource.h>
+#include <unistd.h>
+
+#include "bananative/dm/gfx/vk_android/vka.h"
+#include "bananative/dm/host/plat/plat.h"
+#include "nvn_direct.h"
+#include "nvn_direct_front.h"
+#include "nvn_recompile_stamp.h"
+
+int vka_shader_translate(const nvn_direct_shader_source* s, nvn_direct_shader* o); // vka_dev.c
+void vka_shader_translated_free(nvn_direct_shader* o);
+
+int vka_rc_mode(void) {
+    static int mode = -1;
+    if (mode < 0) {
+        const char* e = getenv("EDEN_NX2_NVN_RECOMPILE");
+        mode = e && *e ? atoi(e) : 1;
+        if (mode) VLOG("shaders: Lichii's recompiler (EDEN_NX2_NVN_RECOMPILE=%d: %s)", mode, mode == 1 ? "every shader, no library" : "the library draws, both compared");
+    }
+    return mode;
+}
+
+static uint32_t rd32(const uint8_t* p, size_t o) { uint32_t v; memcpy(&v, p + o, 4); return v; }
+static int nvn2_control(const uint8_t* c) { return c && rd32(c, 0) == 0x98761234u && rd32(c, 4) == 0xc9; }
+
+// A stage's control section as translation reads it (vka_rc_keep): its NVN stage (an NVN2 section's +0x56, an NVN1 stage's code area's) and the section's
+// first size bytes (NVN2's whole section, NVN1's first NVN_DIRECT_NVN1_CONTROL_SIZE)
+typedef struct { uint32_t stage, size; uint8_t bytes[]; } rc_control;
+static size_t rc_control_bytes(const rc_control* c) { return sizeof *c + c->size; }
+// Where the shader's own constants (c[1]) lie in its code area: NVN2 between control +0x40 and +0x44, NVN1 between +0x700 and +0x704 (the code area's end)
+static void rc_c1_range(const rc_control* c, uint32_t* begin, uint32_t* end) {
+    const int nvn2 = nvn2_control(c->bytes);
+    *begin = rd32(c->bytes, nvn2 ? 0x40 : 0x700); *end = rd32(c->bytes, nvn2 ? 0x44 : 0x704);
+}
+// An NVN1 stage's NVN stage: graphics code starts with a 0x30-byte header (magic 0x12345678) and an SPH whose shader type (word 0 bits 10-13: 0 and 1 vertex,
+// 2 tess control, 3 tess evaluation, 4 geometry, 5 pixel) names it; compute code has a header of its own (0x12345679) or none, and a workgroup at control +0x748
+// (Luigi's Mansion 3's has none); -1 neither
+static int nvn1_stage(const uint8_t* control, const uint8_t* code, uint32_t ncode) {
+    static const int8_t of_type[6] = {0, 0, 3, 4, 2, 1};
+    if (ncode >= 0x80 && rd32(code, 0) == 0x12345678u) {
+        const uint32_t type = rd32(code, 0x30) >> 10 & 0xf;
+        return type < 6 ? of_type[type] : -1;
+    }
+    return rd32(control, 0x748) ? 5 : -1;
+}
+
+// ---------- Tables by shader key (open addressing, 0 = empty) ----------
+typedef struct { uint64_t key; void* val; } rc_ent;
+typedef struct { rc_ent* e; size_t cap, n; } rc_map;
+static size_t rc_slot(uint64_t k, size_t cap) { return (size_t)((k * 0x9E3779B97F4A7C15ull) >> 17) & (cap - 1); }
+static rc_ent* rc_find(rc_map* m, uint64_t key) {
+    if (!m->cap) return NULL;
+    for (size_t i = rc_slot(key, m->cap);; i = (i + 1) & (m->cap - 1)) { if (!m->e[i].key) return NULL; if (m->e[i].key == key) return &m->e[i]; }
+}
+static void rc_put(rc_map* m, uint64_t key, void* val) {
+    rc_ent* f = rc_find(m, key);
+    if (f) { f->val = val; return; }
+    if (2 * (m->n + 1) > m->cap) {
+        size_t nc = m->cap ? 2 * m->cap : 1024; rc_ent* n = calloc(nc, sizeof *n);
+        for (size_t i = 0; i < m->cap; i++) if (m->e[i].key) { size_t j = rc_slot(m->e[i].key, nc); while (n[j].key) j = (j + 1) & (nc - 1); n[j] = m->e[i]; }
+        free(m->e); m->e = n; m->cap = nc;
+    }
+    size_t j = rc_slot(key, m->cap); while (m->e[j].key) j = (j + 1) & (m->cap - 1);
+    m->e[j] = (rc_ent){key, val}; m->n++;
+}
+static pthread_mutex_t g_mu = PTHREAD_MUTEX_INITIALIZER;
+static rc_map g_ctl;      // key -> rc_control
+static rc_map g_sh;       // key -> rc_shader
+static rc_map g_cmp;      // key -> compared (mode 2)
+static uint64_t rc_key(uint64_t k) { return k ? k : 1; }   // (0 marks an empty slot)
+
+static void dump_listed(const prog_t* p, unsigned i, uint64_t key, const rc_control* control);
+static void spec_add(uint64_t key, uint64_t data, const rc_control* control);
+// nvnProgramSetShaders (mtl_prog_prefetch): the control sections, while they are valid
+void vka_rc_keep(const prog_t* p) {
+    if (!vka_rc_mode()) return;
+    for (unsigned i = 0; i < p->nstage && i < 6; i++) {
+        const uint8_t* c = p->sd[i].control; uint8_t md[8];
+        if (!c || rd32(c, 0) != 0x98761234u || !prog_key(p, i, md)) continue;
+        uint64_t key = rc_key(vka_shlib_key(md));
+        int st; uint32_t size;
+        if (nvn2_control(c)) { st = c[0x56]; size = NVN_DIRECT_NVN2_CONTROL_SIZE; }
+        else {   // NVN1: the stage its code area names, which is in a memory pool by now
+            uint32_t nctl, ncode; nvn_ctl_lens(c, &nctl, &ncode);
+            const uint64_t data = p->sd[i].data;
+            st = data && ncode && vka_addr(data, ncode, NULL, NULL, NULL) ? nvn1_stage(c, (const uint8_t*)(uintptr_t)nvn_direct_host_of(data), ncode) : -1;
+            size = NVN_DIRECT_NVN1_CONTROL_SIZE;
+            if (st < 0) { static _Atomic int n; if (atomic_fetch_add(&n, 1) < 16) VRED("shader %016llx: its code area (%u bytes at %#llx) is not in a memory pool or names no stage: not translated", (unsigned long long)key, ncode, (unsigned long long)data); continue; }
+        }
+        pthread_mutex_lock(&g_mu);
+        rc_control* copy = NULL;
+        if (!rc_find(&g_ctl, key)) {
+            copy = malloc(sizeof *copy + size);
+            if (copy) { copy->stage = (uint32_t)st; copy->size = size; memcpy(copy->bytes, c, size); rc_put(&g_ctl, key, copy); }
+        }
+        pthread_mutex_unlock(&g_mu);
+        if (copy) { dump_listed(p, i, key, copy); spec_add(key, p->sd[i].data, copy); }
+    }
+}
+static const rc_control* rc_control_of(uint64_t key) {
+    pthread_mutex_lock(&g_mu); rc_ent* e = rc_find(&g_ctl, rc_key(key)); const rc_control* c = e ? e->val : NULL; pthread_mutex_unlock(&g_mu);
+    return c;
+}
+
+// Loops the recompiler's safety check ended (Lichii's 8192 iterations; RuntimeInfo::loop_guard_binding): each shader with loops has a word in static
+// memory the check sets, looked at every 4096 draws and dispatches and logged once per shader: a loop that would not end has wrong inputs, which the
+// check hides (dotfiles-25x.15: the library's modules have no such check, and such a loop hangs the GPU)
+typedef struct { uint64_t key; const volatile uint32_t* word; int noted; } rc_guard;
+static rc_guard* g_guards; static size_t g_nguards, g_guards_cap;
+static void guard_add(uint64_t key, const vka_span* s) {
+    pthread_mutex_lock(&g_mu);
+    if (g_nguards == g_guards_cap) { size_t nc = g_guards_cap ? 2 * g_guards_cap : 256; rc_guard* n = realloc(g_guards, nc * sizeof *n); if (!n) { pthread_mutex_unlock(&g_mu); return; } g_guards = n; g_guards_cap = nc; }
+    g_guards[g_nguards++] = (rc_guard){key, (const volatile uint32_t*)s->ptr, 0};
+    pthread_mutex_unlock(&g_mu);
+}
+static void guard_poll(void) {
+    static unsigned calls;
+    if (++calls % 4096) return;
+    pthread_mutex_lock(&g_mu);
+    for (size_t i = 0; i < g_nguards; i++) if (!g_guards[i].noted && *g_guards[i].word) {
+        g_guards[i].noted = 1;
+        VRED("recompiled shader %016llx: a loop ran 8192 iterations and the recompiler's safety check ended it (its inputs would not end it)", (unsigned long long)g_guards[i].key);
+    }
+    pthread_mutex_unlock(&g_mu);
