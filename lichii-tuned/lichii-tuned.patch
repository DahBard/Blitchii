+static int snap_valid(uintptr_t lo, uintptr_t hi) {   // no block of [lo, hi) changed since the snapshot began (marked g_snap.gen or later)
+    _Atomic uint64_t *b = atomic_load_explicit(&g_pblk, memory_order_acquire);
