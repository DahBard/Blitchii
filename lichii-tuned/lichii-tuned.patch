+    if (e.vk >= VK_FORMAT_ASTC_4x4_UNORM_BLOCK && e.vk <= VK_FORMAT_ASTC_12x12_SRGB_BLOCK && bpb && (vka_astc_gpu_on() || vka_astc_transcode) && !(feats(e.vk) & VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT)) {
