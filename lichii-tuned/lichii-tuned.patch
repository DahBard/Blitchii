+            return std::pair{counter.builds.exchange(0, std::memory_order_relaxed),
+                             counter.nanoseconds.exchange(0, std::memory_order_relaxed)};
+        };
+        const auto [graphics, graphics_ns] = take(g_driver_graphics_builds);
+        const auto [compute, compute_ns] = take(g_driver_compute_builds);
+        LOG_INFO(Render_Vulkan,
+                 "Worst frame in the last 10 s: {:.1f} ms ({} of {} frames over 33 ms); in it {}; "
+                 "in the 10 s {} pipelines built by Lichii on the GPU thread ({:.1f} ms) and {} "
+                 "translations queued, {} pipelines built by the driver ({} graphics, {} compute; "
+                 "{:.1f} ms)",
+                 ms(worst.time), slow_frames, frames, describe(worst), window_tally.count,
+                 ms(window_tally.builds), window_tally.queued, graphics + compute, graphics,
+                 compute, static_cast<double>(graphics_ns + compute_ns) / 1e6);
