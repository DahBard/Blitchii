+std::vector<std::string> RevertClientSwitches(SwitchOwners& owners, u64 client, u64 present) {
+    std::vector<std::string> lines;
+    for (auto it = owners.entries.begin(); it != owners.entries.end();) {
+        if (it->second.client != client) {
+            ++it;
+            continue;
+        }
+        if (std::atomic<int>* const value = VideoCore::Nx2Debug::FindSwitch(it->first)) {
+            const int current = value->exchange(it->second.original, std::memory_order_relaxed);
+            if (current != it->second.original) {
+                lines.push_back(fmt::format("Live switch {}: {} -> {} (client gone, present {})",
+                                            it->first, current, it->second.original, present));
+                LOG_INFO(Debug, "{}", lines.back());
+            }
+        }
+        it = owners.entries.erase(it);
+    }
+    return lines;
