new file mode 100644
index 0000000000..14702485a9
--- /dev/null
+++ b/src/video_core/vulkan_common/vulkan_memory_reserve.h
@@ -0,0 +1,188 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdlib>
+#include <mutex>
+#include <optional>
+#include <unordered_map>
+#include <vector>
+
+#include "common/common_types.h"
+#include "video_core/vulkan_common/vulkan.h"
+
+namespace Vulkan::DeviceMemory {
+
+/// A size in MiB from a switch's value: nothing when it is unset (null) or empty, 0 (off) when it
+/// is not a number.
+[[nodiscard]] inline std::optional<u64> ParseMiBSwitch(const char* value) {
+    if (value == nullptr || value[0] == '\0') {
+        return std::nullopt;
+    }
+    return std::strtoull(value, nullptr, 10);
+}
+
+/// ParseMiBSwitch of the environment variable `name`.
+[[nodiscard]] std::optional<u64> ReadMiBSwitch(const char* name);
+
+/// EDEN_NX2_STAGING_RING_MIB when unset.
+inline constexpr u64 DefaultStagingRingMiB = 256;
+
+/// EDEN_NX2_PREALLOC_MIB when unset, on a discrete GPU with a device-local heap of
+/// PreallocDefaultMinHeap or more, in a host with PreallocDefaultMinHostRam or more of RAM (else
+/// off). The texture cache limits the reserve by the budget and the usage every 30 frames; from
+/// 11 GiB the boot room (3/8 of the budget past the base margin) also leaves 1.3 GiB or more of
+/// the budget free on top of a Switch 1 cache at its critical use (1 GiB with the resolution
+/// scaler or aggressive VRAM use), 0.6 GiB on an 8 GB card. Other GPUs' heaps are system memory.
+/// On Windows the reserve's blocks hold host commit too (r64: 4.9 GB less left at the title), and
+/// it was proven with 32 GB of RAM.
+inline constexpr u64 DefaultPreallocMiB = 4096;
+inline constexpr u64 PreallocDefaultMinHeap = u64{11} << 30;
+inline constexpr u64 PreallocDefaultMinHostRam = u64{24} << 30;
+
+/// EDEN_NX2_PREALLOC_MIB's size when it is unset, for this device and host.
+[[nodiscard]] constexpr u64 DefaultPreallocMiBFor(bool discrete, u64 device_local_heap,
+                                                  u64 host_ram) {
+    return discrete && device_local_heap >= PreallocDefaultMinHeap &&
+                   host_ram >= PreallocDefaultMinHostRam
+               ? DefaultPreallocMiB
+               : 0;
+}
+
+/// EDEN_NX2_PREALLOC_MIB and EDEN_NX2_STAGING_RING_MIB as the device and the staging pool applied
+/// them, for the switches boot line (0: off).
+inline std::atomic<u64> g_prealloc_cap_mib{0};
+inline std::atomic<u64> g_prealloc_made_mib{0};
+inline std::atomic<u64> g_staging_ring_mib{0};
+
+/// EDEN_NX2_PREALLOC_MIB=<MiB> (0: off; DefaultPreallocMiBFor when unset): device-local memory
+/// blocks VMA frees are kept, up to that much and to the room the budget leaves (SetLimit), and
+/// handed back when VMA asks the driver for a block of the same memory type, size and flags;
+/// that much is made at boot. At the texture cache's threshold area loads evict images and then
+/// allocate new ones: vkAllocateMemory took 29-50% of the GPU back thread in Ocarina's transition
+/// frames. Only VMA's 16 MiB and 256 MiB blocks (Device::SeparatePoolBlockSize,
+/// Device::MediumImagePoolBlockSize) are kept, never memory dedicated to an image or a buffer.
+class Reserve {
+public:
+    struct Totals {
+        u64 reused{};
+        u64 reused_bytes{};
+        u64 kept{};
+        u64 kept_bytes{};
+        u64 released{};
+        u64 released_bytes{};
+    };
+
+    explicit Reserve(VkDevice device, PFN_vkAllocateMemory allocate, PFN_vkFreeMemory free,
+                     const VkPhysicalDeviceMemoryProperties& properties, u64 cap);
+    ~Reserve();
+
+    Reserve(const Reserve&) = delete;
+    Reserve& operator=(const Reserve&) = delete;
+
+    /// The reserve VMA's memory calls for `device` go through, or null.
+    [[nodiscard]] static Reserve* Active(VkDevice device) noexcept;
+
+    /// VMA's memory calls go through this reserve until Close.
+    void Activate() noexcept;
+
+    /// Whether blocks of this memory type are kept (device-local, not host-visible).
+    [[nodiscard]] bool Keeps(u32 memory_type) const noexcept;
+
+    /// Makes up to `count` blocks of `size` bytes in `memory_type` now, with the flags VMA gives
+    /// its blocks; returns how many it made.
+    u32 Make(u32 memory_type, VkDeviceSize size, u32 count, VkMemoryAllocateFlags flags);
+
+    /// A kept block for `info` (true, `memory` set): the driver is not called.
+    bool Take(const VkMemoryAllocateInfo& info, VkDeviceMemory& memory);
+
+    /// `memory`, just allocated by the driver for `info`, is remembered if it can be kept.
+    void Track(const VkMemoryAllocateInfo& info, VkDeviceMemory memory);
+
+    /// True when `memory`, which VMA frees, is kept instead of given back to the driver.
+    bool Keep(VkDeviceMemory memory);
+
+    /// The most the reserve may keep from now on.
+    void SetLimit(u64 bytes) noexcept;
+
+    /// Gives one kept block back to the driver while the reserve keeps more than allowed.
+    void Trim();
+
+    /// Gives every kept block back to the driver now; returns how many bytes.
+    u64 Release();
+
+    /// Gives every kept block back and keeps nothing more (device teardown).
+    void Close();
+
+    [[nodiscard]] u64 KeptBytes() const noexcept;
+    [[nodiscard]] u64 KeptBytes(u32 heap) const noexcept;
+    [[nodiscard]] u64 KeptBlocks() const noexcept;
+    [[nodiscard]] u64 Cap() const noexcept {
+        return cap;
+    }
+    [[nodiscard]] u64 Limit() const noexcept;
+
+    /// What it did since the last call.
+    [[nodiscard]] Totals TakeTotals();
+
+private:
+    struct Key {
+        u32 memory_type{};
+        VkMemoryAllocateFlags flags{};
+        VkDeviceSize size{};
+        bool operator==(const Key&) const = default;
+    };
+    struct Block {
+        VkDeviceMemory memory;
+        Key key;
+    };
+
+    [[nodiscard]] std::optional<Key> KeyOf(const VkMemoryAllocateInfo& info) const noexcept;
+    [[nodiscard]] u64 Allowed() const noexcept;
+    void AddKept(const Key& key);
+    void RemoveKept(const Key& key);
+
+    VkDevice device;
+    PFN_vkAllocateMemory allocate;
+    PFN_vkFreeMemory free_memory;
+    u64 cap;
+    u32 keep_types{};
+    std::array<u32, VK_MAX_MEMORY_TYPES> heap_of_type{};
+    std::atomic<u64> limit;
+    std::atomic<u64> kept_total{0};
+    std::atomic<u64> kept_blocks{0};
+    std::array<std::atomic<u64>, VK_MAX_MEMORY_HEAPS> kept_by_heap{};
+    std::mutex mutex;
+    std::vector<Block> blocks; ///< Kept, oldest first
+    std::unordered_map<VkDeviceMemory, Key> tracked; ///< In VMA's hands, kept when freed
+    Totals totals;
+    bool closed{};
+};
+
+/// The driver's memory calls under VMA, with the reserve's and the staging ring's work, logged
+/// every 10 s ("Device memory in 10 s") under EDEN_NX2_STUTTER_TRACE=1, EDEN_NX2_TC_LOG, or
+/// EDEN_NX2_PREALLOC_MIB or EDEN_NX2_STAGING_RING_MIB set to a size (not by their defaults).
+namespace Stats {
+
+inline std::atomic<bool> g_enabled{false};
+
+[[nodiscard]] inline bool Enabled() noexcept {
+    return g_enabled.load(std::memory_order_relaxed);
+}
+
+void Enable(const VkPhysicalDeviceMemoryProperties& properties);
+void CountAllocation(const VkMemoryAllocateInfo& info, u64 ns);
+void CountFree(u64 ns);
+/// `large`: over half the ring. `behind_large`: refused while such an upload was in flight.
+void CountRingUpload(u64 bytes, bool large);
+void CountRingRefusal(bool behind_large);
+
+/// Called once a frame by one thread: logs the last 10 s when anything happened.
+void Tick(Reserve* reserve);
+
+} // namespace Stats
+
+} // namespace Vulkan::DeviceMemory
