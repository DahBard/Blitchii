+static_assert(sizeof(dmsh_vk_entry) == DMSH_VK_ENTRY_SIZE, "entry");
+static_assert(sizeof(dmsh_vk_bind) == DMSH_VK_BIND_SIZE, "bind");
+static_assert(sizeof(dmsh_vk_module) == DMSH_VK_MOD_SIZE, "module");
