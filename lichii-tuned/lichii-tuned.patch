+void OnPresentInstalled(u64 present);
+
+/// A present (nx2:vi2), numbered from 1.
+inline void OnPresent(u64 present) {
+    if (g_installed) [[unlikely]] {
+        OnPresentInstalled(present);
+    }
+}
