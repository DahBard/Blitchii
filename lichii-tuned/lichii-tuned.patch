+        else if (w[i].pImageInfo) { b = (uint64_t)w[i].pImageInfo->sampler; c = (uint64_t)w[i].pImageInfo->imageView; e = w[i].pImageInfo->imageLayout; }
+        else if (w[i].pTexelBufferView) b = (uint64_t)*w[i].pTexelBufferView;
