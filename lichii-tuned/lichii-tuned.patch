+// From Banana Native (github.com/hugorosario/BananaNative, Android port of github.com/seedds/nxnative by seedds), MIT: see LICENSE in src/video_core/nvn_direct/bananative.
+// The binding walker (vka_bind.h): nvn_mtl.m encode_args' sources for each binding kind, written once for the Vulkan replay and its Mac test
+#include "vka_bind.h"
+#include "nvn_direct_front.h"
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+_Static_assert(DMSH_C2_TEX + DMSH_C2_ROW * DMSH_C2_TEX_SLOTS == DMSH_C2_SEPTEX && DMSH_C2_SEPTEX + DMSH_C2_ROW * DMSH_C2_SEP_SLOTS == DMSH_C2_SAMP
+               && DMSH_C2_SAMP + DMSH_C2_ROW * DMSH_C2_SEP_SLOTS <= DMSH_DRV_SIZE, "NVN driver handle tables");
+
+uint64_t vka_tex_slot(const vka_bstate *s, int st, unsigned reg) {
+    return reg >= 32 && reg - 32 < DMSH_C2_IMG_SLOTS && s->img[st][reg - 32] ? s->img[st][reg - 32] : reg < VKA_NTEX ? s->tex[st][reg] : 0;
+}
+uint64_t vka_c2_handle(const vka_bstate *s, int st, unsigned b) {
+    if (b >= DMSH_C2_TEX && b < DMSH_C2_SEPTEX && !((b - DMSH_C2_TEX) % DMSH_C2_ROW)) return vka_tex_slot(s, st, (b - DMSH_C2_TEX) / DMSH_C2_ROW);
+    if (b >= DMSH_C2_SEPTEX && b < DMSH_C2_SAMP && !((b - DMSH_C2_SEPTEX) % DMSH_C2_ROW)) return s->tex[st][DMSH_SEPTEX_SLOT0 + (b - DMSH_C2_SEPTEX) / DMSH_C2_ROW];
+    if (b >= DMSH_C2_SAMP && b < DMSH_C2_SAMP + DMSH_C2_ROW * DMSH_C2_SEP_SLOTS && !((b - DMSH_C2_SAMP) % DMSH_C2_ROW)) return s->samp[st][(b - DMSH_C2_SAMP) / DMSH_C2_ROW];
+    return 0;
+}
+static uint64_t ubo_word(const vka_bstate *s, int st, int reg, unsigned off, unsigned n, vka_read_fn rd, void *ctx) {
+    uint64_t v = 0;
+    if (reg < 0 || reg >= 16 || !s->ubo[st][reg].addr || !rd) return 0;
+    if (s->ubo[st][reg].size && off + n > s->ubo[st][reg].size) return 0;
+    if (!rd(ctx, s->ubo[st][reg].addr + off, &v, n)) return 0;
+    return v;
+}
+static int ubo_tex_id(const vka_bstate *s, uint32_t h) { int t = (int)(h & 0xfffff); return t ? t + s->tex_base : 0; }
+static int ubo_samp_id(const vka_bstate *s, uint32_t h) { int x = (int)(h >> 20); return x ? x + s->samp_base : 0; }
+
+// The sampler half of a combined image sampler (skind, sreg, soff); element k of an array
+static int samp_of(const vka_bstate *s, int st, const dmsh_vk_bind *b, unsigned k, vka_read_fn rd, void *ctx) {
+    switch (b->skind) {
+    case DMSH_VK_KIND_SAMP_TEX: return b->sreg >= 0 && b->sreg < VKA_NTEX ? (int)(vka_tex_slot(s, st, (unsigned)b->sreg) >> 20 & 0xfff) : 0;   // the handle the texture half reads
+    case DMSH_VK_KIND_SAMP: return b->sreg >= 0 && b->sreg < 128 ? (int)(s->samp[st][b->sreg] >> 20 & 0xfff) : 0;
+    case DMSH_VK_KIND_SAMP_ID: return b->sreg > 0 ? b->sreg : 0;   // a constant of the shader (nvn_mtl.m NVN_RB_SAMPI): taken as it is
+    case DMSH_VK_KIND_SAMP_UBO: return ubo_samp_id(s, (uint32_t)ubo_word(s, st, b->sreg, b->soff, 4, rd, ctx));
+    case DMSH_VK_KIND_SAMP_C2A: {   // the handle at c2 byte off + 8 k, ORed with the separate sampler word at soff (nvn_mtl.m NVN_RB_SAMPA)
+        uint64_t sw = b->soff != 0xFFFF ? vka_c2_handle(s, st, b->soff) : 0;
+        return (int)((vka_c2_handle(s, st, b->off + 8u * k) | sw) >> 20 & 0xfff); }
+    default: return 0;
+    }
+}
+
+static int refuse(char *why, size_t n, const char *fmt, ...) {
+    if (why && n) { va_list ap; va_start(ap, fmt); vsnprintf(why, n, fmt, ap); va_end(ap); }
+    return VKA_WALK_REFUSE;
+}
+
+int vka_walk(const vka_bstate *s, int st, const dmsh_vk_entry *e, const dmsh_vk_bind *bs, uint32_t ssbo_align, uint64_t dev_align, vka_read_fn rd, void *ctx,
+             vka_res *out, int max, int *uses_pool, char *why, size_t whyn) {
+    int n = 0;
+    if (st < 0 || st >= VKA_NSTAGE) return refuse(why, whyn, "NVN stage %d", st);
+    for (unsigned i = 0; i < e->bind_count; i++) {
+        const dmsh_vk_bind *b = &bs[i];
+        if (b->kind == DMSH_VK_KIND_UNKNOWN) return refuse(why, whyn, "binding %u has no placed kind", b->binding);
+        if (b->set == DMSH_VK_SET_POOL || b->kind == DMSH_VK_KIND_TEX_POOL || b->kind == DMSH_VK_KIND_SAMP_POOL) { if (uses_pool) *uses_pool = 1; continue; }
+        unsigned cnt = b->count ? b->count : 1;
+        for (unsigned k = 0; k < cnt; k++) {
+            if (n >= max) return refuse(why, whyn, "more than %d descriptors", max);
+            vka_res r = {VKA_R_NULL, b->desc, b->flags, b->dim, b->binding, (uint16_t)k, 0, 0, 0, 0, 0};
+            int reg = b->reg;
+            int noslot = (b->flags & DMSH_VK_BF_NOSLOT) || reg < 0;
+            switch (b->kind) {
+            case DMSH_VK_KIND_CBUF:
+                if (!noslot && reg < 16 && s->ubo[st][reg].addr) { r.what = VKA_R_BUF; r.addr = s->ubo[st][reg].addr; r.size = s->ubo[st][reg].size; }
+                break;
+            case DMSH_VK_KIND_C1: r.what = VKA_R_C1; break;
+            case DMSH_VK_KIND_SUPPORT: r.what = VKA_R_SUPPORT; break;
+            case DMSH_VK_KIND_DRVCB: r.what = VKA_R_DRV; r.bank = (int16_t)reg; break;
+            case VKA_KIND_NVN2_CS_C0: r.what = VKA_R_DRV; r.bank = VKA_BANK_NVN2_CS_C0; break;
+            case VKA_KIND_LOOP_GUARD: r.what = VKA_R_LOOP_GUARD; break;
+            case DMSH_VK_KIND_SBUF: case DMSH_VK_KIND_UBO_PTR: {
+                const vka_range *u = noslot || reg >= 16 ? NULL : b->kind == DMSH_VK_KIND_SBUF ? &s->ssbo[st][reg] : &s->ubo[st][reg];
+                if (u && u->addr) { r.what = VKA_R_BUF; r.addr = u->addr; r.size = u->size; }
+                break; }
+            case DMSH_VK_KIND_SBUF_UBO: {
+                uint64_t a = noslot ? 0 : ubo_word(s, st, reg, b->off, 8, rd, ctx);
+                if (a) { r.what = VKA_R_BUF; r.addr = a; r.size = 0; }   // the size is not known: to the end of the chunk
+                break; }
+            case DMSH_VK_KIND_TEX: case DMSH_VK_KIND_TEX_UBO: case DMSH_VK_KIND_TEX_C2A: {
+                int tid = b->kind == DMSH_VK_KIND_TEX_UBO ? (noslot ? 0 : ubo_tex_id(s, (uint32_t)ubo_word(s, st, reg, b->off, 4, rd, ctx)))
+                        : b->kind == DMSH_VK_KIND_TEX_C2A ? (int)(vka_c2_handle(s, st, b->off + 8u * k) & 0xfffff)
+                        : noslot ? 0 : (int)(vka_tex_slot(s, st, (unsigned)reg) & 0xfffff);
+                int sid = b->skind ? samp_of(s, st, b, k, rd, ctx) : 0;
+                if (tid) { r.what = VKA_R_TEX; r.tid = tid; r.sid = sid; }
+                break; }
+            case DMSH_VK_KIND_TBUF: {
+                int tid = noslot ? 0 : (int)(vka_tex_slot(s, st, (unsigned)reg) & 0xfffff);
+                if (tid) { r.what = VKA_R_TBUF; r.tid = tid; }
+                break; }
+            case DMSH_VK_KIND_IMG: {
+                int tid = noslot || reg >= 32 ? 0 : (int)(s->img[st][reg] & 0xfffff);
+                if (tid) { r.what = VKA_R_IMG; r.tid = tid; }
+                break; }
+            case DMSH_VK_KIND_SAMP: case DMSH_VK_KIND_SAMP_TEX: case DMSH_VK_KIND_SAMP_ID: case DMSH_VK_KIND_SAMP_UBO: case DMSH_VK_KIND_SAMP_C2A: {
+                dmsh_vk_bind sb = *b; sb.skind = b->kind; sb.sreg = b->reg; sb.soff = b->kind == DMSH_VK_KIND_SAMP_C2A ? b->soff : b->off;   // a sampler on its own: its own fields name it
+                int sid = noslot && b->kind != DMSH_VK_KIND_SAMP_C2A ? 0 : samp_of(s, st, &sb, k, rd, ctx);
+                if (sid) { r.what = VKA_R_TEX; r.sid = sid; }
+                break; }
+            case DMSH_VK_KIND_GMEM_MAP: r.what = VKA_R_GMEM_MAP; break;
+            case DMSH_VK_KIND_GMEM_LOG: r.what = VKA_R_GMEM_LOG; break;
+            case DMSH_VK_KIND_SHARED_SPILL:
+                if (!b->bytes || b->bytes % 4) return refuse(why, whyn, "binding %u: shared memory spill of %u bytes a slice", b->binding, b->bytes);
+                r.what = VKA_R_SHARED_SPILL; r.size = b->bytes; break;
+            default: return refuse(why, whyn, "binding %u: kind %u", b->binding, b->kind);
+            }
+            if (r.what == VKA_R_BUF && r.desc == 7 /* VK_DESCRIPTOR_TYPE_STORAGE_BUFFER */) {
+                if (ssbo_align) { uint64_t d = r.addr & (ssbo_align - 1); r.addr -= d; if (r.size) r.size += d; }   // the shader adds the difference back
+                else if (dev_align && (r.addr & (dev_align - 1)))
+                    return refuse(why, whyn, "storage buffer (binding %u, slot %d) at %#llx is not %llu-byte aligned (a library built before ssbo_align)", b->binding, reg, (unsigned long long)r.addr, (unsigned long long)dev_align);
+            }
+            out[n++] = r;
+        }
+    }
+    return n;
+}
+
+static int c0_ssbo_base(int st) { return st == 0 ? DMSH_C0_SSBO_VS : st == 1 ? DMSH_C0_SSBO_PS : st == 2 ? DMSH_C0_SSBO_GS : st == 5 ? DMSH_C0_SSBO_CS : st == 6 ? DMSH_C0_SSBO_TS : st == 7 ? DMSH_C0_SSBO_MS : -1; }
+
+// The pixel stage's sample table (nvn_mtl.m c0_sample_rows): one byte per sample, x in the low nibble and y in the high one in 1/16 pixel, at Vulkan's standard sample locations
+static void c0_sample_rows(uint8_t *d, uint32_t samples) {
+    static const uint8_t pos[5][16] = {
+        {0x88},
+        {0xCC, 0x44},
+        {0x26, 0x6E, 0xA2, 0xEA},
+        {0x59, 0xB7, 0x9D, 0x35, 0xD3, 0x71, 0xFB, 0x1F},
+        {0x99, 0x57, 0xA5, 0x7C, 0x63, 0xDA, 0xBD, 0x3B, 0xE6, 0x18, 0x24, 0xC2, 0x80, 0x4F, 0xFE, 0x01},
+    };
+    if (samples < 1 || samples > 16 || (samples & (samples - 1))) samples = 1;
+    int l = __builtin_ctz(samples);
+    uint32_t info[4] = {samples - 1, (uint32_t)l, 0, 0};
+    memcpy(d + DMSH_C0_SAMPLE_TABLE, pos[l], DMSH_C0_SAMPLE_BYTES); memcpy(d + DMSH_C0_SAMPLE_INFO, info, sizeof info);
+}
+
+size_t vka_drv_size(int bank) { return bank == DMSH_PUSH_BANK ? DMSH_PUSH_SIZE : DMSH_DRV_SIZE; }
+void vka_drv_fill(const vka_bstate *s, int st, int bank, int pool, uint8_t *d) {
+    if (bank == DMSH_PUSH_BANK) { memcpy(d, s->push[st == 5], DMSH_PUSH_SIZE); return; }
+    memset(d, 0, DMSH_DRV_SIZE);
+    if (bank == 0) {
+        int base = c0_ssbo_base(st);
+        if (base >= 0) for (int r = 0; r < DMSH_C0_SSBO_SLOTS; r++) {
+            uint64_t a = nvn_direct_guest_of(s->ssbo[st][r].addr); uint32_t n = (uint32_t)s->ssbo[st][r].size;   // Lichii: the game's address, as raw global memory's table keys it (vka_mem.c)
+            memcpy(d + base + DMSH_C0_ROW * r, &a, 8); memcpy(d + base + DMSH_C0_ROW * r + 8, &n, 4);
+        }
+        if (st != 5) { const float max_point = 2047.0f; memcpy(d + DMSH_C0_POINT_SIZE, &max_point, 4); memcpy(d + DMSH_C0_BASE_INSTANCE, &s->base_instance, 4); }
+        if (st == 1) c0_sample_rows(d, s->samples);
+        if (st == 5) {
+            memcpy(d + DMSH_C0_DISPATCH, s->dispatch, 12);
+            // NVN2's compute driver segment keeps the counts at c0 + 4 too (x, y, z), below the per-shader layout the translator remaps from 0x10 (InstEmitAmpere.AMapC0):
+            // a shader that indexes by them reads 0 otherwise and every workgroup of a column writes the same entry (upstream nxnative 0a759de7: nvn_mtl.m encode_args_; Fire Emblem Fortune's Weave's light culling)
+            if (s->nvn2) memcpy(d + DMSH_C0_DISPATCH_NVN2, s->dispatch, 12);
+            for (int r = 0; r < DMSH_C0_CS_UBO_SLOTS; r++) {
+                uint64_t a = nvn_direct_guest_of(s->ubo[5][r].addr); uint32_t n = (uint32_t)s->ubo[5][r].size;   // Lichii: the game's address (as above)
+                memcpy(d + DMSH_C0_CS_UBO + DMSH_C0_ROW * r, &a, 8); memcpy(d + DMSH_C0_CS_UBO + DMSH_C0_ROW * r + 8, &n, 4);
+            }
+        }
+    } else if (bank == 2) {
+        // A shader that reads the pools indexes them with the IDs it reads, which are the bound pool's own: its c2 holds the handles as the game bound them, without the bases
+        int tb = pool ? s->tex_base : 0, sb = pool ? s->samp_base : 0;
+#define C2_LOCAL(h) ((uint32_t)((((h) & 0xfffff) ? ((h) & 0xfffff) - (uint64_t)tb : 0) | ((((h) >> 20) & 0xfff) ? ((((h) >> 20) & 0xfff) - (uint64_t)sb) << 20 : 0)))
+        const uint64_t *tx = s->tex[st], *im = s->img[st];
+        for (int r = 0; r < DMSH_C2_IMG_SLOTS; r++) { uint32_t ih = (uint32_t)(im[r] & 0xfffff ? im[r] - (uint64_t)tb : im[r]); memcpy(d + DMSH_C2_IMG + DMSH_C2_ROW * r, &ih, 4); }   // (bind_handles moves only an image's texture ID)
+        for (int r = 0; r < DMSH_C2_TEX_SLOTS; r++) {   // a combined slot past 31 is written when it is bound and the image slot it shares is not
+            if (r >= 32 && (!tx[r] || (r - 32 < DMSH_C2_IMG_SLOTS && im[r - 32]))) continue;
+            uint32_t v = C2_LOCAL(tx[r]); memcpy(d + DMSH_C2_TEX + DMSH_C2_ROW * r, &v, 4);
+        }
+        for (int r = 0; r < DMSH_C2_SEP_SLOTS; r++) { uint64_t h = tx[DMSH_SEPTEX_SLOT0 + r]; uint32_t v = C2_LOCAL(h); memcpy(d + DMSH_C2_SEPTEX + DMSH_C2_ROW * r, &v, 4); }
+        for (int r = 0; r < DMSH_C2_SEP_SLOTS; r++) { uint64_t h = s->samp[st][r]; uint32_t v = C2_LOCAL(h); memcpy(d + DMSH_C2_SAMP + DMSH_C2_ROW * r, &v, 4); }
+#undef C2_LOCAL
+    }
+}
+
+void vka_support_fill(uint8_t *d, size_t n) {
+    memset(d, 0, n);
+    for (size_t o = 192; o + 4 <= n && o < 192 + 16 * 73; o += 16) { const float one = 1.0f; memcpy(d + o, &one, 4); }   // render_scale[73] (nvn_mtl.m support_buf)
+}
diff --git a/src/video_core/nvn_direct/bananative/dm/gfx/vk_android/vka_bind.h b/src/video_core/nvn_direct/bananative/dm/gfx/vk_android/vka_bind.h
new file mode 100644
index 0000000000..8d7d365c98
--- /dev/null
+++ b/src/video_core/nvn_direct/bananative/dm/gfx/vk_android/vka_bind.h
@@ -0,0 +1,81 @@
+// From Banana Native (github.com/hugorosario/BananaNative, Android port of github.com/seedds/nxnative by seedds), MIT: see LICENSE in src/video_core/nvn_direct/bananative.
+// The binding walker of the Vulkan replay: what each of a shader's binding records (dmsh_vk_bind, android/SHADERS.md "Descriptor ABI") is filled from, given the NVN state a draw
+// or dispatch sees. It is nvn_mtl.m's encode_args without Metal: the same slots, handles, pool bases and driver segments. Plain C with no Vulkan (the Mac unit test runs it on a
+// real library); vka_draw.c turns its answers into descriptors
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#include "../nvn/dmsh_abi.h"
+#include "../nvn/dmsh_abi_vk.h"
+
+#define VKA_NTEX (DMSH_SEPTEX_SLOT0 + DMSH_C2_SEP_SLOTS)   // texture slots of a stage: combined 0-127, separate 128-255 (nvn_obj.h NVN_SEPTEX_SLOT0)
+#define VKA_NSTAGE 8                                         // NVN stages: 0 vertex, 1 fragment, 2 geometry, 3 tess control, 4 tess evaluation, 5 compute, 6 task, 7 mesh (NVN2)
+
+typedef struct { uint64_t addr, size; } vka_range;
+// What the draw path keeps of the NVN bindings, by NVN stage (the stage field of the bind records, as hle_nvn.c records them)
+typedef struct {
+    vka_range ubo[VKA_NSTAGE][16], ssbo[VKA_NSTAGE][16];
+    uint64_t tex[VKA_NSTAGE][VKA_NTEX], samp[VKA_NSTAGE][128], img[VKA_NSTAGE][32];   // handles as bound: texture ID | sampler ID << 20, the pool bases already added (hle_nvn.c bind_handles)
+    uint8_t push[2][DMSH_PUSH_SIZE];   // NVN2 pushed constants: graphics, compute
+    int tex_base, samp_base;           // the bound pools' bases, for handles read from memory at replay (nvn_mtl.m ubo_tex_id)
+    uint32_t base_instance;            // the draw's base instance (c0 + DMSH_C0_BASE_INSTANCE)
+    uint32_t dispatch[3];              // the dispatch's group counts (c0 + DMSH_C0_DISPATCH, and with nvn2 also c0 + DMSH_C0_DISPATCH_NVN2)
+    uint32_t nvn2;                     // a Switch 2 game (NVN2): its compute reads the group counts at c0 + DMSH_C0_DISPATCH_NVN2. Set by the replay (vka_nvn2), not here: this file stays host-free
+    uint32_t samples;                  // the pass's sample count (the pixel stage's sample table)
+} vka_bstate;
+
+// NVN stage ↔ ABI stage (DMSH_VK_STAGE_*: vertex 0, tess control 1, tess evaluation 2, geometry 3, fragment 4, compute 5, task 6, mesh 7). NVN2's task and mesh stages are 6 and 7
+// in both numberings (nvnCommandBufferDrawMeshTasks; switch2mac nvn_mtl.m NVN_NSTAGE)
+static inline int vka_vk_stage(int nvn) { static const int8_t m[8] = {DMSH_VK_STAGE_VS, DMSH_VK_STAGE_FS, DMSH_VK_STAGE_GS, DMSH_VK_STAGE_TCS, DMSH_VK_STAGE_TES, DMSH_VK_STAGE_CS, DMSH_VK_STAGE_TS, DMSH_VK_STAGE_MS}; return nvn >= 0 && nvn < 8 ? m[nvn] : -1; }
+static inline int vka_nvn_stage(int vks) { static const int8_t m[8] = {0, 3, 4, 2, 1, 5, 6, 7}; return vks >= 0 && vks < 8 ? m[vks] : -1; }
+
+enum {
+    VKA_R_NULL,       // nothing bound there: a null descriptor (or a placeholder of the record's dim)
+    VKA_R_BUF,        // guest memory [addr, addr + size) (size 0: to the end of its placed chunk); desc says uniform or storage
+    VKA_R_C1,         // the shader's own c1 bytes
+    VKA_R_SUPPORT,    // Ryujinx's support buffer
+    VKA_R_DRV,        // a driver segment the replay fills (bank 0, 2 or DMSH_PUSH_BANK: vka_drv_fill)
+    VKA_R_TEX,        // texture ID tid (0 = none) with sampler ID sid (0 = none), read through a view of shape dim
+    VKA_R_IMG,        // image of texture ID tid, storage
+    VKA_R_TBUF,       // buffer texture of texture ID tid
+    VKA_R_GMEM_MAP,   // the guest → device address table of raw global memory
+    VKA_R_GMEM_LOG,   // that memory's write log, cleared per draw or dispatch
+    VKA_R_SHARED_SPILL,   // a compute program's shared memory past the device's limit (DMSH_VK_KIND_SHARED_SPILL): size = bytes of one workgroup's slice
+    VKA_R_LOOP_GUARD,     // Lichii: the shader's loop guard word (VKA_KIND_LOOP_GUARD)
+};
+typedef struct {
+    uint8_t what, desc, flags, dim;    // VKA_R_*, VkDescriptorType, DMSH_VK_BF_*, DMSH_VK_DIM_*
+    uint16_t binding, elem;            // set 0 binding and array element
+    int16_t bank;                      // VKA_R_DRV
+    int32_t tid, sid;
+    uint64_t addr, size;
+} vka_res;
+
+// Reads guest memory for handles kept in uniform buffers (TEX_UBO, SAMP_UBO, SBUF_UBO): 1 = read, 0 = not readable (the value reads as 0)
+typedef int (*vka_read_fn)(void *ctx, uint64_t addr, void *out, size_t n);
+
+// Lichii (dotfiles-25x.11): a recompiled NVN2 compute shader's c[0], in the shader's own layout (nvn_recompile.c vka_rc_cs_c0): a VKA_R_DRV of bank
+// VKA_BANK_NVN2_CS_C0, which the walk's caller fills from the shader
+#define VKA_KIND_NVN2_CS_C0 64
+#define VKA_BANK_NVN2_CS_C0 0x100
+// Lichii (dotfiles-25x.11): a recompiled shader's loop guard word (nvn_recompile.c): a VKA_R_LOOP_GUARD the walk's caller binds from the shader
+#define VKA_KIND_LOOP_GUARD 65
+
+#define VKA_WALK_REFUSE (-1)
+// Walks one stage's binding records (e->bind_count of them from b) for NVN stage nvn_stage. Writes at most max results to out and returns their count, or VKA_WALK_REFUSE with
+// *why set when the draw cannot run correctly. Storage buffers of global memory (SBUF, SBUF_UBO, UBO_PTR): with the library's ssbo_align (header; DMSH_VK_SSBO_ALIGN) they are
+// bound at their address rounded down to it, the range grown by the difference (the shader adds it back); with 0 (an older library) at the exact address, and one off the
+// device's dev_align refuses the draw. An UNKNOWN record refuses it too. *uses_pool is set when the shader reads set 1 (the texture or sampler pool)
+int vka_walk(const vka_bstate *s, int nvn_stage, const dmsh_vk_entry *e, const dmsh_vk_bind *b, uint32_t ssbo_align, uint64_t dev_align, vka_read_fn rd, void *rd_ctx,
+             vka_res *out, int max, int *uses_pool, char *why, size_t whyn);
+// Fills a driver segment as the GPU's driver would (nvn_mtl.m encode_args NVN_RB_DRV0 / DRV2 / PUSH): DMSH_DRV_SIZE bytes for banks 0 and 2, DMSH_PUSH_SIZE for the push bank.
+// pool: the shader reads the pools (c2 then holds the handles without the pools' bases, as the game wrote them)
+void vka_drv_fill(const vka_bstate *s, int nvn_stage, int bank, int pool, uint8_t *d);
+size_t vka_drv_size(int bank);
+// The handle the driver's c2 holds at byte off for a stage (nvn_mtl.m c2_handle), and a combined texture slot's handle (tex_slot_h: past slot 31 an image slot shares the word)
+uint64_t vka_c2_handle(const vka_bstate *s, int nvn_stage, unsigned off);
+uint64_t vka_tex_slot(const vka_bstate *s, int nvn_stage, unsigned reg);
+// Ryujinx's support buffer (SupportBuffer.cs: 1,392 bytes): word 0 the alpha test reference (float bits, DMSH_VK_SPEC_ALPHA_FUNC), zeros, render_scale floats at 192 + 16 i set to 1.0
+#define VKA_SUPPORT_SIZE 2048
+// The support buffer's contents; n bytes
+void vka_support_fill(uint8_t *d, size_t n);
diff --git a/src/video_core/nvn_direct/bananative/dm/gfx/vk_android/vka_capture.c b/src/video_core/nvn_direct/bananative/dm/gfx/vk_android/vka_capture.c
new file mode 100644
index 0000000000..4fd5c43652
--- /dev/null
+++ b/src/video_core/nvn_direct/bananative/dm/gfx/vk_android/vka_capture.c
@@ -0,0 +1,663 @@
+// From Banana Native (github.com/hugorosario/BananaNative, Android port of github.com/seedds/nxnative by seedds), MIT: see LICENSE in src/video_core/nvn_direct/bananative.
+// DM_NVN_CAPTURE on Android: one frame captured at the replay boundary (nvnQueueSubmitCommands → mtl_exec) into one file, for the replayer on the phone (vka_replay.c,
+// nxhost_replay; android/TESTING.md "Frame capture and replay") to replay against the Vulkan replay without the game. It is dm/gfx/nvn/nvn_capture.inc (the Mac's) with the Vulkan
+// replay's tables: the pools (vka_mem.c), the texture and sampler registries and the images by serial (vka_tex.c), and the shader library's binding records for the interface hash.
+// The file format is nvn_capture.h's, written uncompressed (no LZFSE here). What a frame holds, and how each later submit adds what changed, is described in nvn_capture.inc.
+// Images whose content only the GPU has (render targets, copy and clear destinations, and images filled once from storage that may have changed since) are read back; images that
+// follow their storage (tracked) are made again from the pools at replay. Each capture step waits for the GPU first; that changes the frame's timing, not what it renders.
+//   DM_NVN_CAPTURE=<frame>:1:<path>      the frame-th present (counted from the first, as DM_NVN_SHOT counts them)
+//   DM_NVN_CAPTURE=@<seconds>:1:<path>   the first frame that starts after that many seconds of the host's run (scripted runs on the phone, whose frame rate varies)
+// The path's folder is made when missing. A capture is game data: it stays on the phone or in the game's work folder, never in the repository
+#if defined(__ANDROID__)
+#include "vka_capture.h"
+#include "../nvn/nvn_hmap.h"
+#include "../../host/plat/plat.h"
+#include <errno.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <zlib.h>
+#if defined(_WIN32)   // Lichii
+#include <direct.h>
+#define mkdir(path, mode) _mkdir(path)
+#endif
+
+#ifndef MIN
+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+#define MAX(a, b) ((a) > (b) ? (a) : (b))
+#endif
+#define CLOG(...) LOG("DM_NVN_CAPTURE: " __VA_ARGS__)
+#define CRED(...) LOG("[RED] DM_NVN_CAPTURE: " __VA_ARGS__)
+
+// ---------- One-off GPU work ----------
+static VkCommandPool g_ocp; static VkCommandBuffer g_ocb; static pthread_mutex_t g_omu = PTHREAD_MUTEX_INITIALIZER;
+// Lichii: a submission whose fence was not reached in 30 s keeps its command pool, staging buffer and image (a reference) until the fence is reached (checked at each
+// vcap_cb_begin); the GPU may still run it. The next one-off work gets a new pool. At most VCAP_LATE stay pending: one-off work stops while they all do
+#define VCAP_LATE 4
+typedef struct { VkFence f; VkCommandPool cp; vcap_hbuf h; vka_img *im; } vcap_late;
+static vcap_late g_olate[VCAP_LATE]; static int g_nolate;
+static void vcap_late_reap(void) {
+    for (int i = 0; i < g_nolate;) {
+        vcap_late *l = &g_olate[i];
+        if (vk.vkWaitForFences(V.dev, 1, &l->f, VK_TRUE, 0) != VK_SUCCESS) { i++; continue; }
+        vk.vkDestroyFence(V.dev, l->f, NULL); vk.vkDestroyCommandPool(V.dev, l->cp, NULL); vcap_hbuf_free(&l->h); vka_tex_drop(l->im);
+        *l = g_olate[--g_nolate];
+    }
+}
+VkCommandBuffer vcap_cb_begin(void) {
+    if (!vka_init()) return VK_NULL_HANDLE;
+    pthread_mutex_lock(&g_omu);
+    vcap_late_reap();
+    if (g_nolate == VCAP_LATE) { pthread_mutex_unlock(&g_omu); return VK_NULL_HANDLE; }
+    if (!g_ocp) {
+        VkCommandPoolCreateInfo pi = {VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO, .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT, .queueFamilyIndex = V.qf};
+        VkCommandBufferAllocateInfo ai = {VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO, .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY, .commandBufferCount = 1};
+        if (vk.vkCreateCommandPool(V.dev, &pi, NULL, &g_ocp) || ((ai.commandPool = g_ocp), vk.vkAllocateCommandBuffers(V.dev, &ai, &g_ocb))) { g_ocp = VK_NULL_HANDLE; pthread_mutex_unlock(&g_omu); return VK_NULL_HANDLE; }
+    }
+    vk.vkResetCommandBuffer(g_ocb, 0);
+    VkCommandBufferBeginInfo bi = {VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO, .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT};
+    vk.vkBeginCommandBuffer(g_ocb, &bi);
+    vka_barrier(g_ocb);   // after everything submitted before it
+    return g_ocb;         // g_omu stays held until vcap_cb_run
+}
+int vcap_cb_run(VkCommandBuffer cb, vcap_hbuf *h, vka_img *im) {
+    vka_barrier(cb);
+    VkMemoryBarrier mb = {VK_STRUCTURE_TYPE_MEMORY_BARRIER, .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT, .dstAccessMask = VK_ACCESS_HOST_READ_BIT};
+    vk.vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &mb, 0, NULL, 0, NULL);
+    int ok = 0; VkFence f = VK_NULL_HANDLE; VkFenceCreateInfo fi = {VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+    if (!vk.vkEndCommandBuffer(cb) && !vk.vkCreateFence(V.dev, &fi, NULL, &f)) {
+        VkSubmitInfo si = {VK_STRUCTURE_TYPE_SUBMIT_INFO, .commandBufferCount = 1, .pCommandBuffers = &cb};
+        vka_qlock(); VkResult r = vka_hung() ? VK_ERROR_DEVICE_LOST : vk.vkQueueSubmit(V.q, 1, &si, f); vka_qunlock();
+        ok = !r && !vk.vkWaitForFences(V.dev, 1, &f, VK_TRUE, 30000000000ull);
+        if (!ok) LOG("[RED] vk: capture / replay copy: submit %d, fence not reached in 30 s", r);
+        if (ok || r) vk.vkDestroyFence(V.dev, f, NULL);
+        else {   // the GPU may still run it: its pool, staging buffer and image wait for the fence (vcap_late_reap); the caller's vcap_hbuf_free then frees nothing
+            vcap_late *l = &g_olate[g_nolate++]; *l = (vcap_late){f, g_ocp, {0}, vka_tex_ref(im)};
+            if (h) { l->h = *h; memset(h, 0, sizeof *h); }
+            g_ocp = VK_NULL_HANDLE; g_ocb = VK_NULL_HANDLE;
+        }
+    }
+    pthread_mutex_unlock(&g_omu);
+    return ok;
+}
+int vcap_hbuf_make(vcap_hbuf *h, VkDeviceSize n) {
+    memset(h, 0, sizeof *h); if (!n) n = 16;
+    VkBufferCreateInfo bi = {VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, .size = n, .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT};
+    if (vk.vkCreateBuffer(V.dev, &bi, NULL, &h->b)) return 0;
+    VkMemoryRequirements mr; vk.vkGetBufferMemoryRequirements(V.dev, h->b, &mr);
+    uint32_t t = vka_mem_type(mr.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT | VK_MEMORY_PROPERTY_HOST_CACHED_BIT, 0);
+    if (t == UINT32_MAX) t = vka_mem_type(mr.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, 0);
+    VkMemoryAllocateInfo ai = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, .allocationSize = mr.size, .memoryTypeIndex = t};
+    void *p = NULL;
+    if (t == UINT32_MAX || vk.vkAllocateMemory(V.dev, &ai, NULL, &h->m) || vk.vkBindBufferMemory(V.dev, h->b, h->m, 0) || vk.vkMapMemory(V.dev, h->m, 0, VK_WHOLE_SIZE, 0, &p)) { vcap_hbuf_free(h); return 0; }
+    h->p = p; h->n = n; return 1;
+}
+void vcap_hbuf_free(vcap_hbuf *h) { if (h->b) vk.vkDestroyBuffer(V.dev, h->b, NULL); if (h->m) vk.vkFreeMemory(V.dev, h->m, NULL); memset(h, 0, sizeof *h); }
+
+// ---------- Image contents ----------
+static int plane_block(const vka_img *im, int pl, uint32_t *bw, uint32_t *bh, VkImageAspectFlags *asp) {   // bytes per block of a plane (0 = unknown)
+    *bw = *bh = 1;
+    switch (im->f.kind) {
+    case 3: *asp = VK_IMAGE_ASPECT_DEPTH_BIT; return pl ? 0 : im->f.vk == VK_FORMAT_D16_UNORM ? 2 : 4;
+    case 4: *asp = VK_IMAGE_ASPECT_STENCIL_BIT; return pl ? 0 : 1;
+    case 5: *asp = pl ? VK_IMAGE_ASPECT_STENCIL_BIT : VK_IMAGE_ASPECT_DEPTH_BIT; return pl ? 1 : 4;   // the depth aspect of D24S8 and D32S8 copies as 4 bytes a texel
+    default: *asp = VK_IMAGE_ASPECT_COLOR_BIT; if (pl) return 0; *bw = im->f.bw ? im->f.bw : 1; *bh = im->f.bh ? im->f.bh : 1; return im->f.bpb;
+    }
+}
+uint32_t vcap_subs(const vka_img *im, cap_tsub **subs, uint64_t *total) {
+    *subs = NULL; *total = 0;
+    if (!im || im->samples > 1 || !im->img) return 0;
+    uint32_t np = im->f.kind == 5 ? 2 : 1, n = 0, layers = im->layers ? im->layers : 1, levels = im->levels ? im->levels : 1;
+    cap_tsub *s = calloc((size_t)np * levels * layers, sizeof *s);
+    for (uint32_t pl = 0; pl < np; pl++) for (uint32_t lv = 0; lv < levels; lv++) for (uint32_t ly = 0; ly < layers; ly++) {
+        uint32_t w = MAX(im->w >> lv, 1u), h = MAX(im->h >> lv, 1u), d = im->d.target == NVN_TEXTURE_TARGET_3D ? MAX(im->depth >> lv, 1u) : 1, bw, bh; VkImageAspectFlags a;
+        uint64_t bpb = (uint64_t)plane_block(im, (int)pl, &bw, &bh, &a);
+        if (!bpb) { free(s); return 0; }
+        uint64_t row = (uint64_t)((w + bw - 1) / bw) * bpb, img = row * ((h + bh - 1) / bh);
+        s[n++] = (cap_tsub){lv, ly, w, h, d, pl, row, img, img * d}; *total += img * d;
+    }
+    *subs = s; return n;
+}
+VkDeviceSize vcap_sub_off(const cap_tsub *subs, uint32_t i) { VkDeviceSize o = 0; for (uint32_t j = 0; j < i; j++) o += (subs[j].bytes + 15) & ~15ull; return o; }
+void vcap_img_copy(VkCommandBuffer cb, vka_img *im, const cap_tsub *subs, uint32_t nsub, VkBuffer b, int to_image) {
+    VkBufferImageCopy *c = calloc(nsub ? nsub : 1, sizeof *c); VkDeviceSize off = 0;
+    for (uint32_t i = 0; i < nsub; i++) {
+        uint32_t bw, bh; VkImageAspectFlags a; plane_block(im, (int)subs[i].plane, &bw, &bh, &a);
+        c[i] = (VkBufferImageCopy){off, 0, 0, {a, subs[i].level, subs[i].slice, 1}, {0, 0, 0}, {subs[i].w, subs[i].h, subs[i].d}};
+        off += (subs[i].bytes + 15) & ~15ull;
+    }
+    if (to_image) vka_tex_own(im, cb);   // (a zero-shared image gets memory of its own first)
+    vka_barrier(cb);
+    if (to_image) vk.vkCmdCopyBufferToImage(cb, b, im->img, VK_IMAGE_LAYOUT_GENERAL, nsub, c);
+    else vk.vkCmdCopyImageToBuffer(cb, im->img, VK_IMAGE_LAYOUT_GENERAL, b, nsub, c);
+    vka_barrier(cb);
+    free(c);
+}
+uint8_t *vcap_img_level0(vka_img *im, size_t *n) {
+    cap_tsub *all; uint64_t total; uint32_t ns = vcap_subs(im, &all, &total);
+    if (!ns || !im->inited) { free(all); return NULL; }
+    cap_tsub s = all[0]; free(all);   // plane 0, level 0, layer 0
+    vcap_hbuf h; if (!vcap_hbuf_make(&h, s.bytes)) return NULL;
+    VkCommandBuffer cb = vcap_cb_begin(); uint8_t *out = NULL;
+    if (cb) { vcap_img_copy(cb, im, &s, 1, h.b, 0); if (vcap_cb_run(cb, &h, im) && (out = malloc((size_t)s.bytes))) { memcpy(out, h.p, (size_t)s.bytes); *n = (size_t)s.bytes; } }
+    vcap_hbuf_free(&h);
+    return out;
+}
