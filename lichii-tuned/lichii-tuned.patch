+        // The next target counts from the refresh the previous frame was shown at. At most a
+        // refresh and a half: a driver whose present wait never signals would hold every frame
+        // for the whole wait (the pacer turns itself off after a few of these).
+        const auto limit = std::chrono::duration_cast<std::chrono::nanoseconds>(
+            pacer.RefreshPeriod() * 3 / 2 + std::chrono::milliseconds{2});
