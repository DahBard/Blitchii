+void Scheduler::ReportStageTimes() {
+    const u32 count = trace_stage_count;
+    trace_stage_count = 0;
+    if (count == 0) {
+        return;
+    }
+    struct Result {
+        u64 timestamp;
+        u64 available;
+    };
+    std::array<Result, TraceMaxStages * 2> results{};
+    const auto result = device.GetLogical().GetQueryResults(
+        *trace_work_pool, TraceStageQueries, count * 2, count * 2 * sizeof(Result), results.data(),
+        sizeof(Result), VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+    if (result != VK_SUCCESS) {
+        return;
+    }
+    static constexpr std::array names{
+        "none",      "motion",    "color", "fsr",        "output",
+        "reference", "composite", "adapt", "hdr_encode", "applet",
+    };
+    static_assert(names.size() == static_cast<size_t>(GpuStage::Count));
+    std::array<double, names.size()> stage_ms{};
+    std::array<u32, names.size()> runs{};
+    double total_ms{};
+    for (u32 i = 0; i < count; ++i) {
+        if (results[i * 2].available == 0 || results[i * 2 + 1].available == 0) {
+            continue;
+        }
+        const double ms =
+            static_cast<double>(Common::DkbFrameTrace::TimestampDelta(
+                results[i * 2].timestamp, results[i * 2 + 1].timestamp, trace_timestamp_bits)) *
+            trace_timestamp_period / 1e6;
+        const auto stage = static_cast<size_t>(trace_stage_items[i]);
+        stage_ms[stage] += ms;
+        ++runs[stage];
+        total_ms += ms;
+    }
+    std::string stages;
+    for (size_t stage = 1; stage < names.size(); ++stage) {
+        if (runs[stage] == 0) {
+            continue;
+        }
+        stages += fmt::format(" {}_ms={:.3f}", names[stage], stage_ms[stage]);
+        if (runs[stage] > 1) {
+            stages += fmt::format(" {}_runs={}", names[stage], runs[stage]);
+        }
+    }
+    // Paired with 'DKB gpu_frame' by renderer_frame. Each stage runs from the end of the work
+    // before it to its own end, so the stages add up within gpu_busy_ms.
+    LOG_INFO(Render_Vulkan, "DKB fsr_stages renderer_frame={} draws_timed={} stage_sum_ms={:.3f}{}",
+             trace_sample_frame, trace_time_draws ? 1 : 0, total_ms, stages);
 }
 
