+
+namespace Vulkan::DeviceMemory {
+namespace {
+
+constexpr VkDeviceSize MiB = VkDeviceSize{1} << 20;
+/// VMA's default blocks and the separate pools' (Device::SeparatePoolBlockSize).
+constexpr VkDeviceSize SmallBlock = 16 * MiB;
+/// The medium image pool's blocks (Device::MediumImagePoolBlockSize).
+constexpr VkDeviceSize LargeBlock = 256 * MiB;
+
+std::atomic<Reserve*> g_active{nullptr};
+
+/// The flags of a block allocation's chain (empty, or one VkMemoryAllocateFlagsInfo for buffer
+/// device addresses), or nothing for any other chain: memory dedicated to an image or a buffer,
+/// exported memory, priorities, device masks.
+std::optional<VkMemoryAllocateFlags> BlockFlags(const VkMemoryAllocateInfo& info) {
+    VkMemoryAllocateFlags flags = 0;
+    for (auto* next = static_cast<const VkBaseInStructure*>(info.pNext); next != nullptr;
+         next = next->pNext) {
+        if (next->sType != VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO) {
+            return std::nullopt;
+        }
+        const auto& flags_info = *reinterpret_cast<const VkMemoryAllocateFlagsInfo*>(next);
+        if ((flags_info.flags & VK_MEMORY_ALLOCATE_DEVICE_MASK_BIT) != 0) {
+            return std::nullopt;
+        }
+        flags |= flags_info.flags;
+    }
+    return flags;
+}
+
+struct Counter {
+    std::atomic<u64> count{0};
+    std::atomic<u64> ns{0};
+    std::atomic<u64> bytes{0};
+
+    void Add(u64 bytes_, u64 ns_) {
+        count.fetch_add(1, std::memory_order_relaxed);
+        ns.fetch_add(ns_, std::memory_order_relaxed);
+        bytes.fetch_add(bytes_, std::memory_order_relaxed);
+    }
+};
+
+struct Taken {
+    u64 count;
+    double ms;
+    u64 mib;
+};
+
+Taken TakeCounter(Counter& counter) {
+    return {
+        .count = counter.count.exchange(0, std::memory_order_relaxed),
+        .ms = static_cast<double>(counter.ns.exchange(0, std::memory_order_relaxed)) / 1e6,
+        .mib = counter.bytes.exchange(0, std::memory_order_relaxed) / MiB,
+    };
+}
+
+struct Counters {
+    Counter all;
+    Counter small_blocks;
+    Counter large_blocks;
+    Counter dedicated;
+    Counter other;
+    Counter host;
+    Counter frees;
+    std::mutex longest_mutex;
+    u64 longest_ns{};
+    u64 longest_bytes{};
+    std::atomic<u64> ring_uploads{0};
+    std::atomic<u64> ring_bytes{0};
+    std::atomic<u64> ring_refusals{0};
+    std::atomic<u64> ring_large_uploads{0};
+    std::atomic<u64> ring_refusals_behind_large{0};
+};
+
+Counters g_counters;
+VkPhysicalDeviceMemoryProperties g_properties{};
+
+} // Anonymous namespace
+
+std::optional<u64> ReadMiBSwitch(const char* name) {
+    return ParseMiBSwitch(std::getenv(name));
+}
+
+Reserve::Reserve(VkDevice device_, PFN_vkAllocateMemory allocate_, PFN_vkFreeMemory free_,
+                 const VkPhysicalDeviceMemoryProperties& properties, u64 cap_)
+    : device{device_}, allocate{allocate_}, free_memory{free_}, cap{cap_}, limit{cap_} {
+    constexpr VkMemoryPropertyFlags excluded =
+        VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT |
+        VK_MEMORY_PROPERTY_PROTECTED_BIT | VK_MEMORY_PROPERTY_DEVICE_COHERENT_BIT_AMD |
+        VK_MEMORY_PROPERTY_DEVICE_UNCACHED_BIT_AMD;
+    for (u32 type = 0; type < properties.memoryTypeCount; ++type) {
+        const VkMemoryType& memory_type = properties.memoryTypes[type];
+        heap_of_type[type] = memory_type.heapIndex;
+        if ((memory_type.propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) != 0 &&
+            (memory_type.propertyFlags & excluded) == 0) {
+            keep_types |= 1U << type;
+        }
+    }
+}
+
+Reserve::~Reserve() {
+    Close();
+}
+
+Reserve* Reserve::Active(VkDevice device) noexcept {
+    Reserve* const reserve = g_active.load(std::memory_order_acquire);
+    return reserve != nullptr && reserve->device == device ? reserve : nullptr;
+}
+
+void Reserve::Activate() noexcept {
+    g_active.store(this, std::memory_order_release);
+}
+
+bool Reserve::Keeps(u32 memory_type) const noexcept {
+    return memory_type < VK_MAX_MEMORY_TYPES && ((keep_types >> memory_type) & 1) != 0;
+}
+
+std::optional<Reserve::Key> Reserve::KeyOf(const VkMemoryAllocateInfo& info) const noexcept {
+    if (!Keeps(info.memoryTypeIndex) ||
+        (info.allocationSize != SmallBlock && info.allocationSize != LargeBlock)) {
+        return std::nullopt;
+    }
+    const std::optional<VkMemoryAllocateFlags> flags = BlockFlags(info);
+    if (!flags) {
+        return std::nullopt;
+    }
+    return Key{
+        .memory_type = info.memoryTypeIndex,
+        .flags = *flags,
+        .size = info.allocationSize,
+    };
+}
+
+u64 Reserve::Allowed() const noexcept {
+    return (std::min)(cap, limit.load(std::memory_order_relaxed));
+}
+
+void Reserve::AddKept(const Key& key) {
+    kept_total.fetch_add(key.size, std::memory_order_relaxed);
+    kept_blocks.fetch_add(1, std::memory_order_relaxed);
+    kept_by_heap[heap_of_type[key.memory_type]].fetch_add(key.size, std::memory_order_relaxed);
+}
+
+void Reserve::RemoveKept(const Key& key) {
+    kept_total.fetch_sub(key.size, std::memory_order_relaxed);
+    kept_blocks.fetch_sub(1, std::memory_order_relaxed);
+    kept_by_heap[heap_of_type[key.memory_type]].fetch_sub(key.size, std::memory_order_relaxed);
+}
+
+u32 Reserve::Make(u32 memory_type, VkDeviceSize size, u32 count, VkMemoryAllocateFlags flags) {
+    // VMA's blocks: VkMemoryAllocateFlagsInfo with the device address bit when the allocator uses
+    // buffer device addresses (VmaBlockVector::CreateBlock).
+    const VkMemoryAllocateFlagsInfo flags_info{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO,
+        .pNext = nullptr,
+        .flags = flags,
+        .deviceMask = 0,
+    };
+    const VkMemoryAllocateInfo info{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+        .pNext = flags != 0 ? &flags_info : nullptr,
+        .allocationSize = size,
+        .memoryTypeIndex = memory_type,
+    };
+    const std::optional<Key> key = KeyOf(info);
+    if (!key) {
+        return 0;
+    }
+    u32 made = 0;
+    for (; made < count; ++made) {
+        VkDeviceMemory memory{};
+        if (allocate(device, &info, nullptr, &memory) != VK_SUCCESS) {
+            break;
+        }
+        std::scoped_lock lock{mutex};
+        blocks.push_back({memory, *key});
+        AddKept(*key);
+    }
+    return made;
+}
+
+bool Reserve::Take(const VkMemoryAllocateInfo& info, VkDeviceMemory& memory) {
+    const std::optional<Key> key = KeyOf(info);
+    if (!key || kept_total.load(std::memory_order_relaxed) == 0) {
+        return false;
+    }
+    std::scoped_lock lock{mutex};
+    if (closed) {
+        return false;
+    }
+    // The newest first: the one most likely still resident.
+    const auto it = std::find_if(blocks.rbegin(), blocks.rend(),
+                                 [&key](const Block& block) { return block.key == *key; });
+    if (it == blocks.rend()) {
+        return false;
+    }
+    memory = it->memory;
+    blocks.erase(std::next(it).base());
+    RemoveKept(*key);
+    tracked.insert_or_assign(memory, *key);
+    ++totals.reused;
+    totals.reused_bytes += key->size;
+    return true;
+}
+
+void Reserve::Track(const VkMemoryAllocateInfo& info, VkDeviceMemory memory) {
+    if (const std::optional<Key> key = KeyOf(info)) {
+        std::scoped_lock lock{mutex};
+        if (!closed) {
+            tracked.insert_or_assign(memory, *key);
+        }
+    }
+}
+
+bool Reserve::Keep(VkDeviceMemory memory) {
+    std::scoped_lock lock{mutex};
+    const auto it = tracked.find(memory);
+    if (it == tracked.end()) {
+        return false;
+    }
+    const Key key = it->second;
+    tracked.erase(it);
+    if (closed || kept_total.load(std::memory_order_relaxed) + key.size > Allowed()) {
+        return false;
+    }
+    blocks.push_back({memory, key});
+    AddKept(key);
+    ++totals.kept;
+    totals.kept_bytes += key.size;
+    return true;
+}
+
+void Reserve::SetLimit(u64 bytes) noexcept {
+    limit.store(bytes, std::memory_order_relaxed);
+}
+
+void Reserve::Trim() {
+    const u64 allowed = Allowed();
+    if (kept_total.load(std::memory_order_relaxed) <= allowed) {
+        return;
+    }
+    Block block{};
+    {
+        std::scoped_lock lock{mutex};
+        const u64 kept = kept_total.load(std::memory_order_relaxed);
+        if (blocks.empty() || kept <= allowed) {
+            return;
+        }
+        // One a frame, each a driver call: the oldest block of the smallest size that brings the
+        // reserve under its limit, else the oldest of the largest. The limit moves by a few MiB
+        // with the budget and the usage; such a step costs a 16 MiB block, not a 256 MiB one.
+        const u64 excess = kept - allowed;
+        auto chosen = blocks.begin();
+        for (auto it = std::next(blocks.begin()); it != blocks.end(); ++it) {
+            const bool fits = it->key.size >= excess;
+            const bool chosen_fits = chosen->key.size >= excess;
+            if (fits ? !chosen_fits || it->key.size < chosen->key.size
+                     : !chosen_fits && it->key.size > chosen->key.size) {
+                chosen = it;
+            }
+        }
+        block = *chosen;
+        blocks.erase(chosen);
+        RemoveKept(block.key);
+        ++totals.released;
+        totals.released_bytes += block.key.size;
+    }
+    const auto start = std::chrono::steady_clock::now();
+    free_memory(device, block.memory, nullptr);
+    if (Stats::Enabled()) {
+        Stats::CountFree(static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                              std::chrono::steady_clock::now() - start)
+                                              .count()));
+    }
+}
+
+u64 Reserve::Release() {
+    std::vector<Block> released;
+    {
+        std::scoped_lock lock{mutex};
+        released.swap(blocks);
+        for (const Block& block : released) {
+            RemoveKept(block.key);
+            ++totals.released;
+            totals.released_bytes += block.key.size;
+        }
+    }
+    u64 bytes = 0;
+    for (const Block& block : released) {
+        free_memory(device, block.memory, nullptr);
+        bytes += block.key.size;
+    }
+    return bytes;
+}
+
+void Reserve::Close() {
+    {
+        std::scoped_lock lock{mutex};
+        closed = true;
+        tracked.clear();
+    }
+    Reserve* self = this;
+    g_active.compare_exchange_strong(self, nullptr, std::memory_order_acq_rel);
+    // Nothing is kept once closed.
+    Release();
+}
+
+u64 Reserve::KeptBytes() const noexcept {
+    return kept_total.load(std::memory_order_relaxed);
+}
+
+u64 Reserve::KeptBytes(u32 heap) const noexcept {
+    return heap < VK_MAX_MEMORY_HEAPS ? kept_by_heap[heap].load(std::memory_order_relaxed) : 0;
+}
+
+u64 Reserve::KeptBlocks() const noexcept {
+    return kept_blocks.load(std::memory_order_relaxed);
+}
+
+u64 Reserve::Limit() const noexcept {
+    return limit.load(std::memory_order_relaxed);
+}
+
+Reserve::Totals Reserve::TakeTotals() {
+    std::scoped_lock lock{mutex};
+    return std::exchange(totals, Totals{});
+}
+
+namespace Stats {
+
+void Enable(const VkPhysicalDeviceMemoryProperties& properties) {
+    g_properties = properties;
+    g_enabled.store(true, std::memory_order_release);
+}
+
+void CountAllocation(const VkMemoryAllocateInfo& info, u64 ns) {
+    const VkDeviceSize size = info.allocationSize;
+    g_counters.all.Add(size, ns);
+    bool dedicated = false;
+    for (auto* next = static_cast<const VkBaseInStructure*>(info.pNext); next != nullptr;
+         next = next->pNext) {
+        dedicated |= next->sType == VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO;
+    }
+    if (dedicated) {
+        g_counters.dedicated.Add(size, ns);
+    } else if (size == SmallBlock) {
+        g_counters.small_blocks.Add(size, ns);
+    } else if (size == LargeBlock) {
+        g_counters.large_blocks.Add(size, ns);
+    } else {
+        g_counters.other.Add(size, ns);
+    }
+    if (info.memoryTypeIndex < g_properties.memoryTypeCount &&
+        (g_properties.memoryTypes[info.memoryTypeIndex].propertyFlags &
+         VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) == 0) {
+        g_counters.host.Add(size, ns);
+    }
+    std::scoped_lock lock{g_counters.longest_mutex};
+    if (ns > g_counters.longest_ns) {
+        g_counters.longest_ns = ns;
+        g_counters.longest_bytes = size;
+    }
+}
+
+void CountFree(u64 ns) {
+    g_counters.frees.Add(0, ns);
+}
+
+void CountRingUpload(u64 bytes, bool large) {
+    g_counters.ring_uploads.fetch_add(1, std::memory_order_relaxed);
+    g_counters.ring_bytes.fetch_add(bytes, std::memory_order_relaxed);
+    if (large) {
+        g_counters.ring_large_uploads.fetch_add(1, std::memory_order_relaxed);
+    }
+}
+
+void CountRingRefusal(bool behind_large) {
+    g_counters.ring_refusals.fetch_add(1, std::memory_order_relaxed);
+    if (behind_large) {
+        g_counters.ring_refusals_behind_large.fetch_add(1, std::memory_order_relaxed);
+    }
+}
+
+void Tick(Reserve* reserve) {
+    using Clock = std::chrono::steady_clock;
+    static Clock::time_point window_start = Clock::now();
+    const Clock::time_point now = Clock::now();
+    if (now - window_start < std::chrono::seconds{10}) {
+        return;
+    }
+    const double seconds = std::chrono::duration<double>(now - window_start).count();
+    window_start = now;
+    const Taken all = TakeCounter(g_counters.all);
+    const Taken small_blocks = TakeCounter(g_counters.small_blocks);
+    const Taken large_blocks = TakeCounter(g_counters.large_blocks);
+    const Taken dedicated = TakeCounter(g_counters.dedicated);
+    const Taken other = TakeCounter(g_counters.other);
+    const Taken host = TakeCounter(g_counters.host);
+    const Taken frees = TakeCounter(g_counters.frees);
+    u64 longest_ns{};
+    u64 longest_bytes{};
+    {
+        std::scoped_lock lock{g_counters.longest_mutex};
+        longest_ns = std::exchange(g_counters.longest_ns, 0);
+        longest_bytes = std::exchange(g_counters.longest_bytes, 0);
+    }
+    const u64 ring_uploads = g_counters.ring_uploads.exchange(0, std::memory_order_relaxed);
+    const u64 ring_bytes = g_counters.ring_bytes.exchange(0, std::memory_order_relaxed);
+    const u64 ring_refusals = g_counters.ring_refusals.exchange(0, std::memory_order_relaxed);
+    const u64 ring_large_uploads =
+        g_counters.ring_large_uploads.exchange(0, std::memory_order_relaxed);
+    const u64 ring_refusals_behind_large =
+        g_counters.ring_refusals_behind_large.exchange(0, std::memory_order_relaxed);
+    const Reserve::Totals totals = reserve != nullptr ? reserve->TakeTotals() : Reserve::Totals{};
+    if (all.count + frees.count + ring_uploads + ring_refusals + totals.reused + totals.kept +
+            totals.released ==
+        0) {
+        return;
+    }
+    std::string details;
+    if (reserve != nullptr) {
+        fmt::format_to(std::back_inserter(details),
+                       "; reserve {} reused ({} MiB), {} kept ({} MiB), {} released ({} MiB), "
+                       "holds {} MiB in {} blocks (cap {} MiB, limit {} MiB)",
+                       totals.reused, totals.reused_bytes / MiB, totals.kept,
+                       totals.kept_bytes / MiB, totals.released, totals.released_bytes / MiB,
+                       reserve->KeptBytes() / MiB, reserve->KeptBlocks(), reserve->Cap() / MiB,
+                       reserve->Limit() / MiB);
+    }
+    if (g_staging_ring_mib.load(std::memory_order_relaxed) != 0) {
+        fmt::format_to(std::back_inserter(details),
+                       "; staging ring {} uploads ({} MiB), {} refused ({} while an upload over "
+                       "half the ring was in flight), {} over half the ring",
+                       ring_uploads, ring_bytes / MiB, ring_refusals, ring_refusals_behind_large,
+                       ring_large_uploads);
+    }
+    LOG_INFO(Render_Vulkan,
+             "Device memory in {:.1f} s: {} driver allocations ({} MiB) in {:.1f} ms, longest "
+             "{:.1f} ms ({} MiB): 16 MiB blocks {} in {:.1f} ms, 256 MiB blocks {} in {:.1f} ms, "
+             "dedicated {} ({} MiB) in {:.1f} ms, other {} ({} MiB) in {:.1f} ms, in host memory "
+             "{} in {:.1f} ms; {} driver frees in {:.1f} ms{}",
+             seconds, all.count, all.mib, all.ms, static_cast<double>(longest_ns) / 1e6,
+             longest_bytes / MiB, small_blocks.count, small_blocks.ms, large_blocks.count,
+             large_blocks.ms, dedicated.count, dedicated.mib, dedicated.ms, other.count, other.mib,
+             other.ms, host.count, host.ms, frees.count, frees.ms, details);
+}
+
+} // namespace Stats
+
+} // namespace Vulkan::DeviceMemory
