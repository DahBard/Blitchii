+// From Banana Native (github.com/hugorosario/BananaNative, Android port of github.com/seedds/nxnative by seedds), MIT: see LICENSE in src/video_core/nvn_direct/bananative.
+// The replay worker: the game's submissions and presents are replayed on a thread of their own, so the game's thread goes on to its next frame while the
+// Vulkan commands of this one are recorded (on the Adreno 840 phone Donkey Kong Bananza's level spent ~48 ms a frame recording and ~29 ms in its own
+// work on the same thread, one after the other).
+//
+// What the game sees stays what NVN promises, as the inline replay gave it:
+// - Order: submissions, presents and queue finalizations are replayed in the order the game made them (one FIFO, one thread).
+// - Fences: a submission's fence is reserved when the game submits (vka_fence_next, in order), so mtl_last_fence, QueueFenceSync and the window's acquire syncs name
+//   it at once; a sync fenced inside a command buffer (OP_FENCE_SYNC) is given it before the submission is queued (fence_syncs), as the game may wait on it right
+//   after. A wait for a fence the worker has not submitted yet waits for it (vka_wait_done waits for completion, not for submission); the hang detection only
+//   counts fences handed to the GPU.
+// - Presents: the ticket is reserved when the game presents (vka_present_reserve: its order and the bound of the present queue), the frame is filled when the
+//   worker reaches it, after every submission before it was handed to the queue.
+// - CPU reads at replay time (deferred texture binds, render conditions, indirect counts, texture uploads from storage) happen later than inline, which is
+//   closer to the GPU reading them when it runs the commands; the game cannot rely on the old timing (its GPU runs a frame or more behind).
+// - mtl_finish / mtl_drain wait for the last fence reserved, so for the worker too.
+// The game runs at most DM_VK_WORKER_FRAMES (default 1) presents ahead of the worker. DM_VK_WORKER=0 replays inline on the submitting thread, as before.
+#if defined(__ANDROID__)
+#include "vka.h"
+#include "../nvn/nvn_mtl.h"
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+uint64_t vka_frame(void);
+void vka_exec_sub_frame(uint64_t f);
+static uint64_t wns(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return (uint64_t)t.tv_sec * 1000000000ull + (uint64_t)t.tv_nsec; }
+// Where the time goes (logged every 300 presents): the worker busy replaying, idle waiting for a job; the game waiting for room in the queue
+static uint64_t g_busy_ns, g_idle_ns, g_room_ns, g_sub_ns;
+static _Atomic uint64_t g_room_all, g_sub_all, g_sub_cpu_all;   // cumulative (vka_worker_waits: the [longframe] line's attribution); sub_cpu: the worker's CPU time in submissions
+void vka_worker_waits(uint64_t *room_ns, uint64_t *sub_ns) { if (room_ns) *room_ns = atomic_load(&g_room_all); if (sub_ns) *sub_ns = atomic_load(&g_sub_all); }
+uint64_t vka_worker_sub_cpu(void) { return atomic_load(&g_sub_cpu_all); }   // a recording time far above it: the replay thread was blocked in the submission, not busy
+static uint64_t thread_cpu_ns(void) { struct timespec t; clock_gettime(CLOCK_THREAD_CPUTIME_ID, &t); return (uint64_t)t.tv_sec * 1000000000ull + (uint64_t)t.tv_nsec; }
+
+enum { J_SUB = 1, J_PRESENT, J_FORGET, J_EVENT };
+typedef struct {
+    int kind;
+    uint64_t serial, fence, frame; int origin_ll;   // J_SUB: the queue, its window origin, the fence reserved for it, the game's frame when it submitted
+    const uint8_t **h; int nh;                   // J_SUB: the command handles, in order
+    uint64_t wait[NVN_QUEUE_WAITS]; int nwait;   // J_SUB: the fences it waits for (mtl_sub_wait)
+    uint64_t ticket; tex_t t; double period; int has_crop, crop[4];   // J_PRESENT
+    volatile uint32_t *ev; int ev_mode; uint32_t ev_v;                // J_EVENT: a CPU signal (mtl_event_cpu)
+} job_t;
+enum { NJOB = 256 };
+static job_t g_q[NJOB]; static uint64_t g_qin, g_qout, g_pres_in, g_pres_out;   // jobs queued / done; presents queued / done
+static pthread_mutex_t g_mu = PTHREAD_MUTEX_INITIALIZER; static pthread_cond_t g_cv = PTHREAD_COND_INITIALIZER;
+static int g_on = -1, g_frames = 1, g_up;
+// The submission being gathered on the game's thread (the host submits under its own lock: one at a time)
+static job_t g_cur; static int g_cur_cap, g_in_sub; static uint64_t g_pend_serial; static int g_pend_origin;
+
+int vka_worker_on(void) {
+    if (g_on < 0) { const char *e = getenv("DM_VK_WORKER"); g_on = !e || atoi(e); e = getenv("DM_VK_WORKER_FRAMES"); g_frames = e && atoi(e) > 0 ? atoi(e) : 1; }
+    return g_on;
+}
+// Core placement experiments (live, CPU masks as decimal numbers, 0 = leave as is: 192 = cpus 6-7): DM_VK_AFF_REPLAY for this thread, DM_VK_AFF_ALL for every thread of the process (read at each job)
+#include <sched.h>
+#include <dirent.h>
+#include <errno.h>
+static void aff_set(pid_t tid, unsigned mask) {
+    cpu_set_t cs; CPU_ZERO(&cs); for (int c = 0; c < 32; c++) if (mask >> c & 1) CPU_SET(c, &cs);
+    if (sched_setaffinity(tid, sizeof cs, &cs)) { static _Atomic int n; if (atomic_fetch_add(&n, 1) < 4) VRED("sched_setaffinity(%d, %#x): errno %d", (int)tid, mask, errno); }
+}
+static void aff_check(void) {
+    static unsigned r_was, a_was;
+    unsigned r = (unsigned)VKA_ENV("DM_VK_AFF_REPLAY", 0), a = (unsigned)VKA_ENV("DM_VK_AFF_ALL", 0);
+    if (a != a_was) { a_was = a; if (a) { DIR *d = opendir("/proc/self/task"); struct dirent *e; int n = 0;
+            while (d && (e = readdir(d))) if (e->d_name[0] != '.') { aff_set((pid_t)atoi(e->d_name), a); n++; }
+            if (d) closedir(d); VLOG("DM_VK_AFF_ALL=%#x: %d threads", a, n); } }
+    if (r != r_was) { r_was = r; if (r) { aff_set(0, r); VLOG("DM_VK_AFF_REPLAY=%#x", r); } }
+}
+// Lab (DM_VK_SLOWSUB_MS=n, dotfiles-25x.13): each submission whose replay took over n ms of wall time, with what it spent: its CPU time (the rest it was blocked),
+// and the parts of it that the replay's counters see (images made, uploads, pipelines made on the frame path and waits for prewarm threads, pool placements and
+// give-backs, waits for the memory table and the encoder, tex_prepare, upload flushes, vkQueueSubmit)
+typedef struct { uint64_t v[23]; } slow_snap;
+uint64_t vka_up_slot_waits(void);
+uint64_t vka_up_batches(void);
+void vka_up_work_stats(uint64_t *qlock_ns, uint64_t *sblk_n, uint64_t *sblk_ns, uint64_t *sblk_free_ns, uint64_t *up_wait_ns);
+extern uint64_t vka_o72_ns[8];
+void vka_tex_work_stats(uint64_t *made, uint64_t *make_ns, uint64_t *up_ns, uint64_t *up_bytes);
+void vka_mem_waits(uint64_t *place_ns, uint64_t *place_bytes, uint64_t *place_n, uint64_t *give_ns, uint64_t *wait_rec_ns, uint64_t *wait_other_ns);
+void vka_pso_waits(uint64_t *save_ns, uint64_t *pw_wait_ns);
+void mtl_create_ns(uint64_t *lib_ns, uint64_t *pso_ns);
+uint64_t vka_enc_waits(void);
+uint64_t vka_present_filled(void);
+static void slow_take(slow_snap *s) {
+    uint64_t lib, other;
+    vka_tex_work_stats(&s->v[0], &s->v[1], &s->v[2], &s->v[3]);
+    vka_mem_waits(&s->v[4], &s->v[5], &s->v[6], &s->v[7], &s->v[8], &other);
+    vka_pso_waits(&lib, &s->v[9]); mtl_create_ns(&lib, &s->v[10]);
+    s->v[11] = vka_enc_waits(); s->v[12] = vka_o72_ns[0]; s->v[13] = vka_o72_ns[2]; s->v[14] = vka_o72_ns[3]; s->v[15] = vka_o72_ns[4];
+    vka_up_work_stats(&s->v[16], &s->v[17], &s->v[18], &s->v[19], &s->v[20]); s->v[21] = vka_up_batches(); s->v[22] = vka_up_slot_waits();
+}
+static void slow_log(uint64_t wall, uint64_t cpu, const slow_snap *a, const slow_snap *b) {
+    uint64_t d[23]; for (int i = 0; i < 23; i++) d[i] = b->v[i] - a->v[i];
+    VLOG("slow submission at present %llu: %.1f ms (CPU %.1f): %llu images made %.1f ms, uploads %.1f ms (%.1f MB), frame-path pipelines %.1f ms, prewarm waits %.1f ms, "
+         "pool placements %.1f ms (%llu, %.1f MB), give-backs %.1f ms, memory table waits %.1f ms, encoder waits %.1f ms, tex_prepare %.1f ms, upload flushes %.1f ms, submit %.1f ms, sub_begin %.1f ms; queue lock waits %.1f ms (any thread), staging blocks made %llu in %.1f ms, freed in %.1f ms, upload batch waits %.1f ms (%.1f of them for a batch slot; %llu batches)",
+         (unsigned long long)vka_present_filled(), wall / 1e6, cpu / 1e6, (unsigned long long)d[0], d[1] / 1e6, d[2] / 1e6, d[3] / 1e6, d[10] / 1e6, d[9] / 1e6,
+         d[4] / 1e6, (unsigned long long)d[6], d[5] / 1e6, d[7] / 1e6, d[8] / 1e6, d[11] / 1e6, d[12] / 1e6, d[13] / 1e6, d[14] / 1e6, d[15] / 1e6,
+         d[16] / 1e6, (unsigned long long)d[17], d[18] / 1e6, d[19] / 1e6, d[20] / 1e6, d[22] / 1e6, (unsigned long long)d[21]);
+}
+static void *worker_main(void *arg) {
+    (void)arg; pthread_setname_np(pthread_self(), "vk-replay");
+    for (;;) {
+        uint64_t t0 = wns();
+        pthread_mutex_lock(&g_mu);
+        while (g_qout == g_qin) pthread_cond_wait(&g_cv, &g_mu);
+        job_t j = g_q[g_qout % NJOB];
+        pthread_mutex_unlock(&g_mu);
+        uint64_t t1 = wns(), c1 = j.kind == J_SUB ? thread_cpu_ns() : 0; g_idle_ns += t1 - t0;
+        aff_check();
+        static int slow_ms = -1; if (slow_ms < 0) { const char *e = getenv("DM_VK_SLOWSUB_MS"); slow_ms = e ? atoi(e) : 0; }
+        slow_snap sa; if (slow_ms > 0 && j.kind == J_SUB) slow_take(&sa);
+        if (j.kind == J_SUB) {
+            vka_rp_queue_activate(j.serial); vka_rp_set_queue_origin(j.origin_ll);
+            vka_gp_sub_frame(j.frame); vka_exec_sub_frame(j.frame); vka_rp_sub_begin();
+            for (int i = 0; i < j.nwait; i++) vka_rp_sub_wait(j.wait[i]);
+            for (int i = 0; i < j.nh; i++) vka_rp_exec(j.h[i], j.fence);
+            vka_rp_sub_commit(j.fence);
+            free(j.h);
+        } else if (j.kind == J_PRESENT) vka_present_fill(j.ticket, &j.t, j.period, j.has_crop ? j.crop : NULL);
+        else if (j.kind == J_FORGET) vka_rp_queue_forget(j.serial);
+        else if (j.kind == J_EVENT) vka_rp_event(j.ev, j.ev_mode, j.ev_v);
+        uint64_t t2 = wns(); g_busy_ns += t2 - t1;
+        if (slow_ms > 0 && j.kind == J_SUB && t2 - t1 > (uint64_t)slow_ms * 1000000ull) { slow_snap sb; slow_take(&sb); slow_log(t2 - t1, thread_cpu_ns() - c1, &sa, &sb); } if (j.kind == J_SUB) { g_sub_ns += t2 - t1; atomic_fetch_add_explicit(&g_sub_all, t2 - t1, memory_order_relaxed); atomic_fetch_add_explicit(&g_sub_cpu_all, thread_cpu_ns() - c1, memory_order_relaxed); }
+        if (j.kind == J_PRESENT && j.ticket % 300 == 0) {
+            VLOG("replay worker up to present %llu: busy %.1f ms a frame (submissions %.1f), idle %.1f; the game waited %.1f ms a frame for the worker",
+                 (unsigned long long)j.ticket, g_busy_ns / 300e6, g_sub_ns / 300e6, g_idle_ns / 300e6, g_room_ns / 300e6);
+            g_busy_ns = g_idle_ns = g_room_ns = g_sub_ns = 0; }
+        pthread_mutex_lock(&g_mu);
+        g_qout++; if (j.kind == J_PRESENT) g_pres_out++;
+        pthread_cond_broadcast(&g_cv);
+        pthread_mutex_unlock(&g_mu);
+    }
+    return NULL;
+}
+// Lichii: started once, as submissions, CPU event signals and presents may make their first call from different threads at once
+static pthread_once_t g_up_once = PTHREAD_ONCE_INIT;
+static void up_once(void) {
+    if (!vka_worker_on()) return;
+    pthread_t th;
+    if (pthread_create(&th, NULL, worker_main, NULL)) { VRED("cannot start the replay worker: submissions are replayed inline"); g_up = -1; g_on = 0; return; }
+    pthread_detach(th); g_up = 1;
+    VLOG("replay worker: submissions and presents are replayed on their own thread, at most %d frame%s behind the game (DM_VK_WORKER=0: inline)", g_frames, g_frames == 1 ? "" : "s");
+}
+static int up(void) { pthread_once(&g_up_once, up_once); return g_up > 0; }
+static void push(const job_t *j) {
+    uint64_t t0 = wns();
+    pthread_mutex_lock(&g_mu);
+    while (!vka_stopping() && (g_qin - g_qout >= NJOB || (j->kind == J_PRESENT && g_pres_in - g_pres_out >= (uint64_t)g_frames))) pthread_cond_wait(&g_cv, &g_mu);
+    if (vka_stopping()) {   // Lichii: the emulator shuts down (vka_stop): nothing more is replayed (its fences read as done, its present shows nothing)
+        pthread_mutex_unlock(&g_mu);
+        if (j->kind == J_SUB) free(j->h);
+        return;
+    }
+    { uint64_t w = wns() - t0; g_room_ns += w; atomic_fetch_add_explicit(&g_room_all, w, memory_order_relaxed); }
+    g_q[g_qin % NJOB] = *j; g_qin++; if (j->kind == J_PRESENT) g_pres_in++;
+    pthread_cond_broadcast(&g_cv);
+    pthread_mutex_unlock(&g_mu);
+}
+void vka_worker_wake(void) { pthread_mutex_lock(&g_mu); pthread_cond_broadcast(&g_cv); pthread_mutex_unlock(&g_mu); }
+int vka_worker_idle(uint64_t timeout_ns) {
+    struct timespec dl; clock_gettime(CLOCK_REALTIME, &dl);
+    uint64_t ns = (uint64_t)dl.tv_nsec + timeout_ns; dl.tv_sec += (time_t)(ns / 1000000000ull); dl.tv_nsec = (long)(ns % 1000000000ull);
+    pthread_mutex_lock(&g_mu);
+    while (g_qout != g_qin) if (pthread_cond_timedwait(&g_cv, &g_mu, &dl)) break;
+    int idle = g_qout == g_qin; pthread_mutex_unlock(&g_mu);
+    return idle;
+}
+
+// Syncs fenced inside the submission's command lists (OP_FENCE_SYNC), given the submission's fence now: the lists are walked as exec walks them (jumps, calls)
+static void fence_syncs(const uint8_t *p, uint64_t fence, int depth) {
+    for (;;) {
+        op_hdr h; memcpy(&h, p, sizeof h);
+        const void *a = p + 8;
+        if (h.op == OP_END) return;
+        if (h.op == OP_JUMP) { memcpy(&p, a, 8); continue; }
+        if (h.op == OP_CALL) { uint64_t t; memcpy(&t, a, 8); if (depth < 16) fence_syncs((const uint8_t *)(uintptr_t)t, fence, depth + 1); }
+        if (h.op == OP_FENCE_SYNC) { sync_t *s; memcpy(&s, a, 8); s->fence = fence; s->fenced = 1; }
+        if (h.size < 8) return;
+        p += h.size;
+    }
+}
+
+// ---------- The mtl_* calls of the host's submit (hle_nvn.c nvnQueueSubmitCommands) and present ----------
+void mtl_queue_activate(uint64_t serial) { if (up()) g_pend_serial = serial; else vka_rp_queue_activate(serial); }
+void mtl_set_queue_origin_lower_left(int on) { if (up()) g_pend_origin = on != 0; else vka_rp_set_queue_origin(on); }
+void mtl_queue_forget(uint64_t serial) { if (up()) { job_t j = {J_FORGET}; j.serial = serial; push(&j); } else vka_rp_queue_forget(serial); }
+void mtl_event_cpu(volatile uint32_t *val, int mode, uint32_t v) {
+    if (!up()) { vka_rp_event(val, mode, v); return; }
+    job_t j = {J_EVENT}; j.ev = val; j.ev_mode = mode; j.ev_v = v; push(&j);
+}
+void mtl_sub_begin(void) {
+    if (!up()) { vka_rp_sub_begin(); return; }
+    g_in_sub = 1; g_cur.nh = 0; g_cur.nwait = 0;
+}
+void mtl_sub_wait(uint64_t fence) {
+    if (!g_in_sub) { vka_rp_sub_wait(fence); return; }
+    if (g_cur.nwait < NVN_QUEUE_WAITS) g_cur.wait[g_cur.nwait++] = fence;
+}
+void mtl_exec(const uint8_t *handle) {
+    if (!g_in_sub) { vka_rp_exec(handle, 0); return; }
+    if (!handle) return;
+    if (g_cur.nh == g_cur_cap) { g_cur_cap = g_cur_cap ? 2 * g_cur_cap : 64; g_cur.h = realloc(g_cur.h, (size_t)g_cur_cap * sizeof *g_cur.h); }
+    g_cur.h[g_cur.nh++] = handle;
+}
+uint64_t mtl_sub_commit(void) {
+    if (!g_in_sub) return vka_rp_sub_commit(0);
+    g_in_sub = 0;
+    job_t j = {J_SUB}; j.serial = g_pend_serial; j.origin_ll = g_pend_origin; j.nh = g_cur.nh;
+    j.nwait = g_cur.nwait; memcpy(j.wait, g_cur.wait, sizeof j.wait);
+    j.h = malloc((size_t)(j.nh ? j.nh : 1) * sizeof *j.h); if (j.nh) memcpy(j.h, g_cur.h, (size_t)j.nh * sizeof *j.h);
+    j.fence = vka_fence_next(); j.frame = vka_frame();
+    for (int i = 0; i < j.nh; i++) fence_syncs(j.h[i], j.fence, 0);
+    push(&j);
+    return j.fence;
+}
+uint64_t mtl_present(const tex_t *t, double period_s, const int crop[4]) {
+    if (!up()) return vka_present_inline(t, period_s, crop);
+    job_t j = {J_PRESENT}; j.ticket = vka_present_reserve(); j.t = *t; j.period = period_s; j.has_crop = crop != NULL; if (crop) memcpy(j.crop, crop, sizeof j.crop);
+    push(&j);
+    return j.ticket;
+}
+#endif
diff --git a/src/video_core/nvn_direct/bananative/dm/gfx/vk_android/vka_zshare.h b/src/video_core/nvn_direct/bananative/dm/gfx/vk_android/vka_zshare.h
new file mode 100644
index 0000000000..c01467dc08
--- /dev/null
+++ b/src/video_core/nvn_direct/bananative/dm/gfx/vk_android/vka_zshare.h
@@ -0,0 +1,49 @@
+// From Banana Native (github.com/hugorosario/BananaNative, Android port of github.com/seedds/nxnative by seedds), MIT: see LICENSE in src/video_core/nvn_direct/bananative.
+// Zero-shared image memory (vka_imgmem.c vka_imem_bind_zero, vka_tex.c img_own): the bookkeeping, free of Vulkan so the Mac's unit test (dm/host/tests/t_android_zshare.c)
+// can check it. A large image whose content is the GPU's (ST_ZERO) and that nothing has written yet holds zeros; images of one create info (the key: flags with
+// VK_IMAGE_CREATE_ALIAS_BIT, format, extent, levels, layers, samples, usage, format list, memory type, size, alignment) are bound at offset 0 of one zeroed allocation,
+// which Vulkan's aliasing rules let them read alike. An entry is that allocation (handle, size) and the images bound to it (refs); the allocation is freed with its last image
+#ifndef VKA_ZSHARE_H
+#define VKA_ZSHARE_H
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+enum { VKZ_KEY = 128 };
+typedef struct { uint8_t key[VKZ_KEY]; uint32_t klen; uint64_t h, size; int refs; } vkz_ent;
+typedef struct { vkz_ent *e; int n, cap; uint64_t made, owned; } vkz_tab;   // made: allocations ever made; owned: images that left their entry for memory of their own (vkz_note_own)
+
+// An image is a candidate when it is dense (no residency image), single-sampled, not 3D, not block-compressed, not linear and not a display (window) texture, and its storage
+// takes at least min_bytes. Whether its content is the GPU's (ST_ZERO) is the caller's: only those are bound to shared memory
+static inline int vkz_candidate(uint64_t storage_bytes, uint64_t min_bytes, int res, uint32_t samples, int is3d, int compressed, int linear_or_display) {
+    return min_bytes && storage_bytes >= min_bytes && !res && samples <= 1 && !is3d && !compressed && !linear_or_display;
+}
+static inline int vkz_find(const vkz_tab *t, const void *key, uint32_t klen) {
+    for (int i = 0; i < t->n; i++) if (t->e[i].klen == klen && !memcmp(t->e[i].key, key, klen)) return i;
+    return -1;
+}
+static inline int vkz_find_h(const vkz_tab *t, uint64_t h) { for (int i = 0; i < t->n; i++) if (t->e[i].h == h) return i; return -1; }
+// One more image of key: the entry's index (refs counted), or -1 when there is none (the caller allocates and calls vkz_add)
+static inline int vkz_ref(vkz_tab *t, const void *key, uint32_t klen) { int i = klen <= VKZ_KEY ? vkz_find(t, key, klen) : -1; if (i >= 0) t->e[i].refs++; return i; }
+// A new allocation h of size bytes for key, with its first image: the index, or -1 (no room; the caller frees h and binds the image as before)
+static inline int vkz_add(vkz_tab *t, const void *key, uint32_t klen, uint64_t h, uint64_t size) {
+    if (klen > VKZ_KEY || !h) return -1;
+    if (t->n == t->cap) { int c = t->cap ? 2 * t->cap : 16; vkz_ent *e = (vkz_ent *)realloc(t->e, (size_t)c * sizeof *e); if (!e) return -1; t->e = e; t->cap = c; }
+    vkz_ent *e = &t->e[t->n]; memset(e, 0, sizeof *e); memcpy(e->key, key, klen); e->klen = klen; e->h = h; e->size = size; e->refs = 1; t->made++;
+    return t->n++;
+}
+// An image of allocation h let go: 1 when it was the last (the entry is gone; the caller frees h), 0 when others remain, -1 when h is no entry's
+static inline int vkz_unref(vkz_tab *t, uint64_t h) {
+    int i = vkz_find_h(t, h); if (i < 0) return -1;
+    if (--t->e[i].refs > 0) return 0;
+    t->e[i] = t->e[--t->n];
+    return 1;
+}
+static inline void vkz_note_own(vkz_tab *t) { t->owned++; }
+// The table now: images bound, allocations, their bytes, and the bytes they save (each image beyond an allocation's first would have had its own)
+static inline void vkz_stats(const vkz_tab *t, uint64_t *images, uint64_t *allocs, uint64_t *bytes, uint64_t *saved) {
+    uint64_t im = 0, by = 0, sv = 0;
+    for (int i = 0; i < t->n; i++) { im += (uint64_t)t->e[i].refs; by += t->e[i].size; sv += (uint64_t)(t->e[i].refs - 1) * t->e[i].size; }
+    if (images) *images = im; if (allocs) *allocs = (uint64_t)t->n; if (bytes) *bytes = by; if (saved) *saved = sv;
+}
+#endif
diff --git a/src/video_core/nvn_direct/bananative/dm/host/dm.h b/src/video_core/nvn_direct/bananative/dm/host/dm.h
new file mode 100644
index 0000000000..08b4660cf2
--- /dev/null
+++ b/src/video_core/nvn_direct/bananative/dm/host/dm.h
@@ -0,0 +1,210 @@
+// From Banana Native (github.com/hugorosario/BananaNative, Android port of github.com/seedds/nxnative by seedds), MIT: see LICENSE in src/video_core/nvn_direct/bananative.
+// Common header of the native Switch host (multi-module).
+#pragma once
+#include <pthread.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "game_profile.h"   // constants of the current game profile (generated from dm/games/<id>/game.tsv, chosen by the Makefile's GAME)
+
+// Explicit host work does not occupy a guest core (Metal submission, or a blocked native codec lock). A contended host mutex must count as blocked: a signal's same-core handoff
+// can otherwise wait forever for a peer that needs the signaller's native lock. Uncontended locks retain guest ordering; the counter nests inside existing host work.
+extern __thread _Atomic int dm_host_work;
+static inline int dm_host_mutex_lock(pthread_mutex_t *mutex) {
+    int r = pthread_mutex_trylock(mutex);
+    if (r != EBUSY) return r;
+    dm_host_work++;
+    r = pthread_mutex_lock(mutex);
+    dm_host_work--;
+    return r;
+}
+// Joining a native helper releases the guest core while that helper finishes; preserve any enclosing host-work scope.
+static inline int dm_host_thread_join(pthread_t thread, void **result) {
+    dm_host_work++;
+    int r = pthread_join(thread, result);
+    dm_host_work--;
+    return r;
+}
+
+// Lichii: every line goes to Lichii's log (class Render.NvnDirect, nvn_direct_log.cpp) with its text unchanged: "[RED]" lines as errors, "FATAL" ones as critical, the rest as
+// information (dotfiles-25x.19). Upstream wrote them to stderr
+void dm_log(const char *file, int line, const char *func, const char *fmt, ...) __attribute__((format(printf, 4, 5)));
+#define LOG(...) dm_log(__FILE__, __LINE__, __func__, "[dm] " __VA_ARGS__)
+#define die(...) do { LOG("FATAL " __VA_ARGS__); abort(); } while (0)
+#include "plat/plat.h"   // the services whose system interface differs between Apple and Android (time, thread slots, thread suspension, memory copies, ...)
+
+typedef struct { uint32_t st_name; uint8_t st_info, st_other; uint16_t st_shndx; uint64_t st_value, st_size; } Elf64_Sym;
+typedef struct { int64_t d_tag; union { uint64_t d_val, d_ptr; } d_un; } Elf64_Dyn;
+typedef struct { uint64_t r_offset, r_info; int64_t r_addend; } Elf64_Rela;
+#define ELF64_R_SYM(i) ((i) >> 32)
+#define ELF64_R_TYPE(i) ((i) & 0xffffffff)
+enum { DT_INIT = 12, DT_FINI = 13, DT_RELA = 7, DT_RELASZ = 8, DT_JMPREL = 23, DT_PLTRELSZ = 2, DT_SYMTAB = 6, DT_STRTAB = 5,
+       DT_INIT_ARRAY = 25, DT_INIT_ARRAYSZ = 27, DT_RELRSZ = 35, DT_RELR = 36 };
+enum { R_AARCH64_ABS64 = 257, R_AARCH64_GLOB_DAT = 1025, R_AARCH64_JUMP_SLOT = 1026, R_AARCH64_RELATIVE = 1027 };
+#define ELF64_ST_BIND(i) ((i) >> 4)            // symbol binding: 0 = STB_LOCAL, 2 = STB_WEAK
+#define ELF64_ST_VISIBILITY(o) ((o) & 3)       // visibility: 0 = STV_DEFAULT
+enum { STB_LOCAL = 0, STB_WEAK = 2, STV_DEFAULT = 0 };
+
+// Run-time state of one NSO module
+typedef struct {
+    char name[16];
+    uint8_t *base;             // Start address of the image (including the patch area) in the host address space
+    size_t size;
+    uint64_t text_end, ro_off, data_off, key_page_off, key_page_size;   // From the rewriter fixups header
+    uint64_t ue_malloc_vt;     // Unreal's FMallocBinned3 vtable, found by the rewriter (patch_nso.py, ue_malloc.py; hle_uemalloc.c); 0 = none
+    unsigned ue_malloc_slot;   // the slot of its name getter, which names the slot layout
+    struct { char name[32]; uint64_t off; } ue_cvar[8];   // Unreal console variables found by their registered names (patch_nso.py, ue_cvar.py; UE_CVAR:<name>): each one's TAutoConsoleVariable
+    int n_ue_cvar;
+    uint64_t fps_state_off;    // frame step state page (patch_nso.py FRAME_STEP: Tears of the Kingdom 1.4.3 and Breath of the Wild 1.9.0 main); 0 = none
+    int64_t patch_off;         // patch area relative to the base; negative = before the base (image too large, see patch_nso.py FAR), and size does not include it
+    uint64_t image_size, file_image_len, patch_len;   // only with the patch area before the base: whole image (with bss and key page), length of the image part of the file, patch area length
+    uint64_t back_off, back_len;   // a second patch area after the image (patch_nso.py TWO: a text longer than a B reaches), inside size; 0 = none
+    char build_id[33];         // First 16 bytes of the NSO build ID (hex); empty for older build outputs
+    unsigned key_idx[4];       // key page index of each thread slot (K18, KTLS, KTLR, KGATE)
+    const Elf64_Dyn *dyn;
+    const Elf64_Sym *symtab;
+    const char *strtab;
+    unsigned nsym;
+    uint32_t *symh; unsigned symh_mask;   // Name hash table of defined symbols (open addressing, stores symbol indices; for a duplicated name only the smallest index is kept = the first hit of a linear scan)
+    uint64_t init, init_array, init_arraysz;   // init = DT_INIT (the module's _init: registers the DSO and runs this module's init_array)
+    uint64_t fini;             // DT_FINI (nn::ro::UnloadModule calls it)
+    // NRO modules (nn::ro, loader.c "NRO modules"): mapped at start like the others, but they take part in symbol lookups only between LoadModule and UnloadModule
+    int nro;
+    _Atomic int loaded;        // the profile's modules always; NRO activation also synchronizes with borrowed stack backing
+    uint8_t sha256[32];        // an NRO's SHA-256 (what the game's NRR registers; LoadModule finds the module by the image it passes)
+    uint32_t nro_size;         // an NRO's file size (header +0x18), the bytes the hash covers
+    uint8_t *pristine; size_t pristine_len;   // an NRO's initialized data as rewritten; reload restores this and zeroes its bss
+    unsigned loads;            // how many times the game loaded it
+} module_t;
+
+extern module_t *g_mod;         // allocated once from the NSO list and NRO manifest; module addresses stay stable
+extern int g_nmod;
+// main's build ID (empty if none): code with fixed addresses in a game's module runs only on the build they were found in
+static inline const char *dm_main_build(void) { for (int i = 0; i < g_nmod; i++) if (!strcmp(g_mod[i].name, "main")) return g_mod[i].build_id; return ""; }
+// Four thread-local slots: K18 = the Switch's x18, KTLS = tpidr_el0, KTLR = tpidrro_el0 (ThreadLocalRegion), KGATE = host gate entry (dm_slot_get / dm_slot_set, plat.h);
+// where each lies is written into the key page by the loader
+
+void load_modules(const char *dir, const char **names, int n);
+const char *dm_module_dir(void);   // the folder load_modules read the modules and the rewriter's tables from (the cheat engine reads main.changed.tsv there)
+void run_module_inits(void);
+module_t *nro_find(const uint8_t sha256[32]);   // the mapped NRO with this hash (loader.c)
+int nro_refused(const uint8_t sha256[32]);      // an NRO the pack refused (an online SDK, nro.tsv "refused")
+void nro_load(module_t *m);     // relocate an NRO against the loaded modules and bind the earlier modules' imports it defines (the caller runs its init)
+void nro_unload(module_t *m);   // take an NRO out of the lookups and bind the imports that pointed into it again
+int svc_nro_deactivate(module_t *m);   // mark inactive under the memory map lock, refusing while a stack borrows its data
+void *module_sym(module_t *m, const char *name);
+int dm_sdk_major(void);   // SDK major version from the sdk module's version string (loader.c); 0 = unknown
+int dm_sdk_ounce(void);   // 1 when the sdk module was built for the Switch 2 (its spec string "spec: Ounce", loader.c)
+int dm_sdk_nvn2_item(unsigned item, int *out);   // a constant NVN2's own nvnDeviceGetInteger answers for item, read from the sdk module (loader.c); 0 when it has none
+#define DM_SDK_OLD(major) ((major) > 0 && (major) <= 10)   // SDK 10 and older: NVN API 53, the shared-font address points at the TTF itself
+int dm_main_imports(const char *prefix);   // main imports a symbol whose name starts with prefix (loader.c)
+void *guest_sym(const char *name);
+module_t *module_of(const void *p);
+// Gate dispatch: rewritten svc / timer reads come in through the common entry, ret_addr = the return point of that gate block, regs points to the saved x0..x30
+uint64_t gate_dispatch(uint64_t ret_addr, uint64_t *regs);
+// Observation gates (rewriter OBS tables in the profiles' patches.py, applied by patch_nso.py; numbering matches): read-only callbacks, called on a gate hit once attached
+// IDs 19 / 20 belonged to the removed movie request-ring workaround. Old rewritten modules may still contain them; without callbacks those gates are harmless passes through.
+enum { OBS_UE_MALLOC = 21,                                       // Unreal's FMallocBinned3 constructor call, cut: the object in the register its upper bits name (patch_nso.py, hle_uemalloc.c)
+       OBS_REGION_ASK = 22, OBS_REGION_GOT = 23, OBS_REGION_FREE = 24,   // the SDK's address regions, gates the rewriter places by symbol in every sdk (patch_nso.py "Address regions", hle_svc.c)
+       OBS_STDALLOC_INIT = 25,                                         // StandardAllocator::Initialize's entry, the same way: its callback writes the size (hle_svc.c)
+       OBS_UE_REGION = 26,                                             // the store of Unreal's engine region size before nninitStartup reserves it: the register its upper bits name (dm/tools/ue_region.py, hle_svc.c)
+       OBS_MAX = 27 };
+// A gate number's bits from 8 up are a parameter for its callback (OBS_REGION_GOT: the register that holds the address). Callbacks read the registers; a write to x0–x29 takes
+// effect when the gate returns (entry.S restores them from the frame), which OBS_STDALLOC_INIT and OBS_UE_REGION do
+void gate_obs_set(int id, void (*fn)(uint64_t *regs, int param));
+int gate_obs_present(int id);
+uint64_t now_ns(void);
+void dm_fs_time(uint64_t *open_ns, uint64_t *read_ns, uint64_t *read_bytes);   // cumulative host time in open / pread for the game, all threads (hle_fs.c)
+int dm_guest_wait_take(uint64_t *total_ns, uint64_t *max_ns, uint64_t *sleep_ns, uint64_t *native_ns, char *what, size_t n);   // this thread's guest waits since its last call: in all, the longest (and what ended it), SleepThread's sleeps, native HLE waits; 0 = not a guest thread (hle_thread.c)
+uint64_t guest_ns(void);              // Guest clock (hle_os.c; does not advance while frozen, guest_clock_freeze)
+uint64_t guest_ticks(void);           // The guest's system counter on that clock: 19.2 MHz, or 31.25 MHz for the Switch 2 (hle_os.c)
+int dm_detclock_enabled(void);
+void dm_guest_clock_advanced(void);
+void guest_clock_freeze(int on);
+void guest_clock_freeze_for(int reason, int on);   // Freeze by reason (1 background, 2 system keyboard); see hle_os.c
+void guest_clock_read_wait(void);     // A guest read of the system counter: waits while the app is in the background (hle_os.c)
+void dm_guest_suspend(int on);         // The application suspended as Horizon suspends it (hle_os.c): guest threads stop at their next SVC, spin gate or sleep (dm_guest_suspend_wait)
+void dm_guest_suspend_wait(void);      // where a guest thread stops while suspended (not inside host work)
+int dm_guest_suspended(void);
+int dm_is_guest_thread(void);          // hle_thread.c: the calling thread has a guest thread record (host threads running guest code do not stop at the suspend gate)
+void crash_watch_hold(int on);         // crash.c: the watchdog counts no stall while the app is suspended (paused, background)
+void dm_guest_frame_tick(void);        // Called on every present (hle_nvn.c): when DM_DETCLOCK is on, advances the guest clock by one fixed step
+uint64_t dm_nvn_frame_count(void);
+uint64_t dm_nvn_sub_cpu_ns(void);     // Cumulative CPU nanoseconds of submit (excluding present)
+void dm_backtrace(uint64_t fp);
+void crash_watch_progress(uint32_t tick, const char *stage);
+void crash_watch_frame(void);
+void crash_watch_pregame_done(void);
+uint64_t crash_watch_progress_count(void);
+void crash_dump_now(const char *why);   // Dump state on demand (threads + graphics wait points), without exiting
+// Diagnostic switches: read once from environment variables when main starts (getenv takes the libc global environment lock, and on a hot path it would make all guest threads queue up)
+extern uint64_t g_t0_ns;   // Host start time (now_ns), used for relative times in the log
+extern struct dm_flags { int thr, svc, fs, dbg, imports, bootprof; } g_flag;
+void *objmap_get(const void *guest); void objmap_put(const void *guest, void *host); void *objmap_del(const void *guest);
+void hle_signal_system_event(void *g);   // hle_thread.c: signal a service-layer SystemEvent (any thread)
+void hle_bind_system_event(void *g, int autoclear);   // On a guest thread, bind a guest SystemEvent to a kernel event
+void hle_clear_system_event(void *g);    // hle_thread.c: clear a bound service-layer SystemEvent (any thread)
+int hle_signal_bound_system_event(void *g);   // hle_thread.c: signal a service-layer SystemEvent only if it is bound (any thread); 0 when it is not
+uint64_t hle_system_event_binding(void *g);   // Opaque lifetime ID of a binding, 0 if unbound; a rebind gets a new ID even if its address and handle are reused
+int hle_signal_system_event_binding(uint64_t binding);   // Signal only this binding lifetime (any thread); 0 after its write handle closes
+uint32_t hle_dup_readable_handle(uint32_t h);   // hle_thread.c: a second read end of a kernel event (the copy a service hands its client), 0 if h is no read end
+// Page fault hook / hook before the host writes guest memory (crash.c; used for write-protect dirty page tracking)
+void dm_fault_hook_register(int (*fn)(void *addr, int is_write, void *uc));
+void dm_guest_write_prep_register(void (*fn)(void *addr, size_t len));
+void dm_res_report_register(void (*fn)(uint32_t tick, const char *why));   // Resource count callback (registered by the graphics layer): called every 250 ticks, when the loading screen has been dismissed, and on exit when the record is full
+void (*dm_res_report_cb(void))(uint32_t tick, const char *why);   // Get the registered resource count callback (null if not registered)
+void dm_guest_write_prepare(void *addr, size_t len);
+void dm_guest_heap_range(uint64_t *base, size_t *open_len);   // hle_svc.c: the guest heap's base and opened length (guest addresses), 0 / 0 when none
+int dm_guest_heap_read(uint64_t addr, void *out, size_t len);    // hle_svc.c: hole-free guest heap read for the cheat VM (under the memory lock); 0 = ok, 1 = a byte outside the opened span
+int dm_guest_heap_write(uint64_t addr, const void *src, size_t len);   // hle_svc.c: hole-free guest heap write (the dirty tracking sees it first)
+uint64_t dm_guest_unmapped(uintptr_t a, size_t n);   // hle_svc.c: 4 KiB pages of [a, a+n) the guest has not mapped (alias region pages not mapped, heap past its opened size); 0 outside those regions
+uint64_t dm_guest_read_mapped(void *dst, uintptr_t a, size_t n);   // hle_svc.c: [a, a+n) into dst, pages the guest has not mapped as zeros (they are inaccessible: never read); → those pages
+// Cheats (hle_cheats.c): Atmosphère-format cheat code files applied to the running game (docs/development.md "Cheats")
+void dm_cheats_init(void);            // Called once in host_preload after loading the modules (main.c): reads DM_CHEATS and friends, loads the build's file
+void dm_cheats_present(void);         // Per presented frame (hle_nvn.c presents): applies the enabled cheats once
+// The Cheats submenu's rows (front_mac.m, Mac window only). Readers of the list of cheats; the front end copies the strings out immediately
+int dm_cheats_found(void);            // A cheat file is loaded (this build's, or another build's on DM_CHEATS_ANY_BUILD)
+int dm_cheats_ncheats(void);          // The loaded file's cheats, in file order
+const char *dm_cheats_build(void);    // This game's build ID, first 16 hex digits ("" when the main NSO has none)
+const char *dm_cheats_dir_path(void); // The cheats folder ("", when neither DM_CHEATS nor DM_ROOT is set: the menu's folder action is off)
+int dm_cheats_nothers(void);          // The .txt files of other builds in the folder (the menu's disabled "another version" rows)
+const char *dm_cheats_other(int i);
+const char *dm_cheat_name_at(int i);
+const char *dm_cheat_why_at(int i);   // The disabled state's reason (" (unsupported opcode N)", " (off: ...)"); "" when plain
+int dm_cheat_kind_at(int i);          // 0 a plain row (click toggles), 1 master (always on, no toggle), 2 disabled (broken or killed at run time), 3 a label (credits, a section marker)
+int dm_cheat_on_at(int i);
+void dm_cheat_toggle(int i);          // The click on a plain row: flips the cheat (an on / off pair as one switch) and rewrites <build ID>.enabled
+void dm_cheats_reload(void);          // "Reload cheats": re-reads the file (the same path), so edits during play need no re-launch
+// What the panel shows beyond the menu (hle_cheats.c header: labels and sections, the meta file of scripts/cheat_anchor.py)
+enum { DM_CHEAT_LABEL = 1, DM_CHEAT_SECTION_START = 2, DM_CHEAT_SECTION_END = 4, DM_CHEAT_PAIR_ON = 8, DM_CHEAT_PAIR_OFF = 16,
+       DM_CHEAT_ONCE = 32, DM_CHEAT_ASK = 64, DM_CHEAT_HOST = 128, DM_CHEAT_WEAK = 256 };   // ONCE: a "set" cheat; HOST: a never-decrease run by this host only
+int dm_cheat_flags_at(int i);         // DM_CHEAT_* of entry i
+const char *dm_cheat_section_at(int i);   // the section entry i lies in ("" none)
+const char *dm_cheat_note_at(int i);  // the meta file's note: how the cheat was compiled, and its own note
+const char *dm_cheat_type_at(int i);  // the meta type (u16, s32, f32, …), "" unknown
+int dm_cheat_pair_at(int i);          // the other half of an on / off pair, -1 none
+int dm_cheat_preview(int i, char *out, size_t cap);   // a dry run: one line per write it would make now ("main+0x… (2 bytes): 37 -> 999"), nothing written; returns the writes
+int dm_cheat_value_get(int i, char *out, size_t cap); // an "ask" cheat's value as text: 1, or 0 when it takes none
+int dm_cheat_value_set(int i, const char *text);      // set it (its type, its bounds) and keep it in <build ID>.values: 0 done, -1 refused
+const char *dm_cheat_value_bounds(int i);             // "min..max" (a side empty when open), "" when it takes none
+int dm_cheats_master(void);           // the master switch (off: no cheat runs; kept in the folder's .cheats-off)
+void dm_cheats_master_set(int on);
+int dm_cheats_safe(void);             // safe mode: the last run ended without a clean exit while cheats were on, so all start off
+void dm_cheats_safe_restore(void);    // leave safe mode: the masters and the saved toggles come back
+const char *dm_cheats_report(void);   // the load report: counts, duplicate names, ignored lines, carried-over toggles, Atmosphère's limits
+const char *dm_cheats_version(void);  // this build's display version ("" unknown)
+const char *dm_cheats_other_version(int i);   // the display version of another build's file (its meta file), "" unknown
+int dm_cheats_nskipped(void);         // cheats the compiler left out of this build's file (its meta file), with their reasons
+const char *dm_cheats_skipped_name(int i);
+const char *dm_cheats_skipped_why(int i);
+int dm_cheats_nsources(void);         // anchored sources (*.cheats.toml) in the cheats folder
+const char *dm_cheats_source(int i);
+void dm_cheats_exit(void);            // a clean exit (hle_lifecycle.c, atexit): removes the safe-mode flag
