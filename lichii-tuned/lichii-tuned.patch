+}
+
+void Device::LimitMemoryReserve(u64 budget, u64 critical, u64 margins) const {
+    if (!memory_reserve) {
+        return;
+    }
+    // An eighth of the budget more stays free past the usage: Windows lowers the budget as the
+    // card fills (texture_cache.h), by about an eighth at r62's area loads (the critical use, 5/8
+    // of it, fell from 9595 to ~8490 MiB), and kept blocks at the old limit then put the device
+    // over it until the next check and the trims caught up.
+    const u64 needed = (std::max)(critical, GetDeviceMemoryUsage() + budget / 8) + margins;
+    memory_reserve->SetLimit(budget > needed ? budget - needed : 0);
+}
+
+u64 Device::ReleaseMemoryReserve() const {
+    if (!memory_reserve) {
+        return 0;
+    }
+    memory_reserve->SetLimit(0);
+    const u64 released = memory_reserve->Release();
+    if (released != 0) {
+        // The frees bypass VMA, which reads the driver's heap usage again only every 30 of its own
+        // operations: make it read it now, so the next allocations see the room.
+        vmaSetCurrentFrameIndex(allocator, 0);
+    }
+    return released;
+}
+
+void Device::TickMemoryReserve() const {
+    if (memory_reserve) {
+        memory_reserve->Trim();
+    }
+    if (DeviceMemory::Stats::Enabled()) {
+        DeviceMemory::Stats::Tick(memory_reserve.get());
+    }
+}
+
+u64 Device::GetMemoryReserveBytes() const {
+    return memory_reserve ? memory_reserve->KeptBytes() : 0;
