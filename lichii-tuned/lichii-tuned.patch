+    if (g_pf_nlog < 4 || !(g_pf_nlog & 255)) VLOG("placed memory: %.1f MiB faulted in so far, %.1f ms", g_pf_bytes / 1048576.0, g_pf_ns / 1e6); }   // (caller holds g_pl)
