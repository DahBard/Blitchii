+bool BlackOrNan(VkFormat format, const u8* texel) {
+    if (format == COMPACT_OUTPUT_FORMAT) {
+        u32 bits;
+        std::memcpy(&bits, texel, sizeof(bits));
+        return (bits & 0x3fffffff) == 0; // UNORM has no NaN (FSR's NaN is stored as 0)
+    }
+    std::array<u16, 4> half;
+    std::memcpy(half.data(), texel, sizeof(half));
+    bool nan = false;
+    bool black = true;
+    for (u32 channel = 0; channel < 3; ++channel) {
+        nan |= (half[channel] & 0x7c00) == 0x7c00;
+        black &= (half[channel] & 0x7fff) == 0;
+    }
+    return nan || black;
+}
+
+/// Below 1/64 in every colour channel.
+bool DarkInput(VkFormat format, const u8* texel) {
+    if (format == VK_FORMAT_E5B9G9R9_UFLOAT_PACK32) {
+        u32 bits;
+        std::memcpy(&bits, texel, sizeof(bits));
+        const int exponent = static_cast<int>(bits >> 27) - 15 - 9;
+        for (u32 channel = 0; channel < 3; ++channel) {
+            const u32 mantissa = (bits >> (9 * channel)) & 0x1ff;
+            if (std::ldexp(static_cast<float>(mantissa), exponent) >= 1.0f / 64.0f) {
+                return false;
+            }
+        }
+        return true;
+    }
+    // RGBA16F: half-float exponent under 9.
+    std::array<u16, 4> half;
+    std::memcpy(half.data(), texel, sizeof(half));
+    return (half[0] & 0x7fff) < 0x2400 && (half[1] & 0x7fff) < 0x2400 &&
+           (half[2] & 0x7fff) < 0x2400;
+}
