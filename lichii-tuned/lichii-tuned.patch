+
+/// The slot of EDEN_NX2_EXP<n>, or -1 when `name` is not one. Only the getenv spelling counts
+/// (no leading zero), so one slot has one name in the debug server's change list.
+[[nodiscard]] inline int ExperimentSlot(std::string_view name) {
+    constexpr std::string_view prefix = "EDEN_NX2_EXP";
+    if (name.size() <= prefix.size() || name.size() > prefix.size() + 2 ||
+        name.substr(0, prefix.size()) != prefix ||
+        (name.size() == prefix.size() + 2 && name[prefix.size()] == '0')) {
+        return -1;
+    }
+    int n = 0;
+    for (const char c : name.substr(prefix.size())) {
+        if (c < '0' || c > '9') {
+            return -1;
+        }
+        n = n * 10 + (c - '0');
+    }
+    return n < ExperimentCount ? n : -1;
+}
+
+/// The live switch called `name` (read from the environment if it was not yet), or null.
+[[nodiscard]] inline std::atomic<int>* FindSwitch(std::string_view name) {
+    if (const int n = ExperimentSlot(name); n >= 0) {
+        LoadExperiments();
+        return &g_experiments[n];
+    }
+    for (const NamedSwitch& entry : NamedSwitches()) {
+        if (name == entry.name) {
+            static_cast<void>(SwitchValue(*entry.value, entry.name));
+            return entry.value;
+        }
+    }
+    return nullptr;
+}
+
+/// Whether `name` is a live switch's name that only a relaunch changes (a slot in
+/// BootOnlyExperiments).
+[[nodiscard]] inline bool IsBootOnlySwitch(std::string_view name) {
+    return std::ranges::find(BootOnlyExperiments, ExperimentSlot(name)) !=
+           BootOnlyExperiments.end();
+}
