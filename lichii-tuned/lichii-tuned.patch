+void RasterizerVulkan::PrepareOcarinaFsrEarly() {
+    // FSR only runs at the game's own resolution.
+    if (!OcarinaDlssEnabled() ||
+        Settings::values.resolution_setup.GetValue() != Settings::ResolutionSetup::Res1X) {
+        return;
+    }
+    const auto start = std::chrono::steady_clock::now();
+    const auto ms_since = [](std::chrono::steady_clock::time_point from) {
+        return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - from)
+            .count();
+    };
+    try {
+        oot_live_dlss = std::make_unique<OcarinaLiveDlss>(
+            device, scheduler, descriptor_pool, compute_pass_descriptor_queue, memory_allocator);
+        const double built_ms = ms_since(start);
+        // The sizes the first docked upscale passes: the game's 1440p scene to 4K, or to 1440p
+        // in place with Ocarina's 1440p docked output. Handheld and FSR preset sizes are left to
+        // the first upscale.
+        std::string context;
+        if (!Settings::IsDockedMode()) {
+            context = "context left to the first upscale (handheld)";
+        } else if (OcarinaFsrPresetActive()) {
+            context = "context left to the first upscale (an FSR preset)";
+        } else {
+            constexpr VkExtent2D scene{2560, 1440};
+            const bool output_1440p = Settings::values.oot_docked_output.GetValue() ==
+                                      Settings::OotDockedOutput::Output1440p;
+            const VkExtent2D output = output_1440p ? scene : VkExtent2D{3840, 2160};
+            const bool compact_output = OcarinaFsrSlim().compact_output && !oot_last_present_hdr;
+            context = oot_live_dlss->Prepare(scene, output, compact_output)
+                          ? fmt::format("output and context made for {}x{} -> {}x{}", scene.width,
+                                        scene.height, output.width, output.height)
+                          : std::string{"no context made early"};
+        }
+        LOG_INFO(Render_Vulkan,
+                 "Ocarina of Time: FSR built early in {:.1f} ms, frame {} "
+                 "(LICHII_FSR_EARLY_CONTEXT): upscaler and passes {:.1f} ms, {}",
+                 ms_since(start), render_trace_frame, built_ms, context);
+    } catch (const vk::Exception& error) {
+        LOG_WARNING(Render_Vulkan, "Ocarina DLSS unavailable: {}", error.what());
+        oot_live_failed = true;
+    }
+}
