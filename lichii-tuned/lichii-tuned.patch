+static void meet_add(int n, vka_img *im) { if (n == g_meetcap) { g_meetcap = g_meetcap ? 2 * g_meetcap : 256; g_meet = realloc(g_meet, (size_t)g_meetcap * sizeof *g_meet); } g_meet[n] = im; }
