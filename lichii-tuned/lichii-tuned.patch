+// point anywhere; a frame register of 0 crashed the sampler's walk (nx2_sampler.cpp). Replays the
+// unwind codes it applies to `context` and checks that every stack read is in [low, high).
+bool UnwindStaysOnStack(DWORD64 image_base, const RUNTIME_FUNCTION* function,
+                        const CONTEXT& context, DWORD64 low, DWORD64 high) {
+    DWORD64 registers[16]{context.Rax, context.Rcx, context.Rdx, context.Rbx,
