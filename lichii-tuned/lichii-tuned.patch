@@ -0,0 +1,388 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+
+#include "common/logging.h"
+#include "video_core/nx2.h"
+#include "video_core/nx2_perf.h"
+#include "video_core/renderer_vulkan/vk_host_pacer.h"
+
+#ifdef _WIN32
+#include <cwchar>
+#include <string_view>
+#include <vector>
+#include <windows.h>
+#include <dwmapi.h>
+#include "common/string_util.h"
+#endif
+
+namespace Vulkan {
+namespace {
+using Ns = std::chrono::nanoseconds;
+using Ms = std::chrono::duration<double, std::milli>;
+
+Ns ToNs(double ns) {
+    return Ns{static_cast<s64>(ns)};
+}
+} // Anonymous namespace
+
+int HostPaceMode() {
+    static const int mode = [] {
+        const char* value = std::getenv("LICHII_HOST_PACE");
+        const int parsed = value != nullptr ? std::atoi(value) : 0;
+        return parsed == 1 || parsed == 2 ? parsed : 0;
+    }();
+    return mode;
+}
+
+#ifdef _WIN32
+namespace {
+struct DwmPeriod {
+    std::optional<double> measured; ///< The compositor's measured period
+    std::optional<double> nominal;
+};
+
+DwmPeriod QueryDwmPeriod() {
+    DwmPeriod result;
+    DWM_TIMING_INFO info{};
+    info.cbSize = sizeof(info);
+    if (FAILED(DwmGetCompositionTimingInfo(nullptr, &info)) ||
+        info.rateRefresh.uiNumerator == 0 || info.rateRefresh.uiDenominator == 0) {
+        return result;
+    }
+    result.nominal = 1e9 * info.rateRefresh.uiDenominator / info.rateRefresh.uiNumerator;
+    LARGE_INTEGER frequency{};
+    if (info.qpcRefreshPeriod != 0 && QueryPerformanceFrequency(&frequency) &&
+        frequency.QuadPart != 0) {
+        result.measured = 1e9 * static_cast<double>(info.qpcRefreshPeriod) /
+                          static_cast<double>(frequency.QuadPart);
+    }
+    return result;
+}
+
+bool Agrees(double a, double b) {
+    return std::abs(a - b) < b * 0.01;
+}
+
+/// The exact rate of the active display path whose source is GDI display `device` (119.982 Hz
+/// rather than 120), or 0.
+double QueryPathPeriod(const wchar_t* device) {
+    for (int attempt = 0; attempt < 3; ++attempt) {
+        UINT32 path_count = 0;
+        UINT32 mode_count = 0;
+        if (GetDisplayConfigBufferSizes(QDC_ONLY_ACTIVE_PATHS, &path_count, &mode_count) !=
+            ERROR_SUCCESS) {
+            return 0.0;
+        }
+        std::vector<DISPLAYCONFIG_PATH_INFO> paths(path_count);
+        std::vector<DISPLAYCONFIG_MODE_INFO> modes(mode_count);
+        const LONG status = QueryDisplayConfig(QDC_ONLY_ACTIVE_PATHS, &path_count, paths.data(),
+                                               &mode_count, modes.data(), nullptr);
+        if (status == ERROR_INSUFFICIENT_BUFFER) {
+            continue; // The configuration changed in between
+        }
+        if (status != ERROR_SUCCESS) {
+            return 0.0;
+        }
+        for (UINT32 i = 0; i < path_count; ++i) {
+            const DISPLAYCONFIG_PATH_INFO& path = paths[i];
+            DISPLAYCONFIG_SOURCE_DEVICE_NAME source{};
+            source.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_SOURCE_NAME;
+            source.header.size = sizeof(source);
+            source.header.adapterId = path.sourceInfo.adapterId;
+            source.header.id = path.sourceInfo.id;
+            if (DisplayConfigGetDeviceInfo(&source.header) != ERROR_SUCCESS ||
+                std::wcscmp(source.viewGdiDeviceName, device) != 0) {
+                continue;
+            }
+            DISPLAYCONFIG_RATIONAL rate = path.targetInfo.refreshRate;
+            if ((rate.Numerator == 0 || rate.Denominator == 0) &&
+                path.targetInfo.modeInfoIdx < mode_count &&
+                modes[path.targetInfo.modeInfoIdx].infoType ==
+                    DISPLAYCONFIG_MODE_INFO_TYPE_TARGET) {
+                rate = modes[path.targetInfo.modeInfoIdx]
+                           .targetMode.targetVideoSignalInfo.vSyncFreq;
+            }
+            if (rate.Numerator != 0 && rate.Denominator != 0) {
+                return 1e9 * static_cast<double>(rate.Denominator) /
+                       static_cast<double>(rate.Numerator);
+            }
+        }
+        return 0.0;
+    }
+    return 0.0;
+}
+} // Anonymous namespace
+#endif
+
+std::optional<DisplayRefresh> DisplayRefreshQuery::Query([[maybe_unused]] void* native_window) {
+#ifdef _WIN32
+    const DwmPeriod dwm = QueryDwmPeriod();
+
+    const HMONITOR monitor =
+        native_window != nullptr
+            ? MonitorFromWindow(static_cast<HWND>(native_window), MONITOR_DEFAULTTONEAREST)
+            : MonitorFromPoint(POINT{0, 0}, MONITOR_DEFAULTTOPRIMARY);
+    MONITORINFOEXW info{};
+    info.cbSize = sizeof(info);
+    if (monitor != nullptr && GetMonitorInfoW(monitor, &info)) {
+        const bool primary = (info.dwFlags & MONITORINFOF_PRIMARY) != 0;
+        const std::string gdi_name = Common::UTF16ToUTF8(std::wstring_view{info.szDevice});
+        // "\\.\DISPLAY2" -> "DISPLAY2"
+        std::string name = gdi_name.substr(gdi_name.find_last_of('\\') + 1);
+        if (primary) {
+            name += ", primary";
+        }
+
+        DEVMODEW mode{};
+        mode.dmSize = sizeof(mode);
+        const u32 hz = EnumDisplaySettingsW(info.szDevice, ENUM_CURRENT_SETTINGS, &mode) &&
+                               mode.dmDisplayFrequency > 1
+                           ? static_cast<u32>(mode.dmDisplayFrequency)
+                           : 0;
+        // The display configuration is the slow part: read it again only when the window moved
+        // to another display or that display's mode changed, or now and then.
+        const auto now = std::chrono::steady_clock::now();
+        if (gdi_name != device || hz != nominal_hz || now >= stale_at) {
+            device = gdi_name;
+            nominal_hz = hz;
+            rational_ns = QueryPathPeriod(info.szDevice);
+            stale_at = now + std::chrono::seconds{30};
+        }
+
+        std::optional<DisplayRefresh> result;
+        if (rational_ns > 0.0) {
+            result = DisplayRefresh{rational_ns, name + ", display config"};
+        } else if (hz != 0) {
+            result = DisplayRefresh{1e9 / hz, name + ", display settings"};
+        }
+        if (result) {
+            // DWM's timing is the primary display's. Its measured period is the most precise
+            // one there, and the game's frame clock follows it (genlock).
+            if (primary && dwm.measured && Agrees(*dwm.measured, result->period_ns)) {
+                return DisplayRefresh{*dwm.measured, name + ", DWM"};
+            }
+            return result;
+        }
+    }
+
+    // The window's display is unknown: the primary display from DWM, measured when it agrees
+    // with the nominal rate (a "120 Hz" display may run at 119.98).
+    if (dwm.nominal) {
+        if (dwm.measured && Agrees(*dwm.measured, *dwm.nominal)) {
+            return DisplayRefresh{*dwm.measured, "primary, DWM"};
+        }
+        return DisplayRefresh{*dwm.nominal, "primary, DWM nominal"};
+    }
+    DEVMODEW mode{};
+    mode.dmSize = sizeof(mode);
+    if (EnumDisplaySettingsW(nullptr, ENUM_CURRENT_SETTINGS, &mode) &&
+        mode.dmDisplayFrequency > 1) {
+        return DisplayRefresh{1e9 / mode.dmDisplayFrequency, "primary, display settings"};
+    }
+#endif
+    return std::nullopt;
+}
+
+void HostPacer::NoteQueued(Clock::time_point queued) {
+    if (last_queued) {
+        // A load screen's or a stall's gap would take seconds to forget: clamp each sample.
+        const double sample =
+            std::clamp(static_cast<double>(Ns{queued - *last_queued}.count()), refresh_ns * 0.5,
+                       100e6);
+        content_ns += (sample - content_ns) * 0.05;
+    }
+    last_queued = queued;
+}
+
+void HostPacer::Refresh(Clock::time_point now, bool allowed, void* native_window) {
+    if (now >= next_refresh_query) {
+        next_refresh_query = now + std::chrono::seconds{2};
+        if (const auto refresh = refresh_query.Query(native_window);
+            refresh && refresh->period_ns > 2e6 && refresh->period_ns < 50e6) {
+            const double period = refresh->period_ns;
+            if (!refresh_known || std::abs(period - refresh_ns) > refresh_ns * 0.01 ||
+                refresh->display != refresh_display) {
+                LOG_INFO(Render_Vulkan, "Host pacing: display refresh {:.4f} Hz (monitor {})",
+                         1e9 / period, refresh->display);
+                // A new rate or another display: its own refresh grid.
+                vblank.reset();
+                refresh_display = refresh->display;
+            }
+            refresh_ns = period;
+            refresh_known = true;
+        }
+    }
+    pacing = allowed && refresh_known && !broken && HostPaceMode() == 1;
+    VideoCommon::Nx2Perf::g_host_refresh_ns.store(
+        pacing ? static_cast<long long>(refresh_ns) : 0, std::memory_order_relaxed);
+}
+
+HostPacer::Clock::time_point HostPacer::Target(Clock::time_point now) {
+    pending_intended.reset();
+    if (!pacing || !vblank || outstanding != 0) {
+        return now;
+    }
+    // Refreshes per game frame, from the frame rate the game asks for: 2 for 60 fps at 120 Hz,
+    // also while it runs at 55 (those frames then show for 2 or 3), 4 for 30 fps. Not from how
+    // fast frames arrive: holding frames slows the game, and the pacer then locked itself to
+    // the slower rate (a loading screen's 25 ms frames held Ocarina at 40 fps). Unknown: only
+    // one frame per refresh.
+    const long long guest_ns = static_cast<long long>(
+        Tegra::g_nx2_guest_frame_interval_ns.load(std::memory_order_relaxed));
+    const double frame_refreshes = static_cast<double>(guest_ns) / refresh_ns;
+    const s64 k =
+        guest_ns > 0 ? (std::max<s64>)(1, static_cast<s64>(std::floor(frame_refreshes + 0.02)))
+                     : 1;
+    auto intended = *vblank + ToNs(static_cast<double>(k) * refresh_ns);
+    // A late frame moves the schedule a refresh later for good, and the frames after it then
+    // wait that refresh in the queue (input lag). Once frames could have been shown a refresh
+    // earlier for 2 s (1 s at 30 fps and below) in a row, show one a refresh early (one short
+    // frame) to drop that wait. At 30 fps without it, Ocarina's frames waited ~30 ms each after
+    // a few hitches: nearly a frame of extra input lag.
+    if (k >= 2 && intended - ToNs(refresh_ns + lead_ns + 1e6) > now) {
+        if (++early_streak >= (k == 2 ? 120U : 30U)) {
+            early_streak = 0;
+            intended -= ToNs(refresh_ns);
+            ++caught_up;
+        }
+    } else {
+        early_streak = 0;
+    }
+    const auto target = intended - ToNs(lead_ns);
+    if (target <= now) {
+        return now;
+    }
+    pending_intended = intended;
+    return target;
+}
+
+long long HostPacer::NsToNextRefresh(Clock::time_point now) const {
+    if (!vblank || !pacing) {
+        return -1;
+    }
+    const double since = static_cast<double>(Ns{now - *vblank}.count());
+    const double into = std::fmod(std::fmod(since, refresh_ns) + refresh_ns, refresh_ns);
+    return static_cast<long long>(refresh_ns - into);
+}
+
+void HostPacer::NoteSubmitted(u64 id, Clock::time_point submitted_at, bool was_held) {
+    if (id == 0) {
+        outstanding = 0;
+        pending_intended.reset();
+        return;
+    }
+    submitted.push_back({id, submitted_at, was_held ? pending_intended : std::nullopt});
+    while (submitted.size() > 16) {
+        submitted.pop_front();
+    }
+    pending_intended.reset();
+    outstanding = id;
+}
+
+void HostPacer::NoteShown(u64 id, Clock::time_point shown, bool was_lost) {
+    while (!submitted.empty() && submitted.front().id < id) {
+        submitted.pop_front();
+    }
+    std::optional<Submitted> entry;
+    if (!submitted.empty() && submitted.front().id == id) {
+        entry = submitted.front();
+        submitted.pop_front();
+    }
+    if (outstanding != 0 && id >= outstanding) {
+        outstanding = 0;
+    }
+    if (report_start == Clock::time_point{}) {
+        report_start = shown;
+    }
+    if (was_lost) {
+        ++lost;
+        vblank.reset();
+        last_shown.reset();
+        return;
+    }
+    ++frames;
+    if (entry) {
+        latency_sum_ms += Ms{shown - entry->submitted}.count();
+    }
+    if (last_shown && last_shown_id + 1 == id) {
+        const double interval = static_cast<double>(Ns{shown - *last_shown}.count());
+        interval_sum_ms += interval / 1e6;
+        interval_max_ms = (std::max)(interval_max_ms, interval / 1e6);
+        const auto count = std::clamp<s64>(std::llround(interval / refresh_ns), 0, 5);
+        ++refreshes_shown[static_cast<size_t>(count)];
+    }
+    // Follow the refresh grid: snap to the refresh this was shown at and correct the phase a
+    // little, so the wake-up noise of the wait does not move the targets.
+    if (vblank) {
+        const double since = static_cast<double>(Ns{shown - *vblank}.count());
+        const s64 refreshes = std::llround(since / refresh_ns);
+        if (refreshes >= 1) {
+            const auto predicted = *vblank + ToNs(static_cast<double>(refreshes) * refresh_ns);
+            const double residual = static_cast<double>(Ns{shown - predicted}.count());
+            vblank = std::abs(residual) < refresh_ns * 0.5 ? predicted + ToNs(residual * 0.1)
+                                                            : shown;
+        }
+    } else {
+        vblank = shown;
+    }
+    if (entry && entry->intended) {
+        if (shown > *entry->intended + ToNs(refresh_ns * 0.5)) {
+            ++missed;
+            lead_ns = (std::min)(lead_ns + 0.5e6, refresh_ns * 0.75);
+        } else {
+            lead_ns = (std::max)(lead_ns - 0.01e6, 0.5e6);
+        }
+    }
+    last_shown = shown;
+    last_shown_id = id;
+    Report(shown);
+}
+
+void HostPacer::NoteShownWait(bool shown) {
+    if (shown) {
+        shown_wait_misses = 0;
+        return;
+    }
+    if (++shown_wait_misses >= 8 && !broken) {
+        broken = true;
+        pacing = false;
+        VideoCommon::Nx2Perf::g_host_refresh_ns.store(0, std::memory_order_relaxed);
+        LOG_WARNING(Render_Vulkan, "Host pacing: frames are not reported shown in time (present "
+                                   "wait does not signal here); pacing is off for this session");
+    }
+}
+
+void HostPacer::NoteHold(Ns hold) {
+    ++held;
+    hold_sum_ms += Ms{hold}.count();
+}
+
+void HostPacer::Report(Clock::time_point now) {
+    if (now - report_start < std::chrono::seconds{10} || frames == 0) {
+        return;
+    }
+    u32 intervals = 0;
+    for (const u32 count : refreshes_shown) {
+        intervals += count;
+    }
+    LOG_INFO(Render_Vulkan,
+             "Host pacing {}: {} frames at {:.3f} Hz; shown for 1/2/3/4/5+ refreshes: "
+             "{}/{}/{}/{}/{} (same refresh {}); interval mean {:.2f} ms, max {:.2f}; held {} "
+             "(mean {:.2f} ms, missed {}), lead {:.2f} ms; present to shown {:.2f} ms; game "
+             "frame {:.2f} ms; {} lost; caught up {}",
+             pacing ? "on" : "off", frames, 1e9 / refresh_ns, refreshes_shown[1],
+             refreshes_shown[2], refreshes_shown[3], refreshes_shown[4], refreshes_shown[5],
+             refreshes_shown[0], intervals ? interval_sum_ms / intervals : 0.0, interval_max_ms,
+             held, held ? hold_sum_ms / held : 0.0, missed, lead_ns / 1e6,
+             latency_sum_ms / frames, content_ns / 1e6, lost, caught_up);
+    report_start = now;
+    refreshes_shown = {};
+    frames = held = missed = lost = caught_up = 0;
+    interval_sum_ms = interval_max_ms = hold_sum_ms = latency_sum_ms = 0;
+}
+
+} // namespace Vulkan
diff --git a/src/video_core/renderer_vulkan/vk_host_pacer.h b/src/video_core/renderer_vulkan/vk_host_pacer.h
new file mode 100644
index 0000000000..015b184add
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_host_pacer.h
@@ -0,0 +1,134 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <deque>
+#include <optional>
+#include <string>
+
+#include "common/common_types.h"
+
+namespace Vulkan {
+
+struct DisplayRefresh {
+    double period_ns;
+    std::string display; ///< Which display and source, for the log
+};
+
+/// The refresh period of the display a window is on (Windows; nullopt elsewhere or on failure).
+/// Keeps the display's rate between queries so the display configuration is only read again
+/// when the window moves to another display, its mode changes, or every 30 s.
+class DisplayRefreshQuery {
+public:
+    /// `native_window`: the HWND on Windows; null queries the primary display.
+    [[nodiscard]] std::optional<DisplayRefresh> Query(void* native_window);
+
+private:
+    std::string device;   ///< GDI name of the display the rate below belongs to
+    u32 nominal_hz{};     ///< Its integer rate when the rate was read
+    double rational_ns{}; ///< From the display configuration; 0: unavailable
+    std::chrono::steady_clock::time_point stale_at{};
+};
+
+/// LICHII_HOST_PACE: 1 = the host frame pacer holds frames for their refresh and the game's
+/// frame clock follows the display (genlock), 2 = it only measures how long frames are shown,
+/// unset or 0 = off (no present ids, no present wait thread).
+[[nodiscard]] int HostPaceMode();
+
+/// Host frame pacer, from Fritchii (Frizti/Lichii v3 to v4.1).
+///
+/// A swapchain shows a frame at the first display refresh after it is ready. A 60 fps game on a
+/// 120 Hz display should then show every frame for two refreshes, but when its frames reach the
+/// present thread unevenly (the GPU thread's work varies frame to frame) one lands just after a
+/// refresh and stays three refreshes (25 ms), the next just before one and stays one (8 ms); with
+/// mailbox two frames ready within one refresh drop the first. The pacer learns when each frame
+/// was shown (VK_KHR_present_wait) and the display's refresh period, and holds the next frame
+/// until shortly before the refresh `k` refreshes after the previous one, `k` being the game's
+/// frame period in refreshes. A frame that is ready later is presented at once.
+///
+/// Used by the present thread only.
+class HostPacer {
+public:
+    using Clock = std::chrono::steady_clock;
+
+    /// A frame reached the present thread (for the game's frame period).
+    void NoteQueued(Clock::time_point queued);
+
+    /// Whether frames are held now (switch, refresh period known).
+    [[nodiscard]] bool Pacing() const {
+        return pacing;
+    }
+
+    /// Re-reads the refresh period of the display `native_window` is on (see
+    /// DisplayRefreshQuery) now and then.
+    void Refresh(Clock::time_point now, bool allowed, void* native_window);
+
+    /// When the next frame should be handed to the swapchain; `now` or earlier = at once.
+    [[nodiscard]] Clock::time_point Target(Clock::time_point now);
+
+    /// The frame was presented with `id` (0: not presented); `was_held` if Target made it wait.
+    void NoteSubmitted(u64 id, Clock::time_point submitted_at, bool was_held);
+
+    /// Whether the previous frame was reported shown in time. After 8 misses in a row present
+    /// wait is taken as broken on this driver and the pacer turns itself off for the session.
+    void NoteShownWait(bool shown);
+
+    /// Target made the present thread wait `hold`.
+    void NoteHold(std::chrono::nanoseconds hold);
+
+    /// vkWaitForPresentKHR returned for `id` at `shown`, or the present was lost.
+    void NoteShown(u64 id, Clock::time_point shown, bool was_lost);
+
+    /// The last presented id, which the next Target wants shown first (0: none outstanding).
+    [[nodiscard]] u64 Outstanding() const {
+        return outstanding;
+    }
+
+    /// Time from `now` to the display's next refresh, or -1 while the refresh grid is unknown.
+    [[nodiscard]] long long NsToNextRefresh(Clock::time_point now) const;
+
+    [[nodiscard]] std::chrono::nanoseconds RefreshPeriod() const {
+        return std::chrono::nanoseconds{static_cast<s64>(refresh_ns)};
+    }
+
+private:
+    struct Submitted {
+        u64 id;
+        Clock::time_point submitted;
+        std::optional<Clock::time_point> intended; // the refresh it was held for
+    };
+
+    void Report(Clock::time_point now);
+
+    bool pacing{};
+    bool broken{};           ///< Present wait does not signal here: pacing stays off
+    u32 shown_wait_misses{}; ///< In a row
+    double refresh_ns{1e9 / 60.0};
+    bool refresh_known{};
+    Clock::time_point next_refresh_query{};
+    DisplayRefreshQuery refresh_query;
+    std::string refresh_display;
+
+    std::optional<Clock::time_point> last_queued;
+    double content_ns{1e9 / 60.0};
+
+    std::optional<Clock::time_point> vblank; // refresh the last shown frame appeared at
+    std::optional<Clock::time_point> last_shown;
+    u64 last_shown_id{};
+    std::optional<Clock::time_point> pending_intended;
+    double lead_ns{2.0e6};
+    u32 early_streak{}; ///< Frames in a row that could have been shown a refresh earlier
+    u64 outstanding{};
+    std::deque<Submitted> submitted;
+
+    // Reported every 10 s.
+    Clock::time_point report_start{};
+    std::array<u32, 6> refreshes_shown{}; // 0 (same refresh), 1, 2, 3, 4, 5+
+    u32 frames{}, held{}, missed{}, lost{}, caught_up{};
+    double interval_sum_ms{}, interval_max_ms{}, hold_sum_ms{}, latency_sum_ms{};
+};
+
+} // namespace Vulkan
diff --git a/src/video_core/renderer_vulkan/vk_nvn_direct_astc.cpp b/src/video_core/renderer_vulkan/vk_nvn_direct_astc.cpp
new file mode 100644
index 0000000000..721753237f
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_nvn_direct_astc.cpp
@@ -0,0 +1,593 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#ifdef LICHII_NVN_DIRECT
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+
+#include "common/div_ceil.h"
+#include "common/logging.h"
+#include "video_core/host_shaders/astc_decoder_comp_spv.h"
+#include "video_core/host_shaders/bc_encoder_comp_spv.h"
+#include "video_core/renderer_vulkan/vk_compute_pass.h"
+#include <cstdlib>
+#include <span>
+#include <string>
+
+#include "video_core/renderer_vulkan/vk_nvn_direct_astc.h"
+#include "video_core/textures/astc.h"
+#include "video_core/vulkan_common/vulkan_device.h"
+#include "video_core/vulkan_common/vulkan_memory_allocator.h"
+
+namespace Vulkan {
+namespace {
+
+// A GOB is 64 bytes (4 ASTC blocks) wide and 8 block rows high (astc_decoder.comp's
+// GOB_SIZE_*_SHIFT); a block of GOBs is 1 << block_height_log2 GOBs high.
+constexpr u32 GobBlocksX = 4;
+constexpr u32 GobRows = 8;
+constexpr u32 GobShift = 9;
+
+/// Both shaders take one storage buffer and one storage image (push descriptors).
+struct TileDescriptors {
+    VkDescriptorBufferInfo buffer;
+    VkDescriptorImageInfo image;
+};
+
+struct ComputeProgram {
+    vk::DescriptorSetLayout set_layout;
+    vk::PipelineLayout layout;
+    vk::DescriptorUpdateTemplate update_template;
+    vk::ShaderModule module;
+    vk::Pipeline pipeline;
+};
+
+ComputeProgram MakeProgram(const Device& device, u32 buffer_binding, u32 image_binding,
+                           u32 push_size, std::span<const u32> code) {
+    const vk::Device& dev = device.GetLogical();
+    const std::array<VkDescriptorSetLayoutBinding, 2> bindings{{
+        {buffer_binding, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT,
+         nullptr},
+        {image_binding, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 1, VK_SHADER_STAGE_COMPUTE_BIT,
+         nullptr},
+    }};
+    ComputeProgram program;
+    program.set_layout = dev.CreateDescriptorSetLayout({
+        .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+        .pNext = nullptr,
+        .flags = VK_DESCRIPTOR_SET_LAYOUT_CREATE_PUSH_DESCRIPTOR_BIT_KHR,
+        .bindingCount = static_cast<u32>(bindings.size()),
+        .pBindings = bindings.data(),
+    });
+    const VkPushConstantRange push_range{VK_SHADER_STAGE_COMPUTE_BIT, 0, push_size};
+    program.layout = dev.CreatePipelineLayout({
+        .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+        .pNext = nullptr,
+        .flags = 0,
+        .setLayoutCount = 1,
+        .pSetLayouts = program.set_layout.address(),
+        .pushConstantRangeCount = 1,
+        .pPushConstantRanges = &push_range,
+    });
+    const std::array<VkDescriptorUpdateTemplateEntry, 2> entries{{
+        {buffer_binding, 0, 1, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+         offsetof(TileDescriptors, buffer), sizeof(TileDescriptors)},
+        {image_binding, 0, 1, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, offsetof(TileDescriptors, image),
+         sizeof(TileDescriptors)},
+    }};
+    program.update_template = dev.CreateDescriptorUpdateTemplate({
+        .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_UPDATE_TEMPLATE_CREATE_INFO,
+        .pNext = nullptr,
+        .flags = 0,
+        .descriptorUpdateEntryCount = static_cast<u32>(entries.size()),
+        .pDescriptorUpdateEntries = entries.data(),
+        .templateType = VK_DESCRIPTOR_UPDATE_TEMPLATE_TYPE_PUSH_DESCRIPTORS_KHR,
+        .descriptorSetLayout = *program.set_layout,
+        .pipelineBindPoint = VK_PIPELINE_BIND_POINT_COMPUTE,
+        .pipelineLayout = *program.layout,
+        .set = 0,
+    });
+    program.module = dev.CreateShaderModule({
+        .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+        .pNext = nullptr,
+        .flags = 0,
+        .codeSize = code.size_bytes(),
+        .pCode = code.data(),
+    });
+    program.pipeline = dev.CreateComputePipeline(
+        {
+            .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+            .pNext = nullptr,
+            .flags = std::getenv("DM_VK_PIPE_STATS") != nullptr && device.IsKhrPipelineExecutablePropertiesEnabled()
+                         ? VkPipelineCreateFlags{VK_PIPELINE_CREATE_CAPTURE_STATISTICS_BIT_KHR}
+                         : VkPipelineCreateFlags{0},
+            .stage{
+                .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+                .pNext = nullptr,
+                .flags = 0,
+                .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+                .module = *program.module,
+                .pName = "main",
+                .pSpecializationInfo = nullptr,
+            },
+            .layout = *program.layout,
+            .basePipelineHandle = {},
+            .basePipelineIndex = 0,
+        },
+        device.StaticPipelineCache());
+    // Lab (DM_VK_PIPE_STATS=1, dotfiles-25x.8): the driver's statistics of the decode / encode
+    // pipeline (local memory per thread sizes a pool NVML counts outside the memory heaps).
+    if (std::getenv("DM_VK_PIPE_STATS") != nullptr && device.IsKhrPipelineExecutablePropertiesEnabled()) {
+        const auto& logical = device.GetLogical();
+        const auto executables = logical.GetPipelineExecutablePropertiesKHR(*program.pipeline);
+        for (u32 index = 0; index < executables.size(); ++index) {
+            std::string text;
+            for (const auto& statistic :
+                 logical.GetPipelineExecutableStatisticsKHR(*program.pipeline, index)) {
+                text += fmt::format(" {}={}", statistic.name, statistic.value.u64);
+            }
+            LOG_INFO(Render_Vulkan, "NVN2 direct mode: ASTC/BC pipeline ({} bytes of SPIR-V) statistics:{}",
+                     code.size_bytes(), text);
+        }
+    }
+    return program;
+}
+
+void MemoryBarrier(const vk::CommandBuffer& cmdbuf, VkPipelineStageFlags src,
+                   VkAccessFlags src_access, VkPipelineStageFlags dst, VkAccessFlags dst_access) {
+    cmdbuf.PipelineBarrier(src, dst, 0,
+                           VkMemoryBarrier{
+                               .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                               .pNext = nullptr,
+                               .srcAccessMask = src_access,
+                               .dstAccessMask = dst_access,
+                           });
+}
