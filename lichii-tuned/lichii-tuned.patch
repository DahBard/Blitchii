+              vk.vkCreateSampler(V.dev, &ci, NULL, &s); }
+    return s;
+}
+
+// Re-uploads im if the CPU wrote its storage since its last upload, or a sparse one if its mappings or pages changed (vka_tex_prepare; caller holds g_tmu and nvn_pool_use)
+static void reup_written(vka_img *im, VkCommandBuffer cb) {
+    if (img_pool_dead(im)) return;
+    // (GPU-written: binds only. Lichii, dotfiles-25x.22: a sampled one's residency image too once the GPU wrote it (copies into MKW's 68-layer arrays): its content is the
+    // GPU's from then on, but the tiles the game maps later still need memory before the copies that fill them)
+    if ((im->vbind || (im->rs && im->vtrack && im->gpu_owned)) && im->mem) { if (nvn_sparse_since(im->vpool, (uint64_t)(uintptr_t)im->mem, im->L.size, im->vgen, im->stamp)) sparse_bind(im, cb, 0); return; }
+    if (im->vtrack && !im->gpu_owned && im->mem) {
+        if (!nvn_sparse_since(im->vpool, (uint64_t)(uintptr_t)im->mem, im->L.size, im->vgen, im->stamp)) return;
+        sparse_refresh(im, cb);
+        if (g_reup++ < 8) VLOG("sparse texture serial %llu %ux%u format %#x: its mappings or pages changed, re-uploaded", (unsigned long long)im->serial, im->w, im->h, im->d.format);
+        return;
+    }
+    if (!im->track || im->gpu_owned || !im->mem) return;
+    uint64_t size = im->L.size;
+    size_t lo, hi;
+    if (!nvn_dirty_bounds_since(im->span, im->mem, size, im->stamp, &lo, &hi)) return;
+    tex_t t = {0}; t.serial = im->serial; t.d = im->d; t.L = im->L; t.mem = (uint8_t *)im->mem;
+    int rows = VKA_ENV("DM_VK_ROWS", 1);
+    if (rows && upload_rows_tracked(im, &t, cb, lo, hi)) return;
+    upload_tracked(im, &t, cb);
+    if (g_reup++ < 8) VLOG("texture serial %llu %ux%u format %#x flags %#x target %d: its storage changed, re-uploaded", (unsigned long long)im->serial, im->w, im->h, im->d.format, im->d.flags, im->d.target);
+}
+// A BC1 image of an ASTC texture made again as BC3 and filled from its storage (vka_tex_astc_copy; caller holds g_tmu), as img_rebase swaps a sparse texture's image: the old
+// image goes when the GPU is done with it, and the texture IDs that name it are written again. 0: it keeps BC1 (the GPU wrote it, a holder has it, or no image was made)
+static int astc_reformat(vka_img *im, uint8_t bpb, VkCommandBuffer cb) {
+    if (!im->f.astc_bw) return 0;
+    if (im->f.bpb == bpb) return 1;
+    if (im->gpu_owned || im->holds || im->rs || im->vpool || img_pool_dead(im)) {
+        static _Atomic int n; if (atomic_fetch_add(&n, 1) < 8) VRED("ASTC texture serial %llu %ux%u format %#x: its BC%d image is in a copy with a BC%d one and is not made again (%s): the copy is skipped",
+                                                                (unsigned long long)im->serial, im->w, im->h, im->d.format, im->f.bpb == 8 ? 1 : 3, bpb == 8 ? 1 : 3, im->gpu_owned ? "the GPU wrote it" : "held or sparse");
+        return 0;
+    }
+    tex_t t = {0}; t.serial = im->serial; t.d = im->d; t.L = im->L; t.mem = (uint8_t *)im->mem; t.pool = (pool_t *)im->pool;
+    vka_fmt f; if (!vka_fmt_of(im->d.format, &f)) return 0;
+    if (bpb == 8) bc1_fmt(&f);
+    vka_img *n = img_create(&t, &f, im->base);
+    if (!n) return 0;
+    vka_img *old = calloc(1, sizeof *old);
+    if (!old) { g_img_bytes -= n->bytes; img_destroy(n); return 0; }
+    old->img = im->img; old->m = im->m; old->views = im->views;
+    uint64_t ob = im->bytes;
+    g_img_bytes -= im->bytes;
+    im->img = n->img; im->m = n->m; im->views = NULL; im->usage = n->usage; im->bytes = n->bytes; im->f = n->f; im->alt = n->alt; im->nx = n->nx; memcpy(im->xfmt, n->xfmt, sizeof im->xfmt);
+    free(n);
+    vka_after(vka_fence_last() + !vka_worker_on(), img_destroy, old);   // (inline replay: after the submission being recorded)
+    VkCommandBuffer ucb = cb && cb == vka_rp_cb() && vka_up_on() ? vka_up_begin() : VK_NULL_HANDLE, ub = ucb ? ucb : cb;
+    vka_img_barrier(ub, im->img, im->aspect, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL);
+    nvn_tex_layout(&t.d, &t.L);
+    if (im->track) upload_tracked(im, &t, ub); else upload_fill(im, &t, ub);
+    if ((ub = vka_up_cur(ub))) vka_barrier(ub);
+    if (ucb) vka_up_end();
+    unsigned nid = redirty_ids(im);
+    if (g_bc1_n[3]++ < 16) VLOG("ASTC texture serial %llu %ux%u format %#x: made again as BC%d for a texture copy (%.1f -> %.1f MiB, %u texture IDs written again)",
+                                (unsigned long long)im->serial, im->w, im->h, im->d.format, bpb == 8 ? 1 : 3, ob / 1048576.0, im->bytes / 1048576.0, nid);
+    return 1;
+}
+void vka_tex_prepare(VkCommandBuffer cb) {
+    bindless_init();
+    nvn_pool_use(1);   // the re-uploads below read guest storage: no pool is finalized (and unmapped) under them. Taken before g_tmu, as write_tex does
+    pthread_mutex_lock(&g_tmu);
+    for (int i = 0; i < g_nredo; i++) {   // CPU writes to textures that already have an image (WriteTexels): from now on they follow their storage
+        smap_ent *e = map_get(g_redo[i]); vka_img *im = e ? e->im : NULL;
+        if (!im || !im->cpu_dirty) continue;
+        im->cpu_dirty = 0;
+        if (im->gpu_owned || img_pool_dead(im)) continue;
+        tex_t t = {0}; t.serial = im->serial; t.d = im->d; t.L = im->L; t.mem = (uint8_t *)im->mem;
+        nvn_tex_layout(&t.d, &t.L);
+        if (im->vtrack) { sparse_refresh(im, cb); g_reup++; continue; }
+        if (!im->track && (im->span = nvn_dirty_span(t.mem, t.L.size))) im->track = 1;
+        if (im->track) upload_tracked(im, &t, cb); else upload_fill(im, &t, cb);
+        g_reup++;
+    }
+    g_nredo = 0;
+    // GPU writes whose submission is done: the images over them that did not get their bytes are uploaded again (see gw_t above)
+    gml_poll();
+    if (vka_nan_on()) watch_scan(cb);
+    static uint64_t nprep, kinds[4], ntake; nprep++;
+    if (vka_nan_on()) { for (int i = 0; i < g_ngw; i++) if (g_gw[i].fence && g_gw[i].fence <= vka_done()) kinds[g_gw[i].kind]++;
+        if (nprep % 600 == 0) VLOG("NaN scan: GPU writes into guest memory done so far: %llu copies, %llu fills, %llu inline updates, %llu stores / texture → buffer copies (%llu pages from raw global memory logs, %llu logs full, %llu without a log); textures re-uploaded after them %llu", (unsigned long long)kinds[0], (unsigned long long)kinds[1], (unsigned long long)kinds[2], (unsigned long long)kinds[3], (unsigned long long)g_gml_pages, (unsigned long long)g_gml_full, (unsigned long long)g_gml_none, (unsigned long long)g_gw_late); }
+    (void)ntake;
+    if (g_ngw) {
+        // The images whose content comes from their storage, found by address for each done write (hundreds a frame, thousands of images: memidx_meet)
+        uint64_t done = vka_done(); int k = 0;
+        for (int i = 0; i < g_ngw; i++) {
+            gw_t *w = &g_gw[i];
+            if (!w->fence || w->fence > done) { g_gw[k++] = *w; continue; }
+            for (int j = 0, nm = memidx_meet((uintptr_t)w->lo, (uintptr_t)w->hi); j < nm; j++) {
+                vka_img *im = g_meet[j];
+                if (!im->from_mem || im->gpu_owned || im->vpool || img_pool_dead(im) || im->gw_seen >= w->seq) continue;
+                tex_t t = {0}; t.serial = im->serial; t.d = im->d; t.L = im->L; t.mem = (uint8_t *)im->mem;
+                if (im->track) upload_tracked(im, &t, cb); else upload_fill(im, &t, cb);
+                g_gw_late++; if (g_gw_late <= 8 || !(g_gw_late & (g_gw_late - 1))) VLOG("textures re-uploaded after a GPU write into their storage: %llu (uploads that applied pending GPU writes: %llu; pages raw global memory stores wrote: %llu)", (unsigned long long)g_gw_late, (unsigned long long)g_gw_over, (unsigned long long)g_gml_pages);
+                if (g_gw_late <= 8) VLOG("texture serial %llu %ux%u format %#x: a GPU write into its storage (%s %#llx+%#llx) is done, re-uploaded", (unsigned long long)im->serial, im->w, im->h, im->d.format,
+                                          w->kind == GW_COPY ? "copy" : w->kind == GW_FILL ? "fill" : w->kind == GW_UPDATE ? "inline update" : "store", (unsigned long long)w->lo, (unsigned long long)(w->hi - w->lo));
+            }
+            free(w->data);
+        }
+        g_ngw = k;
+    }
+    // Tracked images whose pages the CPU wrote since their last upload (a write to a protected page moves the dirty clock, so nothing is scanned while it stands still)
+    // Sparse pools' textures also when a mapping request came since (the page table's generation moved)
+    static uint64_t seen, vseen; uint64_t now = nvn_dirty_now(), vnow = nvn_sparse_gen();
+    if (now != seen || vnow != vseen) {
+        seen = now; vseen = vnow;
+        // Lichii (dotfiles-25x.13): only the images over the pages written since the last check (nvn_dirty_take), and the sparse pools' ones, whose physical pages lie elsewhere;
+        // every live image when the write log was lost
+        static nvn_dirty_range wr[4096]; int nwr = nvn_dirty_take(wr, 4096);
+        if (nwr < 0) for (int i = 0; i < g_nlive; i++) reup_written(g_live[i], cb);
+        else {
+            for (int i = 0; i < g_nvimg; i++) reup_written(g_vimg[i], cb);
+            for (int r = 0; r < nwr; r++) for (int j = 0, nm = memidx_meet(wr[r].lo, wr[r].hi); j < nm; j++) if (!g_meet[j]->vpool) reup_written(g_meet[j], cb);
+        }
+    }
+    nvn_pool_use(0);   // (write_tex takes it again for each ID, after letting g_tmu go: never twice on one thread)
+    if (!g_set) { g_ntd = g_nsd = 0; if (g_tdflag) memset(g_tdflag, 0, 1 << 20); if (g_sdflag) memset(g_sdflag, 0, 4096 * 4); pthread_mutex_unlock(&g_tmu); return; }
+    if (g_ntl > 2 * g_tl_pending + 1024) { int k = 0; for (int i = 0; i < g_ntl; i++) if (g_tlflag[g_tlazy[i]]) g_tlazy[k++] = g_tlazy[i]; g_ntl = k; }   // (IDs made since: out of the waiting list)
+    enum { BATCH = 64 }; VkWriteDescriptorSet w[BATCH]; VkDescriptorImageInfo ii[BATCH]; int nw = 0;
+    for (int k = 0; k < g_ntd; k++) {
+        int id = g_tdirty[k]; g_tdflag[id] = 0;
+        if (id >= (int)(g_treg[id].img ? g_nimg_slots : g_ntex_slots)) { VRED_ONCE("texture ID %d beyond the table", id); continue; }
+        write_tex(id, cb, &w[nw], &ii[nw], 0);
+        if (w[nw].pImageInfo->imageView) nw++;
+        if (nw == BATCH) { vk.vkUpdateDescriptorSets(V.dev, (uint32_t)nw, w, 0, NULL); nw = 0; }
+    }
+    g_ntd = 0;
+    for (int k = 0; k < g_nsd; k++) {
+        int id = g_sdirty[k]; g_sdflag[id] = 0;
+        if (id >= (int)g_nsamp_slots) { VRED_ONCE("sampler ID %d beyond the table (%u)", id, g_nsamp_slots); continue; }
