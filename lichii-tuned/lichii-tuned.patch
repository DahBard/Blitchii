+    else if (nf == 0x0a || nf == 0x16 || nf == 0x22 || nf == 0x2e) { for (size_t i = 0; i + 4 <= n; i += 4) { uint32_t v; memcpy(&v, p + i, 4); if ((v & 0x7f800000u) == 0x7f800000u) { v = 0; memcpy(p + i, &v, 4); } } }
