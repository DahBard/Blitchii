+    }
+    const int previous = value->load(std::memory_order_relaxed);
+    json result = {
+        {"name", name}, {"previous", previous}, {"value", previous}, {"present", present}};
+    if (!params.contains("value")) {
+        return result;
+    }
+    const json& wanted = params.at("value");
+    int max = (std::numeric_limits<int>::max)();
+    for (const Control::NamedSwitch& entry : Control::NamedSwitches()) {
+        max = name == entry.name ? entry.max : max;
+    }
+    if (!wanted.is_number_integer() || wanted.get<s64>() < 0 || wanted.get<s64>() > max) {
+        throw std::runtime_error{fmt::format("value must be a whole number from 0 to {}", max)};
+    }
+    const int next = static_cast<int>(wanted.get<s64>());
+    const bool keep = params.value("keep", false);
+    if (keep) {
+        owners.entries.erase(name);
+    } else {
