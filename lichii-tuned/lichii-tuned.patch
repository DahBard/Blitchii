+        return 1;
+    }
+    if (!vka_scratch(sz, V.ub_align, &s)) return 0;
+    vka_drv_fill(&d->b, st, bank, pool, s.ptr);
+    *bi = (VkDescriptorBufferInfo){s.buf, s.off, sz};
