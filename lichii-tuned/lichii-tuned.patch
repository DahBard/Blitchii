+        std::span<const u8> input;
+        size_t pitch;
+        size_t band_bytes;
+        u32 bytes_per_pixel;
+        u32 width;
+        u32 height;
+        u32 band_rows;
+        u32 bands_per_chunk;
+        u32 block_height;
+        u32 stride_alignment;
+        u32 chunks;
+        bool native_tiling;
+        std::atomic<u32> next{};
+        std::atomic<u32> done{};
