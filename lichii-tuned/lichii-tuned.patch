+/// EDEN_NX2_GPU_CLOCK_PROBE=1 (off by default, read at device creation): VK_KHR_shader_clock is
+/// enabled, and once a second the Vulkan worker records one single-wave dispatch that times a
+/// fixed dependent loop with the shader clock, read back once its submission completed. Every
+/// 10 s a 'GPU clock probe' line gives the shader clock in MHz and the loop's time.
+[[nodiscard]] bool GpuClockProbeRequested();
+
+/// The probe's state for the boot line: off, on, or why it doesn't run.
+[[nodiscard]] std::string_view GpuClockProbeState();
+
+class GpuClockProbe {
+public:
+    /// Nothing unless the switch is set and the device has the subgroup clock and timestamps.
+    [[nodiscard]] static std::optional<GpuClockProbe> Create(const Device& device);
+
+    explicit GpuClockProbe(const Device& device);
+
+    /// Vulkan worker, when a submission's upload command buffer begins: reads back the last probe
+    /// once its submission completed, and records the next one into cmdbuf once a second.
+    void BeginCommandBuffer(const Device& device, MasterSemaphore& master_semaphore,
+                            vk::CommandBuffer cmdbuf);
+
+    /// Vulkan worker: the command buffer passed last to BeginCommandBuffer is submitted as tick.
+    void Submit(u64 tick) {
+        if (recorded) {
+            recorded = false;
+            pending_tick = tick;
+        }
+    }
+
+    /// The submission whose probe is not read back yet (it uses the probe's objects), or 0.
+    [[nodiscard]] u64 PendingTick() const {
+        return pending_tick;
+    }
+
+private:
+    struct Sample {
+        u64 cycles;
+        u64 realtime_ticks;
+        u64 timestamp_ticks;
+    };
+
+    void Record(vk::CommandBuffer cmdbuf) const;
+    void ReadBack(const Device& device);
+    void Report(std::chrono::steady_clock::time_point now);
+
+    vk::Buffer buffer;
+    vk::QueryPool query_pool;
+    vk::DescriptorSetLayout set_layout;
+    vk::DescriptorPool descriptor_pool;
+    vk::DescriptorSets descriptor_set;
+    vk::PipelineLayout pipeline_layout;
+    vk::ShaderModule shader;
+    vk::Pipeline pipeline;
+
+    bool realtime{};
+    u32 timestamp_bits{};
+    double timestamp_period_ns{};
+
+    bool recorded{};
+    u64 pending_tick{};
+    std::chrono::steady_clock::time_point next_refresh{};
+    std::chrono::steady_clock::time_point next_probe{};
+    std::chrono::steady_clock::time_point window_start{};
+    std::vector<Sample> samples;
+    u32 dropped{};
+
+    /// The realtime clock's rate, measured against the timestamps from probe to probe: the
+    /// drivers don't report it.
+    std::optional<std::pair<u64, u64>> last_clocks; ///< Realtime and timestamp at a loop start.
+    double calibration_ticks{};
+    double calibration_seconds{};
+    double realtime_hz{};
+};
+
+} // namespace Vulkan
