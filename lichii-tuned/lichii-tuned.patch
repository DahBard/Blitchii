+typedef struct qjob { void (*fn)(void *); void *ctx; struct qjob *next; } qjob;
+struct plat_queue { pthread_mutex_t mu; pthread_cond_t cv; qjob *head, *tail; char name[16]; };
+static void *queue_run(void *p) {
